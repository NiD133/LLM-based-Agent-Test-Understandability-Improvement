  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 09:02:07 GMT 2026\n */\n\npackage org.apache.commons.codec.net;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.charset.Charset;\nimport org.apache.commons.codec.CodecPolicy;\nimport org.apache.commons.codec.net.BCodec;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class BCodec_ESTest extends BCodec_ESTest_scaffolding {\n\n    // --- encode(String, String) ---\n\n    @Test(timeout = 4000)\n    public void test00_encodeWithInvalidCharsetNameThrowsException() throws Throwable {\n        BCodec bCodec = new BCodec();\n        try {\n            bCodec.encode(\"\", \"org.apache.commons.codec.binary.Base64\");\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // org.apache.commons.codec.binary.Base64\n            //\n            verifyException(\"org.apache.commons.codec.net.BCodec\", e);\n        }\n    }\n\n    // --- isStrictDecoding() ---\n\n    @Test(timeout = 4000)\n    public void test01_strictDecodingPolicyReturnsTrue() throws Throwable {\n        Charset charset = Charset.defaultCharset();\n        BCodec bCodec = new BCodec(charset, CodecPolicy.STRICT);\n        boolean isStrict = bCodec.isStrictDecoding();\n        assertTrue(isStrict);\n    }\n\n    @Test(timeout = 4000)\n    public void test02_defaultDecodingPolicyIsLenientReturnsFalse() throws Throwable {\n        Charset charset = Charset.defaultCharset();\n        BCodec bCodec = new BCodec(charset);\n        boolean isStrict = bCodec.isStrictDecoding();\n        assertFalse(isStrict);\n    }\n\n    @Test(timeout = 4000)\n    public void test11_constructorWithCharsetNameUsesLenientDecoding() throws Throwable {\n        BCodec bCodec = new BCodec(\"uS\");\n        assertFalse(bCodec.isStrictDecoding());\n    }\n\n    // --- encode(Object) ---\n\n    @Test(timeout = 4000)\n    public void test03_encodeObjectWithUnsupportedTypeThrowsException() throws Throwable {\n        BCodec bCodec = new BCodec();\n        try {\n            bCodec.encode((Object) bCodec);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // Objects of type org.apache.commons.codec.net.BCodec cannot be encoded using BCodec\n            //\n            verifyException(\"org.apache.commons.codec.net.BCodec\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test04_encodeObjectWithNullReturnsNull() throws Throwable {\n        BCodec bCodec = new BCodec();\n        Object result = bCodec.encode((Object) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test12_encodeObjectWithStringReturnsRfc1522Base64Header() throws Throwable {\n        BCodec bCodec = new BCodec();\n        Object result = bCodec.encode((Object) \"}~\");\n        assertNotNull(result);\n        assertEquals(\"=?UTF-8?B?fX4=?=\", result);\n    }\n\n    // --- doEncoding(byte[]) ---\n\n    @Test(timeout = 4000)\n    public void test05_doEncodingWithNullInputReturnsNull() throws Throwable {\n        BCodec bCodec = new BCodec();\n        byte[] result = bCodec.doEncoding((byte[]) null);\n        assertNull(result);\n    }\n\n    // --- doDecoding(byte[]) ---\n\n    @Test(timeout = 4000)\n    public void test06_doDecodingWithNullInputReturnsNull() throws Throwable {\n        BCodec bCodec = new BCodec();\n        byte[] result = bCodec.doDecoding((byte[]) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test07_doDecodingWithEmptyByteArrayReturnsEmptyByteArray() throws Throwable {\n        BCodec bCodec = new BCodec();\n        byte[] emptyInput = new byte[0];\n        byte[] result = bCodec.doDecoding(emptyInput);\n        assertArrayEquals(new byte[] {}, result);\n    }\n\n    // --- decode(Object) ---\n\n    @Test(timeout = 4000)\n    public void test08_decodeObjectWithUnsupportedTypeThrowsException() throws Throwable {\n        BCodec bCodec = new BCodec();\n        try {\n            bCodec.decode((Object) bCodec);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // Objects of type org.apache.commons.codec.net.BCodec cannot be decoded using BCodec\n            //\n            verifyException(\"org.apache.commons.codec.net.BCodec\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test09_decodeObjectWithNullReturnsNull() throws Throwable {\n        BCodec bCodec = new BCodec();\n        Object result = bCodec.decode((Object) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test10_decodeObjectWithMalformedEncodedStringThrowsException() throws Throwable {\n        BCodec bCodec = new BCodec();\n        try {\n            bCodec.decode((Object) \")1Y'}:,$Nj&:wqC\");\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // RFC 1522 violation: malformed encoded content\n            //\n            verifyException(\"org.apache.commons.codec.net.RFC1522Codec\", e);\n        }\n    }\n}\n",
