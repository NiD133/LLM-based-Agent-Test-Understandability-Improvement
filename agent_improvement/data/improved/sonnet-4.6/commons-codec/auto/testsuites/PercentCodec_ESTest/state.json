  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 09:05:53 GMT 2026\n */\n\npackage org.apache.commons.codec.net;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.codec.net.PercentCodec;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class PercentCodec_ESTest extends PercentCodec_ESTest_scaffolding {\n\n    // ASCII value of '+', which PercentCodec converts to/from space when plusForSpace=true\n    private static final byte PLUS_SIGN = (byte) 43;\n    // ASCII value of '%', the percent-encoding escape character\n    private static final byte PERCENT_SIGN = (byte) 37;\n\n    // -------------------------------------------------------------------------\n    // Constructor tests\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testConstructorWithNullAlwaysEncodeBytes() throws Throwable {\n        // Passing null for alwaysEncodeChars should not throw; the codec still adds '%' internally\n        PercentCodec percentCodec0 = new PercentCodec((byte[]) null, true);\n    }\n\n    @Test(timeout = 4000)\n    public void testConstructorRejectsNegativeByteInAlwaysEncodeSet() throws Throwable {\n        // Bytes in the always-encode set must be non-negative (valid ASCII range)\n        byte[] alwaysEncodeChars = new byte[] { (byte) (-43) };\n        PercentCodec percentCodec0 = null;\n        try {\n            percentCodec0 = new PercentCodec(alwaysEncodeChars, false);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // byte must be >= 0\n            //\n            verifyException(\"org.apache.commons.codec.net.PercentCodec\", e);\n        }\n    }\n\n    // -------------------------------------------------------------------------\n    // encode(byte[]) tests\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testEncodeByteArrayNullReturnsNull() throws Throwable {\n        PercentCodec percentCodec0 = new PercentCodec();\n        byte[] result = percentCodec0.encode((byte[]) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeNonAsciiByteProducesPercentHexSequence() throws Throwable {\n        // Byte value -59 (0xC5) is non-ASCII; the default codec encodes it as %C5\n        PercentCodec percentCodec0 = new PercentCodec();\n        byte[] input = new byte[] { (byte) (-59) };\n        byte[] encoded = percentCodec0.encode(input);\n        assertArrayEquals(new byte[] { PERCENT_SIGN, (byte) 67, (byte) 53 }, encoded);\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeZeroByteProducesPercentEncodedSequence() throws Throwable {\n        // Zero byte (0x00) falls in the always-encode set; encode gives %00, re-encoding gives %2500\n        byte[] zeroByteArray = new byte[1]; // byteArray[0] == 0\n        PercentCodec percentCodec0 = new PercentCodec(zeroByteArray, false);\n\n        byte[] firstEncode = percentCodec0.encode(zeroByteArray); // 0x00 -> %00\n        byte[] secondEncode = percentCodec0.encode(firstEncode);  // '%' itself gets encoded -> %2500\n        assertArrayEquals(new byte[] { PERCENT_SIGN, (byte) 50, (byte) 53, (byte) 48, (byte) 48 }, secondEncode);\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeSpaceAsPlusWhenPlusForSpaceEnabled() throws Throwable {\n        // With plusForSpace=true, a space (0x20) in the input is encoded as '+' (0x2B)\n        byte[] alwaysEncodeChars = new byte[1]; // [0x00]\n        PercentCodec percentCodec0 = new PercentCodec(alwaysEncodeChars, true);\n\n        byte[] input = new byte[] { (byte) 32, (byte) 4, (byte) 1, (byte) 17 };\n        byte[] encoded = percentCodec0.encode(input);\n\n        assertNotNull(encoded);\n        assertArrayEquals(new byte[] { PLUS_SIGN, (byte) 4, (byte) 1, (byte) 17 }, encoded);\n        assertEquals(4, encoded.length);\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeReturnsSameArrayWhenNoBytesNeedEncoding() throws Throwable {\n        // Byte 13 (0x0D, carriage return) is not in the always-encode set; no encoding needed\n        byte[] alwaysEncodeChars = new byte[5]; // contains only 0x00 five times\n        PercentCodec percentCodec0 = new PercentCodec(alwaysEncodeChars, true);\n\n        byte[] input = new byte[] { (byte) 13 };\n        byte[] result = percentCodec0.encode(input);\n\n        // When nothing needs encoding, the codec returns the original array unchanged\n        assertSame(result, input);\n        assertNotNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeDecodeRoundtripForZeroByte() throws Throwable {\n        // Encode 0x00 -> %00, then decode %00 back to 0x00\n        byte[] zeroByteArray = new byte[1];\n        PercentCodec percentCodec0 = new PercentCodec(zeroByteArray, false);\n\n        byte[] encoded = percentCodec0.encode(zeroByteArray);\n        byte[] decoded = percentCodec0.decode(encoded);\n\n        assertArrayEquals(new byte[] { PERCENT_SIGN, (byte) 48, (byte) 48 }, encoded);\n        assertArrayEquals(new byte[] { (byte) 0 }, decoded);\n    }\n\n    // -------------------------------------------------------------------------\n    // encode(Object) tests\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testEncodeObjectNullReturnsNull() throws Throwable {\n        byte[] alwaysEncodeChars = new byte[1];\n        PercentCodec percentCodec0 = new PercentCodec(alwaysEncodeChars, true);\n        Object result = percentCodec0.encode((Object) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeObjectThrowsForNonByteArrayType() throws Throwable {\n        // Only byte[] objects can be percent-encoded; other types cause an exception\n        byte[] alwaysEncodeChars = new byte[1];\n        PercentCodec percentCodec0 = new PercentCodec(alwaysEncodeChars, true);\n        try {\n            percentCodec0.encode((Object) percentCodec0);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // Objects of type org.apache.commons.codec.net.PercentCodec cannot be Percent encoded\n            //\n            verifyException(\"org.apache.commons.codec.net.PercentCodec\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeObjectReturnsSameArrayWhenNoBytesNeedEncoding() throws Throwable {\n        // With an empty always-encode set (no extra chars, only '%'), zero bytes pass through unchanged\n        byte[] input = new byte[5];\n        byte[] emptyAlwaysEncodeChars = new byte[0];\n        PercentCodec percentCodec0 = new PercentCodec(emptyAlwaysEncodeChars, false);\n\n        Object result = percentCodec0.encode((Object) input);\n        assertSame(input, result);\n        assertNotNull(result);\n    }\n\n    // -------------------------------------------------------------------------\n    // decode(byte[]) tests\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testDecodeByteArrayNullReturnsNull() throws Throwable {\n        PercentCodec percentCodec0 = new PercentCodec();\n        byte[] result = percentCodec0.decode((byte[]) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testDecodeThrowsOnIncompletePercentSequence() throws Throwable {\n        // A '%' at the last position (with no following hex digits)