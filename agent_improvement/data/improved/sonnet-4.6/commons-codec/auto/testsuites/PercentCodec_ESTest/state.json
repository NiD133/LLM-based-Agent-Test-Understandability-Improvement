s = new byte[1];\n        PercentCodec percentCodec0 = new PercentCodec(alwaysEncodeChars, false);\n        Object result = percentCodec0.decode((Object) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testDecodeObjectThrowsForNonByteArrayType() throws Throwable {\n        // Only byte[] objects can be percent-decoded; other types cause an exception\n        byte[] alwaysEncodeChars = new byte[1];\n        PercentCodec percentCodec0 = new PercentCodec(alwaysEncodeChars, true);\n        Object nonByteArray = new Object();\n        try {\n            percentCodec0.decode(nonByteArray);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // Objects of type java.lang.Object cannot be Percent decoded\n            //\n            verifyException(\"org.apache.commons.codec.net.PercentCodec\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void testEncodeDecodeObjectRoundtripPreservesData() throws Throwable {\n        // Encode a byte[] via the Object API and decode it back; result should equal original value\n        byte[] alwaysEncodeChars = new byte[5];\n        PercentCodec percentCodec0 = new PercentCodec(alwaysEncodeChars, false);\n\n        byte[] original = new byte[5];\n        Object encoded = percentCodec0.encode((Object) original);\n        Object decoded = percentCodec0.decode(encoded);\n\n        assertNotNull(decoded);\n        assertNotSame(original, encoded); // encoding produced a new array\n    }\n}\n",
