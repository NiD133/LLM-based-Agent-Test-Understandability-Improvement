  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 07:48:41 GMT 2026\n */\n\npackage org.apache.commons.codec.binary;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.codec.binary.BinaryCodec;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class BinaryCodec_ESTest extends BinaryCodec_ESTest_scaffolding {\n\n    // encode(Object) must reject non-byte-array arguments with an EncoderException\n    @Test(timeout = 4000)\n    public void testEncodeObjectThrowsExceptionForNonByteArray() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        Object nonByteArray = new Object();\n        try {\n            codec.encode(nonByteArray);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // argument not a byte array\n            //\n            verifyException(\"org.apache.commons.codec.binary.BinaryCodec\", e);\n        }\n    }\n\n    // decode(Object) must reject non-byte-array, non-String, non-char[] arguments\n    @Test(timeout = 4000)\n    public void testDecodeObjectThrowsExceptionForNonByteArray() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        Object nonByteArray = new Object();\n        try {\n            codec.decode(nonByteArray);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // argument not a byte array\n            //\n            verifyException(\"org.apache.commons.codec.binary.BinaryCodec\", e);\n        }\n    }\n\n    // Roundtrip: decode(\"\") → empty byte[] → encode → empty char[] → decode → empty byte[] (same instance)\n    @Test(timeout = 4000)\n    public void testDecodeEncodeDecodeEmptyStringRoundtrip() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        Object emptyBytes = codec.decode((Object) \"\");\n        Object encodedChars = codec.encode(emptyBytes);\n        Object redecoded = codec.decode(encodedChars);\n        assertSame(redecoded, emptyBytes);\n    }\n\n    // decode(null) returns the shared empty-byte-array constant, never null\n    @Test(timeout = 4000)\n    public void testDecodeNullObjectReturnsNonNullEmptyByteArray() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        Object result = codec.decode((Object) null);\n        assertNotNull(result);\n    }\n\n    // toAsciiString converts each byte to 8 binary-character digits (MSB-first within each byte,\n    // bytes written right-to-left so byte[0] appears at the rightmost 8 characters)\n    // byte[]{-125, 0, 0} → 0x83=10000011, preceded by two zero bytes → \"000000000000000010000011\"\n    @Test(timeout = 4000)\n    public void testToAsciiStringRepresentsEachByteAsEightBinaryDigits() throws Throwable {\n        byte[] input = new byte[3];\n        input[0] = (byte) (-125); // 0x83 = 10000011\n        String binaryString = BinaryCodec.toAsciiString(input);\n        assertEquals(\"000000000000000010000011\", binaryString);\n    }\n\n    // encode(byte[]) expands each input byte into 8 ASCII '0'/'1' bytes\n    @Test(timeout = 4000)\n    public void testEncodeTwoBytesProducesSixteenAsciiBitBytes() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        byte[] twoBytes = new byte[2];\n        twoBytes[0] = (byte) (-1); // all bits set: 11111111\n        byte[] encoded = codec.encode(twoBytes);\n        assertEquals(16, encoded.length);\n    }\n\n    // toByteArray(null) returns the shared empty-byte-array constant;\n    // toAsciiBytes of that empty array also returns the same constant\n    @Test(timeout = 4000)\n    public void testToAsciiByteOfNullStringResultIsEmptyByteArray() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        byte[] emptyFromNull = codec.toByteArray((String) null);\n        byte[] encodedEmpty = BinaryCodec.toAsciiBytes(emptyFromNull);\n        assertSame(encodedEmpty, emptyFromNull);\n    }\n\n    // toAsciiString returns an empty string when given null\n    @Test(timeout = 4000)\n    public void testToAsciiStringOfNullReturnsEmptyString() throws Throwable {\n        String result = BinaryCodec.toAsciiString((byte[]) null);\n        assertEquals(\"\", result);\n    }\n\n    // toByteArray converts a 56-character binary string (7 bytes worth of bits) into a 7-element byte array\n    @Test(timeout = 4000)\n    public void testToByteArrayConvertsLongBinaryStringToExpectedBytes() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        byte[] result = codec.toByteArray(\"00000001110010111111111110111000101100100000000011111111\");\n        assertArrayEquals(new byte[] {(byte) (-1), (byte) 0, (byte) (-78), (byte) (-72), (byte) (-1), (byte) (-53), (byte) 1}, result);\n    }\n\n    // fromAscii(char[]) with a null argument returns an empty byte array, not null\n    @Test(timeout = 4000)\n    public void testFromAsciiWithNullCharArrayReturnsEmptyByteArray() throws Throwable {\n        byte[] result = BinaryCodec.fromAscii((char[]) null);\n        assertArrayEquals(new byte[] {}, result);\n    }\n\n    // decode(byte[]) interprets each byte as ASCII '0' or '1';\n    // an 8-byte array whose first byte is '1' (ASCII 49) encodes 0x80 = -128 in the output\n    @Test(timeout = 4000)\n    public void testDecodeByteArrayWithOneSetBitReturnsOneByte() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        byte[] asciiBits = new byte[8];\n        asciiBits[0] = (byte) 49; // ASCII '1' — the most-significant bit position\n        byte[] decoded = codec.decode(asciiBits);\n        assertArrayEquals(new byte[] {(byte) (-128)}, decoded);\n    }\n\n    // Decoding an empty string yields the empty-byte-array constant;\n    // decoding that constant again yields the same object reference\n    @Test(timeout = 4000)\n    public void testDecodeEmptyStringAndRedecodeResultReturnsSameInstance() throws Throwable {\n        BinaryCodec codec = new BinaryCodec();\n        Object emptyBytes = codec.decode((Object) \"\");\n        Object redecoded = codec.decode(emptyBytes);\n        assertSame(redecoded, emptyBytes);\n    }\n}\n",
