  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 08:50:14 GMT 2026\n */\n\npackage org.apache.commons.codec.language;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.codec.language.RefinedSoundex;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class RefinedSoundex_ESTest extends RefinedSoundex_ESTest_scaffolding {\n\n  // The US_ENGLISH_MAPPING_STRING \"01360240043788015936020505\" contains only digit characters.\n  // Since RefinedSoundex ignores non-letter input, encoding this string produces an empty result.\n  @Test(timeout = 4000)\n  public void test_encodeDigitOnlyStringProducesEmptyResult()  throws Throwable  {\n      RefinedSoundex refinedSoundex = new RefinedSoundex();\n      Object encoded = refinedSoundex.US_ENGLISH.encode((Object) \"01360240043788015936020505\");\n      assertEquals(\"\", encoded);\n  }\n\n  // When the first argument to difference() is null, the method returns 0\n  // (no phonetic similarity can be computed).\n  @Test(timeout = 4000)\n  public void test_differenceWithNullFirstArgumentReturnsZero()  throws Throwable  {\n      RefinedSoundex refinedSoundex = new RefinedSoundex();\n      int similarity = refinedSoundex.difference((String) null, \"ov9Sw<^R\");\n      assertEquals(0, similarity);\n  }\n\n  // getMappingCode returns '\u0000' for characters that are not letters,\n  // because digits and symbols have no phonetic mapping.\n  @Test(timeout = 4000)\n  public void test_getMappingCodeForNonLetterCharacterReturnsNullChar()  throws Throwable  {\n      char[] customMapping = new char[3];\n      RefinedSoundex refinedSoundex = new RefinedSoundex(customMapping);\n      char mappingCode = refinedSoundex.getMappingCode('9');\n      assertEquals('\u0000', mappingCode);\n  }\n\n  // encode(Object) requires the argument to be a String; passing any other\n  // type must throw an EncoderException with an explanatory message.\n  @Test(timeout = 4000)\n  public void test_encodeNonStringObjectThrowsEncoderException()  throws Throwable  {\n      RefinedSoundex refinedSoundex = new RefinedSoundex();\n      Object nonStringObject = new Object();\n      try {\n        refinedSoundex.encode(nonStringObject);\n        fail(\"Expecting exception: Exception\");\n\n      } catch(Exception e) {\n         //\n         // Parameter supplied to RefinedSoundex encode is not of type java.lang.String\n         //\n         verifyException(\"org.apache.commons.codec.language.RefinedSoundex\", e);\n      }\n  }\n\n  // Two identical strings always produce identical soundex codes, so their\n  // difference score is 1 (length of the shared encoded prefix).\n  // A 6-element all-zero custom mapping means every letter beyond 'F' maps to zero,\n  // so both inputs encode to just their leading letter.\n  @Test(timeout = 4000)\n  public void test_differenceOfIdenticalStringsWithCustomMappingReturnsOne()  throws Throwable  {\n      char[] customMapping = new char[6];\n      RefinedSoundex refinedSoundex = new RefinedSoundex(customMapping);\n      int similarity = refinedSoundex.difference(\"org.apache.commons.codec.EncoderException\", \"org.apache.commons.codec.EncoderException\");\n      assertEquals(1, similarity);\n  }\n\n  // RefinedSoundex can be constructed from an arbitrary mapping String; this\n  // verifies that the constructor accepts any string without throwing.\n  @Test(timeout = 4000)\n  public void test_constructorAcceptsArbitraryMappingString()  throws Throwable  {\n      RefinedSoundex refinedSoundex = new RefinedSoundex(\"p)p5OA\");\n  }\n}\n",
