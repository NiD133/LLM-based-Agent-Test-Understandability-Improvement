  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 08:14:15 GMT 2026\n */\n\npackage org.apache.commons.codec.digest;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.Random;\nimport org.apache.commons.codec.digest.Md5Crypt;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.mock.java.util.MockRandom;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Md5Crypt_ESTest extends Md5Crypt_ESTest_scaffolding {\n\n    // -----------------------------------------------------------------------\n    // Validation: md5Crypt rejects malformed salts and prefixes\n    // -----------------------------------------------------------------------\n\n    /**\n     * Salt \"%=XSdI= \" does not match the pattern required by prefix \"1%NP@$\",\n     * so md5Crypt must throw IllegalArgumentException with \"Invalid salt value\".\n     */\n    @Test(timeout = 4000)\n    public void testMd5Crypt_throwsOnSaltNotMatchingPrefix() throws Throwable {\n        byte[] password = new byte[9];\n        MockRandom mockRandom = new MockRandom((byte) (-21));\n        try {\n            Md5Crypt.md5Crypt(password, \"%=XSdI= \", \"1%NP@$\", (Random) mockRandom);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            verifyException(\"org.apache.commons.codec.digest.Md5Crypt\", e);\n        }\n    }\n\n    /**\n     * Prefix \"zHE)\" neither starts nor ends with '$', which violates the\n     * required prefix format, so md5Crypt must throw IllegalArgumentException.\n     */\n    @Test(timeout = 4000)\n    public void testMd5Crypt_throwsOnPrefixMissingDollarSign() throws Throwable {\n        byte[] password = new byte[7];\n        try {\n            Md5Crypt.md5Crypt(password, \"$apr1$org.apache.commons.codec.digest.B64\", \"zHE)\");\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            verifyException(\"org.apache.commons.codec.digest.Md5Crypt\", e);\n        }\n    }\n\n    /**\n     * An empty string prefix is too short (minimum length is 3),\n     * so md5Crypt must throw IllegalArgumentException with \"Invalid prefix value\".\n     */\n    @Test(timeout = 4000)\n    public void testMd5Crypt_throwsOnEmptyPrefix() throws Throwable {\n        byte[] password = new byte[2];\n        MockRandom mockRandom = new MockRandom(0L);\n        try {\n            Md5Crypt.md5Crypt(password, \"\", \"\", (Random) mockRandom);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            verifyException(\"org.apache.commons.codec.digest.Md5Crypt\", e);\n        }\n    }\n\n    // -----------------------------------------------------------------------\n    // apr1Crypt: Apache \"$apr1$\" hash generation\n    // -----------------------------------------------------------------------\n\n    /**\n     * apr1Crypt(byte[], null) generates a deterministic APR1 hash when the\n     * MockRandom produces a fixed salt sequence of eight '.' characters.\n     */\n    @Test(timeout = 4000)\n    public void testApr1Crypt_byteArrayWithNullSaltUsesGeneratedSalt() throws Throwable {\n        byte[] password = new byte[8];\n        String hash = Md5Crypt.apr1Crypt(password, (String) null);\n        assertEquals(\"$apr1$........$qPSnH67sU5.ONzPrASfCP1\", hash);\n    }\n\n    /**\n     * apr1Crypt(String, String) accepts a plain salt (without the \"$apr1$\"\n     * prefix) and prepends it automatically before hashing.\n     */\n    @Test(timeout = 4000)\n    public void testApr1Crypt_stringPasswordWithExplicitSalt() throws Throwable {\n        String hash = Md5Crypt.apr1Crypt(\"~jShJLXp!+\", \"WU04K\");\n        assertEquals(\"$apr1$WU04K$bMFrvq41gU5Hz2FhGeKhI.\", hash);\n    }\n\n    /**\n     * apr1Crypt(byte[], Random) uses the supplied Random instance to generate\n     * the salt, producing a deterministic hash under MockRandom.\n     */\n    @Test(timeout = 4000)\n    public void testApr1Crypt_byteArrayWithMockRandomSalt() throws Throwable {\n        byte[] password = new byte[4];\n        MockRandom mockRandom = new MockRandom((byte) 0);\n        String hash = Md5Crypt.apr1Crypt(password, (Random) mockRandom);\n        assertEquals(\"$apr1$........$bvww3NgecnxNN8NV12woN/\", hash);\n    }\n\n    /**\n     * apr1Crypt(String) converts the string to bytes internally and generates\n     * a valid APR1 hash even for an empty-string password.\n     */\n    @Test(timeout = 4000)\n    public void testApr1Crypt_emptyStringPassword() throws Throwable {\n        String hash = Md5Crypt.apr1Crypt(\"\");\n        assertEquals(\"$apr1$........$7DPFf0mVu8RHaTUUmUaFT.\", hash);\n    }\n\n    // -----------------------------------------------------------------------\n    // md5Crypt: libc \"$1$\" hash generation\n    // -----------------------------------------------------------------------\n\n    /**\n     * md5Crypt(byte[], Random) uses the supplied Random instance to generate\n     * the salt, producing a deterministic \"$1$\" hash under MockRandom.\n     */\n    @Test(timeout = 4000)\n    public void testMd5Crypt_byteArrayWithMockRandomSalt() throws Throwable {\n        byte[] password = new byte[2];\n        MockRandom mockRandom = new MockRandom();\n        String hash = Md5Crypt.md5Crypt(password, (Random) mockRandom);\n        assertEquals(\"$1$........$bTtUql3/Wawqh.jbOopI01\", hash);\n    }\n\n    /**\n     * md5Crypt(byte[]) generates a \"$1$\" hash with a deterministic salt when\n     * the EvoSuite MockRandom controls the SecureRandom seed.\n     */\n    @Test(timeout = 4000)\n    public void testMd5Crypt_byteArrayWithGeneratedSalt() throws Throwable {\n        byte[] password = new byte[4];\n        String hash = Md5Crypt.md5Crypt(password);\n        assertEquals(\"$1$........$EixpgL5t2L5AS7g5LlQUj.\", hash);\n    }\n\n    // -----------------------------------------------------------------------\n    // Constructor: Md5Crypt is instantiable (deprecated but public API)\n    // -----------------------------------------------------------------------\n\n    /**\n     * The no-arg constructor is public (though deprecated), so instantiation\n     * must succeed without throwing any exception.\n     */\n    @Test(timeout = 4000)\n    public void testConstructor_canBeInstantiated() throws Throwable {\n        Md5Crypt md5Crypt = new Md5Crypt();\n    }\n}\n",
