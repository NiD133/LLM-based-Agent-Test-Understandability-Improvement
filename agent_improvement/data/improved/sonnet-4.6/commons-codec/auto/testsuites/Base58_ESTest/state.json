  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 07:38:52 GMT 2026\n */\n\npackage org.apache.commons.codec.binary;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.codec.binary.Base58;\nimport org.apache.commons.codec.binary.BaseNCodec;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Base58_ESTest extends Base58_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void test00_encodeAsString_withNegativeFirstByte_returnsString() throws Throwable {\n      Base58 codec = new Base58();\n      byte[] data = new byte[2];\n      data[0] = (byte) (-115);\n      String encoded = codec.encodeAsString(data);\n      //  // Unstable assertion: assertEquals(\"(jM\", encoded);\n  }\n\n  @Test(timeout = 4000)\n  public void test01_encode_withOffsetBeyondArrayBounds_throwsArrayIndexOutOfBoundsException() throws Throwable {\n      Base58 codec = new Base58();\n      BaseNCodec.Context context = new BaseNCodec.Context();\n      byte[] oneByteArray = codec.decode(\"X\");\n      codec.ensureBufferSize(76, context);\n      // Undeclared exception!\n      try {\n          codec.encode(oneByteArray, 64, 64, context); // offset 64 is beyond the 1-byte array\n          fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n      } catch (ArrayIndexOutOfBoundsException e) {\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void test02_encode_withNegativeLength_returnsEmptyByteArray() throws Throwable {\n      Base58 codec = new Base58();\n      byte[] input = new byte[1];\n      byte[] result = codec.encode(input, -20, -20); // negative length signals no data\n      assertEquals(0, result.length);\n  }\n\n  @Test(timeout = 4000)\n  public void test03_decode_withPresetBufferAndOffsetOutOfBounds_throwsArrayIndexOutOfBoundsException() throws Throwable {\n      Base58 codec = new Base58();\n      byte[] buffer = new byte[3];\n      BaseNCodec.Context context = new BaseNCodec.Context();\n      context.buffer = buffer;\n      // Undeclared exception!\n      try {\n          codec.decode(buffer, 15, 0, context); // offset 15 exceeds 3-byte buffer length\n          fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n      } catch (ArrayIndexOutOfBoundsException e) {\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void test04_decode_negativeLength_signalsEofAndSubsequentDecodeIsNoOp() throws Throwable {\n      Base58 codec = new Base58();\n      byte[] buffer = new byte[5];\n      BaseNCodec.Context context = new BaseNCodec.Context();\n      codec.decode(buffer, 95, -98, context); // negative length signals EOF\n      codec.decode(buffer, 88, 71, context);  // decode after EOF is a no-op\n      assertFalse(codec.isStrictDecoding());\n  }\n\n  @Test(timeout = 4000)\n  public void test05_decode_validBase58String_Dt2_returnsExpectedBytes() throws Throwable {\n      Base58 codec = new Base58();\n      byte[] decoded = codec.decode(\"Dt2\");\n      assertArrayEquals(new byte[] {(byte) (-87), (byte) 63}, decoded);\n  }\n\n  @Test(timeout = 4000)\n  public void test06_decode_validBase58String_t2_returnsExpectedBytes() throws Throwable {\n      Base58 codec = new Base58();\n      byte[] decoded = codec.decode(\"t2\");\n      assertArrayEquals(new byte[] {(byte) 11, (byte) (-113)}, decoded);\n  }\n\n  @Test(timeout = 4000)\n  public void test07_decode_stringContainingInvalidCharacter_throwsIllegalArgumentException() throws Throwable {\n      Base58 codec = new Base58();\n      // Undeclared exception!\n      try {\n          codec.decode(\"U/H~Pu3Wv_(Ozg_|N\"); // '|' (0x7c) is not in the Base58 alphabet\n          fail(\"Expecting exception: IllegalArgumentException\");\n      } catch (IllegalArgumentException e) {\n          //\n          // Invalid character in Base58 string: 0x7c\n          //\n          verifyException(\"org.apache.commons.codec.binary.Base58\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void test08_decode_twoLeadingOnes_returnsTwoBytesRepresentingLeadingZeros() throws Throwable {\n      Base58 codec = new Base58();\n      // In Base58, '1' represents a leading zero byte\n      byte[] decoded = codec.decode(\"11\");\n      assertEquals(2, decoded.length);\n  }\n\n  @Test(timeout = 4000)\n  public void test09_builderSetEncodeTable_returnsBuilderItself_forFluentChaining() throws Throwable {\n      Base58.Builder builder = new Base58.Builder();\n      byte[] customTable = new byte[3];\n      Base58.Builder returnedBuilder = builder.setEncodeTable(customTable);\n      assertSame(returnedBuilder, builder);\n  }\n\n  @Test(timeout = 4000)\n  public void test10_builderGet_returnsBase58Instance_andVerifyMimeChunkSizeConstant() throws Throwable {\n      Base58.Builder builder = new Base58.Builder();\n      Base58 codec = builder.get();\n      assertEquals(76, BaseNCodec.MIME_CHUNK_SIZE);\n  }\n\n  @Test(timeout = 4000)\n  public void test11_isInAlphabet_stringWithNonBase58Characters_returnsFalse() throws Throwable {\n      Base58 codec = new Base58();\n      boolean result = codec.isInAlphabet(\"Invalid character in Base58 string: 0x%02x\");\n      assertFalse(result);\n  }\n\n  @Test(timeout = 4000)\n  public void test12_encodeAsString_allZeroBytes_producesAllOnesString() throws Throwable {\n      Base58 codec = new Base58();\n      // In Base58, each leading zero byte encodes as '1'\n      byte[] allZeros = new byte[18];\n      String encoded = codec.encodeAsString(allZeros);\n      assertEquals(\"111111111111111111\", encoded);\n  }\n\n  @Test(timeout = 4000)\n  public void test13_staticBuilderFactory_returnsNonNullBuilder() throws Throwable {\n      Base58.Builder builder = Base58.builder();\n      assertNotNull(builder);\n  }\n}\n",
