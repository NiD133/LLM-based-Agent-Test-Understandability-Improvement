  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 08:54:43 GMT 2026\n */\n\npackage org.apache.commons.codec.language;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.codec.language.Soundex;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Soundex_ESTest extends Soundex_ESTest_scaffolding {\n\n    // Non-letter characters are stripped before encoding; H and W are silent in US_ENGLISH\n    @Test(timeout = 4000)\n    public void test00() throws Throwable {\n        Soundex soundex = Soundex.US_ENGLISH;\n        String result = soundex.encode(\"vyHWF);{\");\n        assertEquals(\"V100\", result);\n    }\n\n    // Encoding a null string returns null without throwing an exception\n    @Test(timeout = 4000)\n    public void test01() throws Throwable {\n        Soundex soundex = Soundex.US_ENGLISH;\n        soundex.encode((String) null);\n        //  // Unstable assertion: assertEquals(0, soundex.getMaxLength());\n    }\n\n    // A mapping shorter than 26 chars causes IllegalArgumentException when a letter falls outside the mapping range\n    @Test(timeout = 4000)\n    public void test02() throws Throwable {\n        Soundex soundex = new Soundex(\"'NY8Wa^[4\");\n        // Undeclared exception!\n        try {\n            soundex.encode(\"'NY8Wa^[4\");\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // The character is not mapped: N (index=13)\n            //\n            verifyException(\"org.apache.commons.codec.language.Soundex\", e);\n        }\n    }\n\n    // encode(Object) only accepts String; passing any other type throws EncoderException\n    @Test(timeout = 4000)\n    public void test03() throws Throwable {\n        Soundex soundex = Soundex.US_ENGLISH_SIMPLIFIED;\n        try {\n            soundex.encode((Object) soundex);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            //\n            // Parameter supplied to Soundex encode is not of type java.lang.String\n            //\n            verifyException(\"org.apache.commons.codec.language.Soundex\", e);\n        }\n    }\n\n    // encode(Object) delegates to encode(String); letters extracted from the input are encoded via the custom mapping\n    @Test(timeout = 4000)\n    public void test04() throws Throwable {\n        Soundex soundex = new Soundex(\"9^n}]@7bH(,#/L\");\n        Object result = soundex.encode((Object) \"9^n}]@7bH(,#/L\");\n        assertEquals(4, soundex.getMaxLength());\n        assertEquals(\"N^#0\", result);\n    }\n\n    // difference() scores phonetic similarity on a 0–4 scale; 1 indicates little similarity\n    @Test(timeout = 4000)\n    public void test05() throws Throwable {\n        Soundex soundex = new Soundex(\"org.apache.commons.codec.EncoderException\");\n        int diff = soundex.US_ENGLISH_GENEALOGY.difference(\")1XSFmv!V?i#\", \"org.apache.commons.codec.EncoderException\");\n        assertEquals(4, soundex.getMaxLength());\n        assertEquals(1, diff);\n    }\n\n    // The US_ENGLISH_GENEALOGY mapping string \"-123-12--22455-12623-1-2-2\" is a valid 26-char mapping\n    @Test(timeout = 4000)\n    public void test06() throws Throwable {\n        Soundex soundex = new Soundex(\"-123-12--22455-12623-1-2-2\");\n        assertEquals(4, soundex.getMaxLength());\n    }\n\n    // A char array containing a single SILENT_MARKER ('-') is accepted as a mapping\n    @Test(timeout = 4000)\n    public void test07() throws Throwable {\n        char[] mapping = new char[1];\n        mapping[0] = '-';\n        Soundex soundex = new Soundex(mapping);\n        assertEquals(4, soundex.getMaxLength());\n    }\n\n    // Two identical strings produce the same Soundex code; difference() between them is 0\n    @Test(timeout = 4000)\n    public void test08() throws Throwable {\n        Soundex soundex = Soundex.US_ENGLISH_GENEALOGY;\n        int diff = soundex.US_ENGLISH.difference(\"01230120022455012623010202\", \"01230120022455012623010202\");\n        assertEquals(0, diff);\n    }\n\n    // setMaxLength() on the static US_ENGLISH instance does not affect a separately constructed instance\n    @Test(timeout = 4000)\n    public void test09() throws Throwable {\n        char[] mapping = new char[9];\n        Soundex soundex = new Soundex(mapping);\n        soundex.US_ENGLISH.setMaxLength(0);\n        assertEquals(4, soundex.getMaxLength());\n    }\n\n    // The default constructor always initialises maxLength to 4 (Soundex codes are exactly 4 characters)\n    @Test(timeout = 4000)\n    public void test10() throws Throwable {\n        Soundex soundex = new Soundex();\n        int maxLength = soundex.getMaxLength();\n        assertEquals(4, maxLength);\n    }\n\n    // The (String, boolean) constructor with specialCaseHW=false still defaults maxLength to 4\n    @Test(timeout = 4000)\n    public void test11() throws Throwable {\n        Soundex soundex = new Soundex(\"#9fO$#-_\", false);\n        assertEquals(4, soundex.getMaxLength());\n    }\n}\n",
