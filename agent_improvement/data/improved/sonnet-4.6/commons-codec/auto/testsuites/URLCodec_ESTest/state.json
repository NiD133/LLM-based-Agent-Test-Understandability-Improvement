meout = 4000)\n  public void test08()  throws Throwable  {\n      URLCodec codec = new URLCodec();\n      String result = codec.decode((String) null);\n      assertNull(result);\n  }\n\n  // decode(Object) with a type that is neither String nor byte[] should throw DecoderException\n  @Test(timeout = 4000)\n  public void test09()  throws Throwable  {\n      URLCodec codec = new URLCodec();\n      try {\n        codec.decode((Object) codec);\n        fail(\"Expecting exception: Exception\");\n\n      } catch(Exception e) {\n         //\n         // Objects of type org.apache.commons.codec.net.URLCodec cannot be URL decoded\n         //\n         verifyException(\"org.apache.commons.codec.net.URLCodec\", e);\n      }\n  }\n\n  // decode(Object) with null should return null\n  @Test(timeout = 4000)\n  public void test10()  throws Throwable  {\n      URLCodec codec = new URLCodec(\"p-I+PXoM<\\\"[Z\");\n      Object result = codec.decode((Object) null);\n      assertNull(result);\n  }\n\n  // encode() should replace spaces with '+' and leave safe characters unchanged\n  @Test(timeout = 4000)\n  public void test11()  throws Throwable  {\n      URLCodec codec = new URLCodec();\n      String encoded = codec.encode(\" cannot be URL decoded\");\n      assertEquals(\"+cannot+be+URL+decoded\", encoded);\n      assertNotNull(encoded);\n  }\n\n  // encode() should percent-encode '%' as %25 and '+' as %2B\n  @Test(timeout = 4000)\n  public void test12()  throws Throwable  {\n      URLCodec codec = new URLCodec();\n      String encoded = codec.encode(\"*aAC%+\");\n      assertEquals(\"*aAC%25%2B\", encoded);\n      assertNotNull(encoded);\n  }\n\n  // encodeUrl() with a null BitSet falls back to the default safe-character set;\n  // a negative byte value (e.g. -38) is treated as an unsigned value and percent-encoded,\n  // expanding each such byte to 3 bytes ('%', hex1, hex2)\n  @Test(timeout = 4000)\n  public void test13()  throws Throwable  {\n      byte[] bytes = new byte[8];\n  