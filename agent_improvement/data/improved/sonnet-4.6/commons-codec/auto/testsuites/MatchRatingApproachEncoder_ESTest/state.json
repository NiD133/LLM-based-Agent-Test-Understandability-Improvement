  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 08:27:53 GMT 2026\n */\n\npackage org.apache.commons.codec.language;\n\nimport org.junit.Before;\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.codec.language.MatchRatingApproachEncoder;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class MatchRatingApproachEncoder_ESTest extends MatchRatingApproachEncoder_ESTest_scaffolding {\n\n    private MatchRatingApproachEncoder encoder;\n\n    @Before\n    public void setUp() {\n        encoder = new MatchRatingApproachEncoder();\n    }\n\n    // -------------------------------------------------------------------------\n    // removeAccents\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test00_removeAccents_nullInputReturnsNull() throws Throwable {\n        String result = encoder.removeAccents((String) null);\n        assertNull(result);\n    }\n\n    // -------------------------------------------------------------------------\n    // leftToRightThenRightToLeftProcessing\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test01_leftToRightThenRightToLeftProcessing_identicalStringsProducesMaxSimilarityScore() throws Throwable {\n        // When both strings are identical every character matches, leaving nothing unmatched,\n        // so 6 - 0 = 6 is returned as the similarity count.\n        int result = encoder.leftToRightThenRightToLeftProcessing(\"u96p[In]=-vK={K5\", \"u96p[In]=-vK={K5\");\n        assertEquals(6, result);\n    }\n\n    // -------------------------------------------------------------------------\n    // getMinRating — threshold score required for a \"similar\" classification\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test16_getMinRating_sumLengthAbove12RequiresMinRatingOfOne() throws Throwable {\n        // Combined encoded-name length of 21 is in the \"> 12\" bucket → min rating = 1\n        int result = encoder.getMinRating(21);\n        assertEquals(1, result);\n    }\n\n    @Test(timeout = 4000)\n    public void test19_getMinRating_sumLengthOf12RequiresMinRatingOfTwo() throws Throwable {\n        // Combined encoded-name length of exactly 12 → min rating = 2\n        int result = encoder.getMinRating(12);\n        assertEquals(2, result);\n    }\n\n    // -------------------------------------------------------------------------\n    // encode(String) — produces the MRA phonetic code for a name\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test03_encode_shortInputIsUppercasedAndSpecialCharsRetained() throws Throwable {\n        String result = encoder.encode(\"inS[\");\n        assertEquals(\"INS[\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test04_encode_longStringIsTruncatedToFirst3AndLast3Letters() throws Throwable {\n        // Input is longer than 6 characters after processing, so MRA keeps first 3 + last 3\n        String result = encoder.encode(\"org.apache.commons.codec.EncoderException\");\n        assertEquals(\"ORGPTN\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test05_encode_accentedCharactersAreNormalisedBeforeEncoding() throws Throwable {\n        // String of accented letters (grave, acute, circumflex, tilde, umlaut, ring, cedilla,\n        // double-acute) should be de-accented and then MRA-encoded.\n        String accentedInput =\n            \"ÀàÈèÌìÒòÙù\"\n            + \"ÁáÉéÍíÓóÚúÝý\"\n            + \"ÂâÊêÎîÔôÛûŶŷ\"\n            + \"ÃãÕõÑñ\"\n            + \"ÄäËëÏïÖöÜüŸÿ\"\n            + \"ÅåÇçŐőŰű\";\n        String result = encoder.encode(accentedInput);\n        assertEquals(\"AYYNYC\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test20_encode_inputWithOnlyPunctuationReturnsEmpty() throws Throwable {\n        // \",-\" has no alphabetic content after cleaning, so encoding yields empty string\n        String result = encoder.encode(\",-\");\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test21_encode_singleDigitReturnsEmpty() throws Throwable {\n        // A single-character input is rejected early by the algorithm and returns \"\"\n        String result = encoder.encode(\"4\");\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test22_encode_singleSpaceReturnsEmpty() throws Throwable {\n        // A space-only input is treated as empty by the algorithm\n        String result = encoder.encode(\" \");\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test23_encode_nullInputReturnsEmpty() throws Throwable {\n        String result = encoder.encode((String) null);\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test26_encode_twoLetterLowercaseStringIsUppercased() throws Throwable {\n        String result = encoder.encode(\"ec\");\n        assertEquals(\"EC\", result);\n    }\n\n    // -------------------------------------------------------------------------\n    // encode(Object) — Object overload required by the Encoder interface\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test24_encodeObject_nonStringInputThrowsEncoderException() throws Throwable {\n        Object nonStringObject = new Object();\n        try {\n            encoder.encode(nonStringObject);\n            fail(\"Expecting exception: Exception\");\n        } catch (Exception e) {\n            verifyException(\"org.apache.commons.codec.language.MatchRatingApproachEncoder\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test25_encodeObject_emptyStringCastToObjectReturnsEmpty() throws Throwable {\n        Object result = encoder.encode((Object) \"\");\n        assertEquals(\"\", result);\n    }\n\n    // -------------------------------------------------------------------------\n    // isEncodeEquals — determines phonetic similarity between two names\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test02_isEncodeEquals_lengthDifferenceExceedsThresholdReturnsFalse() throws Throwable {\n        // \"ZZ\" is far shorter than the second string; the MRA length-difference rule rejects them\n        boolean result = encoder.isEncodeEquals(\"ZZ\", \"u96p[In]=-vK={K5\");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test06_isEncodeEquals_shortStringsWithMatchingConsonantCodesReturnsTrue() throws Throwable {\n        // \",-l\" encodes to \"L\" and \"RR\" encodes to \"R\"; the similarity score meets the min rating\n        boolean result = encoder.isEncodeEquals(\",-l\", \"RR\");\n        assertTrue(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test07_isEncodeEquals_identicalStringsReturnsTrueImmediately() throws Throwable {\n        // Identical inputs short-circuit before encoding and return true\n        boolean result = encoder.isEncodeEquals(\"AYYNYC\", \"AYYNYC\");\n        assertTrue(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test08_isEncodeEquals_secondArgIsSingleCharReturnsFalse() throws Throwable {\n        // Single-character second argument is rejected by the algorithm\n        boolean result = encoder.isEncodeEquals(\"T7pioZh#;op/_0`\\\".?\", \"z\");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test09_isEncodeEquals_firstArgIsSingleCharReturnsFalse() throws Throwable {\n        // Single-character first argument is rejected by the algorithm\n        boolean result = encoder.isEncodeEquals(\"O\", \")^[N]\\\"*0f'jGO`\");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test10_isEncodeEquals_secondArgIsSpaceReturnsFalse() throws Throwable {\n        // A space-only argument is treated as empty and the comparison short-circuits to false\n        boolean result = encoder.isEncodeEquals(\"M:]!J~\", \" \");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test11_isEncodeEquals_secondArgIsEmptyReturnsFalse() throws Throwable {\n        boolean result = encoder.isEncodeEquals(\"DK^/JQ\", \"\");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test12_isEncodeEquals_secondArgIsNullReturnsFalse() throws Throwable {\n        boolean result = encoder.isEncodeEquals(\")-\", (String) null);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test13_isEncodeEquals_bothArgsAreSpacesReturnsFalse() throws Throwable {\n        boolean result = encoder.isEncodeEquals(\" \", \" \");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test14_isEncodeEquals_bothArgsAreEmptyReturnsFalse() throws Throwable {\n        boolean result = encoder.isEncodeEquals(\"\", \"\");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test15_isEncodeEquals_firstArgIsNullReturnsFalse() throws Throwable {\n        boolean result = encoder.isEncodeEquals((String) null, \"\");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test17_isEncodeEquals_mixedAlphanumericAndSpecialCharsReturnsFalse() throws Throwable {\n        // Neither name encodes to anything similar enough to pass the MRA min-rating check\n        boolean result = encoder.isEncodeEquals(\"H7mK+_\", \"k!zbM\");\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test18_isEncodeEquals_specialCharOnlyNamesReturnsFalse() throws Throwable {\n        boolean result = encoder.isEncodeEquals(\"-}_\", \"Jj~(\");\n        assertFalse(result);\n    }\n}\n",
