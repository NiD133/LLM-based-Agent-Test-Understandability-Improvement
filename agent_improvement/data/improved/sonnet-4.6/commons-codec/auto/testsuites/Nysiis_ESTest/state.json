  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 08:42:52 GMT 2026\n */\n\npackage org.apache.commons.codec.language;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.codec.language.Nysiis;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Nysiis_ESTest extends Nysiis_ESTest_scaffolding {\n\n  // Non-strict mode returns the full encoded result without truncating to 6 characters.\n  @Test(timeout = 4000)\n  public void test00_nonStrictModeReturnsFullLengthEncoding()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis(false);\n      String encoded = nysiis0.nysiis(\"&:ZN(sDK;@X'DhCe\");\n      assertEquals(\"ZNSDCXDC\", encoded);\n  }\n\n  // Strict mode (the default) truncates the result to at most 6 characters.\n  @Test(timeout = 4000)\n  public void test01_strictModeDefaultTruncatesResultToSixChars()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.nysiis(\"&:ZN(sDK;@X'DhCe\");\n      assertEquals(\"ZNSDCX\", encoded);\n  }\n\n  // The no-arg constructor creates a strict encoder (max 6-character output).\n  @Test(timeout = 4000)\n  public void test02_defaultConstructorCreatesStrictEncoder()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      nysiis0.encode(\"A\");\n      assertTrue(nysiis0.isStrict());\n  }\n\n  // Encoding an empty string leaves the encoder in strict mode.\n  @Test(timeout = 4000)\n  public void test03_encodingEmptyStringPreservesStrictMode()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      nysiis0.nysiis(\"\");\n      assertTrue(nysiis0.isStrict());\n  }\n\n  // A null input is handled gracefully and does not alter the encoder's strict setting.\n  @Test(timeout = 4000)\n  public void test04_nullInputHandledGracefullyInStrictMode()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      nysiis0.nysiis((String) null);\n      assertTrue(nysiis0.isStrict());\n  }\n\n  // encode(Object) throws an EncoderException when given a non-String argument.\n  @Test(timeout = 4000)\n  public void test05_encodeObjectThrowsExceptionForNonStringInput()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      Object object0 = new Object();\n      try {\n        nysiis0.encode(object0);\n        fail(\"Expecting exception: Exception\");\n\n      } catch(Exception e) {\n         //\n         // Parameter supplied to Nysiis encode is not of type java.lang.String\n         //\n         verifyException(\"org.apache.commons.codec.language.Nysiis\", e);\n      }\n  }\n\n  // encode(Object) accepts a String argument and returns the NYSIIS code.\n  @Test(timeout = 4000)\n  public void test06_encodeObjectWithStringInputReturnsNysiisCode()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      Object encoded = nysiis0.encode((Object) \"org.apache.commons.codec.EncodeyException\");\n      assertEquals(\"ORGAPA\", encoded);\n      assertNotNull(encoded);\n  }\n\n  // Special characters are stripped before encoding; only letters influence the result.\n  @Test(timeout = 4000)\n  public void test07_specialCharsAreStrippedBeforeEncoding()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.nysiis(\"B*(EG$;*A+w7oQ\");\n      assertEquals(\"BAGAG\", encoded);\n      assertTrue(nysiis0.isStrict());\n  }\n\n  // Mixed special characters and letters produce a correct NYSIIS code.\n  @Test(timeout = 4000)\n  public void test08_mixedInputWithSpecialCharsEncodesCorrectly()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.nysiis(\"|5tl0=0cuh:63pEY\");\n      assertTrue(nysiis0.isStrict());\n      assertEquals(\"TLCAPY\", encoded);\n  }\n\n  // Vowels, Z, and PH within a mixed input are transcoded per the NYSIIS rules.\n  @Test(timeout = 4000)\n  public void test09_vowelsAndPhTranscodingInMixedInput()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.nysiis(\"dIpYze0FuZfr/K1EPh%\");\n      assertEquals(\"DAPYSA\", encoded);\n  }\n\n  // \"kSCH\": leading K->C and SCH->SSS collapse, trailing S is removed, yielding \"C\".\n  @Test(timeout = 4000)\n  public void test10_leadingKAndSchTranscodingProducesSingleC()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.encode(\"kSCH\");\n      assertNotNull(encoded);\n      assertTrue(nysiis0.isStrict());\n      assertEquals(\"C\", encoded);\n  }\n\n  // A long input with special characters is correctly trimmed to 6-character strict output.\n  @Test(timeout = 4000)\n  public void test11_longInputWithSpecialCharsIsTrimmedToSixChars()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.nysiis(\"Bd}F:LH6ciJkN{]w^1\");\n      assertEquals(\"BDFLCA\", encoded);\n      assertNotNull(encoded);\n  }\n\n  // Vowel sequences including 'H' and 'AU' combinations are handled by the H/W rules.\n  @Test(timeout = 4000)\n  public void test12_vowelSequencesAndHRuleAreAppliedCorrectly()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.nysiis(\"tl1[CoH5>Aeu)UA;J.\");\n      assertEquals(\"TLCAHA\", encoded);\n      assertNotNull(encoded);\n  }\n\n  // encode(String) strips non-letter characters and applies all NYSIIS transcoding rules.\n  @Test(timeout = 4000)\n  public void test13_encodeStringStripsSpecialCharsAndAppliesNysiisRules()  throws Throwable  {\n      Nysiis nysiis0 = new Nysiis();\n      String encoded = nysiis0.encode(\"@A9Q mhK(EVj%r\");\n      assertEquals(\"AGNCAF\", encoded);\n  }\n}\n",
