  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 08:23:25 GMT 2026\n */\n\npackage org.apache.commons.codec.digest;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport org.apache.commons.codec.digest.XXHash32;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class XXHash32_ESTest extends XXHash32_ESTest_scaffolding {\n\n    // The initial hash value produced by XXHash32(seed=0) with no data fed into it.\n    private static final long INITIAL_HASH_SEED_0 = 46947589L;\n\n    /**\n     * A zero-length update must be a no-op: the hash value must remain\n     * equal to the initial value for seed 0.\n     */\n    @Test(timeout = 4000)\n    public void testZeroLengthUpdateLeavesHashUnchanged() throws Throwable {\n        XXHash32 hasher = new XXHash32(0);\n        byte[] data = new byte[20];\n        hasher.update(data, 16, 0); // length == 0, so no bytes are consumed\n        assertEquals(INITIAL_HASH_SEED_0, hasher.getValue());\n    }\n\n    /**\n     * Feeding a single zero byte into a seed-0 hasher must produce the\n     * expected hash.\n     */\n    @Test(timeout = 4000)\n    public void testHashAfterSingleZeroByteUpdate() throws Throwable {\n        XXHash32 hasher = new XXHash32(0);\n        hasher.update(0);\n        long hash = hasher.getValue();\n        assertEquals(3479547966L, hash);\n    }\n\n    /**\n     * Feeding four bytes (13, 13, 0, 0) one at a time into a seed-0 hasher\n     * must produce the expected hash.\n     */\n    @Test(timeout = 4000)\n    public void testHashAfterFourSingleByteUpdates() throws Throwable {\n        XXHash32 hasher = new XXHash32(0);\n        hasher.update(13);\n        hasher.update(13);\n        hasher.update(0);\n        hasher.update(0);\n        long hash = hasher.getValue();\n        assertEquals(2114005244L, hash);\n    }\n\n    /**\n     * A freshly constructed XXHash32 with the default seed (0) must return\n     * the initial hash without any data being fed.\n     */\n    @Test(timeout = 4000)\n    public void testInitialHashWithDefaultConstructor() throws Throwable {\n        XXHash32 hasher = new XXHash32();\n        long hash = hasher.getValue();\n        assertEquals(INITIAL_HASH_SEED_0, hash);\n    }\n\n    /**\n     * After calling reset(), the hasher must return to its initial state and\n     * produce the same hash as a brand-new instance with seed 0.\n     */\n    @Test(timeout = 4000)\n    public void testResetRestoresInitialHash() throws Throwable {\n        XXHash32 hasher = new XXHash32(0);\n        hasher.reset();\n        assertEquals(INITIAL_HASH_SEED_0, hasher.getValue());\n    }\n\n    /**\n     * Mixing a single-byte update (value 109) followed by a 16-byte array\n     * update must produce the expected hash when using the default seed.\n     */\n    @Test(timeout = 4000)\n    public void testHashAfterMixedSingleByteAndArrayUpdates() throws Throwable {\n        XXHash32 hasher = new XXHash32();\n        hasher.update(109);\n        byte[] zeros = new byte[22];\n        hasher.update(zeros, 0, 16);\n        assertEquals(1174888648L, hasher.getValue());\n    }\n\n    /**\n     * Updating with the first 16 bytes of a zero-filled array must produce\n     * the expected hash when using the default seed.\n     */\n    @Test(timeout = 4000)\n    public void testHashAfterSixteenZeroByteArrayUpdate() throws Throwable {\n        XXHash32 hasher = new XXHash32();\n        byte[] zeros = new byte[22];\n        hasher.update(zeros, 0, 16);\n        long hash = hasher.getValue();\n        assertEquals(2382506810L, hash);\n    }\n}\n",
