  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 06:47:55 GMT 2026\n */\n\npackage com.itextpdf.text.io;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport com.itextpdf.text.io.ArrayRandomAccessSource;\nimport com.itextpdf.text.io.GetBufferedRandomAccessSource;\nimport com.itextpdf.text.io.GroupedRandomAccessSource;\nimport com.itextpdf.text.io.IndependentRandomAccessSource;\nimport com.itextpdf.text.io.RandomAccessSource;\nimport com.itextpdf.text.io.WindowRandomAccessSource;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class GroupedRandomAccessSource_ESTest extends GroupedRandomAccessSource_ESTest_scaffolding {\n\n    /**\n     * Builds the 8-slot source array reused by many tests.\n     *\n     * Layout: [buffered, array, buffered, buffered, independent, buffered, array, independent]\n     * where `buffered` wraps `base` and `independent` wraps `buffered`.\n     */\n    private RandomAccessSource[] buildEightSources(ArrayRandomAccessSource base) {\n        GetBufferedRandomAccessSource buffered = new GetBufferedRandomAccessSource(base);\n        IndependentRandomAccessSource independent = new IndependentRandomAccessSource(buffered);\n        RandomAccessSource[] sources = new RandomAccessSource[8];\n        sources[0] = (RandomAccessSource) buffered;\n        sources[1] = (RandomAccessSource) base;\n        sources[2] = (RandomAccessSource) buffered;\n        sources[3] = (RandomAccessSource) buffered;\n        sources[4] = (RandomAccessSource) independent;\n        sources[5] = (RandomAccessSource) buffered;\n        sources[6] = (RandomAccessSource) base;\n        sources[7] = (RandomAccessSource) independent;\n        return sources;\n    }\n\n    @Test(timeout = 4000)\n    public void testLengthAfterClose_returnsAggregatedLength() throws Throwable {\n        // GroupedRandomAccessSource reports the total length even after close().\n        byte[] data = new byte[6];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(data);\n        RandomAccessSource[] sources = buildEightSources(base);\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        grouped.close();\n        assertEquals(48L, grouped.length()); // 8 sources × 6 bytes = 48\n    }\n\n    @Test(timeout = 4000)\n    public void testGetBulk_positionBeforeWindowStart_returnsMinusOne() throws Throwable {\n        // A WindowRandomAccessSource with offset 807 has no data before that position.\n        // Requesting bytes at position 196 (before the window) returns -1.\n        byte[] dest = new byte[6];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(dest);\n        WindowRandomAccessSource window = new WindowRandomAccessSource(base, 807L, 807L);\n        RandomAccessSource[] sources = new RandomAccessSource[1];\n        sources[0] = (RandomAccessSource) window;\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        int bytesRead = grouped.get(196L, dest, 1318, 1318);\n        assertEquals((-1), bytesRead);\n        assertEquals(807L, grouped.length());\n    }\n\n    @Test(timeout = 4000)\n    public void testGetBulk_negativeBufferOffsetAndLength_returnsMinusOne() throws Throwable {\n        // Passing a negative buffer offset and negative length to get() returns -1.\n        byte[] data = new byte[8];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(data);\n        RandomAccessSource[] sources = buildEightSources(base);\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        int bytesRead = grouped.get((long) (byte)0, data, (int) (byte) (-126), (int) (byte) (-43));\n        assertEquals((-1), bytesRead);\n        assertEquals(64L, grouped.length()); // 8 sources × 8 bytes = 64\n    }\n\n    @Test(timeout = 4000)\n    public void testGetSingle_negativePosition_returnsMinusOne() throws Throwable {\n        // Reading a single byte at a negative position returns -1.\n        byte[] data = new byte[8];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(data);\n        RandomAccessSource[] sources = buildEightSources(base);\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        int result = grouped.get((-1L));\n        assertEquals(64L, grouped.length());\n        assertEquals((-1), result);\n    }\n\n    @Test(timeout = 4000)\n    public void testGetSingle_positionZero_returnsZeroByte() throws Throwable {\n        // Reading a single byte at position 0 from a zero-filled source returns 0.\n        byte[] data = new byte[7];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(data);\n        RandomAccessSource[] sources = buildEightSources(base);\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        int result = grouped.get(0L);\n        assertEquals(56L, grouped.length()); // 8 sources × 7 bytes = 56\n        assertEquals(0, result);\n    }\n\n    @Test(timeout = 4000)\n    public void testGetBulk_negativePosition_returnsMinusOne() throws Throwable {\n        // Reading bytes starting at position -1 returns -1.\n        byte[] data = new byte[6];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(data);\n        RandomAccessSource[] sources = buildEightSources(base);\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        int bytesRead = grouped.get((long) (-1), data, 1310, (-156));\n        assertEquals(48L, grouped.length()); // 8 sources × 6 bytes = 48\n        assertEquals((-1), bytesRead);\n    }\n\n    @Test(timeout = 4000)\n    public void testGetBulk_readBeyondEnd_returnsAvailableByteCount() throws Throwable {\n        // Requesting 4 bytes starting at position 4 in a 6-byte source returns 2 (only 2 remain).\n        byte[] data = new byte[6];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(data);\n        RandomAccessSource[] sources = new RandomAccessSource[1];\n        sources[0] = (RandomAccessSource) base;\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        int bytesRead = grouped.get((long) 4, data, 4, 4);\n        assertEquals(6L, grouped.length());\n        assertEquals(2, bytesRead);\n    }\n\n    @Test(timeout = 4000)\n    public void testLength_windowWithNegativeLength_returnsNegativeLength() throws Throwable {\n        // A WindowRandomAccessSource constructed with a negative length reports that negative value.\n        WindowRandomAccessSource window = new WindowRandomAccessSource((RandomAccessSource) null, (-2147L), (-645L));\n        RandomAccessSource[] sources = new RandomAccessSource[1];\n        sources[0] = (RandomAccessSource) window;\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        long length = grouped.length();\n        assertEquals((-645L), length);\n    }\n\n    @Test(timeout = 4000)\n    public void testGetBulk_readSpansPastArrayEnd_throwsArrayIndexOutOfBounds() throws Throwable {\n        // Reading 5 bytes starting at position 5 into a 6-element destination array causes\n        // ArrayIndexOutOfBoundsException because the copy would write past index 5.\n        byte[] data = new byte[6];\n        ArrayRandomAccessSource base = new ArrayRandomAccessSource(data);\n        RandomAccessSource[] sources = new RandomAccessSource[2];\n        sources[0] = (RandomAccessSource) base;\n        sources[1] = (RandomAccessSource) base;\n        GroupedRandomAccessSource grouped = new GroupedRandomAccessSource(sources);\n        try {\n            grouped.get((long) 5, data, 5, 5);\n            fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n        } catch(ArrayIndexOutOfBoundsException e) {\n            //\n            // no message in exception (getMessage() returned null)\n            //\n            verifyException(\"com.itextpdf.text.io.ArrayRandomAccessSource\", e);\n        }\n    }\n}\n",
