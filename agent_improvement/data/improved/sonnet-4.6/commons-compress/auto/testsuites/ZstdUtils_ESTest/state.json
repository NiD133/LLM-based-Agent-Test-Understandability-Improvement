  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 08:40:17 GMT 2026\n */\n\npackage org.apache.commons.compress.compressors.zstandard;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.compress.compressors.zstandard.ZstdUtils;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class ZstdUtils_ESTest extends ZstdUtils_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void testDisablingThenEnablingCachingSucceeds() throws Throwable {\n      ZstdUtils.setCacheZstdAvailablity(false);\n      ZstdUtils.setCacheZstdAvailablity(true);\n  }\n\n  @Test(timeout = 4000)\n  public void testEnablingCachingSucceeds() throws Throwable {\n      ZstdUtils.setCacheZstdAvailablity(true);\n  }\n\n  @Test(timeout = 4000)\n  public void testMatchesReturnsFalseWhenSkippableFramePrefixPresentButRestDoesNotMatch() throws Throwable {\n      // Byte 0x53 has upper nibble 0x50, which triggers the skippable-frame path,\n      // but subsequent bytes do not match SKIPPABLE_FRAME_MAGIC so matches() returns false.\n      byte[] signature = new byte[8];\n      signature[0] = (byte) 0x53;  // 0x53 & 0xF0 == 0x50 → skippable-frame candidate\n      signature[1] = (byte) 0x2A;  // matches SKIPPABLE_FRAME_MAGIC[0], but…\n      // …signature[2] remains 0x00, which != SKIPPABLE_FRAME_MAGIC[1] (0x4D), so no match\n      boolean result = ZstdUtils.matches(signature, (byte) 42);\n      assertFalse(result);\n  }\n\n  @Test(timeout = 4000)\n  public void testMatchesThrowsWhenSignatureArrayIsShorterThanRequiredMagicLength() throws Throwable {\n      // A one-element array with first byte 0x28 passes the length guard (length=40 >= 4),\n      // but the loop then reads signature[1] which is out of bounds.\n      byte[] signature = new byte[1];\n      signature[0] = (byte) 0x28;  // first byte of Zstandard frame magic\n      try {\n          ZstdUtils.matches(signature, (byte) 40);\n          fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n      } catch (ArrayIndexOutOfBoundsException e) {\n          verifyException(\"org.apache.commons.compress.compressors.zstandard.ZstdUtils\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void testMatchesReturnsFalseWhenLengthParameterIsNegative() throws Throwable {\n      // Negative length is smaller than ZSTANDARD_FRAME_MAGIC.length (4), so the\n      // method returns false immediately without examining the (null) signature array.\n      boolean result = ZstdUtils.matches((byte[]) null, -1988);\n      assertFalse(result);\n  }\n\n  @Test(timeout = 4000)\n  public void testMatchesReturnsFalseWhenSignatureDoesNotMatchAnyMagicPattern() throws Throwable {\n      // All-zero bytes match neither Zstandard frame magic (0x28, 0xB5, 0x2F, 0xFD)\n      // nor the skippable-frame prefix (upper nibble 0x50), so matches() returns false.\n      byte[] signature = new byte[3];\n      boolean result = ZstdUtils.matches(signature, 63);\n      assertFalse(result);\n  }\n\n  @Test(timeout = 4000)\n  public void testIsZstdCompressionAvailableReturnsTrueWhenLibraryIsOnClasspath() throws Throwable {\n      boolean available = ZstdUtils.isZstdCompressionAvailable();\n      assertTrue(available);\n  }\n\n  @Test(timeout = 4000)\n  public void testIsZstdCompressionAvailableReturnsTrueEvenWhenCachingIsDisabled() throws Throwable {\n      // With caching disabled the method falls back to the internal class-loading check,\n      // which still finds the zstd-jni library on the test classpath.\n      ZstdUtils.setCacheZstdAvailablity(false);\n      boolean available = ZstdUtils.isZstdCompressionAvailable();\n      assertTrue(available);\n  }\n\n  @Test(timeout = 4000)\n  public void testGetCachedZstdAvailabilityDoesNotThrow() throws Throwable {\n      ZstdUtils.getCachedZstdAvailability();\n  }\n}\n",
