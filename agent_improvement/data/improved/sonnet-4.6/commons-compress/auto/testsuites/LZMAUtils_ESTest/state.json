  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 07:39:23 GMT 2026\n */\n\npackage org.apache.commons.compress.compressors.lzma;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport org.apache.commons.compress.compressors.lzma.LZMAUtils;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class LZMAUtils_ESTest extends LZMAUtils_ESTest_scaffolding {\n\n    // The first byte of a valid LZMA stream header (0x5D)\n    private static final byte LZMA_MAGIC_FIRST_BYTE = (byte) 93;\n\n    @Test(timeout = 4000)\n    public void test00_setCacheLZMAAvailablity_enableCaching() throws Throwable {\n        LZMAUtils.setCacheLZMAAvailablity(true);\n    }\n\n    @Test(timeout = 4000)\n    public void test01_matches_validLZMAHeader_returnsTrue() throws Throwable {\n        // Provide a signature whose first byte matches the LZMA magic byte (0x5D)\n        // and whose remaining bytes are zero (matching the expected header pattern)\n        byte[] signature = new byte[6];\n        signature[0] = LZMA_MAGIC_FIRST_BYTE;\n        boolean result = LZMAUtils.matches(signature, 3);\n        assertTrue(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test02_matches_lengthZero_returnsFalse() throws Throwable {\n        // A length of 0 is shorter than the required LZMA header length, so no match\n        byte[] signature = new byte[2];\n        boolean result = LZMAUtils.matches(signature, 0);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test03_matches_wrongMagicByte_returnsFalse() throws Throwable {\n        // Signature is all zeros; first byte does not match the LZMA magic byte (0x5D)\n        byte[] signature = new byte[2];\n        boolean result = LZMAUtils.matches(signature, (byte) 51);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void test04_isLZMACompressionAvailable_returnsTrueByDefault() throws Throwable {\n        boolean available = LZMAUtils.isLZMACompressionAvailable();\n        assertTrue(available);\n    }\n\n    @Test(timeout = 4000)\n    public void test05_isLZMACompressionAvailable_afterDisablingCache_stillReturnsTrue() throws Throwable {\n        // Disabling the cache forces a live check; LZMA classes are present so the result is still true\n        LZMAUtils.setCacheLZMAAvailablity(false);\n        boolean available = LZMAUtils.isLZMACompressionAvailable();\n        assertTrue(available);\n    }\n\n    @Test(timeout = 4000)\n    public void test06_isCompressedFilename_nonLZMAExtension_returnsFalse() throws Throwable {\n        boolean compressed = LZMAUtils.isCompressedFilename(\"3JJDsw`@x[\");\n        assertFalse(compressed);\n    }\n\n    @Test(timeout = 4000)\n    public void test07_setCacheLZMAAvailablity_disableThenEnable() throws Throwable {\n        LZMAUtils.setCacheLZMAAvailablity(false);\n        LZMAUtils.setCacheLZMAAvailablity(true);\n    }\n\n    @Test(timeout = 4000)\n    public void test08_getUncompressedFilename_noLZMASuffix_returnsNameUnchanged() throws Throwable {\n        // \"CACHED_AVAILABLE\" has no LZMA suffix, so it is returned as-is\n        String uncompressed = LZMAUtils.getUncompressedFilename(\"CACHED_AVAILABLE\");\n        assertEquals(\"CACHED_AVAILABLE\", uncompressed);\n    }\n\n    @Test(timeout = 4000)\n    public void test09_getCompressedFilename_appendsLZMASuffix() throws Throwable {\n        String compressed = LZMAUtils.getCompressedFilename(\"CACHED_AVAILABLE\");\n        assertEquals(\"CACHED_AVAILABLE.lzma\", compressed);\n    }\n\n    @Test(timeout = 4000)\n    public void test10_isCompressedFileName_emptyString_returnsFalse() throws Throwable {\n        boolean compressed = LZMAUtils.isCompressedFileName(\"\");\n        assertFalse(compressed);\n    }\n\n    @Test(timeout = 4000)\n    public void test11_getCompressedFileName_emptyString_returnsLZMASuffix() throws Throwable {\n        String compressed = LZMAUtils.getCompressedFileName(\"\");\n        assertEquals(\".lzma\", compressed);\n    }\n\n    @Test(timeout = 4000)\n    public void test12_getCachedLZMAAvailability_doesNotThrow() throws Throwable {\n        LZMAUtils.getCachedLZMAAvailability();\n    }\n\n    @Test(timeout = 4000)\n    public void test13_getUncompressedFileName_noLZMASuffix_returnsNameUnchanged() throws Throwable {\n        String uncompressed = LZMAUtils.getUncompressedFileName(\"3JJDsw`@x[\");\n        assertEquals(\"3JJDsw`@x[\", uncompressed);\n    }\n}\n",
