  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 08:03:12 GMT 2026\n */\n\npackage org.apache.commons.compress.harmony.unpack200;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.compress.harmony.unpack200.AttributeLayout;\nimport org.apache.commons.compress.harmony.unpack200.IMatcher;\nimport org.apache.commons.compress.harmony.unpack200.SegmentUtils;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class SegmentUtils_ESTest extends SegmentUtils_ESTest_scaffolding {\n\n    // -----------------------------------------------------------------------\n    // countMatches(long[][], IMatcher)\n    // -----------------------------------------------------------------------\n\n    /**\n     * All inner arrays are empty, so countMatches never calls matcher.matches().\n     * The null matcher is therefore never dereferenced, and the result is 0.\n     */\n    @Test(timeout = 4000)\n    public void test00_countMatches_2dArray_allEmptyRows_nullMatcher_returnsZero() throws Throwable {\n        long[] emptyRow = new long[0];\n        long[][] flagRows = new long[5][6];\n        flagRows[0] = emptyRow;\n        flagRows[1] = emptyRow;\n        flagRows[2] = emptyRow;\n        flagRows[3] = emptyRow;\n        flagRows[4] = emptyRow;\n\n        int matchCount = SegmentUtils.countMatches(flagRows, (IMatcher) null);\n\n        assertEquals(0, matchCount);\n    }\n\n    // -----------------------------------------------------------------------\n    // countMatches(long[], IMatcher)\n    // -----------------------------------------------------------------------\n\n    /**\n     * An array of 8 longs where only index 3 holds -1L (all bits set).\n     * AttributeLayout is used as the IMatcher; -1L satisfies its match\n     * condition, so exactly one element should match.\n     */\n    @Test(timeout = 4000)\n    public void test01_countMatches_1dArray_oneNegativeFlag_matcherMatchesIt_returnsOne() throws Throwable {\n        long[] flags = new long[8];\n        flags[3] = -1L; // all bits set — matches any bit-mask check\n\n        AttributeLayout matcher = new AttributeLayout(\"7.kMp'Z\", 2, \"> AQHR!W+eH?K(U\", 2);\n        int matchCount = SegmentUtils.countMatches(flags, (IMatcher) matcher);\n\n        assertEquals(1, matchCount);\n    }\n\n    // -----------------------------------------------------------------------\n    // countBit16(long[][])\n    // -----------------------------------------------------------------------\n\n    /**\n     * A 2-D flags array where one element (-366L) has bit 16 set.\n     * countBit16 should return 1.\n     */\n    @Test(timeout = 4000)\n    public void test02_countBit16_2dLongArray_oneElementHasBit16Set_returnsOne() throws Throwable {\n        long[] row = new long[7];\n        row[3] = -366L; // negative value whose two's complement has bit 16 set\n\n        long[][] flagRows = new long[1][3];\n        flagRows[0] = row;\n\n        int bit16Count = SegmentUtils.countBit16(flagRows);\n\n        assertEquals(1, bit16Count);\n    }\n\n    // -----------------------------------------------------------------------\n    // countBit16(long[])\n    // -----------------------------------------------------------------------\n\n    /**\n     * A single-element long array where the value (-4750) has bit 16 set.\n     * countBit16 should return 1.\n     */\n    @Test(timeout = 4000)\n    public void test03_countBit16_1dLongArray_valueHasBit16Set_returnsOne() throws Throwable {\n        long[] flags = new long[1];\n        flags[0] = (long) (-4750); // bit 16 (0x10000) is set in the two's complement representation\n\n        int bit16Count = SegmentUtils.countBit16(flags);\n\n        assertEquals(1, bit16Count);\n    }\n\n    /**\n     * A single-element long array initialized to 0 has no bits set.\n     * countBit16 should return 0.\n     */\n    @Test(timeout = 4000)\n    public void test04_countBit16_1dLongArray_allZeroes_returnsZero() throws Throwable {\n        long[] flags = new long[1]; // default value 0L — bit 16 is not set\n\n        int bit16Count = SegmentUtils.countBit16(flags);\n\n        assertEquals(0, bit16Count);\n    }\n\n    // -----------------------------------------------------------------------\n    // countBit16(int[])\n    // -----------------------------------------------------------------------\n\n    /**\n     * An int array where one element (-1622) has bit 16 set.\n     * countBit16 should return 1.\n     */\n    @Test(timeout = 4000)\n    public void test05_countBit16_intArray_oneValueHasBit16Set_returnsOne() throws Throwable {\n        int[] flags = new int[4];\n        flags[2] = -1622; // bit 16 (0x10000) is set in the two's complement representation\n\n        int bit16Count = SegmentUtils.countBit16(flags);\n\n        assertEquals(1, bit16Count);\n    }\n\n    // -----------------------------------------------------------------------\n    // countArgs(String) — normal cases\n    // -----------------------------------------------------------------------\n\n    /**\n     * A long mixed-content descriptor string whose argument section contains\n     * 51 countable tokens (characters not inside a reference type and not '[').\n     */\n    @Test(timeout = 4000)\n    public void test06_countArgs_longDescriptorWith51Args_returns51() throws Throwable {\n        String descriptor = \"Can't ad beyonI end of strea (n = %,d/ coun= %,E, tax-e>gZh % D,d,Aemaining = %,d)\";\n\n        int argCount = SegmentUtils.countArgs(descriptor);\n\n        assertEquals(51, argCount);\n    }\n\n    /**\n     * A descriptor whose argument section contains 7 countable tokens.\n     * The '[' character starts an array type and its following character is\n     * counted as one argument rather than two.\n     */\n    @Test(timeout = 4000)\n    public void test07_countArgs_descriptorWithArrayTypeAndMixedChars_returns7() throws Throwable {\n        String descriptor = \"(0ANr[&rF)8mUn?\";\n\n        int argCount = SegmentUtils.countArgs(descriptor);\n\n        assertEquals(7, argCount);\n    }\n\n    /**\n     * A standard Java method descriptor with one reference-type parameter.\n     * The 'L...;' notation counts as a single argument.\n     */\n    @Test(timeout = 4000)\n    public void test08_countArgs_standardJavaMethodDescriptor_oneObjectParam_returnsOne() throws Throwable {\n        String descriptor = \"(Ljava/lang/Object;)Ljava/lang/Object;\";\n\n        int argCount = SegmentUtils.countArgs(descriptor);\n\n        assertEquals(1, argCount);\n    }\n\n    /**\n     * A long mixed-content descriptor string whose argument section contains\n     * 52 countable tokens.\n     */\n    @Test(timeout = 4000)\n    public void test13_countArgs_longDescriptorWith52Args_returns52() throws Throwable {\n        String descriptor = \"Can't ead b1yonI end of strea(n J %,d/ coun = %,E, max-e>gZh % %,d,Aemaining = %,d)\";\n\n        int argCount = SegmentUtils.countArgs(descriptor);\n\n        assertEquals(52, argCount);\n    }\n\n    // -----------------------------------------------------------------------\n    // countArgs(String) — exception cases\n    // -----------------------------------------------------------------------\n\n    /**\n     * A descriptor where ')' appears before '(' is invalid; countArgs must\n     * throw IllegalArgumentException with message \"No arguments\".\n     */\n    @Test(timeout = 4000)\n    public void test09_countArgs_closingParenBeforeOpeningParen_throwsIllegalArgumentException() throws Throwable {\n        try {\n            SegmentUtils.countArgs(\")}WJ,:qJ(Hxxh\");\n            fail(\"Expecting exception: IllegalArgumentException\");\n    