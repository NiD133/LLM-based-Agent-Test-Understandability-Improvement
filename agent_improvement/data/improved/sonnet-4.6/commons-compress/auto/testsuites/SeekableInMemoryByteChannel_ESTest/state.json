  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 08:24:55 GMT 2026\n */\n\npackage org.apache.commons.compress.utils;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.io.IOException;\nimport java.nio.ByteBuffer;\nimport java.nio.channels.ClosedChannelException;\nimport java.nio.channels.SeekableByteChannel;\nimport org.apache.commons.compress.utils.SeekableInMemoryByteChannel;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class SeekableInMemoryByteChannel_ESTest extends SeekableInMemoryByteChannel_ESTest_scaffolding {\n\n  // Default internal buffer size allocated by the no-arg constructor (IOUtils.DEFAULT_BUFFER_SIZE)\n  private static final int DEFAULT_BUFFER_SIZE = 8192;\n\n  // A position value that exceeds Integer.MAX_VALUE, triggering special read/write guard paths\n  private static final long POSITION_BEYOND_MAX_INT = 2147483651L;\n\n  // A position value just below Integer.MAX_VALUE, useful for near-boundary truncate tests\n  private static final long POSITION_NEAR_MAX_INT = 2147483628L;\n\n  @Test(timeout = 4000)\n  public void readIntoLargerBufferReadsAllChannelContent() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel(2245);\n      ByteBuffer buffer = ByteBuffer.allocateDirect(2402);\n      int bytesRead = channel.read(buffer);\n      // All 2245 bytes in the channel are consumed; 2402 - 2245 = 157 bytes remain unfilled\n      assertEquals(157, buffer.remaining());\n      assertEquals(2245, bytesRead);\n  }\n\n  @Test(timeout = 4000)\n  public void writeFullBufferToDefaultChannelConsumesAllBytes() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      ByteBuffer buffer = ByteBuffer.allocate(2245);\n      int bytesWritten = channel.write(buffer);\n      assertEquals(\"java.nio.HeapByteBuffer[pos=2245 lim=2245 cap=2245]\", buffer.toString());\n      assertEquals(2245, bytesWritten);\n  }\n\n  @Test(timeout = 4000)\n  public void writeThrowsIOExceptionWhenPositionExceedsIntegerMaxValue() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      channel.position(POSITION_BEYOND_MAX_INT);\n      ByteBuffer buffer = ByteBuffer.allocate((byte) 52);\n      try {\n          channel.write(buffer);\n          fail(\"Expecting exception: IOException\");\n      } catch (IOException e) {\n          //\n          // position > Integer.MAX_VALUE\n          //\n          verifyException(\"org.apache.commons.compress.utils.SeekableInMemoryByteChannel\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void truncateAfterPositionSetNearMaxIntKeepsChannelOpen() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      SeekableByteChannel positioned = channel.position(POSITION_NEAR_MAX_INT);\n      SeekableByteChannel truncated = positioned.truncate(1);\n      assertTrue(truncated.isOpen());\n  }\n\n  @Test(timeout = 4000)\n  public void truncateToZeroTwiceReturnsSameChannelInstance() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      channel.truncate(0L);\n      SeekableByteChannel result = channel.truncate(0L);\n      assertSame(channel, result);\n  }\n\n  @Test(timeout = 4000)\n  public void truncateWithNegativeSizeThrowsIllegalArgumentException() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      // Undeclared exception!\n      try {\n          channel.truncate(-794L);\n          fail(\"Expecting exception: IllegalArgumentException\");\n      } catch (IllegalArgumentException e) {\n          //\n          // New size is negative: -794\n          //\n          verifyException(\"org.apache.commons.compress.utils.SeekableInMemoryByteChannel\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void writeToZeroSizedChannelExpandsCapacityAndWritesAllBytes() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel(0);\n      ByteBuffer buffer = ByteBuffer.allocateDirect(2064);\n      int bytesWritten = channel.write(buffer);\n      assertEquals(0, buffer.remaining());\n      assertEquals(2064, bytesWritten);\n  }\n\n  @Test(timeout = 4000)\n  public void writeAfterTruncateToZeroSucceeds() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      channel.truncate(0L);\n      ByteBuffer buffer = ByteBuffer.allocateDirect(832);\n      int bytesWritten = channel.write(buffer);\n      assertEquals(832, buffer.position());\n      assertEquals(832, bytesWritten);\n  }\n\n  @Test(timeout = 4000)\n  public void readFromChannelTruncatedToZeroReturnsMinusOne() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      channel.truncate(0L);\n      ByteBuffer buffer = ByteBuffer.allocateDirect(832);\n      int bytesRead = channel.read(buffer);\n      assertEquals(-1, bytesRead);\n  }\n\n  @Test(timeout = 4000)\n  public void readReturnsMinusOneWhenPositionExceedsIntegerMaxValue() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      channel.position(POSITION_BEYOND_MAX_INT);\n      ByteBuffer buffer = ByteBuffer.allocate((byte) 52);\n      int bytesRead = channel.read(buffer);\n      assertEquals(-1, bytesRead);\n  }\n\n  @Test(timeout = 4000)\n  public void readFromDefaultChannelFillsSmallerBuffer() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      ByteBuffer buffer = ByteBuffer.allocateDirect(832);\n      int bytesRead = channel.read(buffer);\n      assertEquals(0, buffer.remaining());\n      assertEquals(832, bytesRead);\n  }\n\n  @Test(timeout = 4000)\n  public void setNegativePositionThrowsIllegalArgumentException() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      // Undeclared exception!\n      try {\n          channel.position(-1L);\n          fail(\"Expecting exception: IllegalArgumentException\");\n      } catch (IllegalArgumentException e) {\n          //\n          // New position is negative: -1\n          //\n          verifyException(\"org.apache.commons.compress.utils.SeekableInMemoryByteChannel\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void arrayReturnsInternalBufferWithDefaultSize() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      byte[] internalBuffer = channel.array();\n      assertEquals(DEFAULT_BUFFER_SIZE, internalBuffer.length);\n  }\n\n  @Test(timeout = 4000)\n  public void sizeReturnsZeroForZeroCapacityChannel() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel(0);\n      long size = channel.size();\n      assertEquals(0L, size);\n  }\n\n  @Test(timeout = 4000)\n  public void readAfterCloseThrowsClosedChannelException() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      channel.close();\n      try {\n          channel.read((ByteBuffer) null);\n          fail(\"Expecting exception: ClosedChannelException\");\n      } catch (ClosedChannelException e) {\n          //\n          // no message in exception (getMessage() returned null)\n          //\n          verifyException(\"org.apache.commons.compress.utils.SeekableInMemoryByteChannel\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void initialPositionIsZero() throws Throwable {\n      SeekableInMemoryByteChannel channel = new SeekableInMemoryByteChannel();\n      long position = channel.position();\n      assertEquals(0L, position);\n  }\n}\n",
