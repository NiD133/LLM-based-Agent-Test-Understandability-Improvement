  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 08:01:52 GMT 2026\n */\n\npackage org.apache.commons.compress.harmony.unpack200;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.IdentityHashMap;\nimport java.util.List;\nimport org.apache.commons.compress.harmony.unpack200.SegmentConstantPoolArrayCache;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class SegmentConstantPoolArrayCache_ESTest extends SegmentConstantPoolArrayCache_ESTest_scaffolding {\n\n    /**\n     * Verifies that looking up a key that does not exist in the cached array returns an empty list.\n     * The array contains 8 null entries; searching for \"\" should yield zero matches.\n     * The second call exercises the repeated-query fast path (lastArray/lastKey cache).\n     */\n    @Test(timeout = 4000)\n    public void test0()  throws Throwable  {\n        SegmentConstantPoolArrayCache cache = new SegmentConstantPoolArrayCache();\n        String[] arrayWithNulls = new String[8];\n        // Prime the cache on first call, then hit the repeated-query fast path on second call.\n        cache.indexesForArrayKey(arrayWithNulls, \"\");\n        List<Integer> indexes = cache.indexesForArrayKey(arrayWithNulls, \"\");\n        assertEquals(0, indexes.size());\n    }\n\n    /**\n     * Verifies that attempting to cache an array that is already cached throws\n     * an IllegalArgumentException with the expected message.\n     */\n    @Test(timeout = 4000)\n    public void test1()  throws Throwable  {\n        SegmentConstantPoolArrayCache cache = new SegmentConstantPoolArrayCache();\n        String[] array = new String[7];\n        cache.cacheArray(array);\n        // Undeclared exception!\n        try {\n            cache.cacheArray(array);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // Trying to cache an array that already exists\n            //\n            verifyException(\"org.apache.commons.compress.harmony.unpack200.SegmentConstantPoolArrayCache\", e);\n        }\n    }\n\n    /**\n     * Verifies that arrayIsCached returns false when the knownArrays map holds a\n     * CachedArray whose recorded size differs from the current array length.\n     *\n     * The scenario: a 7-element array is registered in knownArrays but its\n     * CachedArray was built from a 4-element array, so the sizes do not match and\n     * the cache is considered stale.\n     */\n    @Test(timeout = 4000)\n    public void test2()  throws Throwable  {\n        SegmentConstantPoolArrayCache cache = new SegmentConstantPoolArrayCache();\n        String[] sevenElementArray = new String[7];\n        String[] fourElementArray = new String[4];\n\n        // Directly manipulate internal state to create a size-mismatch scenario.\n        IdentityHashMap<String[], SegmentConstantPoolArrayCache.CachedArray> knownArrays = cache.knownArrays;\n        SegmentConstantPoolArrayCache.CachedArray cachedArrayForFour = cache.new CachedArray(fourElementArray);\n        knownArrays.put(sevenElementArray, cachedArrayForFour);\n        assertEquals(4, cachedArrayForFour.lastKnownSize());\n\n        // The cache entry reports size 4 but the array has length 7, so it should be considered stale.\n        boolean isCached = cache.arrayIsCached(sevenElementArray);\n        assertFalse(isCached);\n    }\n\n    /**\n     * Verifies that CachedArray.indexesForKey returns a non-empty list when the\n     * search key is present in the underlying array.\n     *\n     * The first element of the array is set to a specific string; searching for\n     * that string should return at least one index.\n     */\n    @Test(timeout = 4000)\n    public void test3()  throws Throwable  {\n        SegmentConstantPoolArrayCache cache = new SegmentConstantPoolArrayCache();\n        String[] array = new String[7];\n        String presentKey = \"org.apache.commons.compress.harmony.unpack200.SegmentConstantPoolArrayCache$CachedArray\";\n        array[0] = presentKey;\n\n        SegmentConstantPoolArrayCache.CachedArray cachedArray = cache.new CachedArray(array);\n        List<Integer> indexes = cachedArray.indexesForKey(presentKey);\n        assertFalse(indexes.isEmpty());\n    }\n}\n",
