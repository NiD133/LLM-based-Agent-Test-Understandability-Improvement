  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testCharSetMatcher_String extends AbstractLangTest {\n\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    // Indices: a=0, b=1, c=2, d=3, e=4, f=5\n    private static final char[] BUFFER2 = \"abcdef\".toCharArray();\n\n    @Test\n    void testCharSetMatcher_String() {\n        // Matcher built from a multi-character string matches exactly those characters\n        final StrMatcher matcher = StrMatcher.charSetMatcher(\"ace\");\n\n        // Characters in the set {\"a\", \"c\", \"e\"} should match (return 1)\n        assertEquals(1, matcher.isMatch(BUFFER2, 0)); // 'a' is in the set\n        assertEquals(1, matcher.isMatch(BUFFER2, 2)); // 'c' is in the set\n        assertEquals(1, matcher.isMatch(BUFFER2, 4)); // 'e' is in the set\n\n        // Characters not in the set {\"b\", \"d\", \"f\"} should not match (return 0)\n        assertEquals(0, matcher.isMatch(BUFFER2, 1)); // 'b' is not in the set\n        assertEquals(0, matcher.isMatch(BUFFER2, 3)); // 'd' is not in the set\n        assertEquals(0, matcher.isMatch(BUFFER2, 5)); // 'f' is not in the set\n\n        // Empty or null input produces the shared noneMatcher singleton (matches nothing)\n        assertSame(StrMatcher.noneMatcher(), StrMatcher.charSetMatcher(\"\"));\n        assertSame(StrMatcher.noneMatcher(), StrMatcher.charSetMatcher((String) null));\n\n        // A single-character string optimises to a CharMatcher rather than a CharSetMatcher\n        assertInstanceOf(StrMatcher.CharMatcher.class, StrMatcher.charSetMatcher(\"a\"));\n    }\n}\n",
