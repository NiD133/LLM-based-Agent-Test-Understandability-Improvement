  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testCommaMatcher extends AbstractLangTest {\n\n    // Index layout: 0='0', 1=',', 2='1', ...\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    private static final int NO_MATCH = 0;\n    private static final int SINGLE_CHAR_MATCH = 1;\n\n    @Test\n    void testCommaMatcher() {\n        final StrMatcher commaMatcher = StrMatcher.commaMatcher();\n\n        // commaMatcher() always returns the same singleton instance\n        assertSame(commaMatcher, StrMatcher.commaMatcher());\n\n        // '0' at index 0 is not a comma — no match\n        assertEquals(NO_MATCH, commaMatcher.isMatch(BUFFER1, 0));\n        // ',' at index 1 is a comma — matches one character\n        assertEquals(SINGLE_CHAR_MATCH, commaMatcher.isMatch(BUFFER1, 1));\n        // '1' at index 2 is not a comma — no match\n        assertEquals(NO_MATCH, commaMatcher.isMatch(BUFFER1, 2));\n    }\n}\n",
