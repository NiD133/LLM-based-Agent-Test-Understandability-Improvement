  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testSpaceMatcher extends AbstractLangTest {\n\n    // Characters and their positions in BUFFER1:\n    //   index: 0='0', 1=',', 2='1', 3='\\t', 4='2', 5=' ', 6='3', 7='\\n', 8='\\r', 9='\\f', 10='\u0000', 11='\\'', 12='\"'\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    private static final int POS_DIGIT_BEFORE_SPACE = 4; // '2' — not a space\n    private static final int POS_SPACE               = 5; // ' ' — the space character\n    private static final int POS_DIGIT_AFTER_SPACE   = 6; // '3' — not a space\n\n    private static final int NO_MATCH          = 0; // isMatch return value: no match\n    private static final int SINGLE_CHAR_MATCH = 1; // isMatch return value: matched one character\n\n    @Test\n    void testSpaceMatcher() {\n        final StrMatcher spaceMatcher = StrMatcher.spaceMatcher();\n\n        // spaceMatcher() always returns the same shared singleton instance\n        assertSame(spaceMatcher, StrMatcher.spaceMatcher());\n\n        // '2' (digit) immediately before the space — should not match\n        assertEquals(NO_MATCH, spaceMatcher.isMatch(BUFFER1, POS_DIGIT_BEFORE_SPACE));\n\n        // ' ' (space) — should match exactly one character\n        assertEquals(SINGLE_CHAR_MATCH, spaceMatcher.isMatch(BUFFER1, POS_SPACE));\n\n        // '3' (digit) immediately after the space — should not match\n        assertEquals(NO_MATCH, spaceMatcher.isMatch(BUFFER1, POS_DIGIT_AFTER_SPACE));\n    }\n}\n",
