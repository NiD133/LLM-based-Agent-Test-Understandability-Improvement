  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testQuoteMatcher extends AbstractLangTest {\n\n    // Buffer layout: idx 0='0' 1=',' 2='1' 3='\\t' 4='2' 5=' ' 6='3'\n    //                    7='\\n' 8='\\r' 9='\\f' 10=NUL 11='\\'' 12='\"'\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    // Named indices make each assertion self-documenting\n    private static final int INDEX_NULL_CHAR    = 10; // NUL char — not a quote, expect 0\n    private static final int INDEX_SINGLE_QUOTE = 11; // '\\'' — expect 1\n    private static final int INDEX_DOUBLE_QUOTE = 12; // '\"'  — expect 1\n\n    /** quoteMatcher() must return the same singleton instance on every call. */\n    @Test\n    void testQuoteMatcherIsSingleton() {\n        final StrMatcher matcher = StrMatcher.quoteMatcher();\n        assertSame(matcher, StrMatcher.quoteMatcher());\n    }\n\n    /** quoteMatcher() must return 0 for a character that is not a quote. */\n    @Test\n    void testQuoteMatcherDoesNotMatchNullChar() {\n        final StrMatcher matcher = StrMatcher.quoteMatcher();\n        assertEquals(0, matcher.isMatch(BUFFER1, INDEX_NULL_CHAR));\n    }\n\n    /** quoteMatcher() must return 1 when the character at pos is a single quote. */\n    @Test\n    void testQuoteMatcherMatchesSingleQuote() {\n        final StrMatcher matcher = StrMatcher.quoteMatcher();\n        assertEquals(1, matcher.isMatch(BUFFER1, INDEX_SINGLE_QUOTE));\n    }\n\n    /** quoteMatcher() must return 1 when the character at pos is a double quote. */\n    @Test\n    void testQuoteMatcherMatchesDoubleQuote() {\n        final StrMatcher matcher = StrMatcher.quoteMatcher();\n        assertEquals(1, matcher.isMatch(BUFFER1, INDEX_DOUBLE_QUOTE));\n    }\n}\n",
