  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertInstanceOf;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testCharSetMatcher_charArray extends AbstractLangTest {\n\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    // \"abcdef\": even indices (0,2,4) are 'a','c','e'; odd indices (1,3,5) are 'b','d','f'\n    private static final char[] BUFFER2 = \"abcdef\".toCharArray();\n\n    private static final int MATCH = 1;\n    private static final int NO_MATCH = 0;\n\n    @Test\n    void testCharSetMatcher_charArray() {\n        // Matcher that accepts any character in the set {'a', 'c', 'e'}\n        final StrMatcher aceSetMatcher = StrMatcher.charSetMatcher(\"ace\".toCharArray());\n\n        assertEquals(MATCH,    aceSetMatcher.isMatch(BUFFER2, 0)); // BUFFER2[0] == 'a' — in set\n        assertEquals(NO_MATCH, aceSetMatcher.isMatch(BUFFER2, 1)); // BUFFER2[1] == 'b' — not in set\n        assertEquals(MATCH,    aceSetMatcher.isMatch(BUFFER2, 2)); // BUFFER2[2] == 'c' — in set\n        assertEquals(NO_MATCH, aceSetMatcher.isMatch(BUFFER2, 3)); // BUFFER2[3] == 'd' — not in set\n        assertEquals(MATCH,    aceSetMatcher.isMatch(BUFFER2, 4)); // BUFFER2[4] == 'e' — in set\n        assertEquals(NO_MATCH, aceSetMatcher.isMatch(BUFFER2, 5)); // BUFFER2[5] == 'f' — not in set\n\n        // Empty or null char array produces the shared none-matcher singleton\n        assertSame(StrMatcher.noneMatcher(), StrMatcher.charSetMatcher());\n        assertSame(StrMatcher.noneMatcher(), StrMatcher.charSetMatcher((char[]) null));\n\n        // A single-character array is optimised into a CharMatcher, not a CharSetMatcher\n        assertInstanceOf(StrMatcher.CharMatcher.class, StrMatcher.charSetMatcher(\"a\".toCharArray()));\n    }\n}\n",
