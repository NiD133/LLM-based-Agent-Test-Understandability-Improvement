  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testTabMatcher extends AbstractLangTest {\n\n    // Buffer layout: index 0='0', 1=',', 2='1', 3='\\t', 4='2', ...\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    private static final int INDEX_BEFORE_TAB = 2; // '1' — not a tab\n    private static final int INDEX_AT_TAB     = 3; // '\\t' — the tab character\n    private static final int INDEX_AFTER_TAB  = 4; // '2' — not a tab\n\n    @Test\n    void testTabMatcher() {\n        final StrMatcher matcher = StrMatcher.tabMatcher();\n\n        // tabMatcher() returns the same singleton instance on every call\n        assertSame(matcher, StrMatcher.tabMatcher());\n\n        assertEquals(0, matcher.isMatch(BUFFER1, INDEX_BEFORE_TAB)); // non-tab: no match\n        assertEquals(1, matcher.isMatch(BUFFER1, INDEX_AT_TAB));     // tab: matched 1 char\n        assertEquals(0, matcher.isMatch(BUFFER1, INDEX_AFTER_TAB));  // non-tab: no match\n    }\n}\n",
