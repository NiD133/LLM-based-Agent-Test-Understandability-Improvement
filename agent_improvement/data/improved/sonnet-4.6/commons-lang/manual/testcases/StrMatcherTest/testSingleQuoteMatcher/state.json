  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testSingleQuoteMatcher extends AbstractLangTest {\n\n    // Positions of interest in BUFFER1:\n    //   index 10 = '\u0000' (null character — not a single quote)\n    //   index 11 = '\\''     (single quote   — the character under test)\n    //   index 12 = '\"'      (double quote   — not a single quote)\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    private static final int INDEX_OF_NULL_CHAR    = 10;\n    private static final int INDEX_OF_SINGLE_QUOTE = 11;\n    private static final int INDEX_OF_DOUBLE_QUOTE = 12;\n\n    @Test\n    void testSingleQuoteMatcher() {\n        final StrMatcher matcher = StrMatcher.singleQuoteMatcher();\n\n        // singleQuoteMatcher() must always return the same singleton instance\n        assertSame(matcher, StrMatcher.singleQuoteMatcher());\n\n        // null char ('\u0000') is not a single quote — expect no match\n        assertEquals(0, matcher.isMatch(BUFFER1, INDEX_OF_NULL_CHAR));\n\n        // single quote ('\\'') is the target character — expect match length of 1\n        assertEquals(1, matcher.isMatch(BUFFER1, INDEX_OF_SINGLE_QUOTE));\n\n        // double quote ('\"') is not a single quote — expect no match\n        assertEquals(0, matcher.isMatch(BUFFER1, INDEX_OF_DOUBLE_QUOTE));\n    }\n}\n",
