  "last_code": "package org.apache.commons.lang3;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertNotEquals;\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\nimport static org.junit.jupiter.api.Assertions.assertThrows;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\n\nimport java.util.Iterator;\nimport java.util.NoSuchElementException;\n\nimport org.junit.jupiter.api.Test;\n\npublic class CharRangeTest_testIterator extends AbstractLangTest {\n\n    // --- Single-character range ('a' only) ---\n\n    @Test\n    void testIterator_singleChar_returnsOnlyThatChar() {\n        final CharRange singleA = CharRange.is('a');\n        final Iterator<Character> it = singleA.iterator();\n\n        assertNotNull(it);\n        assertTrue(it.hasNext());\n        assertEquals(Character.valueOf('a'), it.next());\n        assertFalse(it.hasNext());\n    }\n\n    // --- Inclusive range ('a' through 'd') ---\n\n    @Test\n    void testIterator_inclusiveRange_returnsAllCharsInOrder() {\n        final CharRange aToD = CharRange.isIn('a', 'd');\n        final Iterator<Character> it = aToD.iterator();\n\n        assertNotNull(it);\n        assertTrue(it.hasNext());\n        assertEquals(Character.valueOf('a'), it.next());\n        assertEquals(Character.valueOf('b'), it.next());\n        assertEquals(Character.valueOf('c'), it.next());\n        assertEquals(Character.valueOf('d'), it.next());\n        assertFalse(it.hasNext());\n    }\n\n    // --- Negated single-character range (everything except 'a') ---\n\n    @Test\n    void testIterator_negatedSingleChar_neverYieldsExcludedChar() {\n        final CharRange notA = CharRange.isNot('a');\n        final Iterator<Character> it = notA.iterator();\n\n        assertNotNull(it);\n        assertTrue(it.hasNext());\n        while (it.hasNext()) {\n            final Character c = it.next();\n            assertNotEquals('a', c.charValue());\n        }\n    }\n\n    // --- Negated full range (empty set: notIn '\u0000'..MAX_VALUE) ---\n\n    @Test\n    void testIterator_emptySet_hasNoElementsAndThrowsOnNext() {\n        final CharRange emptySet = CharRange.isNotIn((char) 0, Character.MAX_VALUE);\n        final Iterator<Character> it = emptySet.iterator();\n\n        assertNotNull(it);\n        assertFalse(it.hasNext());\n        assertThrows(NoSuchElementException.class, it::next);\n    }\n\n    // --- Negated range that excludes all chars except '\u0000' (notIn '\u0001'..MAX_VALUE) ---\n\n    @Test\n    void testIterator_onlyFirstCharInRange_returnsNullCharThenExhausts() {\n        final CharRange notFirst = CharRange.isNotIn((char) 1, Character.MAX_VALUE);\n        final Iterator<Character> it = notFirst.iterator();\n\n        assertNotNull(it);\n        assertTrue(it.hasNext());\n        assertEquals(Character.valueOf((char) 0), it.next());\n        assertFalse(it.hasNext());\n        assertThrows(NoSuchElementException.class, it::next);\n    }\n\n    // --- Negated range that excludes all chars except MAX_VALUE (notIn '\u0000'..MAX_VALUE-1) ---\n\n    @Test\n    void testIterator_onlyLastCharInRange_returnsMaxValueThenExhausts() {\n        final CharRange notLast = CharRange.isNotIn((char) 0, (char) (Character.MAX_VALUE - 1));\n        final Iterator<Character> it = notLast.iterator();\n\n        assertNotNull(it);\n        assertTrue(it.hasNext());\n        assertEquals(Character.valueOf(Character.MAX_VALUE), it.next());\n        assertFalse(it.hasNext());\n        assertThrows(NoSuchElementException.class, it::next);\n    }\n}\n",
