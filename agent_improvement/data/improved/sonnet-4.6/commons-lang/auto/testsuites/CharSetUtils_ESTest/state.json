  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 11:19:16 GMT 2026\n */\n\npackage org.apache.commons.lang3;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport org.apache.commons.lang3.CharSetUtils;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class CharSetUtils_ESTest extends CharSetUtils_ESTest_scaffolding {\n\n    // --- squeeze() tests ---\n\n    @Test(timeout = 4000)\n    public void squeeze_withNonMatchingCharSet_returnsOriginalString() throws Throwable {\n        String[] charSet = new String[1];\n        charSet[0] = \"Minimum abbreviation width with offset is %d\";\n        String result = CharSetUtils.squeeze(\"...\", charSet);\n        assertEquals(\"...\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void squeeze_withMatchingCharSet_collapsesConsecutiveDuplicates() throws Throwable {\n        String[] charSet = new String[4];\n        charSet[1] = \"ZS[4!;6>G|3UPaJfj\";\n        String result = CharSetUtils.squeeze(\"Minimum abbreviation width with offset is %d\", charSet);\n        assertEquals(\"Minimum abbreviation width with ofset is %d\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void squeeze_dots_collapsesConsecutiveDots() throws Throwable {\n        String[] charSet = new String[2];\n        charSet[1] = \"...\";\n        String result = CharSetUtils.squeeze(\"...\", charSet);\n        assertEquals(\".\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void squeeze_withFInCharSet_collapsesDoubleF() throws Throwable {\n        String[] charSet = new String[2];\n        charSet[1] = \"ZS[4!;6>G|3UPaJfj\";\n        String result = CharSetUtils.squeeze(\"offset cannot be negative\", charSet);\n        assertEquals(\"ofset cannot be negative\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void squeeze_withNullCharSetEntries_returnsOriginalString() throws Throwable {\n        String[] charSet = new String[2];\n        String result = CharSetUtils.squeeze(\"Minimum abbreviation width with offset is %d\", charSet);\n        assertEquals(\"Minimum abbreviation width with offset is %d\", result);\n    }\n\n    // --- keep() tests ---\n\n    @Test(timeout = 4000)\n    public void keep_whenNoCharsMatch_returnsEmptyString() throws Throwable {\n        String[] charSet = new String[9];\n        charSet[3] = \"!f0C7\\\"CJoqlK\";\n        String result = CharSetUtils.keep(\"E\", charSet);\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void keep_withNullCharSetEntries_returnsEmptyString() throws Throwable {\n        String[] charSet = new String[1];\n        String result = CharSetUtils.keep(\"=11X|n;V_\", charSet);\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void keep_withNullInput_returnsNull() throws Throwable {\n        String[] charSet = new String[1];\n        String result = CharSetUtils.keep((String) null, charSet);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void keep_withEmptyInput_returnsEmptyString() throws Throwable {\n        String[] charSet = new String[9];\n        String result = CharSetUtils.keep(\"\", charSet);\n        assertEquals(\"\", result);\n    }\n\n    // --- delete() tests ---\n\n    @Test(timeout = 4000)\n    public void delete_withEmptyInput_returnsEmptyString() throws Throwable {\n        String[] charSet = new String[9];\n        String result = CharSetUtils.delete(\"\", charSet);\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void delete_whenNoCharsMatch_returnsOriginalString() throws Throwable {\n        String[] charSet = new String[9];\n        charSet[7] = \"Iyc@#m)6#tX\";\n        String result = CharSetUtils.delete(\"YhY[\", charSet);\n        assertEquals(\"YhY[\", result);\n    }\n\n    // --- count() tests ---\n\n    @Test(timeout = 4000)\n    public void count_withNullInput_returnsZero() throws Throwable {\n        String[] charSet = new String[1];\n        // charSet[0] is null, so both the string argument and charSet entry are null\n        int result = CharSetUtils.count(charSet[0], charSet);\n        assertEquals(0, result);\n    }\n\n    @Test(timeout = 4000)\n    public void count_withMatchingCharSet_returnsMatchCount() throws Throwable {\n        String[] charSet = new String[4];\n        charSet[0] = \"!NIzU+h g./^6\";\n        int result = CharSetUtils.count(\"!NIzU+h g./^6\", charSet);\n        assertEquals(12, result);\n    }\n\n    // --- containsAny() tests ---\n\n    @Test(timeout = 4000)\n    public void containsAny_whenNoCharsMatch_returnsFalse() throws Throwable {\n        String[] charSet = new String[6];\n        charSet[0] = \"org.apache.commons.lang3.CharSetUtils\";\n        boolean result = CharSetUtils.containsAny(\"<\", charSet);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void containsAny_withNullCharSetEntries_returnsFalse() throws Throwable {\n        String[] charSet = new String[11];\n        boolean result = CharSetUtils.containsAny(\"@~j'\\\"_*}sm\", charSet);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void containsAny_whenCharMatches_returnsTrue() throws Throwable {\n        String[] charSet = new String[2];\n        charSet[1] = \"ZS[4!;6>G|3UPaJfj\";\n        boolean result = CharSetUtils.containsAny(\"@~j'\\\"_*}sm\", charSet);\n        assertTrue(result);\n    }\n\n    // --- constructor test ---\n\n    @Test(timeout = 4000)\n    public void constructor_canBeInstantiated() throws Throwable {\n        CharSetUtils charSetUtils = new CharSetUtils();\n    }\n}\n",
