  "last_code": "package org.apache.commons.lang3.text.translate;\n\nimport org.junit.Before;\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport java.nio.CharBuffer;\nimport org.apache.commons.lang3.text.translate.NumericEntityUnescaper;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class NumericEntityUnescaper_ESTest extends NumericEntityUnescaper_ESTest_scaffolding {\n\n    // Empty option array construction defaults to semiColonRequired behavior\n    private NumericEntityUnescaper defaultUnescaper;\n\n    @Before\n    public void setUp() {\n        defaultUnescaper = new NumericEntityUnescaper(new NumericEntityUnescaper.OPTION[0]);\n    }\n\n    @Test(timeout = 4000)\n    public void translate_decimalEntityWithSemicolon_convertsToCharAndPassesThroughRemainder() throws Throwable {\n        // Buffer: \"&#2;\" at [0-3], then three null chars (\u0000) at [4-6].\n        // \"&#2;\" is a valid decimal numeric entity (code point 2). The unescaper writes\n        // \u0002 and advances past \"&#2;\"; the three trailing null chars pass through.\n        char[] buf = new char[7];\n        buf[0] = '&';\n        buf[1] = '#';\n        buf[2] = '2';\n        buf[3] = ';';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"\u0002\u0000\u0000\u0000\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void translate_hexPrefixWithNoDigitsBeforeSemicolon_returnsInputUnchanged() throws Throwable {\n        // Buffer: \"&#X;\" at [0-3], then three null chars at [4-6].\n        // \"&#X;\" has the uppercase hex prefix 'X' but no hex digits before ';'.\n        // Integer.parseInt(\"\", 16) throws NumberFormatException, so translate returns 0\n        // and every character is emitted verbatim.\n        char[] buf = new char[7];\n        buf[0] = '&';\n        buf[1] = '#';\n        buf[2] = 'X';\n        buf[3] = ';';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"&#X;\u0000\u0000\u0000\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void translate_decimalEntityWithoutSemicolon_noTranslationWhenSemicolonRequired() throws Throwable {\n        // Buffer: four null chars at [0-3], then \"&#3\" at [4-6] (no closing ';').\n        // The default semiColonRequired option causes translate to return 0 for \"&#3\",\n        // so all characters — including the four leading null chars — pass through verbatim.\n        char[] buf = new char[7];\n        buf[4] = '&';\n        buf[5] = '#';\n        buf[6] = '3';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"\u0000\u0000\u0000\u0000&#3\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void translate_hexPrefixWithNoDigitsAndNoSemicolon_returnsInputUnchanged() throws Throwable {\n        // Buffer: \"&#X\" at [0-2], then four null chars at [3-6].\n        // 'X' is the hex prefix, but the null chars are not valid hex digits and there\n        // is no semicolon, so every character is emitted verbatim.\n        char[] buf = new char[7];\n        buf[0] = '&';\n        buf[1] = '#';\n        buf[2] = 'X';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"&#X\u0000\u0000\u0000\u0000\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void translate_lowercaseHexPrefixFollowedByNullChars_returnsInputUnchanged() throws Throwable {\n        // Buffer: \"&#x\" at [0-2], then seven null chars at [3-9].\n        // 'x' is the lowercase hex prefix. Null (\u0000) is not a valid hex digit,\n        // so no digits are accumulated, semiColonRequired blocks translation, and\n        // every character is emitted verbatim.\n        char[] buf = new char[10];\n        buf[0] = '&';\n        buf[1] = '#';\n        buf[2] = 'x';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"&#x\u0000\u0000\u0000\u0000\u0000\u0000\u0000\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void translate_ampersandWithoutHashSign_returnsInputUnchanged() throws Throwable {\n        // Buffer: '&' at [0], then five null chars at [1-5].\n        // The char at index 1 is \u0000 (not '#'), so this is not a numeric entity.\n        // translate returns 0 and all characters pass through verbatim.\n        char[] buf = new char[6];\n        buf[0] = '&';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"&\u0000\u0000\u0000\u0000\u0000\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void translate_singleAmpersand_returnsAmpersand() throws Throwable {\n        // Buffer: a lone '&' (length 1).\n        // The length guard (index < seqEnd - 2) evaluates to 0 < -1, which is false,\n        // so translate returns 0 immediately and '&' is emitted verbatim.\n        char[] buf = new char[1];\n        buf[0] = '&';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"&\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void constructor_withNullOptionElement_throwsNullPointerException() throws Throwable {\n        // An array of length 1 whose sole element is null (default uninitialized reference).\n        // Arrays.asList wraps it into a list with a null entry, and EnumSet.copyOf rejects\n        // null elements by throwing NullPointerException.\n        NumericEntityUnescaper.OPTION[] optionsWithNull = new NumericEntityUnescaper.OPTION[1];\n        try {\n            new NumericEntityUnescaper(optionsWithNull);\n            fail(\"Expected NullPointerException\");\n        } catch (NullPointerException e) {\n            // expected — null OPTION element is rejected by EnumSet.copyOf\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void translate_hexPrefixAtEndOfInputWithoutDigitsOrSemicolon_returnsInputUnchanged() throws Throwable {\n        // Buffer: three null chars at [0-2], then \"&#X\" at [3-5].\n        // After advancing past the 'X' hex prefix, start equals seqEnd (no room for digits),\n        // so translate returns 0 immediately and all characters pass through verbatim.\n        char[] buf = new char[6];\n        buf[3] = '&';\n        buf[4] = '#';\n        buf[5] = 'X';\n        String result = defaultUnescaper.translate((CharSequence) CharBuffer.wrap(buf));\n        assertEquals(\"\u0000\u0000\u0000&#X\", result);\n    }\n}\n",
