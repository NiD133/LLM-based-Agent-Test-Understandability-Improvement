 public void isValidEnumIgnoreCase_withLowercaseName_returnsTrue()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      boolean valid = EnumUtils.isValidEnumIgnoreCase(enumClass, \"autoselect_filtering\");\n      assertTrue(valid);\n  }\n\n  // A null name cannot match any enum constant\n  @Test(timeout = 4000)\n  public void isValidEnumIgnoreCase_withNullName_returnsFalse()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      boolean valid = EnumUtils.isValidEnumIgnoreCase(enumClass, (String) null);\n      assertFalse(valid);\n  }\n\n  // The mock makes every enum's int value equal to 3; getFirstEnum(value=3) must return\n  // the first matching enum, which is AUTOSELECT_FILTERING (ordinal 0)\n  @Test(timeout = 4000)\n  public void getFirstEnum_whenMockedFunctionMatchesValue_returnsFirstMatchingEnum()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      ToIntFunction<Locale.FilteringMode> intMapper = (ToIntFunction<Locale.FilteringMode>) mock(ToIntFunction.class, new ViolatedAssumptionAnswer());\n      doReturn(3).when(intMapper).applyAsInt(any(java.util.Locale.FilteringMode.class));\n      Locale.FilteringMode defaultEnum = Locale.FilteringMode.IGNORE_EXTENDED_RANGES;\n      Locale.FilteringMode result = EnumUtils.getFirstEnum(enumClass, 3, intMapper, defaultEnum);\n      assertEquals(Locale.FilteringMode.AUTOSELECT_FILTERING, result);\n  }\n\n  // A null enum class is not a valid enum type, so the default must be returned\n  @Test(timeout = 4000)\n  public void getFirstEnum_withNullEnumClass_returnsDefaultEnum()  throws Throwable  {\n      ToIntFunction<Locale.FilteringMode> intMapper = (ToIntFunction<Locale.FilteringMode>) mock(ToIntFunction.class, new ViolatedAssumptionAnswer());\n      Locale.FilteringMode defaultEnum = Locale.FilteringMode.EXTENDED_FILTERING;\n      Locale.FilteringMode result = EnumUtils.getFirstEnum((Class<Locale.FilteringMode>) null, 649, intMapper, defaultEnum);\n      assertSame(result, defaultEnum);\n  }\n\n  // \"+\" is not a valid FilteringMode name, so the default enum must be returned\n  @Test(timeout = 4000)\n  public void getEnum_withUnknownName_returnsDefaultEnum()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      Locale.FilteringMode defaultEnum = Locale.FilteringMode.IGNORE_EXTENDED_RANGES;\n      Locale.FilteringMode result = EnumUtils.getEnum(enumClass, \"+\", defaultEnum);\n      assertSame(defaultEnum, result);\n  }\n\n  // AUTOSELECT_FILTERING has ordinal 0, so its bit vector in the long[] is 1L\n  @Test(timeout = 4000)\n  public void generateBitVectors_withIterableContainingOneValue_returnsOneBitSet()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      Vector<Locale.FilteringMode> values = new Vector<Locale.FilteringMode>(0);\n      values.add(Locale.FilteringMode.AUTOSELECT_FILTERING);\n      long[] bitVectors = EnumUtils.generateBitVectors(enumClass, (Iterable<? extends Locale.FilteringMode>) values);\n      assertArrayEquals(new long[] {1L}, bitVectors);\n      assertEquals(1, bitVectors.length);\n  }\n\n  // The mock always returns 0, which does not match -1, so getFirstEnum returns the default\n  // (AUTOSELECT_FILTERING). The array of 9 elements collapses to just AUTOSELECT_FILTERING (ordinal 0 = bit 0 = 1L).\n  @Test(timeout = 4000)\n  public void generateBitVectors_withArrayContainingDuplicates_deduplicatesViaBitMask()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      ToIntFunction<Locale.FilteringMode> intMapper = (ToIntFunction<Locale.FilteringMode>) mock(ToIntFunction.class, new ViolatedAssumptionAnswer());\n      doReturn(0, 0, 0, 0, 0).when(intMapper).applyAsInt(any(java.util.Locale.FilteringMode.class));\n      Locale.FilteringMode defaultEnum = Locale.FilteringMode.AUTOSELECT_FILTERING;\n      // -1 never matches 0, so getFirstEnum returns the default AUTOSELECT_FILTERING\n      Locale.FilteringMode resolvedDefault = EnumUtils.getFirstEnum(enumClass, (-1), intMapper, defaultEnum);\n      Locale.FilteringMode[] values = new Locale.FilteringMode[9];\n      values[0] = defaultEnum;\n      values[1] = defaultEnum;\n      values[2] = resolvedDefault;\n      values[3] = defaultEnum;\n      values[4] = defaultEnum;\n      values[5] = defaultEnum;\n      values[6] = resolvedDefault;\n      values[7] = resolvedDefault;\n      values[8] = resolvedDefault;\n      long[] bitVectors = EnumUtils.generateBitVectors(enumClass, values);\n      assertArrayEquals(new long[] {1L}, bitVectors);\n      assertEquals(1, bitVectors.length);\n  }\n\n  // All 5 FilteringMode values have ordinals 0-4, so all bits 0-4 are set: 1+2+4+8+16 = 31L\n  @Test(timeout = 4000)\n  public void generateBitVector_withAllEnumValues_setsAllCorrespondingBits()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      List<Locale.FilteringMode> allValues = EnumUtils.getEnumList(enumClass);\n      long bitVector = EnumUtils.generateBitVector(enumClass, (Iterable<? extends Locale.FilteringMode>) allValues);\n      assertEquals(31L, bitVector);\n  }\n\n  // An empty string is not a valid system property key, so no enum is found and the default is returned\n  @Test(timeout = 4000)\n  public void getEnumSystemProperty_withEmptyPropertyName_returnsDefaultEnum()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      Locale.FilteringMode defaultEnum = Locale.FilteringMode.IGNORE_EXTENDED_RANGES;\n      Locale.FilteringMode result = EnumUtils.getEnumSystemProperty(enumClass, \"\", defaultEnum);\n      assertSame(defaultEnum, result);\n  }\n\n  // 2800L in binary has bit 4 set (among others above ordinal 4), so only EXTENDED_FILTERING (ordinal 4) is included\n  @Test(timeout = 4000)\n  public void processBitVector_withBitPatternHavingOnlyOneBitInValidRange_returnsOneElementSet()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      EnumSet<Locale.FilteringMode> result = EnumUtils.processBitVector(enumClass, 2800L);\n      assertEquals(1, result.size());\n  }\n\n  // A null class cannot have enum constants to compare against\n  @Test(timeout = 4000)\n  public void isValidEnumIgnoreCase_withNullClass_returnsFalse()  throws Throwable  {\n      boolean valid = EnumUtils.isValidEnumIgnoreCase((Class<Locale.FilteringMode>) null, \"3qV_Tp24g8R8F5_u\");\n      assertFalse(valid);\n  }\n\n  // getEnumMap must return all declared constants of the enum\n  @Test(timeout = 4000)\n  public void getEnumMap_withValidEnumClass_returnsNonEmptyMap()  throws Throwable  {\n      Class<Locale.FilteringMode> enumClass = Locale.FilteringMode.class;\n      Map<String, Locale.FilteringMode> enumMap = EnumUtils.getEnumMap(enumClass);\n      assertFalse(enumMap.isEmpty());\n  }\n\n  // A null class cannot have enum constants, so the name cannot be valid\n  @Test(timeout = 4000)\n  public void isValidEnum_withNullClass_returnsFalse()  throws Throwable  {\n      boolean valid = EnumUtils.isValidEnum((Class<Locale.FilteringMode>) null, \"HaEk[w(YT.?P#4B\");\n      assertFalse(valid);\n  }\n\n  // EnumUtils provides a public no-arg constructor for JavaBean compatibility\n  @Test(timeout = 4000)\n  public void constructor_canBeInstantiated()  throws Throwable  {\n      EnumUtils enumUtils = new EnumUtils();\n  }\n}\n",
