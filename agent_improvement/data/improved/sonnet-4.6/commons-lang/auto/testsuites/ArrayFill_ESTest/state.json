e, Throwable> nopGenerator = FailableIntFunction.nop();\n        Object[] result = ArrayFill.fill(array, (FailableIntFunction<?, Throwable>) nopGenerator);\n        assertSame(result, array);\n    }\n\n    @Test(timeout = 4000)\n    public void test04_fillObjectArrayWithGenerator_nullArray_returnsNull() throws Throwable {\n        FailableIntFunction<Object, Throwable> nopGenerator = FailableIntFunction.nop();\n        Object[] result = ArrayFill.fill((Object[]) null, (FailableIntFunction<?, Throwable>) nopGenerator);\n        assertNull(result);\n    }\n\n    // --- fill(short[], short) ---\n\n    @Test(timeout = 4000)\n    public void test05_fillShortArray_fillsAllElementsWithValue() throws Throwable {\n        short[] array = new short[2];\n        short[] result = ArrayFill.fill(array, (short) 2260);\n        assertArrayEquals(new short[] {(short) 2260, (short) 2260}, result);\n    }\n\n    @Test(timeout = 4000)\n    public void test06_fillShortArray_nullArray_returnsNull() throws Throwable {\n        short[] result = ArrayFill.fill((short[]) null, (short) (-807));\n        assertNull(result);\n    }\n\n    // --- fill(long[], long) ---\n\n    @Test(timeout = 4000)\n    public void test07_fillLongArray_fillsWithZero_returnsSameInstance() throws Throwable {\n        long[] array = new long[2];\n        long[] result = ArrayFill.fill(array, 0L);\n        assertSame(result, array);\n    }\n\n    @Test(timeout = 4000)\n    public void test08_fillLongArray_nullArray_returnsNull() throws Throwable {\n        long[] result = ArrayFill.fill((long[]) null, (-1L));\n        assertNull(result);\n    }\n\n    // --- fill(int[], int) ---\n\n    @Test(timeout = 4000)\n    public void test09_fillIntArray_fillsAllElementsWithValue() throws Throwable {\n        int[] array = new int[4];\n        int[] result = ArrayFill.fill(array, 1);\n        assertArrayEquals(new int[] {1, 1, 1, 1}, result);\n    }\n\n    @Test(timeout = 4000)\n    public void test10_fillIntArray_nullArray_re