  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 11:14:25 GMT 2026\n */\n\npackage org.apache.commons.lang3;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport java.util.Set;\nimport org.apache.commons.lang3.CharRange;\nimport org.apache.commons.lang3.CharSet;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class CharSet_ESTest extends CharSet_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void test_equals_differentCharSets_returnsFalse() throws Throwable {\n      CharSet lowerCaseAlpha = CharSet.ASCII_ALPHA_LOWER;\n      String[] twoNullStrings = new String[2];\n      CharSet charSetFromNullStrings = CharSet.getInstance(twoNullStrings);\n\n      boolean lowerAlphaEqualsNullBased = lowerCaseAlpha.equals(charSetFromNullStrings);\n\n      assertFalse(charSetFromNullStrings.equals((Object) lowerCaseAlpha));\n      assertFalse(lowerAlphaEqualsNullBased);\n  }\n\n  @Test(timeout = 4000)\n  public void test_equals_sameInstance_returnsTrue() throws Throwable {\n      String[] oneNullString = new String[1];\n      CharSet charSet = CharSet.getInstance(oneNullString);\n\n      boolean equalsItself = charSet.equals(charSet);\n\n      assertTrue(equalsItself);\n  }\n\n  @Test(timeout = 4000)\n  public void test_equals_nonCharSetObject_returnsFalse() throws Throwable {\n      CharSet lowerCaseAlpha = CharSet.ASCII_ALPHA_LOWER;\n      Object plainObject = new Object();\n\n      boolean result = lowerCaseAlpha.equals(plainObject);\n\n      assertFalse(result);\n  }\n\n  @Test(timeout = 4000)\n  public void test_constructor_withMixedNullAndNonNullStrings_doesNotThrow() throws Throwable {\n      String[] strings = new String[6];\n      strings[4] = \"=]w9^0fV\";\n      CharSet charSet = new CharSet(strings);\n  }\n\n  @Test(timeout = 4000)\n  public void test_getInstance_withComplexPatternString_returnsNonNull() throws Throwable {\n      String[] strings = new String[6];\n      strings[2] = \"\\\"@mi/vnsJ<U6tm^D-O\";\n\n      CharSet charSet = CharSet.getInstance(strings);\n\n      assertNotNull(charSet);\n  }\n\n  @Test(timeout = 4000)\n  public void test_getInstance_withMultiRangePattern_returnsNonNull() throws Throwable {\n      String[] patterns = new String[1];\n      patterns[0] = \"A-Xa-z\";\n\n      CharSet charSet = CharSet.getInstance(patterns);\n\n      assertNotNull(charSet);\n  }\n\n  @Test(timeout = 4000)\n  public void test_getInstance_withNullArray_hashCodeDoesNotThrow() throws Throwable {\n      CharSet emptyCharSet = CharSet.getInstance((String[]) null);\n      emptyCharSet.hashCode();\n  }\n\n  @Test(timeout = 4000)\n  public void test_contains_charAbsentFromNullBasedCharSet_returnsFalse() throws Throwable {\n      String[] oneNullString = new String[1];\n      CharSet charSet = CharSet.getInstance(oneNullString);\n\n      boolean containsV = charSet.contains('v');\n\n      assertFalse(containsV);\n  }\n\n  @Test(timeout = 4000)\n  public void test_toString_lowerCaseAlphaCharSet_returnsExpectedString() throws Throwable {\n      CharSet lowerCaseAlpha = CharSet.ASCII_ALPHA_LOWER;\n\n      String result = lowerCaseAlpha.toString();\n\n      assertEquals(\"[a-z]\", result);\n  }\n\n  @Test(timeout = 4000)\n  public void test_getCharRanges_nullBasedCharSet_returnsEmptySet() throws Throwable {\n      String[] oneNullString = new String[1];\n      CharSet charSet = CharSet.getInstance(oneNullString);\n\n      Set<CharRange> ranges = charSet.getCharRanges();\n\n      assertEquals(0, ranges.size());\n  }\n}\n",
