  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 10:32:06 GMT 2026\n */\n\npackage org.apache.commons.lang3;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.io.IOException;\nimport java.util.ArrayList;\nimport java.util.HashSet;\nimport java.util.LinkedHashSet;\nimport org.apache.commons.lang3.AppendableJoiner;\nimport org.apache.commons.lang3.function.FailableBiConsumer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class AppendableJoiner_ESTest extends AppendableJoiner_ESTest_scaffolding {\n\n    // --- Builder tests ---\n\n    @Test(timeout = 4000)\n    public void test00_builderWithEmptyDelimiter_returnsNonNullJoiner() throws Throwable {\n        AppendableJoiner.Builder<StringBuilder> builder = new AppendableJoiner.Builder<StringBuilder>();\n        AppendableJoiner.Builder<StringBuilder> builderWithDelimiter = builder.setDelimiter(\"\");\n        AppendableJoiner<StringBuilder> joiner = builderWithDelimiter.get();\n        assertNotNull(joiner);\n    }\n\n    @Test(timeout = 4000)\n    public void test04_builderSetDelimiterWithCharSequence_returnsSameBuilderInstance() throws Throwable {\n        AppendableJoiner.Builder<Object> builder = AppendableJoiner.builder();\n        StringBuilder delimiter = new StringBuilder(457);\n        AppendableJoiner.Builder<Object> returned = builder.setDelimiter(delimiter);\n        assertSame(returned, builder);\n    }\n\n    @Test(timeout = 4000)\n    public void test05_builderSetSuffix_returnsNonNullBuilder() throws Throwable {\n        StringBuilder suffix = new StringBuilder();\n        AppendableJoiner.Builder<StringBuilder> builder = new AppendableJoiner.Builder<StringBuilder>();\n        AppendableJoiner.Builder<StringBuilder> returned = builder.setSuffix(suffix);\n        assertNotNull(returned);\n    }\n\n    @Test(timeout = 4000)\n    public void test06_builderSetElementAppenderThenGet_returnsNonNullJoiner() throws Throwable {\n        FailableBiConsumer<Appendable, StringBuilder, IOException> noopAppender = FailableBiConsumer.nop();\n        AppendableJoiner.Builder<StringBuilder> builder = AppendableJoiner.builder();\n        AppendableJoiner.Builder<StringBuilder> builderWithAppender = builder.setElementAppender(noopAppender);\n        AppendableJoiner<StringBuilder> joiner = builderWithAppender.get();\n        assertNotNull(joiner);\n    }\n\n    @Test(timeout = 4000)\n    public void test07_builderSetPrefix_returnsSameBuilderInstance() throws Throwable {\n        AppendableJoiner.Builder<Object> builder = AppendableJoiner.builder();\n        StringBuilder prefix = new StringBuilder(457);\n        AppendableJoiner.Builder<Object> returned = builder.setPrefix(prefix);\n        assertSame(returned, builder);\n    }\n\n    // --- Static joinI (Iterable) tests ---\n\n    @Test(timeout = 4000)\n    public void test01_joinI_withNullSuffixAndTwoElements_appendsNullSuffix() throws Throwable {\n        StringBuilder target = new StringBuilder(457);\n        FailableBiConsumer<Appendable, StringBuilder, IOException> noopTyped = FailableBiConsumer.nop();\n        FailableBiConsumer<Appendable, Object, IOException> noopAppender = FailableBiConsumer.nop();\n        // Set contains null and another object; nop appender writes nothing per element.\n        // Suffix is null, which Appendable.append(null) renders as \"null\".\n        LinkedHashSet<Object> elements = new LinkedHashSet<Object>();\n        elements.add((Object) null);\n        elements.add(noopTyped);\n        AppendableJoiner.joinI(target, (CharSequence) target, (CharSequence) null, (CharSequence) target, noopAppender, (Iterable<Object>) elements);\n        assertEquals(\"null\", target.toString());\n    }\n\n    @Test(timeout = 4000)\n    public void test02_joinI_withNullIterable_producesEmptyString() throws Throwable {\n        StringBuilder target = new StringBuilder();\n        FailableBiConsumer<Appendable, Object, IOException> noopAppender = FailableBiConsumer.nop();\n        StringBuilder result = AppendableJoiner.joinI(target, (CharSequence) target, (CharSequence) target, (CharSequence) target, noopAppender, (Iterable<Object>) null);\n        assertEquals(\"\", result.toString());\n    }\n\n    // --- Static joinSB (StringBuilder varargs) tests ---\n\n    @Test(timeout = 4000)\n    public void test03_joinSB_withEmptyArray_returnsSameStringBuilderInstance() throws Throwable {\n        StringBuilder target = new StringBuilder();\n        FailableBiConsumer<Appendable, Object, IOException> noopAppender = FailableBiConsumer.nop();\n        Object[] emptyElements = new Object[0];\n        StringBuilder result = AppendableJoiner.joinSB(target, (CharSequence) target, (CharSequence) target, (CharSequence) target, noopAppender, emptyElements);\n        assertSame(result, target);\n    }\n\n    @Test(timeout = 4000)\n    public void test11_joinSB_withNullElements_returnsSameStringBuilderInstance() throws Throwable {\n        StringBuilder target = new StringBuilder(\"\");\n        FailableBiConsumer<Appendable, StringBuilder, IOException> noopAppender = FailableBiConsumer.nop();\n        StringBuffer emptyPrefix = new StringBuffer(\"\");\n        StringBuffer emptySuffix = new StringBuffer(\"\");\n        StringBuilder[] elementsWithNulls = new StringBuilder[7];\n        StringBuilder result = AppendableJoiner.joinSB(target, (CharSequence) emptyPrefix, (CharSequence) target, (CharSequence) emptySuffix, noopAppender, elementsWithNulls);\n        assertSame(target, result);\n    }\n\n    // --- Instance join(Iterable) / join(array) tests ---\n\n    @Test(timeout = 4000)\n    public void test08_joinIterable_withEmptySet_producesEmptyString() throws Throwable {\n        AppendableJoiner.Builder<StringBuilder> builder = new AppendableJoiner.Builder<StringBuilder>();\n        AppendableJoiner<StringBuilder> joiner = builder.get();\n        StringBuilder target = new StringBuilder();\n        HashSet<StringBuilder> emptySet = new HashSet<StringBuilder>();\n        StringBuilder result = joiner.join(target, (Iterable<StringBuilder>) emptySet);\n        assertEquals(\"\", result.toString());\n    }\n\n    @Test(timeout = 4000)\n    public void test09_joinArray_withNullArray_producesEmptyString() throws Throwable {\n        AppendableJoiner.Builder<StringBuilder> builder = new AppendableJoiner.Builder<StringBuilder>();\n        AppendableJoiner<StringBuilder> joiner = builder.get();\n        StringBuilder target = new StringBuilder();\n        StringBuilder result = joiner.join(target, (StringBuilder[]) null);\n        assertEquals(\"\", result.toString());\n    }\n\n    // --- Instance joinA (Appendable) tests ---\n\n    @Test(timeout = 4000)\n    public void test10_joinA_withEmptyList_producesEmptyString() throws Throwable {\n        StringBuilder target = new StringBuilder();\n        ArrayList<StringBuilder> emptyList = new ArrayList<StringBuilder>();\n        AppendableJoiner.Builder<StringBuilder> builder = AppendableJoiner.builder();\n        AppendableJoiner<StringBuilder> joiner = builder.get();\n        StringBuilder result = joiner.joinA(target, (Iterable<StringBuilder>) emptyList);\n        assertEquals(\"\", result.toString());\n    }\n\n    @Test(timeout = 4000)\n    public void test12_joinA_withNullAppendable_throwsNullPointerException() throws Throwable {\n        StringBuilder[] emptyArray = new StringBuilder[0];\n        AppendableJoiner.Builder<Appendable> builder = AppendableJoiner.builder();\n        AppendableJoiner<Appendable> joiner = builder.get();\n        // Undeclared exception!\n        try {\n            joiner.joinA((StringBuilder) null, (Appendable[]) emptyArray);\n            fail(\"Expecting exception: NullPointerException\");\n        } catch (NullPointerException e) {\n            //\n            // no message in exception (getMessage() returned null)\n            //\n            verifyException(\"org.apache.commons.lang3.AppendableJoiner\", e);\n        }\n    }\n}\n",
