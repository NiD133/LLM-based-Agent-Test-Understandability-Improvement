sertEquals(1488.587F, result, 0.01F);\n  }\n\n  // --- three-argument double min/max ---\n\n  @Test(timeout = 4000)\n  public void test09_minThreeDoubles_twoNegativeOneZero_returnsNegative() throws Throwable {\n      // min(-1.0, -1.0, 0.0) => -1.0\n      double result = IEEE754rUtils.min((-1.0), (-1.0), 0.0);\n      assertEquals((-1.0), result, 0.01);\n  }\n\n  @Test(timeout = 4000)\n  public void test10_maxThreeDoubles_firstIsLargest_returnsFirst() throws Throwable {\n      // max(734.1, 331.69, 0.0) => 734.1\n      double result = IEEE754rUtils.max(734.1, 331.69049072265625, (double) 0.0F);\n      assertEquals(734.1, result, 0.01);\n  }\n\n  // --- constructor ---\n\n  @Test(timeout = 4000)\n  public void test12_constructor_instantiatesSuccessfully() throws Throwable {\n      IEEE754rUtils instance = new IEEE754rUtils();\n  }\n}\n",
