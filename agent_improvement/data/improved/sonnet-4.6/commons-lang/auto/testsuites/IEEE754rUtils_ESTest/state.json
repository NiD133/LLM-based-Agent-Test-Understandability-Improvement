  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 12:03:48 GMT 2026\n */\n\npackage org.apache.commons.lang3.math;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.lang3.math.IEEE754rUtils;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class IEEE754rUtils_ESTest extends IEEE754rUtils_ESTest_scaffolding {\n\n  // --- float array min ---\n\n  @Test(timeout = 4000)\n  public void test00_minFloatArray_allZeros_returnsZero() throws Throwable {\n      float[] allZeros = new float[3];\n      float result = IEEE754rUtils.min(allZeros);\n      assertEquals(0.0F, result, 0.01F);\n  }\n\n  @Test(timeout = 4000)\n  public void test01_minFloatArray_emptyArray_throwsIllegalArgument() throws Throwable {\n      float[] emptyArray = new float[0];\n      try {\n          IEEE754rUtils.min(emptyArray);\n          fail(\"Expecting exception: IllegalArgumentException\");\n      } catch (IllegalArgumentException e) {\n          verifyException(\"org.apache.commons.lang3.Validate\", e);\n      }\n  }\n\n  // --- double array min ---\n\n  @Test(timeout = 4000)\n  public void test02_minDoubleArray_allZeros_returnsZero() throws Throwable {\n      double[] allZeros = new double[2];\n      double result = IEEE754rUtils.min(allZeros);\n      assertEquals(0.0, result, 0.01);\n  }\n\n  @Test(timeout = 4000)\n  public void test03_minDoubleArray_emptyArray_throwsIllegalArgument() throws Throwable {\n      double[] emptyArray = new double[0];\n      try {\n          IEEE754rUtils.min(emptyArray);\n          fail(\"Expecting exception: IllegalArgumentException\");\n      } catch (IllegalArgumentException e) {\n          verify