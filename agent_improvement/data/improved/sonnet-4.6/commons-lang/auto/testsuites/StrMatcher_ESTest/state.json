ble {\n      StrMatcher matcher = StrMatcher.noneMatcher();\n      assertNotNull(matcher);\n  }\n\n  @Test(timeout = 4000)\n  public void test16_splitMatcher_returnsNonNull() throws Throwable {\n      StrMatcher matcher = StrMatcher.splitMatcher();\n      assertNotNull(matcher);\n  }\n\n  @Test(timeout = 4000)\n  public void test17_tabMatcher_returnsNonNull() throws Throwable {\n      StrMatcher matcher = StrMatcher.tabMatcher();\n      assertNotNull(matcher);\n  }\n\n  @Test(timeout = 4000)\n  public void test18_quoteMatcher_returnsNonNull() throws Throwable {\n      StrMatcher matcher = StrMatcher.quoteMatcher();\n      assertNotNull(matcher);\n  }\n\n  @Test(timeout = 4000)\n  public void test19_commaMatcher_returnsNonNull() throws Throwable {\n      StrMatcher matcher = StrMatcher.commaMatcher();\n      assertNotNull(matcher);\n  }\n\n  @Test(timeout = 4000)\n  public void test23_charSetMatcher_charArray_returnsNonNull() throws Throwable {\n      char[] chars = new char[1];\n      StrMatcher matcher = StrMatcher.charSetMatcher(chars);\n      assertNotNull(matcher);\n  }\n\n  // --- TrimMatcher tests ---\n\n  @Test(timeout = 4000)\n  public void test04_trimMatcher_isMatch_nullCharIsWhitespace_returnsOne() throws Throwable {\n      // '\u0000' (value 0) is <= 32, so TrimMatcher treats it as whitespace and returns 1\n      char[] buffer = new char[6];\n      StrMatcher.TrimMatcher trimMatcher = new StrMatcher.TrimMatcher();\n      int result = trimMatcher.isMatch(buffer, (int) '\u0000');\n      assertEquals(1, result);\n  }\n\n  @Test(timeout = 4000)\n  public void test20_trimMatcher_isMatch_printableChar_returnsZero() throws Throwable {\n      // 'D' has ASCII value 68, which is > 32, so TrimMatcher does not match it\n      StrMatcher trimMatcher = StrMatcher.trimMatcher();\n      char[] buffer = new char[5];\n      buffer[0] = 'D';\n      int result = trimMatcher.isMatch(buffer, 0, 0, 0);\n      assertEquals(0, result);\n  }\n\n  // --- StringMatcher tests ---\n\n  @Test(timeout = 4000)\n  public void test05_stringMatcher_isMatch_bufferMismatch_returnsZero() throws Throwable {\n      // Buffer has 'T' at index 1, but the pattern \"The type must not be null\" requires\n      // all subsequent characters to match — they don't, so isMatch returns 0\n      char[] buffer = new char[4];\n      buffer[1] = 'T';\n      StrMatcher.StringMatcher stringMatcher = new StrMatcher.StringMatcher(\"The type must not be null\");\n      int result = stringMatcher.isMatch(buffer, 1, 6, 365);\n      assertEquals(0, result);\n  }\n\n  @Test(timeout = 4000)\n  public void test06_stringMatcher_isMatch_emptyPattern_returnsZero() throws Throwable {\n      // An empty StringMatcher has no chars to match, so it returns 0\n      StrMatcher.StringMatcher emptyMatcher = new StrMatcher.StringMatcher(\"\");\n      char[] buffer = new char[1];\n      int result = emptyMatcher.isMatch(buffer, (-616), 4, (-616));\n      assertEquals(0, result);\n  }\n\n  @Test(timeout = 4000)\n  public void test22_stringMatcher_isMatch_positionBeyondBufferEnd_returnsZero() throws Throwable {\n      // pos + pattern.length (2860 + 1) > bufferEnd (2860), so no match is possible\n      StrMatcher.StringMatcher stringMatcher = new StrMatcher.StringMatcher(\"^\");\n      char[] buffer = new char[4];\n      int result = stringMatcher.isMatch(buffer, 2860, 0, 2860);\n      assertEquals(0, result);\n  }\n\n  @Test(timeout = 4000)\n  public void test21_stringMatcher_toString_returnsNonNull() throws Throwable {\n      StrMatcher.StringMatcher stringMatcher = new StrMatcher.StringMatcher(\"'\\\"\");\n      String str = stringMatcher.toString();\n      assertNotNull(str);\n  }\n\n  // --- CharSetMatcher tests ---\n\n  @Test(timeout = 4000)\n  public void test07_charSetMatcher_isMatch_charNotInSet_returnsZero() throws Throwable {\n      // buffer[0] is '\\0', which is not in the charset \"-%nVf!yZM0Csg>\"\n      char[] buffer = new char[6];\n      StrMatcher charSetMatcher = StrMatcher.ch