  "last_code": "package org.apache.commons.lang3.text.translate;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class NumericEntityUnescaper_ESTest_test4 extends NumericEntityUnescaper_ESTest_scaffolding {\n\n    /**\n     * Verifies that passing an empty options array to the constructor causes the unescaper to\n     * default to semiColonRequired mode. The input is \"&#x\" followed by seven null characters\n     * (the default value for a newly created char array). Null characters are not valid hex\n     * digits, and there is no trailing semicolon, so the entity is considered incomplete.\n     * As a result, translate() copies the entire input through unchanged.\n     */\n    @Test(timeout = 4000)\n    public void test4() throws Throwable {\n        // Passing zero options forces the constructor to use the semiColonRequired default.\n        NumericEntityUnescaper.OPTION[] noOptions = new NumericEntityUnescaper.OPTION[0];\n        NumericEntityUnescaper unescaper = new NumericEntityUnescaper(noOptions);\n\n        // The first three chars form the hex-entity prefix \"&#x\".\n        // The remaining seven positions keep their Java default value '\u0000' (null char).\n        // '\u0000' is not a valid hex digit, so the parser cannot extract an entity value.\n        // With semiColonRequired active and no ';' found, translate() returns 0 at every\n        // position and the input is returned verbatim.\n        char[] inputChars = new char[10];\n        inputChars[0] = '&';\n        inputChars[1] = '#';\n        inputChars[2] = 'x';\n        CharBuffer inputBuffer = CharBuffer.wrap(inputChars);\n\n        String result = unescaper.translate((CharSequence) inputBuffer);\n\n        assertEquals(\"&#x\u0000\u0000\u0000\u0000\u0000\u0000\u0000\", result);\n    }\n}\n",
