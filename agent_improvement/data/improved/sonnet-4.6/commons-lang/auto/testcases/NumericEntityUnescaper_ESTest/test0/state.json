  "last_code": "package org.apache.commons.lang3.text.translate;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class NumericEntityUnescaper_ESTest_test0 extends NumericEntityUnescaper_ESTest_scaffolding {\n\n    // Tests that a well-formed decimal numeric entity \"&#2;\" is translated to its\n    // corresponding Unicode code point (\u0002 / STX), and that trailing null\n    // characters in the buffer are passed through unchanged. When no options are\n    // supplied the constructor defaults to semiColonRequired, so the semicolon is\n    // consumed as part of the entity.\n    @Test(timeout = 4000)\n    public void test0() throws Throwable {\n        // No options provided: constructor defaults to semiColonRequired\n        NumericEntityUnescaper.OPTION[] noOptions = new NumericEntityUnescaper.OPTION[0];\n\n        // Build a 7-char buffer: \"&#2;\" at positions 0-3, then three null chars at 4-6\n        char[] inputChars = new char[7];\n        inputChars[0] = '&';\n        inputChars[1] = '#';\n        inputChars[2] = '2';  // decimal entity value 2\n        inputChars[3] = ';';  // semicolon terminator (required by the default option)\n        // inputChars[4], [5], [6] remain '\\0' (Java array default)\n        CharBuffer inputBuffer = CharBuffer.wrap(inputChars);\n\n        NumericEntityUnescaper unescaper = new NumericEntityUnescaper(noOptions);\n\n        // \"&#2;\" is translated to code point 2 (\u0002 = STX);\n        // the three trailing null chars (\u0000) are passed through unchanged\n        String result = unescaper.translate((CharSequence) inputBuffer);\n\n        assertEquals(\"\u0002\u0000\u0000\u0000\", result);\n    }\n}\n",
