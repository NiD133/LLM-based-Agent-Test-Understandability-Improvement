  "last_code": "package org.apache.commons.lang3.text.translate;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class NumericEntityUnescaper_ESTest_test1 extends NumericEntityUnescaper_ESTest_scaffolding {\n\n    /**\n     * Verifies that a hex numeric entity with no digit characters (\"&amp;#X;\") is left\n     * untranslated, because Integer.parseInt(\"\", 16) throws NumberFormatException\n     * and translate() returns 0 (nothing consumed).\n     *\n     * Input: CharBuffer wrapping ['&','#','X',';',NUL,NUL,NUL]\n     * The unescaper is constructed with no options, which internally defaults to\n     * OPTION.semiColonRequired. The entity has the required semicolon, but the\n     * digit portion between 'X' and ';' is empty, so parsing fails and the entire\n     * seven-character input is echoed back unchanged.\n     */\n    @Test(timeout = 4000)\n    public void test1_emptyHexEntityIsLeftUntranslated() throws Throwable {\n        // An empty options array causes the constructor to default to semiColonRequired\n        NumericEntityUnescaper.OPTION[] noOptions = new NumericEntityUnescaper.OPTION[0];\n        NumericEntityUnescaper unescaper = new NumericEntityUnescaper(noOptions);\n\n        // Build input \"&#X;\" followed by three NUL characters\n        char[] inputChars = new char[7];\n        inputChars[0] = '&';\n        inputChars[1] = '#';\n        inputChars[2] = 'X';   // hex entity marker, but no hex digits follow before the semicolon\n        inputChars[3] = ';';   // semicolon is present, but digit portion is empty\n        // inputChars[4..6] remain '\u0000' (NUL) — the default for a newly allocated char array\n        CharBuffer inputBuffer = CharBuffer.wrap(inputChars);\n\n        // Malformed entity: the digit portion is empty, so translation is skipped entirely\n        // and the full input \"&#X;\u0000\u0000\u0000\" is returned unchanged\n        String result = unescaper.translate((CharSequence) inputBuffer);\n\n        assertEquals(\"&#X;\u0000\u0000\u0000\", result);\n    }\n}\n",
