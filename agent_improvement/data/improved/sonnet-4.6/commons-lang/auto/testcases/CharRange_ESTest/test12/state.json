  "last_code": "package org.apache.commons.lang3;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class CharRange_ESTest_test12 extends CharRange_ESTest_scaffolding {\n\n    /**\n     * Verifies that a negated range (all chars NOT in ['T', '￿']) contains\n     * a single-character range ('J'), since 'J' lies below 'T' and is therefore\n     * included in the negated range.\n     */\n    @Test(timeout = 4000)\n    public void test12() throws Throwable {\n        // \"Not in [T, ￿]\" covers every character from '\u0000' up to 'S'\n        CharRange notInTtoMax = CharRange.isNotIn('T', '￿');\n\n        // Single-character range for 'J', which falls below 'T'\n        CharRange justJ = CharRange.is('J');\n\n        // 'J' is not in [T, ￿], so the negated range should contain it\n        boolean negatedRangeContainsJ = notInTtoMax.contains(justJ);\n        assertTrue(negatedRangeContainsJ);\n\n        // Verify the boundaries of the negated range\n        assertEquals('T', notInTtoMax.getStart());\n        assertEquals('￿', notInTtoMax.getEnd());\n\n        // Verify that the single-char range 'J' has matching start and end\n        assertEquals('J', justJ.getStart());\n        assertEquals('J', justJ.getEnd());\n    }\n}\n",
