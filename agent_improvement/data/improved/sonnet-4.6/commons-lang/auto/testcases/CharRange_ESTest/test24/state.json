  "last_code": "package org.apache.commons.lang3;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport java.util.function.Consumer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class CharRange_ESTest_test24 extends CharRange_ESTest_scaffolding {\n\n    // '\u0000' is the null character (Unicode code point 0, the very first character)\n    private static final char NULL_CHAR = '\u0000';\n    // 'ß' is the Latin small letter sharp S (ß, Unicode code point 223)\n    private static final char LATIN_SMALL_LETTER_SHARP_S = 'ß';\n\n    @Test(timeout = 4000)\n    public void test24() throws Throwable {\n        // Create a negated range from null ('\u0000') through sharp-S ('ß' = ß).\n        // A negated range represents every character EXCEPT the specified span, so this\n        // range covers all characters outside the [\u0000..ß] interval.\n        CharRange negatedRange = CharRange.isNotIn(NULL_CHAR, LATIN_SMALL_LETTER_SHARP_S);\n\n        // Verify that spliterator() can be called without throwing on a negated range\n        negatedRange.spliterator();\n\n        // The range must be flagged as negated and retain its original boundaries\n        assertTrue(negatedRange.isNegated());\n        assertEquals(NULL_CHAR, negatedRange.getStart());\n        assertEquals(LATIN_SMALL_LETTER_SHARP_S, negatedRange.getEnd());\n    }\n}\n",
