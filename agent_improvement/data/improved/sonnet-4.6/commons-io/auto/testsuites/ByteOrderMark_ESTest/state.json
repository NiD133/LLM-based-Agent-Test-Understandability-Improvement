  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 00:21:08 GMT 2026\n */\n\npackage org.apache.commons.io;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.io.ByteOrderMark;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class ByteOrderMark_ESTest extends ByteOrderMark_ESTest_scaffolding {\n\n    // -----------------------------------------------------------------------\n    // toString\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testToStringReturnsExpectedRepresentationForUTF16LE() throws Throwable {\n        int[] bytes = new int[8];\n        new ByteOrderMark(\"w-\", bytes);\n        String result = ByteOrderMark.UTF_16LE.toString();\n        assertEquals(\"ByteOrderMark[UTF-16LE: 0xFF,0xFE]\", result);\n    }\n\n    // -----------------------------------------------------------------------\n    // matches\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testMatchesReturnsFalseWhenFirstByteDoesNotMatch() throws Throwable {\n        ByteOrderMark utf32le = ByteOrderMark.UTF_32LE;\n        int[] allZeros = new int[7]; // UTF-32LE starts with 0xFF, so all-zero input won't match\n        boolean result = utf32le.matches(allZeros);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testMatchesReturnsTrueWhenPassedSameArrayReference() throws Throwable {\n        int[] bytes = new int[8];\n        ByteOrderMark bom = new ByteOrderMark(\"w-\", bytes);\n        // matches() short-circuits via reference identity; same array always matches\n        boolean result = bom.matches(bytes);\n        assertTrue(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testMatchesReturnsFalseForNullInput() throws Throwable {\n        ByteOrderMark utf32be = ByteOrderMark.UTF_32BE;\n        boolean result = utf32be.matches((int[]) null);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testMatchesReturnsTrueForOwnRawBytes() throws Throwable {\n        ByteOrderMark utf32be = ByteOrderMark.UTF_32BE;\n        int[] rawBytes = utf32be.getRawBytes();\n        boolean result = utf32be.matches(rawBytes);\n        assertTrue(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testMatchesReturnsFalseWhenInputIsShorterThanBom() throws Throwable {\n        ByteOrderMark utf16be = ByteOrderMark.UTF_16BE; // 2-byte BOM\n        int[] tooShort = new int[1];\n        boolean result = utf16be.matches(tooShort);\n        assertFalse(result);\n    }\n\n    // -----------------------------------------------------------------------\n    // hashCode\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testHashCodeDoesNotThrow() throws Throwable {\n        ByteOrderMark utf16be = ByteOrderMark.UTF_16BE;\n        utf16be.hashCode();\n    }\n\n    // -----------------------------------------------------------------------\n    // getBytes\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testGetBytesReturnsCorrectBytesForUTF32LE() throws Throwable {\n        ByteOrderMark utf32le = ByteOrderMark.UTF_32LE;\n        byte[] bytes = utf32le.getBytes();\n        assertArrayEquals(new byte[] {(byte) (-1), (byte) (-2), (byte) 0, (byte) 0}, bytes);\n    }\n\n    // -----------------------------------------------------------------------\n    // equals\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testEqualsReturnsFalseForDifferentEncodings() throws Throwable {\n        ByteOrderMark utf16be = ByteOrderMark.UTF_16BE;\n        ByteOrderMark utf16le = ByteOrderMark.UTF_16LE;\n        boolean result = utf16be.equals(utf16le);\n        assertFalse(result);\n        assertFalse(utf16le.equals((Object) utf16be));\n    }\n\n    @Test(timeout = 4000)\n    public void testEqualsReturnsFalseForDifferentBomLengths() throws Throwable {\n        ByteOrderMark utf16be = ByteOrderMark.UTF_16BE; // 2 bytes\n        ByteOrderMark utf32le = ByteOrderMark.UTF_32LE; // 4 bytes\n        boolean result = utf16be.equals(utf32le);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testEqualsReturnsFalseForNull() throws Throwable {\n        ByteOrderMark utf32le = ByteOrderMark.UTF_32LE;\n        boolean result = utf32le.equals((Object) null);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void testEqualsReturnsTrueForSameInstance() throws Throwable {\n        ByteOrderMark utf16le = ByteOrderMark.UTF_16LE;\n        boolean result = utf16le.equals(utf16le);\n        assertTrue(result);\n    }\n\n    // -----------------------------------------------------------------------\n    // constructor validation\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testConstructorThrowsIllegalArgumentExceptionForEmptyBytesArray() throws Throwable {\n        int[] emptyBytes = new int[0];\n        ByteOrderMark bom = null;\n        try {\n            bom = new ByteOrderMark(\"(\\\"09%p_HU|M5jy\", emptyBytes);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // No bytes specified\n            //\n            verifyException(\"org.apache.commons.io.ByteOrderMark\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void testConstructorThrowsIllegalArgumentExceptionForEmptyCharsetName() throws Throwable {\n        int[] bytes = new int[1];\n        ByteOrderMark bom = null;\n        try {\n            bom = new ByteOrderMark(\"\", bytes);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // No charsetName specified\n            //\n            verifyException(\"org.apache.commons.io.ByteOrderMark\", e);\n        }\n    }\n\n    // -----------------------------------------------------------------------\n    // getCharsetName\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void testGetCharsetNameReturnsExpectedNameForUTF16LE() throws Throwable {\n        ByteOrderMark utf16le = ByteOrderMark.UTF_16LE;\n        String charsetName = utf16le.getCharsetName();\n        assertEquals(\"UTF-16LE\", charsetName);\n    }\n}\n",
