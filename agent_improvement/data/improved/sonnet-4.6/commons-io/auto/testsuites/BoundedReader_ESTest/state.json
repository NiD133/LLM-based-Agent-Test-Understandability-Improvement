  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 00:56:50 GMT 2026\n */\n\npackage org.apache.commons.io.input;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport java.io.PipedReader;\nimport java.io.StringReader;\nimport org.apache.commons.io.input.BoundedReader;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class BoundedReader_ESTest extends BoundedReader_ESTest_scaffolding {\n\n    /**\n     * Verifies that read(char[], off, len) reads exactly 1 character when the bound is 1\n     * and 1 character is requested from a non-empty source.\n     */\n    @Test(timeout = 4000)\n    public void test0() throws Throwable {\n        char[] buffer = new char[14];\n        StringReader source = new StringReader(\"KnLjCdWGnB@(}p3qC\");\n        BoundedReader reader = new BoundedReader(source, 1);\n\n        int charsRead = reader.read(buffer, 1, 1);\n\n        assertEquals(1, charsRead);\n    }\n\n    /**\n     * Verifies that read() returns EOF after reset(), skip(), and mark() on an empty source:\n     * the underlying reader has no content, so reading after marking returns -1.\n     */\n    @Test(timeout = 4000)\n    public void test1() throws Throwable {\n        StringReader emptySource = new StringReader(\"\");\n        BoundedReader reader = new BoundedReader(emptySource, 511);\n        reader.reset();\n        reader.skip(511);\n        reader.mark(511);\n\n        int result = reader.read();\n\n        assertEquals(-1, result);\n    }\n\n    /**\n     * Verifies that read(char[], off, len) returns EOF immediately when the bound is\n     * negative, meaning no characters are permitted to be read.\n     */\n    @Test(timeout = 4000)\n    public void test2() throws Throwable {\n        PipedReader source = new PipedReader();\n        BoundedReader reader = new BoundedReader(source, -1);\n        char[] buffer = new char[14];\n\n        int result = reader.read(buffer, 1, 1);\n\n        assertEquals(-1, result);\n    }\n\n    /**\n     * Verifies that read() returns EOF when the read-ahead limit is exhausted:\n     * after skipping past all 4 characters in the source and marking with a limit of 1,\n     * reading one more character exceeds the read-ahead limit and returns -1.\n     */\n    @Test(timeout = 4000)\n    public void test3() throws Throwable {\n        StringReader source = new StringReader(\"@</'\");\n        BoundedReader reader = new BoundedReader(source, 481);\n        reader.reset();\n\n        long skippedChars = reader.skip(481);\n        assertEquals(4L, skippedChars);\n\n        reader.mark(1);\n        int result = reader.read();\n\n        assertEquals(-1, result);\n    }\n}\n",
