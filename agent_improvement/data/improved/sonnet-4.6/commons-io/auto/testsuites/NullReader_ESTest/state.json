  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 01:08:09 GMT 2026\n */\n\npackage org.apache.commons.io.input;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.io.EOFException;\nimport java.io.IOException;\nimport org.apache.commons.io.input.NullReader;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class NullReader_ESTest extends NullReader_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void skip_withZeroLength_returnsZeroAndMarkIsSupported() throws Throwable {\n      NullReader reader = new NullReader(1017L);\n      long skipped = reader.skip(0L);\n      assertTrue(reader.markSupported());\n      assertEquals(0L, skipped);\n  }\n\n  @Test(timeout = 4000)\n  public void skip_onNegativeSizeReader_clampsPositionToNegativeSize() throws Throwable {\n      NullReader reader = new NullReader((-827L));\n      long skipped = reader.skip(382L);\n      assertEquals((-827L), reader.getPosition());\n      assertEquals((-827L), skipped);\n  }\n\n  @Test(timeout = 4000)\n  public void reset_afterMarkWithNegativeReadLimit_throwsIOException() throws Throwable {\n      NullReader reader = new NullReader();\n      reader.mark((-2081));\n      try {\n        reader.reset();\n        fail(\"Expecting exception: IOException\");\n      } catch (IOException e) {\n         verifyException(\"org.apache.commons.io.input.NullReader\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void reset_whenMarkNotSupported_throwsUnsupportedOperationException() throws Throwable {\n      NullReader reader = new NullReader(0L, false, false);\n      try {\n        reader.reset();\n        fail(\"Expecting exception: UnsupportedOperationException\");\n      } catch (UnsupportedOperationException e) {\n         verifyException(\"org.apache.commons.io.input.UnsupportedOperationExceptions\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void reset_onFreshInstanceWithNoMarkSet_throwsIOException() throws Throwable {\n      NullReader reader = new NullReader();\n      try {\n        reader.INSTANCE.reset();\n        fail(\"Expecting exception: IOException\");\n      } catch (IOException e) {\n         verifyException(\"org.apache.commons.io.input.NullReader\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void readArray_withSufficientData_returnsCountAndUpdatesPosition() throws Throwable {\n      NullReader reader = new NullReader(1017L);\n      char[] buffer = new char[8];\n      int charsRead = reader.read(buffer);\n      assertEquals(8L, reader.getPosition());\n      assertEquals(8, charsRead);\n  }\n\n  @Test(timeout = 4000)\n  public void readArray_afterSkipPastEndOfFile_throwsIOException() throws Throwable {\n      NullReader reader = new NullReader();\n      char[] buffer = new char[3];\n      reader.skip(531L);\n      try {\n        reader.read(buffer);\n        fail(\"Expecting exception: IOException\");\n      } catch (IOException e) {\n         verifyException(\"org.apache.commons.io.input.NullReader\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void readArray_withEmptyBuffer_returnsZeroWithoutReachingEof() throws Throwable {\n      NullReader reader = new NullReader();\n      char[] emptyBuffer = new char[0];\n      int charsRead = reader.read(emptyBuffer);\n      assertEquals(0, charsRead);\n      assertTrue(reader.markSupported());\n  }\n\n  @Test(timeout = 4000)\n  public void read_afterEofMarked_throwsIOException() throws Throwable {\n      NullReader reader = new NullReader();\n      reader.read();\n      try {\n        reader.read();\n        fail(\"Expecting exception: IOException\");\n      } catch (IOException e) {\n         verifyException(\"org.apache.commons.io.input.NullReader\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void mark_whenMarkNotSupported_throwsUnsupportedOperationException() throws Throwable {\n      NullReader reader = new NullReader(2857L, false, false);\n      try {\n        reader.mark(3);\n        fail(\"Expecting exception: UnsupportedOperationException\");\n      } catch (UnsupportedOperationException e) {\n         verifyException(\"org.apache.commons.io.input.UnsupportedOperationExceptions\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void skip_atEndOfFileWithEofExceptionEnabled_throwsEOFException() throws Throwable {\n      NullReader reader = new NullReader((-2742L), true, true);\n      char[] buffer = new char[4];\n      reader.read(buffer);\n      try {\n        reader.skip((-2742));\n        fail(\"Expecting exception: EOFException\");\n      } catch (EOFException e) {\n         verifyException(\"org.apache.commons.io.input.NullReader\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void close_onSharedInstance_doesNotAffectSeparateReaderProperties() throws Throwable {\n      NullReader reader = new NullReader((-827L));\n      reader.INSTANCE.close();\n      assertTrue(reader.markSupported());\n      assertEquals((-827L), reader.getSize());\n  }\n\n  @Test(timeout = 4000)\n  public void skip_afterEofSet_throwsIOException() throws Throwable {\n      NullReader reader = new NullReader();\n      char[] buffer = new char[4];\n      reader.read(buffer);\n      try {\n        reader.skip(2147483640L);\n        fail(\"Expecting exception: IOException\");\n      } catch (IOException e) {\n         verifyException(\"org.apache.commons.io.input.NullReader\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void getSize_doesNotAffectMarkSupportedState() throws Throwable {\n      NullReader reader = new NullReader();\n      reader.getSize();\n      assertTrue(reader.markSupported());\n  }\n\n  @Test(timeout = 4000)\n  public void markSupported_byDefaultConfiguration_returnsTrue() throws Throwable {\n      NullReader reader = new NullReader((-827L));\n      boolean markSupported = reader.markSupported();\n      assertTrue(markSupported);\n      assertEquals((-827L), reader.getSize());\n  }\n\n  @Test(timeout = 4000)\n  public void getPosition_doesNotAffectSizeOrMarkSupportedState() throws Throwable {\n      NullReader reader = new NullReader((-827L));\n      reader.getPosition();\n      assertEquals((-827L), reader.getSize());\n      assertTrue(reader.markSupported());\n  }\n\n  @Test(timeout = 4000)\n  public void read_whenSizeIsNegative_returnsProcessedCharAndIncrementsPosition() throws Throwable {\n      NullReader reader = new NullReader((-1187L));\n      int charValue = reader.read();\n      assertEquals(1L, reader.getPosition());\n      assertEquals(0, charValue);\n  }\n}\n",
