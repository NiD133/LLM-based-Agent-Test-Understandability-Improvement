  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 03:36:31 GMT 2026\n */\n\npackage org.apache.commons.io.input;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.io.PipedReader;\nimport java.io.PipedWriter;\nimport java.io.Reader;\nimport java.io.StringReader;\nimport java.nio.charset.Charset;\nimport java.nio.charset.CharsetEncoder;\nimport org.apache.commons.io.input.ReaderInputStream;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class ReaderInputStream_ESTest extends ReaderInputStream_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void testCloseMarksStreamAsClosed() throws Throwable {\n      PipedWriter pipedWriter = new PipedWriter();\n      PipedReader pipedReader = new PipedReader(pipedWriter, 2);\n      ReaderInputStream stream = new ReaderInputStream(pipedReader);\n      stream.close();\n      assertTrue(stream.isClosed());\n  }\n\n  @Test(timeout = 4000)\n  public void testBuilderWithByteArrayProducesOpenStream() throws Throwable {\n      ReaderInputStream.Builder builder = ReaderInputStream.builder();\n      byte[] byteArray = new byte[4];\n      builder.setByteArray(byteArray);\n      ReaderInputStream stream = builder.get();\n      assertFalse(stream.isClosed());\n  }\n\n  @Test(timeout = 4000)\n  public void testReadSingleByteWithNullEncoderUsesDefaultEncoding() throws Throwable {\n      // '{' has ASCII value 123; null encoder falls back to default charset\n      StringReader reader = new StringReader(\"{/\");\n      ReaderInputStream stream = new ReaderInputStream(reader, (CharsetEncoder) null);\n      int byteRead = stream.read();\n      assertEquals(123, byteRead);\n  }\n\n  @Test(timeout = 4000)\n  public void testSkipReturnsActualBytesSkipped() throws Throwable {\n      // Reader has only 1 character; requesting a large skip returns only 1\n      StringReader reader = new StringReader(\"t\");\n      ReaderInputStream stream = new ReaderInputStream(reader);\n      long skipped = stream.skip(1884L);\n      assertEquals(1L, skipped);\n  }\n\n  @Test(timeout = 4000)\n  public void testSkipOnEmptyReaderReturnsZeroAndSubsequentReadReturnsEOF() throws Throwable {\n      StringReader emptyReader = new StringReader(\"\");\n      Charset defaultCharset = Charset.defaultCharset();\n      CharsetEncoder encoder = defaultCharset.newEncoder();\n      ReaderInputStream stream = new ReaderInputStream(emptyReader, encoder);\n      long skipped = stream.skip(727L);\n      assertEquals(0L, skipped);\n\n      int byteRead = stream.read();\n      assertEquals(-1, byteRead);\n  }\n\n  @Test(timeout = 4000)\n  public void testReadFillsBufferAndAvailableReturnsRemainingBytes() throws Throwable {\n      // 11-char string; reading 6 bytes leaves 5 buffered and available\n      StringReader reader = new StringReader(\"3t8FoIT,\\\",/\");\n      Charset defaultCharset = Charset.defaultCharset();\n      CharsetEncoder encoder = defaultCharset.newEncoder();\n      ReaderInputStream stream = new ReaderInputStream(reader, encoder);\n      byte[] buffer = new byte[6];\n      int bytesRead = stream.read(buffer);\n      assertEquals(6, bytesRead);\n\n      int available = stream.available();\n      assertEquals(5, available);\n  }\n\n  @Test(timeout = 4000)\n  public void testConstructorRejectsBufferSizeTooSmallForEncoder() throws Throwable {\n      Charset defaultCharset = Charset.defaultCharset();\n      ReaderInputStream stream = null;\n      try {\n          stream = new ReaderInputStream((Reader) null, defaultCharset, -4369);\n          fail(\"Expecting exception: IllegalArgumentException\");\n      } catch (IllegalArgumentException e) {\n          //\n          // Buffer size -4,369 must be at least 6.0 for a CharsetEncoder UTF-8.\n          //\n          verifyException(\"org.apache.commons.io.input.ReaderInputStream\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void testSetCharsetOnBuilderPreservesDefaultBufferSize() throws Throwable {\n      ReaderInputStream.Builder builder = new ReaderInputStream.Builder();\n      Charset defaultCharset = Charset.defaultCharset();\n      ReaderInputStream.Builder updatedBuilder = builder.setCharset(defaultCharset);\n      assertEquals(8192, updatedBuilder.getBufferSize());\n  }\n\n  @Test(timeout = 4000)\n  public void testDefaultBuilderHasUTF8CharsetEncoder() throws Throwable {\n      // UTF-8 requires at most 3 bytes per character in this encoder\n      ReaderInputStream.Builder builder = new ReaderInputStream.Builder();\n      CharsetEncoder encoder = builder.getCharsetEncoder();\n      assertEquals(3.0F, encoder.maxBytesPerChar(), 0.01F);\n  }\n\n  @Test(timeout = 4000)\n  public void testGetCharsetEncoderReturnsConfiguredEncoder() throws Throwable {\n      Charset defaultCharset = Charset.defaultCharset();\n      PipedReader pipedReader = new PipedReader(3144);\n      ReaderInputStream stream = new ReaderInputStream(pipedReader, defaultCharset);\n      CharsetEncoder encoder = stream.getCharsetEncoder();\n      assertEquals(3.0F, encoder.maxBytesPerChar(), 0.01F);\n  }\n\n  @Test(timeout = 4000)\n  public void testAvailableReturnsZeroBeforeAnyRead() throws Throwable {\n      StringReader reader = new StringReader(\"3t8FoIT,\\\",/\");\n      Charset defaultCharset = Charset.defaultCharset();\n      CharsetEncoder encoder = defaultCharset.newEncoder();\n      ReaderInputStream stream = new ReaderInputStream(reader, encoder);\n      int available = stream.available();\n      assertEquals(0, available);\n  }\n\n  @Test(timeout = 4000)\n  public void testSetCharsetEncoderOnBuilderPreservesDefaultBufferSize() throws Throwable {\n      ReaderInputStream.Builder builder = ReaderInputStream.builder();\n      Charset defaultCharset = Charset.defaultCharset();\n      CharsetEncoder encoder = defaultCharset.newEncoder();\n      ReaderInputStream.Builder updatedBuilder = builder.setCharsetEncoder(encoder);\n      assertEquals(8192, updatedBuilder.getBufferSize());\n  }\n\n  @Test(timeout = 4000)\n  public void testConstructorWithNullCharsetNameUsesDefaultAndStreamIsOpen() throws Throwable {\n      PipedReader pipedReader = new PipedReader();\n      ReaderInputStream stream = new ReaderInputStream(pipedReader, (String) null);\n      assertFalse(stream.isClosed());\n  }\n\n  @Test(timeout = 4000)\n  public void testReadIntoEmptyByteArrayReturnsZero() throws Throwable {\n      PipedReader pipedReader = new PipedReader();\n      ReaderInputStream stream = new ReaderInputStream(pipedReader);\n      byte[] emptyBuffer = new byte[0];\n      int bytesRead = stream.read(emptyBuffer);\n      assertEquals(0, bytesRead);\n  }\n}\n",
