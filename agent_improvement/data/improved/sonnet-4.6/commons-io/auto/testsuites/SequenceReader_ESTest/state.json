  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 01:45:48 GMT 2026\n */\n\npackage org.apache.commons.io.input;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.io.PipedReader;\nimport java.io.Reader;\nimport java.io.StringReader;\nimport java.nio.CharBuffer;\nimport java.nio.ReadOnlyBufferException;\nimport java.util.LinkedHashSet;\nimport org.apache.commons.io.input.SequenceReader;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class SequenceReader_ESTest extends SequenceReader_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void testReadIntoCharBuffer_readsFirstCharFromSingleReader() throws Throwable {\n      LinkedHashSet<StringReader> readers = new LinkedHashSet<StringReader>();\n      StringReader stringReader = new StringReader(\"org.apache.commons.io.filefilter.AgeFileFilter\");\n      readers.add(stringReader);\n      SequenceReader sequenceReader = new SequenceReader(readers);\n\n      char[] buffer = new char[1];\n      CharBuffer charBuffer = CharBuffer.wrap(buffer);\n      int charsRead = sequenceReader.read(charBuffer);\n\n      assertArrayEquals(new char[] {'o'}, buffer);\n      assertEquals(1, charsRead);\n  }\n\n  @Test(timeout = 4000)\n  public void testReadIntoCharBuffer_returnsZeroWhenBufferHasNoRemainingCapacity() throws Throwable {\n      LinkedHashSet<StringReader> readers = new LinkedHashSet<StringReader>();\n      SequenceReader sequenceReader = new SequenceReader(readers);\n\n      char[] buffer = new char[1];\n      CharBuffer charBuffer = CharBuffer.wrap(buffer);\n      charBuffer.flip(); // sets limit=position=0, leaving no room to write\n\n      int charsRead = sequenceReader.read(charBuffer);\n\n      assertEquals(0, charsRead);\n  }\n\n  @Test(timeout = 4000)\n  public void testReadSingleChar_returnsEOFWhenReaderIsEmpty() throws Throwable {\n      StringReader emptyReader = new StringReader(\"\");\n      LinkedHashSet<StringReader> readers = new LinkedHashSet<StringReader>();\n      readers.add(emptyReader);\n      SequenceReader sequenceReader = new SequenceReader(readers);\n\n      int result = sequenceReader.read();\n\n      assertEquals(-1, result);\n  }\n\n  @Test(timeout = 4000)\n  public void testReadIntoCharBuffer_throwsReadOnlyBufferExceptionForReadOnlyBuffer() throws Throwable {\n      LinkedHashSet<StringReader> readers = new LinkedHashSet<StringReader>();\n      StringReader stringReader = new StringReader(\"org.apache.commons.io.filefilter.AgeFileFilter\");\n      readers.add(stringReader);\n      SequenceReader sequenceReader = new SequenceReader(readers);\n      sequenceReader.read(); // advance past the first character\n\n      // CharBuffer.wrap(CharSequence) produces a read-only StringCharBuffer\n      CharBuffer readOnlyBuffer = CharBuffer.wrap((CharSequence) \"org.apache.commons.io.filefilter.AgeFileFilter\");\n      try {\n          sequenceReader.read(readOnlyBuffer);\n          fail(\"Expecting exception: ReadOnlyBufferException\");\n      } catch (ReadOnlyBufferException e) {\n          verifyException(\"java.nio.StringCharBuffer\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void testClose_succeedsWhenSomeReadersInArrayAreNull() throws Throwable {\n      Reader[] readerArray = new Reader[4];\n      PipedReader pipedReader = new PipedReader(3262);\n      readerArray[1] = pipedReader; // only index 1 is non-null; the rest are null\n\n      SequenceReader sequenceReader = new SequenceReader(readerArray);\n      sequenceReader.close();\n  }\n\n  @Test(timeout = 4000)\n  public void testSkip_returnsZeroWhenNoReadersArePresent() throws Throwable {\n      Reader[] emptyReaderArray = new Reader[0];\n      SequenceReader sequenceReader = new SequenceReader(emptyReaderArray);\n\n      long skipped = sequenceReader.skip(161L);\n\n      assertEquals(0L, skipped);\n  }\n}\n",
