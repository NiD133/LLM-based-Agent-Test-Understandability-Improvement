  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 00:34:16 GMT 2026\n */\n\npackage org.apache.commons.io.file.attribute;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.file.Path;\nimport java.nio.file.attribute.FileTime;\nimport java.util.Date;\nimport java.util.concurrent.TimeUnit;\nimport org.apache.commons.io.file.attribute.FileTimes;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.mock.java.util.MockDate;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class FileTimes_ESTest extends FileTimes_ESTest_scaffolding {\n\n    // The offset (in 100-nanosecond intervals) between the NTFS epoch (1601-01-01)\n    // and the Unix epoch (1970-01-01). Also used as Java milliseconds to create\n    // extreme boundary dates in MockDate.\n    private static final long NTFS_TO_UNIX_EPOCH_OFFSET = -116444736000000000L;\n\n    // An NTFS time value 3 hundred-nanosecond intervals before the NTFS epoch\n    private static final long NTFS_TIME_BEFORE_NTFS_EPOCH = -116444736000000003L;\n\n    @Test(timeout = 4000)\n    public void toUnixTime_nullFileTime_returnsZero() throws Throwable {\n        long result = FileTimes.toUnixTime((FileTime) null);\n        assertEquals(0L, result);\n    }\n\n    @Test(timeout = 4000)\n    public void toNtfsTime_javaMilliseconds_returnsExpectedNtfsTime() throws Throwable {\n        long ntfsTime = FileTimes.toNtfsTime(286L);\n        assertEquals(116444736002860000L, ntfsTime);\n    }\n\n    @Test(timeout = 4000)\n    public void toNtfsTime_dateAtNtfsEpochBoundary_returnsLongMinValue() throws Throwable {\n        MockDate dateAtNtfsEpochBoundary = new MockDate(NTFS_TO_UNIX_EPOCH_OFFSET);\n        long ntfsTime = FileTimes.toNtfsTime((Date) dateAtNtfsEpochBoundary);\n        assertEquals(Long.MIN_VALUE, ntfsTime);\n    }\n\n    @Test(timeout = 4000)\n    public void toFileTime_nullDate_returnsNull() throws Throwable {\n        FileTime result = FileTimes.toFileTime((Date) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void toDate_roundTripViaFileTime_preservesExtremeDateValue() throws Throwable {\n        MockDate extremeDate = new MockDate(NTFS_TO_UNIX_EPOCH_OFFSET);\n        FileTime fileTime = FileTimes.toFileTime(extremeDate);\n        Date recoveredDate = FileTimes.toDate(fileTime);\n        assertEquals(\"Sat Dec 12 00:00:00 GMT 3687943\", recoveredDate.toString());\n    }\n\n    @Test(timeout = 4000)\n    public void toDate_nullFileTime_returnsNull() throws Throwable {\n        Date result = FileTimes.toDate((FileTime) null);\n        assertNull(result);\n    }\n\n    @Test(timeout = 4000)\n    public void isUnixTime_secondsValueExceedsIntMax_returnsFalse() throws Throwable {\n        boolean result = FileTimes.isUnixTime(116444736000000000L);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void isUnixTime_negativeOneSecond_returnsTrue() throws Throwable {\n        boolean result = FileTimes.isUnixTime(-1L);\n        assertTrue(result);\n    }\n\n    @Test(timeout = 4000)\n    public void isUnixTime_fileTimeAtNtfsEpochBoundary_returnsFalse() throws Throwable {\n        MockDate extremeDate = new MockDate(NTFS_TO_UNIX_EPOCH_OFFSET);\n        FileTime extremeFileTime = FileTimes.toFileTime(extremeDate);\n        boolean result = FileTimes.isUnixTime(extremeFileTime);\n        assertFalse(result);\n    }\n\n    @Test(timeout = 4000)\n    public void plusNanos_addingNegativeNanos_producesDistinctFileTime() throws Throwable {\n        FileTime baseTime = FileTimes.ntfsTimeToFileTime(-3078L);\n        FileTime adjustedTime = FileTimes.plusNanos(baseTime, NTFS_TO_UNIX_EPOCH_OFFSET);\n        assertFalse(adjustedTime.equals((Object) baseTime));\n    }\n\n    @Test(timeout = 4000)\n    public void plusSeconds_addingPositiveSeconds_producesDistinctFileTime() throws Throwable {\n        MockDate extremeDate = new MockDate(NTFS_TO_UNIX_EPOCH_OFFSET);\n        FileTime baseTime = FileTimes.toFileTime(extremeDate);\n        FileTime adjustedTime = FileTimes.plusSeconds(baseTime, 172L);\n        assertFalse(adjustedTime.equals((Object) baseTime));\n    }\n\n    @Test(timeout = 4000)\n    public void minusMillis_subtractingNegativeMillis_producesDistinctFileTime() throws Throwable {\n        FileTime baseTime = FileTimes.fromUnixTime(-2021L);\n        FileTime adjustedTime = FileTimes.minusMillis(baseTime, -2021L);\n        assertFalse(adjustedTime.equals((Object) baseTime));\n    }\n\n    @Test(timeout = 4000)\n    public void ntfsTimeToDate_ntfsTimeBeforeNtfsEpoch_returnsExpectedDate() throws Throwable {\n        Date result = FileTimes.ntfsTimeToDate(NTFS_TIME_BEFORE_NTFS_EPOCH);\n        assertEquals(\"Thu Dec 25 23:59:59 GMT 1231\", result.toString());\n    }\n\n    @Test(timeout = 4000)\n    public void plusMillis_addingLargeMilliseconds_producesDistinctFileTime() throws Throwable {\n        FileTime baseTime = FileTime.fromMillis(2147483647L);\n        FileTime adjustedTime = FileTimes.plusMillis(baseTime, 2147483647L);\n        assertFalse(adjustedTime.equals((Object) baseTime));\n    }\n\n    @Test(timeout = 4000)\n    public void toNtfsTime_fileTimeInNanoseconds_returnsExpectedNtfsTime() throws Throwable {\n        FileTime fileTime = FileTime.from(1070L, TimeUnit.NANOSECONDS);\n        long ntfsTime = FileTimes.toNtfsTime(fileTime);\n        assertEquals(116444736000000010L, ntfsTime);\n    }\n\n    @Test(timeout = 4000)\n    public void minusSeconds_subtractingZeroSeconds_returnsEqualFileTime() throws Throwable {\n        FileTime now = FileTimes.now();\n        FileTime result = FileTimes.minusSeconds(now, 0L);\n        assertTrue(result.equals((Object) now));\n    }\n\n    @Test(timeout = 4000)\n    public void minusNanos_subtractingNegativeNanos_producesDistinctFileTime() throws Throwable {\n        FileTime baseTime = FileTimes.fromUnixTime(-2021L);\n        FileTime adjustedTime = FileTimes.minusNanos(baseTime, -2021L);\n        assertFalse(adjustedTime.equals((Object) baseTime));\n    }\n\n    @Test(timeout = 4000)\n    public void setLastModifiedTime_nullPath_throwsNullPointerException() throws Throwable {\n        try {\n            FileTimes.setLastModifiedTime((Path) null);\n            fail(\"Expecting exception: NullPointerException\");\n        } catch (NullPointerException e) {\n            verifyException(\"java.nio.file.Files\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void toNtfsTime_dateWithExtremeFieldValues_returnsLongMaxValue() throws Throwable {\n        MockDate dateWithExtremeFields = new MockDate(\n                (-2147483646), (-2147483646), (-2147483646),\n                (-2147483646), (-2147483646), (-2147483646));\n        long ntfsTime = FileTimes.toNtfsTime((Date) dateWithExtremeFields);\n        assertEquals(Long.MAX_VALUE, ntfsTime);\n    }\n}\n",
