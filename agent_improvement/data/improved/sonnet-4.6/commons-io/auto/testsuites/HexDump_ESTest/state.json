  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 00:52:12 GMT 2026\n */\n\npackage org.apache.commons.io;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.io.ByteArrayOutputStream;\nimport java.io.File;\nimport java.io.OutputStream;\nimport java.io.PipedWriter;\nimport org.apache.commons.io.HexDump;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.mock.java.io.MockFile;\nimport org.evosuite.runtime.mock.java.io.MockFileWriter;\nimport org.evosuite.runtime.mock.java.io.MockPrintWriter;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class HexDump_ESTest extends HexDump_ESTest_scaffolding {\n\n    // Expected hex dump for a 17-byte array where byte[5] = 0x7F (DEL, non-printable → shown as '.')\n    private static final String EXPECTED_DUMP_NONPRINTABLE_AT_INDEX5 =\n            \"00000000 00 00 00 00 00 7F 00 00 00 00 00 00 00 00 00 00 ................\\n\" +\n            \"00000010 00                                              .\\n\";\n\n    // Expected hex dump for a 17-byte array where byte[0] = 0x48 ('H', printable ASCII)\n    private static final String EXPECTED_DUMP_ASCII_H_AT_INDEX0 =\n            \"00000000 48 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 H...............\\n\" +\n            \"00000010 00                                              .\\n\";\n\n    @Test(timeout = 4000)\n    public void dump_toOutputStream_withNonPrintableByteAtIndex5_producesCorrectHexOutput() throws Throwable {\n        byte[] data = new byte[17];\n        data[5] = (byte) 127; // 0x7F = DEL (non-printable, rendered as '.' in ASCII column)\n        ByteArrayOutputStream outputStream = new ByteArrayOutputStream();\n\n        HexDump.dump(data, 0L, (OutputStream) outputStream, 0);\n\n        assertEquals(133, outputStream.size());\n        assertEquals(EXPECTED_DUMP_NONPRINTABLE_AT_INDEX5, outputStream.toString());\n    }\n\n    @Test(timeout = 4000)\n    public void dump_toOutputStream_withPrintableAsciiByteAtIndex0_producesCorrectHexOutput() throws Throwable {\n        byte[] data = new byte[17];\n        data[0] = (byte) 72; // 0x48 = 'H' (printable ASCII, shown in ASCII column)\n        ByteArrayOutputStream outputStream = new ByteArrayOutputStream();\n\n        HexDump.dump(data, 0L, (OutputStream) outputStream, 0);\n\n        assertEquals(EXPECTED_DUMP_ASCII_H_AT_INDEX0, outputStream.toString());\n        assertEquals(133, outputStream.size());\n    }\n\n    @Test(timeout = 4000)\n    public void dump_toAppendable_whenStartIndexPlusLengthExceedsArrayLength_throwsArrayIndexOutOfBounds() throws Throwable {\n        byte[] data = new byte[9];\n        PipedWriter writer = new PipedWriter();\n\n        try {\n            HexDump.dump(data, 0L, (Appendable) writer, (int) (byte) 8, (int) (byte) 101);\n            fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n        } catch (ArrayIndexOutOfBoundsException e) {\n            // Range [8, 8 + 101) out of bounds for length 9\n            verifyException(\"org.apache.commons.io.HexDump\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void dump_toAppendable_whenLengthIsNegative_throwsArrayIndexOutOfBounds() throws Throwable {\n        byte[] data = new byte[9];\n        PipedWriter writer = new PipedWriter();\n\n        try {\n            HexDump.dump(data, 1L, (Appendable) writer, 0, (-186));\n            fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n        } catch (ArrayIndexOutOfBoundsException e) {\n            // Range [0, 0 + -186) out of bounds for length 9\n            verifyException(\"org.apache.commons.io.HexDump\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void dump_toAppendable_whenStartIndexExceedsArrayLength_throwsArrayIndexOutOfBounds() throws Throwable {\n        byte[] data = new byte[17];\n        MockFile mockFile = new MockFile(\"org.apache.commons.io.filefilter.CanExecuteFileFilter\", \"org.apache.commons.io.filefilter.CanExecuteFileFilter\");\n        MockFileWriter fileWriter = new MockFileWriter(mockFile, true);\n\n        try {\n            HexDump.dump(data, (long) (byte) 127, (Appendable) fileWriter, (int) (byte) 127, (-3384));\n            fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n        } catch (ArrayIndexOutOfBoundsException e) {\n            // illegal index: 127 into array of length 17\n            verifyException(\"org.apache.commons.io.HexDump\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void dump_toOutputStream_whenIndexIsNegative_throwsArrayIndexOutOfBounds() throws Throwable {\n        byte[] data = new byte[9];\n        ByteArrayOutputStream outputStream = new ByteArrayOutputStream();\n\n        try {\n            HexDump.dump(data, (long) (byte) 0, (OutputStream) outputStream, (int) (byte) (-1));\n            fail(\"Expecting exception: ArrayIndexOutOfBoundsException\");\n        } catch (ArrayIndexOutOfBoundsException e) {\n            // illegal index: -1 into array of length 9\n            verifyException(\"org.apache.commons.io.HexDump\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void constructor_canBeInstantiated() throws Throwable {\n        HexDump hexDump = new HexDump();\n    }\n\n    @Test(timeout = 4000)\n    public void dump_toAppendable_withAllZeroBytes_doesNotModifyInputArray() throws Throwable {\n        byte[] data = new byte[6];\n        File tempFile = MockFile.createTempFile(\"file\", \"file\");\n        MockPrintWriter printWriter = new MockPrintWriter(tempFile);\n\n        HexDump.dump(data, (Appendable) printWriter);\n\n        assertArrayEquals(new byte[] {(byte) 0, (byte) 0, (byte) 0, (byte) 0, (byte) 0, (byte) 0}, data);\n    }\n}\n",
