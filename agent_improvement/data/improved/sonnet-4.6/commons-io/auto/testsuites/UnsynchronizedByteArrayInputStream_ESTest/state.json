  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 02:44:31 GMT 2026\n */\n\npackage org.apache.commons.io.input;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.io.input.UnsynchronizedByteArrayInputStream;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class UnsynchronizedByteArrayInputStream_ESTest extends UnsynchronizedByteArrayInputStream_ESTest_scaffolding {\n\n    // -----------------------------------------------------------------------\n    // Builder API\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void builderWithByteArrayReportsCorrectAvailable() throws Throwable {\n        byte[] data = new byte[5];\n        UnsynchronizedByteArrayInputStream stream = UnsynchronizedByteArrayInputStream.builder()\n                .setByteArray(data)\n                .get();\n        assertEquals(5, stream.available());\n    }\n\n    @Test(timeout = 4000)\n    public void builderSetOffsetReturnsSameBuilderInstance() throws Throwable {\n        UnsynchronizedByteArrayInputStream.Builder builder = UnsynchronizedByteArrayInputStream.builder();\n        UnsynchronizedByteArrayInputStream.Builder returned = builder.setOffset(1092);\n        assertSame(returned, builder);\n    }\n\n    @Test(timeout = 4000)\n    public void builderSetOffsetWithNegativeValueThrows() throws Throwable {\n        UnsynchronizedByteArrayInputStream.Builder builder = UnsynchronizedByteArrayInputStream.builder();\n        // Undeclared exception!\n        try {\n            builder.setOffset(-2645);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // offset cannot be negative\n            //\n            verifyException(\"org.apache.commons.io.input.UnsynchronizedByteArrayInputStream$Builder\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void builderSetLengthReturnsSameBuilderInstance() throws Throwable {\n        UnsynchronizedByteArrayInputStream.Builder builder = new UnsynchronizedByteArrayInputStream.Builder();\n        UnsynchronizedByteArrayInputStream.Builder returned = builder.setLength(653);\n        assertSame(returned, builder);\n    }\n\n    @Test(timeout = 4000)\n    public void builderSetLengthWithNegativeValueThrows() throws Throwable {\n        UnsynchronizedByteArrayInputStream.Builder builder = UnsynchronizedByteArrayInputStream.builder();\n        // Undeclared exception!\n        try {\n            builder.setLength(-2645);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // length cannot be negative\n            //\n            verifyException(\"org.apache.commons.io.input.UnsynchronizedByteArrayInputStream$Builder\", e);\n        }\n    }\n\n    // -----------------------------------------------------------------------\n    // Constructor validation\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void constructorWithNegativeOffsetThrows() throws Throwable {\n        byte[] data = new byte[1];\n        UnsynchronizedByteArrayInputStream stream = null;\n        try {\n            stream = new UnsynchronizedByteArrayInputStream(data, -9, -9);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // offset cannot be negative\n            //\n            verifyException(\"org.apache.commons.io.input.UnsynchronizedByteArrayInputStream\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void constructorWithOffsetPastArrayEndReportsZeroAvailable() throws Throwable {\n        byte[] data = new byte[0];\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 1);\n        assertEquals(0, stream.available());\n    }\n\n    // -----------------------------------------------------------------------\n    // available()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void availableReturnsRemainingBytesWithinWindow() throws Throwable {\n        byte[] data = new byte[2];\n        // offset=1, length=1 within a 2-byte array => 1 byte available\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 1, 1);\n        int available = stream.available();\n        assertEquals(1, available);\n    }\n\n    @Test(timeout = 4000)\n    public void availableReturnsZeroWhenOffsetEqualsArrayLength() throws Throwable {\n        byte[] data = new byte[1];\n        // offset=1 equals data.length; stream is immediately exhausted\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 1, 1);\n        int available = stream.available();\n        assertEquals(0, available);\n    }\n\n    // -----------------------------------------------------------------------\n    // read()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void readSingleByteReturnsValueAndDecrementsAvailable() throws Throwable {\n        byte[] data = new byte[3];\n        // offset=1, length=1 => one byte left to read\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 1, 1);\n        int byteRead = stream.read();\n        assertEquals(0, stream.available());\n        assertEquals(0, byteRead);\n    }\n\n    @Test(timeout = 4000)\n    public void readSingleByteOnExhaustedStreamReturnsEof() throws Throwable {\n        byte[] data = new byte[1];\n        // offset=1 equals data.length, so nothing left to read\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 1, 1);\n        assertEquals(0, stream.available());\n        int byteRead = stream.read();\n        assertEquals(-1, byteRead);\n    }\n\n    @Test(timeout = 4000)\n    public void readIntoSmallerBufferReadsPartialDataAndUpdatesAvailable() throws Throwable {\n        byte[] data = new byte[2];\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data);\n        byte[] dest = new byte[1];\n        int bytesRead = stream.read(dest);\n        assertEquals(1, stream.available());\n        assertEquals(1, bytesRead);\n    }\n\n    @Test(timeout = 4000)\n    public void readIntoSameSizeBufferDrainsStream() throws Throwable {\n        byte[] data = new byte[2];\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data);\n        int bytesRead = stream.read(data);\n        assertEquals(0, stream.available());\n        assertEquals(2, bytesRead);\n    }\n\n    @Test(timeout = 4000)\n    public void readIntoBufferFromExhaustedStreamReturnsEof() throws Throwable {\n        byte[] data = new byte[8];\n        // offset 358 exceeds array length (8), so stream is immediately exhausted\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 358);\n        assertEquals(0, stream.available());\n        int bytesRead = stream.read(data);\n        assertEquals(-1, bytesRead);\n    }\n\n    @Test(timeout = 4000)\n    public void readZeroBytesReturnsZeroWithoutAdvancingPosition() throws Throwable {\n        byte[] data = new byte[2];\n        // offset=20 exceeds array length (2), so stream is exhausted\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, (byte) 20);\n        int bytesRead = stream.read(data, (int) (byte) 0, 0);\n        assertEquals(0, stream.available());\n        assertEquals(0, bytesRead);\n    }\n\n    // -----------------------------------------------------------------------\n    // skip()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void skipZeroReturnsZeroAndLeavesPositionUnchanged() throws Throwable {\n        byte[] data = new byte[6];\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data);\n        long skipped = stream.skip(0L);\n        assertEquals(0L, skipped);\n        assertEquals(6, stream.available());\n    }\n\n    @Test(timeout = 4000)\n    public void skipNegativeThrowsIllegalArgumentException() throws Throwable {\n        byte[] data = new byte[6];\n        // offset 304 exceeds array length (6), so stream is exhausted\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 304);\n        // Undeclared exception!\n        try {\n            stream.skip(-1634L);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // Skipping backward is not supported\n            //\n            verifyException(\"org.apache.commons.io.input.UnsynchronizedByteArrayInputStream\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void skipBeyondEndOfExhaustedStreamReturnsZeroSkipped() throws Throwable {\n        byte[] data = new byte[2];\n        // offset=20 exceeds array length (2), so no bytes remain to skip\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, (byte) 20);\n        long skipped = stream.skip((byte) 20);\n        assertEquals(0, stream.available());\n        assertEquals(0L, skipped);\n    }\n\n    // -----------------------------------------------------------------------\n    // mark / reset / markSupported\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void markSupportedReturnsTrue() throws Throwable {\n        byte[] data = new byte[2];\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data);\n        boolean supported = stream.markSupported();\n        assertEquals(2, stream.available());\n        assertTrue(supported);\n    }\n\n    @Test(timeout = 4000)\n    public void markRecordsCurrentPositionForReset() throws Throwable {\n        byte[] data = new byte[8];\n        // offset 358 exceeds array length (8), so stream is exhausted\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data, 358);\n        stream.mark(-1429);\n        assertEquals(0, stream.available());\n    }\n\n    @Test(timeout = 4000)\n    public void resetRestoresStreamToInitialPosition() throws Throwable {\n        byte[] data = new byte[2];\n        UnsynchronizedByteArrayInputStream stream = new UnsynchronizedByteArrayInputStream(data);\n        stream.reset();\n        assertEquals(2, stream.available());\n    }\n}\n",
