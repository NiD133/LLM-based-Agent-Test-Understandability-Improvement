  "last_code": "package org.apache.commons.io.input;\n\nimport static org.junit.jupiter.api.Assertions.assertThrows;\nimport static org.junit.jupiter.api.Assertions.fail;\n\nimport java.io.IOException;\n\nimport org.junit.jupiter.api.Test;\n\npublic class UnsynchronizedByteArrayInputStreamTest_testInvalidReadArrayNull {\n\n    /**\n     * Creates a stream backed by the given buffer, failing the test if construction throws unexpectedly.\n     */\n    private UnsynchronizedByteArrayInputStream newStream(final byte[] buffer) {\n        try {\n            return UnsynchronizedByteArrayInputStream.builder().setByteArray(buffer).get();\n        } catch (final IOException e) {\n            fail(\"Should never happen because no conversion is needed.\", e);\n            return null;\n        }\n    }\n\n    /**\n     * Verifies that passing a null destination array to read(byte[]) throws NullPointerException.\n     */\n    @Test\n    void testInvalidReadArrayNull() {\n        final byte[] nullDestinationBuffer = null;\n\n        // not necessary to close these resources\n        @SuppressWarnings(\"resource\")\n        final UnsynchronizedByteArrayInputStream stream = newStream(new byte[] { (byte) 0xa, (byte) 0xb, (byte) 0xc });\n\n        assertThrows(NullPointerException.class, () -> stream.read(nullDestinationBuffer));\n    }\n}\n",
