  "last_code": "package org.apache.commons.io.input;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\nimport java.io.IOException;\nimport java.io.Reader;\nimport java.io.StringReader;\n\nimport org.junit.jupiter.api.Test;\n\npublic class SequenceReaderTest_testReadLength1Readers {\n\n    /**\n     * Verifies that SequenceReader reads characters in order from multiple\n     * single-character readers, transparently crossing reader boundaries.\n     */\n    @Test\n    void testReadLength1Readers() throws IOException {\n        try (Reader reader = new SequenceReader(\n                new StringReader(\"0\"),\n                new StringReader(\"1\"),\n                new StringReader(\"2\"),\n                new StringReader(\"3\"))) {\n            assertEquals('0', reader.read());\n            assertEquals('1', reader.read());\n            assertEquals('2', reader.read());\n            assertEquals('3', reader.read());\n        }\n    }\n}\n",
