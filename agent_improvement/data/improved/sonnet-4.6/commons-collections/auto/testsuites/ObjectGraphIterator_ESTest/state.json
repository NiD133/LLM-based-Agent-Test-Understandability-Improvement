  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 05:40:46 GMT 2026\n */\n\npackage org.apache.commons.collections4.iterators;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.Iterator;\nimport java.util.LinkedList;\nimport java.util.ListIterator;\nimport java.util.NoSuchElementException;\nimport org.apache.commons.collections4.Predicate;\nimport org.apache.commons.collections4.Transformer;\nimport org.apache.commons.collections4.functors.ConstantTransformer;\nimport org.apache.commons.collections4.functors.IdentityPredicate;\nimport org.apache.commons.collections4.functors.NotNullPredicate;\nimport org.apache.commons.collections4.functors.PredicateTransformer;\nimport org.apache.commons.collections4.iterators.ObjectGraphIterator;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class ObjectGraphIterator_ESTest extends ObjectGraphIterator_ESTest_scaffolding {\n\n  /**\n   * Verifies that remove() succeeds after next() when the iterator is backed\n   * by a mutable ListIterator that supports removal.\n   */\n  @Test(timeout = 4000)\n  public void testRemoveAfterNext_whenBackedByMutableListIterator_succeeds() throws Throwable {\n      // Build a single-element list containing Boolean.FALSE via IdentityPredicate evaluation\n      LinkedList<Object> list = new LinkedList<Object>();\n      Object referenceObject = new Object();\n      IdentityPredicate<Object> identityPredicate = new IdentityPredicate<Object>(referenceObject);\n      PredicateTransformer<Transformer<Boolean, Boolean>> predicateTransformer =\n              new PredicateTransformer<Transformer<Boolean, Boolean>>(identityPredicate);\n      // Evaluating the identity predicate against null returns false (null != referenceObject)\n      Boolean falseValue = predicateTransformer.transform((Transformer<Boolean, Boolean>) null);\n      list.add((Object) falseValue);\n\n      ListIterator<Object> listIterator = list.listIterator();\n      ObjectGraphIterator<Object> graphIterator = new ObjectGraphIterator<Object>(listIterator);\n\n      graphIterator.next();\n      // remove() should delegate to the backing ListIterator without throwing\n      graphIterator.remove();\n  }\n\n  /**\n   * Verifies that findNextByIterator() can be called with a sibling\n   * ObjectGraphIterator that has a null transformer, without throwing.\n   */\n  @Test(timeout = 4000)\n  public void testFindNextByIterator_withNullTransformer_doesNotThrow() throws Throwable {\n      Integer rootValue = new Integer(2928);\n      ObjectGraphIterator<Object> outerIterator =\n              new ObjectGraphIterator<Object>(rootValue, (Transformer<? super Object, ?>) null);\n      ObjectGraphIterator<Integer> innerIterator =\n              new ObjectGraphIterator<Integer>(rootValue, (Transformer<? super Integer, ? extends Integer>) null);\n\n      outerIterator.findNextByIterator(innerIterator);\n  }\n\n  /**\n   * Verifies that remove() throws IllegalStateException when the inner iterator\n   * (an ObjectGraphIterator) did not have next() called on it directly, so its\n   * lastUsedIterator is null and it cannot honour the remove() call.\n   */\n  @Test(timeout = 4000)\n  public void testRemove_throwsIllegalState_whenInnerIteratorHasNoLastUsedIterator() throws Throwable {\n      Integer rootValue = new Integer(414);\n      // ConstantTransformer always returns the same value (rootValue) regardless of input\n      Transformer<Object, Integer> constantTransformer = ConstantTransformer.constantTransformer(rootValue);\n      ObjectGraphIterator<Integer> innerIterator =\n              new ObjectGraphIterator<Integer>(rootValue, constantTransformer);\n      // outerIterator treats innerIterator as its root iterator\n      ObjectGraphIterator<Integer> outerIterator = new ObjectGraphIterator<Integer>(innerIterator);\n\n      outerIterator.next();\n      // Undeclared exception!\n      try {\n          outerIterator.remove();\n          fail(\"Expecting exception: IllegalStateException\");\n      } catch (IllegalStateException e) {\n          //\n          // Iterator remove() cannot be called at this time\n          //\n          verifyException(\"org.apache.commons.collections4.iterators.ObjectGraphIterator\", e);\n      }\n  }\n\n  /**\n   * Verifies that next() throws NoSuchElementException when the underlying\n   * iterator is empty and there are no elements to return.\n   */\n  @Test(timeout = 4000)\n  public void testNext_throwsNoSuchElement_onEmptyIterator() throws Throwable {\n      LinkedList<Object> emptyList = new LinkedList<Object>();\n      Iterator<Object> emptyIterator = emptyList.iterator();\n      ObjectGraphIterator<Object> graphIterator = new ObjectGraphIterator<Object>(emptyIterator);\n\n      // Undeclared exception!\n      try {\n          graphIterator.next();\n          fail(\"Expecting exception: NoSuchElementException\");\n      } catch (NoSuchElementException e) {\n          //\n          // No more elements in the iteration\n          //\n          verifyException(\"org.apache.commons.collections4.iterators.ObjectGraphIterator\", e);\n      }\n  }\n\n  /**\n   * Verifies that findNextByIterator() on a sibling ObjectGraphIterator with the\n   * same root and transformer does not mutate the original iterator reference.\n   */\n  @Test(timeout = 4000)\n  public void testFindNextByIterator_withSiblingIterator_doesNotMutateOriginalReference() throws Throwable {\n      Integer rootValue = new Integer(419);\n      Transformer<Object, Integer> constantTransformer = ConstantTransformer.constantTransformer(rootValue);\n      ObjectGraphIterator<Integer> firstIterator =\n              new ObjectGraphIterator<Integer>(rootValue, constantTransformer);\n      ObjectGraphIterator<Integer> secondIterator =\n              new ObjectGraphIterator<Integer>(rootValue, constantTransformer);\n\n      firstIterator.findNextByIterator(secondIterator);\n      assertNotSame(secondIterator, firstIterator);\n  }\n\n  /**\n   * Verifies that calling findNext() on the inner iterator before wrapping it in\n   * an outer iterator still allows the outer iterator's next() to return the correct value.\n   */\n  @Test(timeout = 4000)\n  public void testNext_returnsCorrectValue_afterManualFindNextOnInnerIterator() throws Throwable {\n      Integer rootValue = new Integer(419);\n      Transformer<Object, Integer> constantTransformer = ConstantTransformer.constantTransformer(rootValue);\n      ObjectGraphIterator<Integer> innerIterator =\n              new ObjectGraphIterator<Integer>(rootValue, constantTransformer);\n      ObjectGraphIterator<Integer> outerIterator = new ObjectGraphIterator<Integer>(innerIterator);\n\n      // Manually prime the inner iterator's \"next found\" state\n      innerIterator.findNext(rootValue);\n\n      Integer result = outerIterator.next();\n      assertEquals(419, (int) result);\n  }\n\n  /**\n   * Verifies that findNextByIterator() with a null-rooted iterator (one constructed\n   * with a null root) does not throw an exception.\n   */\n  @Test(timeout = 4000)\n  public void testFindNextByIterator_withNullRootedIterator_doesNotThrow() throws Throwable {\n      Integer rootValue = new Integer(414);\n      Transformer<Object, Integer> constantTransformer = ConstantTransformer.constantTransformer(rootValue);\n      ObjectGraphIterator<Integer> outerIterator =\n              new ObjectGraphIterator<Integer>(rootValue, constantTransformer);\n      ObjectGraphIterator<Integer> wrappingIterator = new ObjectGraphIterator<Integer>(outerIterator);\n      // nullRootedIterator has no elements since its root is null\n      ObjectGraphIterator<Integer> nullRootedIterator =\n              new ObjectGraphIterator<Integer>((Integer) null, constantTransformer);\n\n      wrappingIterator.findNextByIterator(nullRootedIterator);\n      assertNotSame(nullRootedIterator, outerIterator);\n  }\n\n  /**\n   * Verifies that findNext() called with an Iterator argument causes the iterator\n   * to recurse into that argument via findNextByIterator().\n   */\n  @Test(timeout = 4000)\n  public void testFindNext_withIteratorArgument_recursesIntoIt() throws Throwable {\n      Predicate<Object> notNullPredicate = NotNullPredicate.notNullPredicate();\n      PredicateTransformer<Transformer<Boolean, Boolean>> predicateTransformer =\n              new PredicateTransformer<Transformer<Boolean, Boolean>>(notNullPredicate);\n      // constantTransformer always returns null; used as both test input and graph transformer\n      ConstantTransformer<Boolean, Boolean> nullConstantTransformer =\n              new ConstantTransformer<Boolean, Boolean>((Boolean) null);\n      // Evaluating notNullPredicate on a non-null transformer returns true\n      Boolean trueValue = predicateTransformer.transform(nullConstantTransformer);\n\n      ObjectGraphIterator<Boolean> innerIterator =\n              new ObjectGraphIterator<Boolean>(trueValue, nullConstantTransformer);\n      ObjectGraphIterator<Object> outerIterator = new ObjectGraphIterator<Object>(innerIterator);\n\n      // Passing an Iterator to findNext() should trigger traversal of that iterator\n      outerIterator.findNext(innerIterator);\n  }\n\n  /**\n   * Verifies that constructing an ObjectGraphIterator whose root is another\n   * ObjectGraphIterator with a null transformer does not throw.\n   */\n  @Test(timeout = 4000)\n  public void testConstruction_withObjectGraphIteratorRootAndNullTransformer_doesNotThrow() throws Throwable {\n      Integer rootValue = new Integer(0);\n      ObjectGraphIterator<Integer> innerIterator =\n              new ObjectGraphIterator<Integer>(rootValue, (Transformer<? super Integer, ? extends Integer>) null);\n      // outerIterator wraps innerIterator as its root, also with a null transformer\n      ObjectGraphIterator<Object> outerIterator =\n              new ObjectGraphIterator<Object>(innerIterator, (Transformer<? super Object, ?>) null);\n  }\n}\n",
