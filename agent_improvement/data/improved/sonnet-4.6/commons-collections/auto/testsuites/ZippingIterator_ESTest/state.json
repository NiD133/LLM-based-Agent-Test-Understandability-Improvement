  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 05:47:25 GMT 2026\n */\n\npackage org.apache.commons.collections4.iterators;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.lang.reflect.Array;\nimport java.util.Iterator;\nimport java.util.LinkedList;\nimport java.util.NoSuchElementException;\nimport org.apache.commons.collections4.Closure;\nimport org.apache.commons.collections4.Predicate;\nimport org.apache.commons.collections4.functors.ChainedClosure;\nimport org.apache.commons.collections4.functors.IfClosure;\nimport org.apache.commons.collections4.functors.InstanceofPredicate;\nimport org.apache.commons.collections4.functors.OnePredicate;\nimport org.apache.commons.collections4.iterators.ZippingIterator;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class ZippingIterator_ESTest extends ZippingIterator_ESTest_scaffolding {\n\n    /**\n     * Verifies that ZippingIterator can be constructed with three iterators\n     * without throwing any exceptions.\n     */\n    @Test(timeout = 4000)\n    public void test_constructWithThreeEmptyIterators_doesNotThrow() throws Throwable {\n        LinkedList<InstanceofPredicate> emptyList = new LinkedList<InstanceofPredicate>();\n        Iterator<InstanceofPredicate> iterator = emptyList.iterator();\n        ZippingIterator<InstanceofPredicate> zippingIterator = new ZippingIterator<InstanceofPredicate>(iterator, iterator, iterator);\n    }\n\n    /**\n     * Verifies that calling remove() before any element has been returned via next()\n     * throws IllegalStateException with message \"No value can be removed at present\".\n     */\n    @Test(timeout = 4000)\n    public void test_removeWithoutPriorNext_throwsIllegalStateException() throws Throwable {\n        LinkedList<Object> emptyList = new LinkedList<Object>();\n        Iterator<Object> iterator = emptyList.descendingIterator();\n        ZippingIterator<Object> zippingIterator = new ZippingIterator<Object>(iterator, iterator);\n\n        // Undeclared exception!\n        try {\n            zippingIterator.remove();\n            fail(\"Expecting exception: IllegalStateException\");\n        } catch (IllegalStateException e) {\n            //\n            // No value can be removed at present\n            //\n            verifyException(\"org.apache.commons.collections4.iterators.ZippingIterator\", e);\n        }\n    }\n\n    /**\n     * Verifies that remove() succeeds after forEachRemaining() has consumed the last element.\n     * forEachRemaining() internally calls next(), which sets the last-returned iterator,\n     * making a subsequent remove() valid.\n     *\n     * The closure passed to forEachRemaining is effectively a no-op: OnePredicate with an empty\n     * predicate array always evaluates to false, so the IfClosure never executes its body.\n     */\n    @Test(timeout = 4000)\n    public void test_removeAfterForEachRemaining_succeeds() throws Throwable {\n        LinkedList<Object> singleElementList = new LinkedList<Object>();\n        singleElementList.add(new Object());\n        Iterator<Object> iterator = singleElementList.descendingIterator();\n        ZippingIterator<Object> zippingIterator = new ZippingIterator<Object>(iterator, iterator);\n\n        // Build a no-op closure: OnePredicate with empty array always returns false,\n        // so IfClosure never executes the chained (empty) closure body.\n        Predicate<Object>[] emptyPredicates = (Predicate<Object>[]) Array.newInstance(Predicate.class, 0);\n        OnePredicate<Object> neverTruePredicate = new OnePredicate<Object>(emptyPredicates);\n        Closure<Object>[] emptyClosures = (Closure<Object>[]) Array.newInstance(Closure.class, 0);\n        Closure<Object> noOpClosure = ChainedClosure.chainedClosure((Closure<? super Object>[]) emptyClosures);\n        IfClosure<Object> conditionalNoOpClosure = new IfClosure<Object>(neverTruePredicate, noOpClosure);\n\n        // Consume the single element; internally calls next(), setting lastReturned\n        zippingIterator.forEachRemaining(conditionalNoOpClosure);\n\n        // remove() is now valid because lastReturned is set from the forEachRemaining call\n        zippingIterator.remove();\n    }\n\n    /**\n     * Verifies that calling next() on a ZippingIterator wrapping only empty iterators\n     * throws NoSuchElementException.\n     */\n    @Test(timeout = 4000)\n    public void test_nextOnEmptyZippingIterator_throwsNoSuchElementException() throws Throwable {\n        LinkedList<InstanceofPredicate> emptyList = new LinkedList<InstanceofPredicate>();\n        Iterator<InstanceofPredicate> iterator = emptyList.iterator();\n        ZippingIterator<InstanceofPredicate> zippingIterator = new ZippingIterator<InstanceofPredicate>(iterator, iterator);\n\n        try {\n            zippingIterator.next();\n            fail(\"Expecting exception: NoSuchElementException\");\n        } catch (NoSuchElementException e) {\n            //\n            // no message in exception (getMessage() returned null)\n            //\n            verifyException(\"org.apache.commons.collections4.iterators.ZippingIterator\", e);\n        }\n    }\n}\n",
