  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 05:22:35 GMT 2026\n */\n\npackage org.apache.commons.collections4.iterators;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.Iterator;\nimport java.util.LinkedList;\nimport java.util.NoSuchElementException;\nimport org.apache.commons.collections4.Transformer;\nimport org.apache.commons.collections4.functors.TransformerClosure;\nimport org.apache.commons.collections4.iterators.BoundedIterator;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class BoundedIterator_ESTest extends BoundedIterator_ESTest_scaffolding {\n\n  /**\n   * Calling remove() before any call to next() should throw IllegalStateException.\n   */\n  @Test(timeout = 4000)\n  public void testRemoveWithoutNextThrowsIllegalStateException()  throws Throwable  {\n      LinkedList<Integer> emptyList = new LinkedList<Integer>();\n      Iterator<Integer> iterator = emptyList.iterator();\n      BoundedIterator<Integer> boundedIterator = new BoundedIterator<Integer>(iterator, 0L, 1357L);\n      // Undeclared exception!\n      try {\n        boundedIterator.remove();\n        fail(\"Expecting exception: IllegalStateException\");\n\n      } catch(IllegalStateException e) {\n         //\n         // remove() cannot be called before calling next()\n         //\n         verifyException(\"org.apache.commons.collections4.iterators.BoundedIterator\", e);\n      }\n  }\n\n  /**\n   * Calling remove() after next() should succeed and remove the last returned element.\n   */\n  @Test(timeout = 4000)\n  public void testRemoveAfterNextSucceeds()  throws Throwable  {\n      LinkedList<Integer> list = new LinkedList<Integer>();\n      Integer element = new Integer(0);\n      list.add(element);\n      Iterator<Integer> iterator = list.iterator();\n      BoundedIterator<Integer> boundedIterator = new BoundedIterator<Integer>(iterator, 0L, 3226L);\n      boundedIterator.next();\n      boundedIterator.remove();\n  }\n\n  /**\n   * Calling next() on a BoundedIterator with max=0 means no elements are permitted,\n   * so NoSuchElementException should be thrown immediately.\n   */\n  @Test(timeout = 4000)\n  public void testNextOnZeroMaxBoundThrowsNoSuchElementException()  throws Throwable  {\n      LinkedList<Integer> emptyList = new LinkedList<Integer>();\n      Iterator<Integer> iterator = emptyList.iterator();\n      BoundedIterator<Integer> boundedIterator = new BoundedIterator<Integer>(iterator, 0L, 0L);\n      // Undeclared exception!\n      try {\n        boundedIterator.next();\n        fail(\"Expecting exception: NoSuchElementException\");\n\n      } catch(NoSuchElementException e) {\n         //\n         // no message in exception (getMessage() returned null)\n         //\n         verifyException(\"org.apache.commons.collections4.iterators.BoundedIterator\", e);\n      }\n  }\n\n  /**\n   * Constructing a BoundedIterator with a large offset against an iterator that returns\n   * false for hasNext() should complete without error (the init loop simply does not advance).\n   */\n  @Test(timeout = 4000)\n  public void testConstructionWithLargeOffsetOnExhaustedIteratorSucceeds()  throws Throwable  {\n      Iterator<Object> exhaustedIterator = (Iterator<Object>) mock(Iterator.class, new ViolatedAssumptionAnswer());\n      doReturn(false).when(exhaustedIterator).hasNext();\n      BoundedIterator<Object> boundedIterator = new BoundedIterator<Object>(exhaustedIterator, 1357L, 1357L);\n  }\n\n  /**\n   * forEachRemaining() on a BoundedIterator whose offset exceeds the list size\n   * should complete without calling the consumer (no elements are in range).\n   */\n  @Test(timeout = 4000)\n  public void testForEachRemainingOnOutOfBoundsBoundedIteratorDoesNothing()  throws Throwable  {\n      LinkedList<Object> emptyList = new LinkedList<Object>();\n      Iterator<Object> iterator = emptyList.iterator();\n      BoundedIterator<Object> boundedIterator = new BoundedIterator<Object>(iterator, 4124L, 4124L);\n      TransformerClosure<Object> noOpClosure = new TransformerClosure<Object>((Transformer<? super Object, ?>) null);\n      boundedIterator.forEachRemaining(noOpClosure);\n  }\n\n  /**\n   * hasNext() should return false immediately when max=0, regardless of underlying iterator contents.\n   */\n  @Test(timeout = 4000)\n  public void testHasNextReturnsFalseWhenMaxIsZero()  throws Throwable  {\n      LinkedList<Integer> emptyList = new LinkedList<Integer>();\n      Iterator<Integer> iterator = emptyList.iterator();\n      BoundedIterator<Integer> boundedIterator = new BoundedIterator<Integer>(iterator, 0L, 0L);\n      boolean hasNext = boundedIterator.hasNext();\n      assertFalse(hasNext);\n  }\n\n  /**\n   * Constructing a BoundedIterator with a negative max parameter should throw\n   * IllegalArgumentException with a message indicating max must not be negative.\n   */\n  @Test(timeout = 4000)\n  public void testConstructorWithNegativeMaxThrowsIllegalArgumentException()  throws Throwable  {\n      LinkedList<Object> list = new LinkedList<Object>();\n      Iterator<Object> iterator = list.descendingIterator();\n      BoundedIterator<Object> boundedIterator = null;\n      try {\n        boundedIterator = new BoundedIterator<Object>(iterator, 0L, (-1162L));\n        fail(\"Expecting exception: IllegalArgumentException\");\n\n      } catch(IllegalArgumentException e) {\n         //\n         // Max parameter must not be negative.\n         //\n         verifyException(\"org.apache.commons.collections4.iterators.BoundedIterator\", e);\n      }\n  }\n\n  /**\n   * Constructing a BoundedIterator with a negative offset parameter should throw\n   * IllegalArgumentException with a message indicating offset must not be negative.\n   * (The null iterator argument is irrelevant because the offset check fires first.)\n   */\n  @Test(timeout = 4000)\n  public void testConstructorWithNegativeOffsetThrowsIllegalArgumentException()  throws Throwable  {\n      BoundedIterator<Object> boundedIterator = null;\n      try {\n        boundedIterator = new BoundedIterator<Object>((Iterator<? extends Object>) null, (-963L), (-963L));\n        fail(\"Expecting exception: IllegalArgumentException\");\n\n      } catch(IllegalArgumentException e) {\n         //\n         // Offset parameter must not be negative.\n         //\n         verifyException(\"org.apache.commons.collections4.iterators.BoundedIterator\", e);\n      }\n  }\n}\n",
