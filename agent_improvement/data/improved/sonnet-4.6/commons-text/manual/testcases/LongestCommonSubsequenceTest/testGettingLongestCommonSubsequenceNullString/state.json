  "last_code": "package org.apache.commons.text.similarity;\n\nimport static org.junit.jupiter.api.Assertions.assertThrows;\nimport org.junit.jupiter.api.BeforeAll;\nimport org.junit.jupiter.api.DisplayName;\nimport org.junit.jupiter.api.Test;\n\npublic class LongestCommonSubsequenceTest_testGettingLongestCommonSubsequenceNullString {\n\n    private static LongestCommonSubsequence subject;\n\n    @BeforeAll\n    public static void setup() {\n        subject = new LongestCommonSubsequence();\n    }\n\n    @Test\n    @DisplayName(\"longestCommonSubsequence throws IllegalArgumentException when the left (first) argument is null\")\n    void testGettingLongestCommonSubsequenceNullString() {\n        final String nullLeft = null;\n        assertThrows(IllegalArgumentException.class, () -> subject.longestCommonSubsequence(nullLeft, \"right\"));\n    }\n}\n",
