  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 22:45:47 GMT 2026\n */\n\npackage org.apache.commons.text.similarity;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.apache.commons.text.similarity.JaroWinklerSimilarity;\nimport org.apache.commons.text.similarity.SimilarityInput;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class JaroWinklerSimilarity_ESTest extends JaroWinklerSimilarity_ESTest_scaffolding {\n\n  /**\n   * Tests that a 2-character sequence (null chars) compared against a 6-character sequence\n   * (null chars) yields a partial similarity of approximately 0.822. The sequences share\n   * matching characters but differ in length, resulting in a Jaro-Winkler score below 1.0.\n   */\n  @Test(timeout = 4000)\n  public void test0()  throws Throwable  {\n      char[] sixNullChars = new char[6];\n      JaroWinklerSimilarity similarity = JaroWinklerSimilarity.INSTANCE;\n      CharBuffer twoNullChars = CharBuffer.allocate(2);\n      CharBuffer sixNullCharsBuffer = CharBuffer.wrap(sixNullChars);\n      Double result = similarity.apply((CharSequence) twoNullChars, (CharSequence) sixNullCharsBuffer);\n      assertEquals(0.8222222222222222, (double)result, 0.01);\n  }\n\n  /**\n   * Tests that an empty CharSequence compared against a 2-character sequence yields\n   * similarity 0.0. An empty sequence shares no matched characters with any non-empty\n   * sequence, so the Jaro-Winkler score is 0.\n   */\n  @Test(timeout = 4000)\n  public void test1()  throws Throwable  {\n      JaroWinklerSimilarity similarity = JaroWinklerSimilarity.INSTANCE;\n      CharBuffer twoNullChars = CharBuffer.allocate(2);\n      // Wrapping from position 2 to 2 produces an empty CharBuffer\n      CharBuffer emptyBuffer = CharBuffer.wrap((CharSequence) twoNullChars, 2, 2);\n      Double result = similarity.apply((CharSequence) emptyBuffer, (CharSequence) twoNullChars);\n      assertEquals(0.0, (double)result, 0.01);\n  }\n\n  /**\n   * Tests similarity between an 8-character sequence (null chars) and a much longer\n   * 1772-character sequence (null chars). The large length difference reduces the score\n   * to approximately 0.668, showing that length disparity lowers Jaro-Winkler similarity.\n   */\n  @Test(timeout = 4000)\n  public void test2()  throws Throwable  {\n      char[] eightNullChars = new char[8];\n      CharBuffer shortBuffer = CharBuffer.wrap(eightNullChars);\n      JaroWinklerSimilarity similarity = JaroWinklerSimilarity.INSTANCE;\n      CharBuffer longBuffer = CharBuffer.allocate(1772);\n      Double result = similarity.apply((CharSequence) longBuffer, (CharSequence) shortBuffer);\n      assertEquals(0.6681715575620767, (double)result, 0.01);\n  }\n\n  /**\n   * Tests that passing null for both inputs throws an IllegalArgumentException.\n   * The JaroWinklerSimilarity algorithm requires non-null inputs and rejects nulls\n   * with a descriptive error message.\n   */\n  @Test(timeout = 4000)\n  public void test3()  throws Throwable  {\n      JaroWinklerSimilarity similarity = JaroWinklerSimilarity.INSTANCE;\n      // Undeclared exception!\n      try {\n        similarity.apply((SimilarityInput<Object>) null, (SimilarityInput<Object>) null);\n        fail(\"Expecting exception: IllegalArgumentException\");\n\n      } catch(IllegalArgumentException e) {\n         //\n         // CharSequences must not be null\n         //\n         verifyException(\"org.apache.commons.text.similarity.JaroWinklerSimilarity\", e);\n      }\n  }\n\n  /**\n   * Tests the matches() helper with two arrays where each has exactly one 'f' at\n   * different positions. The shorter (6-char) array has 'f' at index 3 and the longer\n   * (8-char) array has 'f' at index 1. The result [6, 2, 1] encodes:\n   * matches=6 (5 null-char matches + 1 'f' match), halfTranspositions=2, prefix=1.\n   */\n  @Test(timeout = 4000)\n  public void test4()  throws Throwable  {\n      char[] eightCharsWithFAtIndex1 = new char[8];\n      eightCharsWithFAtIndex1[1] = 'f';\n      CharBuffer longerBuffer = CharBuffer.wrap(eightCharsWithFAtIndex1);\n      char[] sixCharsWithFAtIndex3 = new char[6];\n      sixCharsWithFAtIndex3[3] = 'f';\n      CharBuffer shorterBuffer = CharBuffer.wrap(sixCharsWithFAtIndex3);\n      int[] matchesResult = JaroWinklerSimilarity.matches(shorterBuffer, longerBuffer);\n      assertArrayEquals(new int[] {6, 2, 1}, matchesResult);\n  }\n\n  /**\n   * Tests that matches() returns [0, 0, 0] when one buffer has been partially overwritten\n   * with content that has no remaining characters to compare. After calling put(\"X19l5(mgJ\")\n   * on charBuffer0, its position advances, leaving no readable characters for matching\n   * against the freshly-wrapped charBuffer1.\n   */\n  @Test(timeout = 4000)\n  public void test5()  throws Throwable  {\n      char[] sharedArray = new char[12];\n      CharBuffer bufferAfterWrite = CharBuffer.wrap(sharedArray);\n      bufferAfterWrite.put(\"X19l5(mgJ\");\n      CharBuffer freshBuffer = CharBuffer.wrap(sharedArray);\n      int[] matchesResult = JaroWinklerSimilarity.matches(freshBuffer, bufferAfterWrite);\n      assertArrayEquals(new int[] {0, 0, 0}, matchesResult);\n  }\n\n  /**\n   * Tests that comparing a CharSequence with itself returns a perfect similarity of 1.0.\n   * Identical sequences always match completely under Jaro-Winkler.\n   */\n  @Test(timeout = 4000)\n  public void test6()  throws Throwable  {\n      JaroWinklerSimilarity similarity = JaroWinklerSimilarity.INSTANCE;\n      CharBuffer twoNullChars = CharBuffer.allocate(2);\n      Double result = similarity.apply((CharSequence) twoNullChars, (CharSequence) twoNullChars);\n      assertEquals(1.0, (double)result, 0.01);\n  }\n\n  /**\n   * Tests that passing a valid SimilarityInput as the first argument and null as the\n   * second throws an IllegalArgumentException. Both inputs must be non-null.\n   */\n  @Test(timeout = 4000)\n  public void test7()  throws Throwable  {\n      JaroWinklerSimilarity similarity = new JaroWinklerSimilarity();\n      SimilarityInput<Object> validInput = (SimilarityInput<Object>) mock(SimilarityInput.class, new ViolatedAssumptionAnswer());\n      // Undeclared exception!\n      try {\n        similarity.apply(validInput, (SimilarityInput<Object>) null);\n        fail(\"Expecting exception: IllegalArgumentException\");\n\n      } catch(IllegalArgumentException e) {\n         //\n         // CharSequences must not be null\n         //\n         verifyException(\"org.apache.commons.text.similarity.JaroWinklerSimilarity\", e);\n      }\n  }\n}\n",
