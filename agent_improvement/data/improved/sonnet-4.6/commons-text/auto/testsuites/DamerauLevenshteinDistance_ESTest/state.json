  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 22:35:00 GMT 2026\n */\n\npackage org.apache.commons.text.similarity;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.apache.commons.text.similarity.DamerauLevenshteinDistance;\nimport org.apache.commons.text.similarity.SimilarityInput;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class DamerauLevenshteinDistance_ESTest extends DamerauLevenshteinDistance_ESTest_scaffolding {\n\n    // -------------------------------------------------------------------------\n    // Constructor validation\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test00_constructorWithNegativeThreshold_throwsIllegalArgumentException() throws Throwable {\n        Integer negativeThreshold = new Integer((-17));\n        DamerauLevenshteinDistance distance = null;\n        try {\n            distance = new DamerauLevenshteinDistance(negativeThreshold);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // Threshold must not be negative\n            //\n            verifyException(\"org.apache.commons.text.similarity.DamerauLevenshteinDistance\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test12_getThreshold_defaultConstructor_returnsNull() throws Throwable {\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance();\n        Integer threshold = distance.getThreshold();\n        assertNull(threshold);\n    }\n\n    // -------------------------------------------------------------------------\n    // Unlimited mode (no threshold): apply(CharSequence, CharSequence)\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test03_applyUnlimited_bothInputsEmpty_returnsZero() throws Throwable {\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance();\n        Integer result = distance.apply((CharSequence) \"\", (CharSequence) \"\");\n        assertEquals(0, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test01_applyUnlimited_onePrefixCharDifference_returnsOne() throws Throwable {\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance();\n        // \"*@\" vs \"@\" — one insertion needed\n        Integer result = distance.apply((CharSequence) \"@\", (CharSequence) \"*@\");\n        assertEquals(1, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test11_applyUnlimited_identicalLongStrings_returnsZero() throws Throwable {\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance();\n        String fullyQualifiedClassName = \"org.apache.commons.text.similarity.DamerauLevenshteinDistance\";\n        Integer result = distance.apply((CharSequence) fullyQualifiedClassName, (CharSequence) fullyQualifiedClassName);\n        assertEquals(0, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test02_applyUnlimited_fullBufferVsEmptySubview_returnsBufferLength() throws Throwable {\n        // charBuffer is 116 null chars; subview wraps from index 116 to 116, yielding an empty sequence\n        CharBuffer fullBuffer = CharBuffer.allocate(116);\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance();\n        CharBuffer emptySubview = CharBuffer.wrap((CharSequence) fullBuffer, 116, 116);\n        Integer result = distance.apply((CharSequence) fullBuffer, (CharSequence) emptySubview);\n        assertEquals(116, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test04_applyUnlimited_nullInputs_throwsIllegalArgumentException() throws Throwable {\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance();\n        // Undeclared exception!\n        try {\n            distance.apply((SimilarityInput<Object>) null, (SimilarityInput<Object>) null);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // Left/right inputs must not be null\n            //\n            verifyException(\"org.apache.commons.text.similarity.DamerauLevenshteinDistance\", e);\n        }\n    }\n\n    // -------------------------------------------------------------------------\n    // Limited mode (with threshold): apply(CharSequence, CharSequence)\n    // -------------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void test08_applyLimited_nullInputs_throwsIllegalArgumentException() throws Throwable {\n        Integer threshold = new Integer(0);\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance(threshold);\n        // Undeclared exception!\n        try {\n            distance.apply((SimilarityInput<Object>) null, (SimilarityInput<Object>) null);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            //\n            // Left/right inputs must not be null\n            //\n            verifyException(\"org.apache.commons.text.similarity.DamerauLevenshteinDistance\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test10_applyLimited_identicalInputs_returnsZero() throws Throwable {\n        Integer threshold = new Integer(4);\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance(threshold);\n        CharBuffer buffer = CharBuffer.allocate(4);\n        Integer result = distance.apply((CharSequence) buffer, (CharSequence) buffer);\n        assertEquals(0, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test05_applyLimited_thresholdZero_differentSingleCharInputs_returnsMinusOne() throws Throwable {\n        Integer threshold = new Integer(0);\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance(threshold);\n        // left: one null char ('\\0'); right: one '%' char — distance is 1, which exceeds threshold 0\n        CharBuffer nullCharBuffer = CharBuffer.allocate(1);\n        char[] percentCharArray = new char[1];\n        percentCharArray[0] = '%';\n        CharBuffer percentCharBuffer = CharBuffer.wrap(percentCharArray);\n        Integer result = distance.apply((CharSequence) nullCharBuffer, (CharSequence) percentCharBuffer);\n        assertEquals((-1), (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test09_applyLimited_thresholdZero_nonEmptyRightInput_returnsMinusOne() throws Throwable {\n        Integer threshold = new Integer(0);\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance(threshold);\n        // empty left vs 16-char right — distance is 16, which exceeds threshold 0\n        CharBuffer emptyBuffer = CharBuffer.allocate(0);\n        Integer result = distance.apply((CharSequence) emptyBuffer, (CharSequence) \"DN{S5$O|Wi*p/ZbT\");\n        assertEquals((-1), (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test06_applyLimited_lengthDifferenceExceedsThreshold_returnsMinusOne() throws Throwable {\n        // left is 15 chars; right is 332 chars — length difference (317) far exceeds threshold 15\n        CharBuffer shortBuffer = CharBuffer.allocate(15);\n        Integer threshold = new Integer(15);\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance(threshold);\n        CharBuffer longBuffer = CharBuffer.allocate(332);\n        Integer result = distance.apply((CharSequence) shortBuffer, (CharSequence) longBuffer);\n        assertEquals((-1), (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void test07_applyLimited_distanceEqualsThreshold_returnsDistance() throws Throwable {\n        // left is 582 null chars; subview wraps from 582 to 582 yielding empty — distance is 582, equals threshold\n        Integer threshold = new Integer(582);\n        DamerauLevenshteinDistance distance = new DamerauLevenshteinDistance(threshold);\n        CharBuffer fullBuffer = CharBuffer.allocate(582);\n        CharBuffer emptySubview = CharBuffer.wrap((CharSequence) fullBuffer, 582, 582);\n        Integer result = distance.apply((CharSequence) fullBuffer, (CharSequence) emptySubview);\n        assertEquals(582, (int) result);\n    }\n}\n",
