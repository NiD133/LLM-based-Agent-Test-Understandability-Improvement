 = 4000)\n  public void test15_getThreshold_returnsValuePassedToConstructor()  throws Throwable  {\n      LevenshteinDistance distanceWithThreshold1403 = new LevenshteinDistance(new Integer(1403));\n      Integer threshold = distanceWithThreshold1403.getThreshold();\n      assertEquals(1403, (int) threshold);\n  }\n\n  @Test(timeout = 4000)\n  public void test16_zeroThreshold_identicalInputs_returnsZero()  throws Throwable  {\n      LevenshteinDistance defaultDistance = LevenshteinDistance.getDefaultInstance();\n      char[] twoNullChars = new char[2];\n      CharBuffer buffer = CharBuffer.wrap(twoNullChars);\n      // Identical input → distance = 0; reuse as threshold\n      Integer zeroDistance = defaultDistance.apply((CharSequence) buffer, (CharSequence) buffer);\n      assertEquals(0, (int) zeroDistance);\n\n      LevenshteinDistance zeroThresholdDistance = new LevenshteinDistance(zeroDistance); // threshold = 0\n      // Same buffer compared to itself → distance = 0, within threshold 0\n      Integer result = zeroThresholdDistance.apply((CharSequence) buffer, (CharSequence) buffer);\n      assertEquals(0, (int) result);\n  }\n}\n",
