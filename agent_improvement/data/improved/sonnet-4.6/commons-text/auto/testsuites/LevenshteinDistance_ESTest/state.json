     CharBuffer leftBuffer = CharBuffer.wrap(eightCharsWithSemicolon);\n      LevenshteinDistance distanceWithThreshold13 = new LevenshteinDistance(new Integer(13));\n      // Distance between these strings exceeds threshold 13, so returns -1\n      Integer result = distanceWithThreshold13.apply((CharSequence) leftBuffer, (CharSequence) \"d0tT~H04{j;2W=\");\n      assertEquals((-1), (int) result);\n  }\n\n  @Test(timeout = 4000)\n  public void test06_zeroThreshold_oneEditDifference_returnsMinusOne()  throws Throwable  {\n      LevenshteinDistance defaultDistance = LevenshteinDistance.getDefaultInstance();\n      char[] charsWithParen = new char[2];\n      charsWithParen[0] = ')';\n      CharBuffer bufferWithParen = CharBuffer.wrap(charsWithParen);\n      // Identical input → distance = 0; reuse as threshold\n      Integer zeroDistance = defaultDistance.apply((CharSequence) bufferWithParen, (CharSequence) bufferWithParen);\n\n      char[] twoNullChars = new char[2];\n      CharBuffer nullCharsBuffer = CharBuffer.wrap(twoNullChars);\n      LevenshteinDistance zeroThresholdDistance = new LevenshteinDistance(zeroDistance); // threshold = 0\n      // \")\\0\" vs \"\\0\\0\" differ by 1 edit, exceeding threshold 0, so returns -1\n      Integer result = zeroThresholdDistance.apply((CharSequence) bufferWithParen, (CharSequence) nullCharsBuffer);\n      assertEquals((-1), (int) result);\n  }\n\n  @Test(timeout = 4000)\n  public void test07_limitedDistance_identicalStrings_returnsZero()  throws Throwable  {\n      LevenshteinDistance distanceWithMaxThreshold = new LevenshteinDistance(new Integer(Integer.MAX_VALUE));\n      Integer result = distanceWithMaxThreshold.apply((CharSequence) \"3{sMd^PVa\", (CharSequence) \"3{sMd^PVa\");\n      assertEquals(0, (int) result);\n  }\n\n  @Test(timeout = 4000)\n  public void test08_zeroThreshold_largeLengthDifference_returnsMinusOne()  throws Throwable  {\n      LevenshteinDistance defaultDistance = LevenshteinDistance.getDefaultInstance(