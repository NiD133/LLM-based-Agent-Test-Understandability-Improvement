  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 21:28:30 GMT 2026\n */\n\npackage org.apache.commons.text.lookup;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport java.util.HashMap;\nimport java.util.Map;\nimport java.util.function.Function;\nimport org.apache.commons.text.lookup.InterpolatorStringLookup;\nimport org.apache.commons.text.lookup.StringLookup;\nimport org.apache.commons.text.lookup.XmlDecoderStringLookup;\nimport org.apache.commons.text.lookup.XmlEncoderStringLookup;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class InterpolatorStringLookup_ESTest extends InterpolatorStringLookup_ESTest_scaffolding {\n\n  /**\n   * When the default lookup is null and the key has no recognized prefix,\n   * lookup() should return null because there is no fallback resolver.\n   */\n  @Test(timeout = 4000)\n  public void test0_lookupReturnsNullWhenDefaultLookupIsNullAndKeyHasNoPrefix() throws Throwable {\n      InterpolatorStringLookup lookupWithNullDefault = new InterpolatorStringLookup((StringLookup) null);\n      String result = lookupWithNullDefault.lookup(\"|Hn2uFFA-fI\");\n      assertNull(result);\n  }\n\n  /**\n   * When a prefix-keyed lookup is registered in the map and the key matches\n   * that prefix (here an empty-string prefix), the matching lookup is used\n   * to resolve the remainder.  The XmlEncoderStringLookup encodes the\n   * apostrophe in the value part, producing the &apos; entity.\n   */\n  @Test(timeout = 4000)\n  public void test1_lookupDelegatesToPrefixedLookupAndXmlEncodesResult() throws Throwable {\n      HashMap<String, StringLookup> prefixMap = new HashMap<String, StringLookup>();\n      XmlEncoderStringLookup xmlEncoderLookup = new XmlEncoderStringLookup();\n      prefixMap.put(\"\", xmlEncoderLookup);\n      InterpolatorStringLookup interpolatorLookup = new InterpolatorStringLookup(prefixMap, xmlEncoderLookup, false);\n\n      // Key starts with ':' so prefix is \"\" which matches the registered entry;\n      // the remainder \"'Rk ^bnj|([Bw~^W\" is XML-encoded, turning ' into &apos;\n      String result = interpolatorLookup.lookup(\":'Rk ^bnj|([Bw~^W\");\n      assertEquals(\"&apos;Rk ^bnj|([Bw~^W\", result);\n  }\n\n  /**\n   * apply() is inherited from the Function interface and delegates to lookup().\n   * For a key with no prefix and no XML entities, XmlDecoderStringLookup\n   * returns the input unchanged.\n   */\n  @Test(timeout = 4000)\n  public void test2_applyWithNoXmlEntitiesReturnsInputUnchanged() throws Throwable {\n      XmlDecoderStringLookup xmlDecoderLookup = XmlDecoderStringLookup.INSTANCE;\n      InterpolatorStringLookup interpolatorLookup = new InterpolatorStringLookup(xmlDecoderLookup);\n\n      String result = interpolatorLookup.apply(\"gr^,<$;(-Ld>~\");\n      assertEquals(\"gr^,<$;(-Ld>~\", result);\n      assertNotNull(result);\n  }\n\n  /**\n   * compose() chains a pre-function before this lookup.  When the pre-function\n   * returns null for its input, the composed result is null regardless of\n   * what the interpolator itself would return.\n   */\n  @Test(timeout = 4000)\n  public void test3_composeWithNullReturningPreFunctionYieldsNull() throws Throwable {\n      XmlDecoderStringLookup xmlDecoderLookup = XmlDecoderStringLookup.INSTANCE;\n      InterpolatorStringLookup interpolatorLookup = new InterpolatorStringLookup(xmlDecoderLookup);\n\n      Function<Object, String> nullReturningFunction = (Function<Object, String>) mock(Function.class, new ViolatedAssumptionAnswer());\n      doReturn((Object) null).when(nullReturningFunction).apply(any());\n\n      Function<Object, String> composedFunction = interpolatorLookup.compose((Function<? super Object, ? extends String>) nullReturningFunction);\n      String result = composedFunction.apply(\"XML_DECODER\");\n      assertNull(result);\n  }\n\n  /**\n   * A key beginning with ':' (empty prefix) has no matching entry in the\n   * default lookup map, so the prefix is stripped and the remainder is\n   * passed to the default XmlDecoderStringLookup.  \"XML_DECODER\" contains\n   * no XML entities, so it is returned as-is.\n   */\n  @Test(timeout = 4000)\n  public void test4_lookupStripsEmptyPrefixAndFallsBackToDefaultLookup() throws Throwable {\n      XmlDecoderStringLookup xmlDecoderLookup = XmlDecoderStringLookup.INSTANCE;\n      InterpolatorStringLookup interpolatorLookup = new InterpolatorStringLookup(xmlDecoderLookup);\n\n      String result = interpolatorLookup.lookup(\":XML_DECODER\");\n      assertNotNull(result);\n      assertEquals(\"XML_DECODER\", result);\n  }\n\n  /**\n   * The no-arg constructor should complete without throwing, initializing\n   * the interpolator with the default set of string lookups.\n   */\n  @Test(timeout = 4000)\n  public void test5_noArgConstructorCompletesWithoutException() throws Throwable {\n      InterpolatorStringLookup interpolatorLookup = new InterpolatorStringLookup();\n  }\n\n  /**\n   * toString() should produce a non-null, human-readable description that\n   * includes the underlying lookup map and default lookup.\n   */\n  @Test(timeout = 4000)\n  public void test6_toStringReturnsNonNullDescription() throws Throwable {\n      HashMap<String, StringLookup> prefixMap = new HashMap<String, StringLookup>();\n      XmlEncoderStringLookup xmlEncoderLookup = new XmlEncoderStringLookup();\n      InterpolatorStringLookup interpolatorLookup = new InterpolatorStringLookup(prefixMap, xmlEncoderLookup, false);\n\n      String description = interpolatorLookup.toString();\n      assertNotNull(description);\n  }\n\n  /**\n   * When constructed with a default StringLookup, the interpolator registers\n   * all 18 built-in prefix lookups (from StringLookupFactory) in its map.\n   */\n  @Test(timeout = 4000)\n  public void test7_defaultConstructionRegisters18BuiltInPrefixLookups() throws Throwable {\n      XmlDecoderStringLookup xmlDecoderLookup = XmlDecoderStringLookup.INSTANCE;\n      InterpolatorStringLookup interpolatorLookup = new InterpolatorStringLookup(xmlDecoderLookup);\n\n      Map<String, StringLookup> registeredLookups = interpolatorLookup.getStringLookupMap();\n      assertEquals(18, registeredLookups.size());\n  }\n}\n",
