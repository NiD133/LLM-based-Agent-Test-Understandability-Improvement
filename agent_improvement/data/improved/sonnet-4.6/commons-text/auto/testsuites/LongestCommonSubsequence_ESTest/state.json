  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 23:11:29 GMT 2026\n */\n\npackage org.apache.commons.text.similarity;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.apache.commons.text.similarity.LongestCommonSubsequence;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class LongestCommonSubsequence_ESTest extends LongestCommonSubsequence_ESTest_scaffolding {\n\n    // The null character (Unicode code point 0), the default value of Java's char primitive.\n    // CharBuffer.allocate(n) and new char[n] both initialise every slot to this value.\n    private static final char NUL = (char) 0;\n\n    // Two-character string: null char followed by 'r'\n    private static final String NUL_R = NUL + \"r\";\n\n    // String of 18 null characters — any string length >= 1 works here;\n    // what matters is that the right argument is null so the exception is thrown immediately.\n    private static final String EIGHTEEN_NULS = new String(new char[18]);\n\n    // Single null character — the expected LCS when both sequences share only that character\n    private static final String SINGLE_NUL = String.valueOf(NUL);\n\n    /**\n     * Returns a CharBuffer of {@code size} characters, all set to the null character (NUL),\n     * which is the default value that {@code new char[size]} produces.\n     */\n    private static CharBuffer nullCharBuffer(int size) {\n        return CharBuffer.wrap(new char[size]);\n    }\n\n    @Test(timeout = 4000)\n    public void testLongestCommonSubstringLengthArray_returnsDpTableWithLengthPlusOneRows() throws Throwable {\n        // The DP table has (left.length() + 1) rows; \"b?'NC=\" has length 6, so 7 rows expected\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        int[][] dpTable = lcs.longestCommonSubstringLengthArray(\"b?'NC=\", \"b?'NC=\");\n        assertEquals(7, dpTable.length);\n    }\n\n    @Test(timeout = 4000)\n    public void testLongestCommonSubsequence_emptyRightSequence_returnsEmpty() throws Throwable {\n        // When the right sequence is empty there is nothing to match — LCS must be \"\"\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        CharBuffer leftBuffer = nullCharBuffer(4);\n        CharSequence result = lcs.longestCommonSubsequence(leftBuffer, \"\");\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void testLogestCommonSubsequence_bothSequencesEmpty_returnsEmpty() throws Throwable {\n        // Both empty sequences share no characters — LCS is \"\" (tests the deprecated logest... spelling)\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        CharBuffer emptyBuffer = CharBuffer.allocate(0);\n        CharSequence result = lcs.logestCommonSubsequence(emptyBuffer, \"\");\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void testLongestCommonSubsequence_nullRightArgument_throwsIllegalArgumentException() throws Throwable {\n        // A null right argument must be rejected with IllegalArgumentException\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        CharBuffer leftBuffer = nullCharBuffer(10);\n        try {\n            lcs.longestCommonSubsequence(leftBuffer, (CharSequence) null);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            verifyException(\"org.apache.commons.text.similarity.LongestCommonSubsequence\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void testLogestCommonSubsequence_bothArgumentsNull_throwsIllegalArgumentException() throws Throwable {\n        // Both null arguments must be rejected (tests deprecated method via singleton INSTANCE)\n        LongestCommonSubsequence lcs = LongestCommonSubsequence.INSTANCE;\n        try {\n            lcs.logestCommonSubsequence((CharSequence) null, (CharSequence) null);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            verifyException(\"org.apache.commons.text.similarity.LongestCommonSubsequence\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void testApply_leftHasNullChar_largeNullCharRightBuffer_returnsLcsLengthOne() throws Throwable {\n        // NUL_R and a 3226-null-char buffer share the NUL character, so the LCS length is 1\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        CharBuffer rightBuffer = CharBuffer.allocate(3226);\n        Integer result = lcs.apply((CharSequence) NUL_R, (CharSequence) rightBuffer);\n        assertEquals(1, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void testApply_emptyRightSequence_returnsZero() throws Throwable {\n        // An empty right sequence yields LCS length 0 regardless of the left\n        LongestCommonSubsequence lcs = LongestCommonSubsequence.INSTANCE;\n        CharBuffer leftBuffer = CharBuffer.allocate(7);\n        CharBuffer emptyRight = CharBuffer.wrap(new char[0]);\n        Integer result = lcs.apply((CharSequence) leftBuffer, (CharSequence) emptyRight);\n        assertEquals(0, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void testApply_bothSequencesEmpty_returnsZero() throws Throwable {\n        // Both sequences empty — LCS length is 0\n        LongestCommonSubsequence lcs = LongestCommonSubsequence.INSTANCE;\n        CharBuffer emptyBuffer = CharBuffer.wrap(new char[0]);\n        Integer result = lcs.apply((CharSequence) emptyBuffer, (CharSequence) emptyBuffer);\n        assertEquals(0, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void testApply_leftHasNullChar_twoNullCharRightBuffer_returnsLcsLengthOne() throws Throwable {\n        // NUL_R and a two-null-char buffer share the NUL character as their one common element\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        CharBuffer rightBuffer = nullCharBuffer(2);\n        Integer result = lcs.apply((CharSequence) NUL_R, (CharSequence) rightBuffer);\n        assertEquals(1, (int) result);\n    }\n\n    @Test(timeout = 4000)\n    public void testApply_nullRightArgument_throwsIllegalArgumentException() throws Throwable {\n        // apply() must reject a null right argument with IllegalArgumentException\n        LongestCommonSubsequence lcs = LongestCommonSubsequence.INSTANCE;\n        try {\n            lcs.apply((CharSequence) EIGHTEEN_NULS, (CharSequence) null);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            verifyException(\"org.apache.commons.text.similarity.LongestCommonSubsequence\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void testApply_bothArgumentsNull_throwsIllegalArgumentException() throws Throwable {\n        // apply() must reject both-null arguments with IllegalArgumentException\n        LongestCommonSubsequence lcs = LongestCommonSubsequence.INSTANCE;\n        try {\n            lcs.apply((CharSequence) null, (CharSequence) null);\n            fail(\"Expecting exception: IllegalArgumentException\");\n        } catch (IllegalArgumentException e) {\n            verifyException(\"org.apache.commons.text.similarity.LongestCommonSubsequence\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void testLogestCommonSubsequence_twoNullCharBuffer_vsNulR_returnsNulChar() throws Throwable {\n        // A buffer of two NUL chars and NUL_R (\"\u0000r\") share the NUL char as their LCS\n        // (tests deprecated logest... method)\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        CharBuffer leftBuffer = nullCharBuffer(2);\n        CharSequence result = lcs.logestCommonSubsequence(leftBuffer, NUL_R);\n        assertEquals(SINGLE_NUL, result);\n    }\n\n    @Test(timeout = 4000)\n    public void testLongestCommonSubsequence_noCharactersInCommon_returnsEmpty() throws Throwable {\n        // A buffer of NUL chars shares no characters with \"+*QLyOuk\" — LCS is \"\"\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n        CharBuffer leftBuffer = nullCharBuffer(7);\n        CharSequence result = lcs.longestCommonSubsequence(leftBuffer, \"+*QLyOuk\");\n        assertEquals(\"\", result);\n    }\n}\n",
