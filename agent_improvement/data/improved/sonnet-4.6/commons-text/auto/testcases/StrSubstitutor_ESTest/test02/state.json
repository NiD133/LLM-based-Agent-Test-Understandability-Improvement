  "last_code": "package org.apache.commons.text;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.HashMap;\nimport java.util.Map;\nimport java.util.Properties;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class StrSubstitutor_ESTest_test02 extends StrSubstitutor_ESTest_scaffolding {\n\n    // A fully-qualified class name reused as both the variable prefix and suffix string.\n    private static final String FQCN_AS_DELIMITER = \"org.apache.commons.text.lookup.ConstantStringLookup\";\n\n    @Test(timeout = 4000)\n    public void test_replaceObject_withOverriddenPrefixAndNoMatchingSuffix_returnsStringUnchanged() throws Throwable {\n        // Substitutor with an empty value map and an unusual multi-char prefix/suffix (the FQCN).\n        HashMap<String, String> emptyVariableMap = new HashMap<String, String>();\n        StrSubstitutor substitutor = new StrSubstitutor(\n                (Map<String, String>) emptyVariableMap,\n                FQCN_AS_DELIMITER,\n                FQCN_AS_DELIMITER);\n\n        // Build the input: start with the FQCN string, then override the prefix matcher to '$'.\n        // This means variable patterns now require a single '$' prefix and the FQCN as suffix.\n        StringBuilder inputBuilder = new StringBuilder((CharSequence) FQCN_AS_DELIMITER);\n        substitutor.setVariablePrefix('$');\n\n        // Append \"$$\\0\\0\\0\": first '$' is the escape char, second '$' is the new prefix.\n        // No matching suffix (FQCN) follows, so this sequence will not be treated as a variable.\n        char[] escapedPrefixSequence = new char[5];\n        escapedPrefixSequence[0] = '$';\n        escapedPrefixSequence[1] = '$';\n        inputBuilder.append(escapedPrefixSequence);\n\n        // Double the content by appending the builder to itself.\n        inputBuilder.append((CharSequence) inputBuilder);\n\n        // No variable pattern is complete, so replace() returns the text unchanged.\n        String result = substitutor.replace((Object) inputBuilder);\n\n        // The escape character remains '$' (the DEFAULT_ESCAPE used at construction time).\n        assertEquals('$', substitutor.getEscapeChar());\n\n        String expectedResult = FQCN_AS_DELIMITER + \"$$\u0000\u0000\u0000\"\n                + FQCN_AS_DELIMITER + \"$$\u0000\u0000\u0000\";\n        assertEquals(expectedResult, result);\n    }\n}\n",
