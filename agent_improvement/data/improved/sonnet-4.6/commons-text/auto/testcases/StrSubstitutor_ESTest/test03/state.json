  "last_code": "package org.apache.commons.text;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport java.util.HashMap;\nimport java.util.Map;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class StrSubstitutor_ESTest_test03 extends StrSubstitutor_ESTest_scaffolding {\n\n    @Test(timeout = 4000)\n    public void test03() throws Throwable {\n        // Build a substitutor with an empty variable map and a long class name as both prefix and suffix\n        Map<String, String> emptyVariableMap = new HashMap<>();\n        String customDelimiter = \"org.apache.commons.text.lookup.ConstantStringLookup\";\n        StrSubstitutor substitutor = new StrSubstitutor(emptyVariableMap, customDelimiter, customDelimiter);\n\n        // Build the template by appending the delimiter twice, then five null characters\n        StringBuilder template = new StringBuilder(customDelimiter);\n        template.append(customDelimiter);\n        char[] nullChars = new char[5];\n\n        // Override the variable suffix to the null character and enable substitution inside variable names\n        substitutor.setVariableSuffix('\u0000');\n        substitutor.setEnableSubstitutionInVariables(true);\n\n        // Finish building the template and run replacement\n        template.append(nullChars);\n        substitutor.replace((Object) template);\n\n        // The substitution-in-variables flag must remain true after replacement\n        assertTrue(substitutor.isEnableSubstitutionInVariables());\n    }\n}\n",
