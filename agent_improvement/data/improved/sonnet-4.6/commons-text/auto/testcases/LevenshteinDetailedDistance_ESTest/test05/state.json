  "last_code": "package org.apache.commons.text.similarity;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport java.nio.CharBuffer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class LevenshteinDetailedDistance_ESTest_test05 extends LevenshteinDetailedDistance_ESTest_scaffolding {\n\n    /**\n     * When the actual Levenshtein distance between two strings exceeds the configured\n     * threshold, apply() must return a result whose distance is -1.\n     *\n     * Setup:\n     *   - left  : CharBuffer of 13 null characters (capacity 13, all '\u0000')\n     *   - right : \"E6sZn1lY$kTP*\\\"\" (14 characters, none of which match '\u0000')\n     *   - threshold : 13\n     *\n     * Because the right side is longer than the threshold and every character differs,\n     * the true edit distance (14) exceeds the threshold (13), so the limited algorithm\n     * returns -1 without computing the full distance.\n     */\n    @Test(timeout = 4000)\n    public void test05() throws Throwable {\n        // A 13-character CharBuffer filled with null characters ('\u0000')\n        CharBuffer nullCharSource = CharBuffer.allocate(13);\n\n        // Threshold of 13 means distances > 13 are reported as -1\n        int threshold = 13;\n        LevenshteinDetailedDistance distanceCalculator = new LevenshteinDetailedDistance(threshold);\n\n        // right side has 14 chars, all different from '\u0000' — distance exceeds threshold\n        LevenshteinResults result = distanceCalculator.apply((CharSequence) nullCharSource, (CharSequence) \"E6sZn1lY$kTP*\\\"\");\n\n        assertEquals(-1, (int) result.getDistance());\n    }\n}\n",
