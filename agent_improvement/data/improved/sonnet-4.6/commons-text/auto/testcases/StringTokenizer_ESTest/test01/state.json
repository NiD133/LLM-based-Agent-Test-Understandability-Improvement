  "last_code": "package org.apache.commons.text;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.NoSuchElementException;\nimport java.util.function.Consumer;\nimport org.apache.commons.text.matcher.StringMatcher;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class StringTokenizer_ESTest_test01 extends StringTokenizer_ESTest_scaffolding {\n\n    /**\n     * Verifies that a StringTokenizer constructed from a single null-character array\n     * with a custom delimiter matcher correctly represents its content via toString(),\n     * and that empty-token ignoring is enabled by default.\n     *\n     * Calling previousToken() at the start of iteration (no previous element) is a\n     * no-op and does not affect subsequent state or string representation.\n     */\n    @Test(timeout = 4000)\n    public void test01() throws Throwable {\n        // A single-element char array; default value is the null character (\u0000)\n        char[] singleNullChar = new char[1];\n\n        // Mock StringMatcher that never matches any character (isMatch always returns 0)\n        StringMatcher nonMatchingDelimiter = mock(StringMatcher.class, new ViolatedAssumptionAnswer());\n        doReturn((String) null, (String) null).when(nonMatchingDelimiter).toString();\n        doReturn(0, 0).when(nonMatchingDelimiter).isMatch(any(char[].class), anyInt(), anyInt(), anyInt());\n\n        StringTokenizer tokenizer = new StringTokenizer(singleNullChar, nonMatchingDelimiter);\n\n        // Attempt to move backwards at the start of iteration; no previous token exists\n        tokenizer.previousToken();\n\n        // toString() should include the original null character in its representation\n        String tokenizerDescription = tokenizer.toString();\n        assertEquals(\"StringTokenizer[\u0000]\", tokenizerDescription);\n\n        // By default, StringTokenizer ignores empty tokens\n        assertTrue(tokenizer.isIgnoreEmptyTokens());\n    }\n}\n",
