  "last_code": "package org.apache.commons.text.similarity;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class LevenshteinDistance_ESTest_test06 extends LevenshteinDistance_ESTest_scaffolding {\n\n    /**\n     * Verifies that apply() returns -1 when the edit distance between two strings\n     * exceeds the configured threshold.\n     *\n     * Setup:\n     *   - source = \")\u0000\" (CharBuffer wrapping [')', '\\0'])\n     *   - target = \"\u0000\u0000\" (CharBuffer wrapping ['\\0', '\\0'])\n     *   - threshold = 0 (distance of source to itself, which is always 0)\n     *\n     * The source and target differ at position 0 (')' vs '\\0'), so their actual\n     * Levenshtein distance is 1. Since 1 > threshold (0), the limited instance\n     * must return -1 to signal that the distance exceeds the threshold.\n     */\n    @Test(timeout = 4000)\n    public void test06() throws Throwable {\n        // Use the unlimited default instance to compute a self-distance (always 0)\n        // and capture that value as the threshold for the limited instance below.\n        LevenshteinDistance unlimitedDistance = LevenshteinDistance.getDefaultInstance();\n\n        char[] sourceChars = new char[2];\n        sourceChars[0] = ')';\n        // sourceChars[1] remains '\\0' (default)\n        CharBuffer source = CharBuffer.wrap(sourceChars);\n\n        // Distance from a CharBuffer to itself is always 0; used as the threshold.\n        Integer zeroThreshold = unlimitedDistance.apply((CharSequence) source, (CharSequence) source);\n\n        char[] targetChars = new char[2];\n        // targetChars[0] and [1] both remain '\\0' (default), so target = \"\u0000\u0000\"\n        CharBuffer target = CharBuffer.wrap(targetChars);\n\n        // Create a threshold-limited instance; threshold == 0 means any difference returns -1.\n        LevenshteinDistance limitedDistance = new LevenshteinDistance(zeroThreshold);\n\n        // source (\")\u0000\") differs from target (\"\u0000\u0000\") at position 0,\n        // so actual distance is 1, which exceeds threshold 0 → expected result is -1.\n        Integer result = limitedDistance.apply((CharSequence) source, (CharSequence) target);\n\n        assertEquals(-1, (int) result);\n    }\n}\n",
