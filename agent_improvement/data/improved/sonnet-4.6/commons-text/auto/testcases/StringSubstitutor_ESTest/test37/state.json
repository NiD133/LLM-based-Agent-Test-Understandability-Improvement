  "last_code": "package org.apache.commons.text;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport java.nio.CharBuffer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class StringSubstitutor_ESTest_test37 extends StringSubstitutor_ESTest_scaffolding {\n\n    /**\n     * Verifies that replacing a CharSequence consisting entirely of null characters\n     * produces a string of the same null characters, and that the default escape\n     * character is '$'.\n     *\n     * CharBuffer.allocate('$') allocates a buffer of capacity 36 (the ASCII value\n     * of '$'), pre-filled with '\u0000'. The replace() call converts that buffer\n     * to its string form without any variable substitution (no '${...}' patterns),\n     * so the result is a 36-character string of null characters.\n     */\n    @Test(timeout = 4000)\n    public void test37_replaceNullCharBufferReturnsNullCharString() throws Throwable {\n        // '$' has ASCII value 36, so this allocates a 36-element buffer of '\u0000'\n        final int DOLLAR_ASCII = '$';\n        CharBuffer nullCharBuffer = CharBuffer.allocate(DOLLAR_ASCII);\n\n        StringSubstitutor substitutor = new StringSubstitutor();\n        String result = substitutor.replace((CharSequence) nullCharBuffer);\n\n        assertNotNull(result);\n        // Default escape character should be '$'\n        assertEquals('$', substitutor.getEscapeChar());\n        // The 36 null characters in the buffer are preserved as-is (no substitution occurs)\n        String expectedNullChars = new String(new char[DOLLAR_ASCII]);\n        assertEquals(expectedNullChars, result);\n    }\n}\n",
