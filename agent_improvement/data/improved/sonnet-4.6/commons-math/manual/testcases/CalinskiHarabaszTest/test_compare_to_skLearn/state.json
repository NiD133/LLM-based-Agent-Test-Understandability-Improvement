c final double[] SKLEARN_SCORES = {\n        622.487247165719,\n        597.7763150683217,\n        1157.7901325495295,\n        1136.8201767857847,\n        1092.708039201163\n    };\n\n    /**\n     * 200-point 2-D dataset (x, y) used by scikit-learn in its reference run.\n     * Points form four separable Gaussian clusters in the plane.\n     */\n    private static final double[][] SKLEARN_DATA = {\n        { 1.403414,  1.148639 }, {  0.203959,  0.172137 }, {  2.132351,  1.883029 },\n        {  0.176704, -0.106040 }, { -0.729892, -0.987217 }, {  2.073591,  1.891133 },\n        { -0.632742, -0.847796 }, { -0.080353,  0.388064 }, {  1.293772,  0.999236 },\n        { -0.478476, -0.444240 }, {  1.154994,  0.922124 }, {  0.213056,  0.247446 },\n        {  1.246047,  1.329821 }, {  2.010432,  1.939522 }, { -0.249074,  0.060909 },\n        {  1.960038,  1.883771 }, {  0.068528, -0.119460 }, {  1.035851,  0.992598 },\n        {  2.206471,  2.040334 }, {  2.114869,  2.186366 }, {  0.192118,  0.042242 },\n        {  0.194172,  0.230945 }, {  1.969581,  2.118761 }, {  1.211497,  0.803267 },\n        {  0.852534,  1.171513 }, {  2.032709,  2.068391 }, {  0.862354,  1.096274 },\n        { -1.151345, -1.192454 }, {  2.642026,  1.905175 }, { -1.009092, -1.383999 },\n        {  1.123967,  0.799541 }, {  2.452222,  2.079981 }, {  0.665412,  0.829890 },\n        {  2.145178,  1.991171 }, { -1.186327, -1.110976 }, {  2.009537,  1.683832 },\n        {  1.900143,  2.059320 }, {  1.217072,  1.073173 }, { -0.011930,  0.182649 },\n        { -1.255492, -0.670092 }, {  0.221479, -0.239351 }, { -0.155211, -0.129519 },\n        {  0.076976,  0.070879 }, {  2.340748,  1.728946 }, { -0.785182, -1.003191 },\n        { -0.048162,  0.054161 }, { -0.590787, -1.261207 }, { -0.322545, -1.678934 },\n        {  1.721805,  2.019360 }, { -0.055982,  0.406160 }, {  1.786591,  2.030543 },\n        {  2.319241,  1.662943 }, { -0.037710,  0.140065 }, {  1.255095,  1.042194 },\n        {  1.111086,  1.16595