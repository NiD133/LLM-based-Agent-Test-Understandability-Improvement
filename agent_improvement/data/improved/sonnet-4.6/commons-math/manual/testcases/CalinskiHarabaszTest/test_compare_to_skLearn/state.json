927 }, { -1.067896, -0.033157 }, {  2.082978,  2.321452 },\n        {  0.975302,  0.964340 }, { -1.199290, -1.836711 }, { -1.199961, -0.825432 },\n        {  0.084522,  0.199842 }, {  0.129213,  0.052383 }\n    };\n\n    // -----------------------------------------------------------------------\n    // Sweep configuration\n    // -----------------------------------------------------------------------\n\n    /** Smallest number of clusters examined in the sweep. */\n    private static final int MIN_K = 2;\n\n    /** Largest number of clusters examined in the sweep. */\n    private static final int MAX_K = 6;\n\n    /**\n     * Maximum relative deviation allowed between our CH score and the\n     * scikit-learn reference score for k <= {@value #SKLEARN_BEST_K}.\n     * KMeans++ is non-deterministic, so a small tolerance is necessary.\n     */\n    private static final double RELATIVE_SCORE_TOLERANCE = 2e-2;\n\n    // -----------------------------------------------------------------------\n    // Test fixtures\n    // -----------------------------------------------------------------------\n\n    private ClusterEvaluator evaluator;\n    private DistanceMeasure distanceMeasure;\n\n    @Before\n    public void setUp() {\n        evaluator = new CalinskiHarabasz();\n        distanceMeasure = new EuclideanDistance();\n    }\n\n    // -----------------------------------------------------------------------\n    // Test\n    // -----------------------------------------------------------------------\n\n    /**\n     * Clusters {@link #SKLEARN_DATA} with KMeans++ for each k in\n     * [{@value #MIN_K}, {@value #MAX_K}] and checks two properties:\n     * <ol>\n     *   <li>For k &le; {@value #SKLEARN_BEST_K} the CH score matches the\n     *       scikit-learn reference within {@value #RELATIVE_SCORE_TOLERANCE}\n     *       relative error.</li>\n     *   <li>The highest CH score across all k is attained at\n     *       k = {@value #SKLEARN_BEST_K}.</li>\n     * </ol>\n     */\n    @Test\n    public void test_compare_to_skLearn() {\n        final UniformRandomProvider rng = RandomSource.MT_64.create();\n\n        // Wrap raw coordinate arrays in DoublePoint objects required by the clusterer.\n        final List<DoublePoint> points = new ArrayList<>();\n        for (double[] coordinates : SKLEARN_DATA) {\n            points.add(new DoublePoint(coordinates));\n        }\n\n        // Track the score at the scikit-learn best k so we can compare it\n        // against every other k after the sweep.\n        double bestKScore = 0.0;\n        double overallBestScore = 0.0;\n\n        for (int k = MIN_K; k <= MAX_K; k++) {\n            // Run KMeans++ to convergence (Integer.MAX_VALUE iterations).\n            KMeansPlusPlusClusterer<DoublePoint> kMeans =\n                new KMeansPlusPlusClusterer<>(k, Integer.MAX_VALUE, distanceMeasure, rng);\n            List<CentroidCluster<DoublePoint>> clusters = kMeans.cluster(points);\n\n            double score = evaluator.score(clusters);\n\n            if (score > overallBestScore) {\n                overallBestScore = score;\n            }\n\n            // For k <= SKLEARN_BEST_K the CH score is expected to be close to\n            // scikit-learn's reference; beyond SKLEARN_BEST_K the score drops,\n            // so no comparison is meaningful there.\n            if (k <= SKLEARN_BEST_K) {\n                bestKScore = score;\n                int skLearnIndex = k - MIN_K;\n                double relativeScore = score / SKLEARN_SCORES[skLearnIndex];\n                Assert.assertEquals(\n                    \"CH score for k=\" + k + \" should match scikit-learn within \" + RELATIVE_SCORE_TOLERANCE,\n                    1.0, relativeScore, RELATIVE_SCORE_TOLERANCE);\n            }\n        }\n\n        // k=SKLEARN_BEST_K must yield the single highest CH score in the sweep.\n        Assert.assertEquals(\n            \"The highest CH score should be achieved at k=\" + SKLEARN_BEST_K,\n            overallBestScore, bestKScore, 0.0);\n    }\n}\n",
