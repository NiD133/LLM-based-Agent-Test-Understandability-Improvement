  "last_code": "package org.apache.commons.math4.legacy.stat.correlation;\n\nimport org.apache.commons.math4.legacy.TestUtils;\nimport org.apache.commons.math4.legacy.exception.MathIllegalArgumentException;\nimport org.apache.commons.math4.legacy.exception.NotStrictlyPositiveException;\nimport org.apache.commons.math4.legacy.linear.Array2DRowRealMatrix;\nimport org.apache.commons.math4.legacy.linear.RealMatrix;\nimport org.junit.Assert;\nimport org.junit.Test;\n\npublic class CovarianceTest_testConsistency {\n\n    protected final double[] longleyData = new double[] { 60323, 83.0, 234289, 2356, 1590, 107608, 1947, 61122, 88.5, 259426, 2325, 1456, 108632, 1948, 60171, 88.2, 258054, 3682, 1616, 109773, 1949, 61187, 89.5, 284599, 3351, 1650, 110929, 1950, 63221, 96.2, 328975, 2099, 3099, 112075, 1951, 63639, 98.1, 346999, 1932, 3594, 113270, 1952, 64989, 99.0, 365385, 1870, 3547, 115094, 1953, 63761, 100.0, 363112, 3578, 3350, 116219, 1954, 66019, 101.2, 397469, 2904, 3048, 117388, 1955, 67857, 104.6, 419180, 2822, 2857, 118734, 1956, 68169, 108.4, 442769, 2936, 2798, 120445, 1957, 66513, 110.8, 444546, 4681, 2637, 121950, 1958, 68655, 112.6, 482704, 3813, 2552, 123366, 1959, 69564, 114.2, 502601, 3931, 2514, 125368, 1960, 69331, 115.7, 518173, 4806, 2572, 127852, 1961, 70551, 116.9, 554894, 4007, 2827, 130081, 1962 };\n\n    protected final double[] swissData = new double[] { 80.2, 17.0, 15, 12, 9.96, 83.1, 45.1, 6, 9, 84.84, 92.5, 39.7, 5, 5, 93.40, 85.8, 36.5, 12, 7, 33.77, 76.9, 43.5, 17, 15, 5.16, 76.1, 35.3, 9, 7, 90.57, 83.8, 70.2, 16, 7, 92.85, 92.4, 67.8, 14, 8, 97.16, 82.4, 53.3, 12, 7, 97.67, 82.9, 45.2, 16, 13, 91.38, 87.1, 64.5, 14, 6, 98.61, 64.1, 62.0, 21, 12, 8.52, 66.9, 67.5, 14, 7, 2.27, 68.9, 60.7, 19, 12, 4.43, 61.7, 69.3, 22, 5, 2.82, 68.3, 72.6, 18, 2, 24.20, 71.7, 34.0, 17, 8, 3.30, 55.7, 19.4, 26, 28, 12.11, 54.3, 15.2, 31, 20, 2.15, 65.1, 73.0, 19, 9, 2.84, 65.5, 59.8, 22, 10, 5.23, 65.0, 55.1, 14, 3, 4.52, 56.6, 50.9, 22, 12, 15.14, 57.4, 54.1, 20, 6, 4.20, 72.5, 71.2, 12, 1, 2.40, 74.2, 58.1, 14, 8, 5.23, 72.0, 63.5, 6, 3, 2.56, 60.5, 60.8, 16, 10, 7.72, 58.3, 26.8, 25, 19, 18.46, 65.4, 49.5, 15, 8, 6.10, 75.5, 85.9, 3, 2, 99.71, 69.3, 84.9, 7, 6, 99.68, 77.3, 89.7, 5, 2, 100.00, 70.5, 78.2, 12, 6, 98.96, 79.4, 64.9, 7, 3, 98.22, 65.0, 75.9, 9, 9, 99.06, 92.2, 84.6, 3, 3, 99.46, 79.3, 63.1, 13, 13, 96.83, 70.4, 38.4, 26, 12, 5.62, 65.7, 7.7, 29, 11, 13.79, 72.7, 16.7, 22, 13, 11.22, 64.4, 17.6, 35, 32, 16.92, 77.6, 37.6, 15, 7, 4.97, 67.6, 18.7, 25, 7, 8.65, 35.0, 1.2, 37, 53, 42.34, 44.7, 46.6, 16, 29, 50.43, 42.8, 27.7, 22, 29, 58.33 };\n\n    // Swiss fertility dataset: 47 observations, 5 variables\n    private static final int SWISS_NUM_ROWS = 47;\n    private static final int SWISS_NUM_COLS = 5;\n\n    private static final double TOLERANCE = 10E-14;\n\n    protected RealMatrix createRealMatrix(double[] data, int nRows, int nCols) {\n        double[][] matrixData = new double[nRows][nCols];\n        int ptr = 0;\n        for (int i = 0; i < nRows; i++) {\n            System.arraycopy(data, ptr, matrixData[i], 0, nCols);\n            ptr += nCols;\n        }\n        return new Array2DRowRealMatrix(matrixData);\n    }\n\n    /**\n     * Verify that diagonal entries are consistent with Variance computation and matrix matches\n     * column-by-column covariances\n     */\n    @Test\n    public void testConsistency() {\n        final RealMatrix swissMatrix = createRealMatrix(swissData, SWISS_NUM_ROWS, SWISS_NUM_COLS);\n        final RealMatrix covarianceMatrix = new Covariance(swissMatrix).getCovarianceMatrix();\n\n        // Diagonal entries must equal the variance of the corresponding column,\n        // because Cov(X, X) == Var(X) by definition.\n        for (int col = 0; col < SWISS_NUM_COLS; col++) {\n            double expectedVariance = org.apache.commons.statistics.descriptive.Variance.of(swissMatrix.getColumn(col)).getAsDouble();\n            Assert.assertEquals(expectedVariance, covarianceMatrix.getEntry(col, col), TOLERANCE);\n        }\n\n        // Off-diagonal entries must match the pairwise covariance of the two columns.\n        // Here we pick columns 2 and 3 as a representative pair.\n        double covCol2Col3 = new Covariance().covariance(swissMatrix.getColumn(2), swissMatrix.getColumn(3), true);\n        Assert.assertEquals(covarianceMatrix.getEntry(2, 3), covCol2Col3, TOLERANCE);\n\n        // The covariance matrix must be symmetric: Cov(X, Y) == Cov(Y, X).\n        Assert.assertEquals(covarianceMatrix.getEntry(2, 3), covarianceMatrix.getEntry(3, 2), Double.MIN_VALUE);\n\n        // When all columns are identical, every entry in the covariance matrix must equal\n        // the variance of that single column, because Cov(X, X) == Var(X) for any pair.\n        final int NUM_REPEATED_COLS = 3;\n        RealMatrix repeatedColumns = new Array2DRowRealMatrix(SWISS_NUM_ROWS, NUM_REPEATED_COLS);\n        for (int col = 0; col < NUM_REPEATED_COLS; col++) {\n            repeatedColumns.setColumnMatrix(col, swissMatrix.getColumnMatrix(0));\n        }\n        RealMatrix repeatedCovarianceMatrix = new Covariance(repeatedColumns).getCovarianceMatrix();\n        double firstColumnVariance = org.apache.commons.statistics.descriptive.Variance.of(swissMatrix.getColumn(0)).getAsDouble();\n        for (int row = 0; row < NUM_REPEATED_COLS; row++) {\n            for (int col = 0; col < NUM_REPEATED_COLS; col++) {\n                Assert.assertEquals(firstColumnVariance, repeatedCovarianceMatrix.getEntry(row, col), TOLERANCE);\n            }\n        }\n\n        // Bias-correction is applied by default: passing biasCorrected=true explicitly\n        // must produce the same result as the no-argument overload.\n        double[][] rawData = swissMatrix.getData();\n        TestUtils.assertEquals(\"Covariances\", covarianceMatrix, new Covariance().computeCovarianceMatrix(rawData), Double.MIN_VALUE);\n        TestUtils.assertEquals(\"Covariances\", covarianceMatrix, new Covariance().computeCovarianceMatrix(rawData, true), Double.MIN_VALUE);\n\n        // The same default bias-correction consistency check for the 1-D overload.\n        double[] firstRow = rawData[0];\n        double[] secondRow = rawData[1];\n        Assert.assertEquals(new Covariance().covariance(firstRow, secondRow),\n                            new Covariance().covariance(firstRow, secondRow, true),\n                            Double.MIN_VALUE);\n    }\n}\n",
