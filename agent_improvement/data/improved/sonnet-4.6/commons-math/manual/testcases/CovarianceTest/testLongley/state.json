  "last_code": "package org.apache.commons.math4.legacy.stat.correlation;\n\nimport org.apache.commons.math4.legacy.TestUtils;\nimport org.apache.commons.math4.legacy.linear.Array2DRowRealMatrix;\nimport org.apache.commons.math4.legacy.linear.RealMatrix;\nimport org.junit.Test;\n\n/**\n * Verifies Covariance computation against the Longley dataset using R as a\n * reference implementation.\n *\n * Data source: J. Longley (1967) \"An Appraisal of Least Squares Programs for\n * the Electronic Computer from the Point of View of the User\", JASA vol. 62,\n * pp. 819-841. Raw data from NIST:\n * http://www.itl.nist.gov/div898/strd/lls/data/LINKS/DATA/Longley.dat\n */\npublic class CovarianceTest_testLongley {\n\n    /**\n     * Longley dataset: 16 annual US economic observations (1947-1962).\n     * Columns: Employment, GNP_Deflator, GNP, Unemployed, ArmedForces, Population, Year\n     */\n    private static final double[][] LONGLEY_DATA = {\n        { 60323,  83.0, 234289, 2356, 1590, 107608, 1947 },\n        { 61122,  88.5, 259426, 2325, 1456, 108632, 1948 },\n        { 60171,  88.2, 258054, 3682, 1616, 109773, 1949 },\n        { 61187,  89.5, 284599, 3351, 1650, 110929, 1950 },\n        { 63221,  96.2, 328975, 2099, 3099, 112075, 1951 },\n        { 63639,  98.1, 346999, 1932, 3594, 113270, 1952 },\n        { 64989,  99.0, 365385, 1870, 3547, 115094, 1953 },\n        { 63761, 100.0, 363112, 3578, 3350, 116219, 1954 },\n        { 66019, 101.2, 397469, 2904, 3048, 117388, 1955 },\n        { 67857, 104.6, 419180, 2822, 2857, 118734, 1956 },\n        { 68169, 108.4, 442769, 2936, 2798, 120445, 1957 },\n        { 66513, 110.8, 444546, 4681, 2637, 121950, 1958 },\n        { 68655, 112.6, 482704, 3813, 2552, 123366, 1959 },\n        { 69564, 114.2, 502601, 3931, 2514, 125368, 1960 },\n        { 69331, 115.7, 518173, 4806, 2572, 127852, 1961 },\n        { 70551, 116.9, 554894, 4007, 2827, 130081, 1962 }\n    };\n\n    /**\n     * Expected 7x7 covariance matrix for LONGLEY_DATA, computed by R.\n     * Rows/columns correspond to the same variable order as in LONGLEY_DATA.\n     */\n    private static final double[][] EXPECTED_COVARIANCE = {\n        { 12333921.73333333246,  3.679666000000000e+04,  343330206.333333313,   1649102.666666666744,  1117681.066666666651,  23461965.733333334,  16240.93333333333248 },\n        {    36796.66000000000,  1.164576250000000e+02,    1063604.115416667,      6258.666250000000,     3490.253750000000,     73503.000000000,      50.92333333333334 },\n        { 343330206.33333331347, 1.063604115416667e+06, 9879353659.329166412,  56124369.854166664183, 30880428.345833335072, 685240944.600000024, 470977.90000000002328 },\n        {  1649102.66666666674,  6.258666250000000e+03,   56124369.854166664,    873223.429166666698,  -115378.762499999997,  4462741.533333333,   2973.03333333333330 },\n        {  1117681.06666666665,  3.490253750000000e+03,   30880428.345833335,   -115378.762499999997,   484304.095833333326,  1764098.133333333,   1382.43333333333339 },\n        { 23461965.73333333433,  7.350300000000000e+04,  685240944.600000024,   4462741.533333333209,  1764098.133333333302, 48387348.933333330,  32917.40000000000146 },\n        {    16240.93333333333,  5.092333333333334e+01,     470977.900000000,      2973.033333333333,     1382.433333333333,    32917.40000000,        22.66666666666667 }\n    };\n\n    @Test\n    public void testLongley() {\n        RealMatrix longleyMatrix = new Array2DRowRealMatrix(LONGLEY_DATA);\n        RealMatrix covarianceMatrix = new Covariance(longleyMatrix).getCovarianceMatrix();\n\n        RealMatrix expectedCovariance = new Array2DRowRealMatrix(EXPECTED_COVARIANCE);\n        TestUtils.assertEquals(\"covariance matrix\", expectedCovariance, covarianceMatrix, 10E-9);\n    }\n}\n",
