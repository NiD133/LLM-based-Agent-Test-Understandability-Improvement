  "last_code": "package org.apache.commons.math4.legacy.stat.correlation;\n\nimport org.apache.commons.math4.legacy.TestUtils;\nimport org.apache.commons.math4.legacy.linear.Array2DRowRealMatrix;\nimport org.apache.commons.math4.legacy.linear.RealMatrix;\nimport org.junit.Test;\n\n/**\n * Tests {@link Covariance} using the Swiss Fertility dataset from R.\n *\n * The dataset contains 47 observations across 5 variables:\n *   Fertility, Agriculture, Examination, Education, Catholic\n */\npublic class CovarianceTest_testSwissFertility {\n\n    // Swiss Fertility dataset: 47 provinces × 5 variables\n    // Variables: Fertility, Agriculture, Examination, Education, Catholic\n    private static final int SWISS_ROWS = 47;\n    private static final int SWISS_COLS = 5;\n\n    private static final double[] swissData = new double[] {\n        80.2,  17.0, 15, 12,  9.96,\n        83.1,  45.1,  6,  9, 84.84,\n        92.5,  39.7,  5,  5, 93.40,\n        85.8,  36.5, 12,  7, 33.77,\n        76.9,  43.5, 17, 15,  5.16,\n        76.1,  35.3,  9,  7, 90.57,\n        83.8,  70.2, 16,  7, 92.85,\n        92.4,  67.8, 14,  8, 97.16,\n        82.4,  53.3, 12,  7, 97.67,\n        82.9,  45.2, 16, 13, 91.38,\n        87.1,  64.5, 14,  6, 98.61,\n        64.1,  62.0, 21, 12,  8.52,\n        66.9,  67.5, 14,  7,  2.27,\n        68.9,  60.7, 19, 12,  4.43,\n        61.7,  69.3, 22,  5,  2.82,\n        68.3,  72.6, 18,  2, 24.20,\n        71.7,  34.0, 17,  8,  3.30,\n        55.7,  19.4, 26, 28, 12.11,\n        54.3,  15.2, 31, 20,  2.15,\n        65.1,  73.0, 19,  9,  2.84,\n        65.5,  59.8, 22, 10,  5.23,\n        65.0,  55.1, 14,  3,  4.52,\n        56.6,  50.9, 22, 12, 15.14,\n        57.4,  54.1, 20,  6,  4.20,\n        72.5,  71.2, 12,  1,  2.40,\n        74.2,  58.1, 14,  8,  5.23,\n        72.0,  63.5,  6,  3,  2.56,\n        60.5,  60.8, 16, 10,  7.72,\n        58.3,  26.8, 25, 19, 18.46,\n        65.4,  49.5, 15,  8,  6.10,\n        75.5,  85.9,  3,  2, 99.71,\n        69.3,  84.9,  7,  6, 99.68,\n        77.3,  89.7,  5,  2,100.00,\n        70.5,  78.2, 12,  6, 98.96,\n        79.4,  64.9,  7,  3, 98.22,\n        65.0,  75.9,  9,  9, 99.06,\n        92.2,  84.6,  3,  3, 99.46,\n        79.3,  63.1, 13, 13, 96.83,\n        70.4,  38.4, 26, 12,  5.62,\n        65.7,   7.7, 29, 11, 13.79,\n        72.7,  16.7, 22, 13, 11.22,\n        64.4,  17.6, 35, 32, 16.92,\n        77.6,  37.6, 15,  7,  4.97,\n        67.6,  18.7, 25,  7,  8.65,\n        35.0,   1.2, 37, 53, 42.34,\n        44.7,  46.6, 16, 29, 50.43,\n        42.8,  27.7, 22, 29, 58.33\n    };\n\n    // Expected 5×5 covariance matrix computed by R for the Swiss Fertility dataset.\n    // Rows/cols correspond to: Fertility, Agriculture, Examination, Education, Catholic\n    private static final double[] expectedCovarianceData = new double[] {\n         156.0424976873265,  100.1691489361702,  -64.36692876965772,  -79.7295097132285,  241.5632030527289,\n         100.169148936170251, 515.7994172062905, -124.39283071230344, -139.6574005550416,  379.9043755781684,\n         -64.3669287696577, -124.3928307123034,   63.64662349676226,   53.5758556891767,  -190.5606105457909,\n         -79.7295097132285, -139.6574005550416,   53.57585568917669,   92.4560592044403,   -61.6988297872340,\n         241.5632030527289,  379.9043755781684, -190.56061054579092,  -61.6988297872340,  1739.2945371877890\n    };\n\n    private static final double COMPARISON_TOLERANCE = 10E-13;\n\n    private RealMatrix createRealMatrix(double[] data, int nRows, int nCols) {\n        double[][] matrixData = new double[nRows][nCols];\n        int ptr = 0;\n        for (int i = 0; i < nRows; i++) {\n            System.arraycopy(data, ptr, matrixData[i], 0, nCols);\n            ptr += nCols;\n        }\n        return new Array2DRowRealMatrix(matrixData);\n    }\n\n    /**\n     * Verifies that {@link Covariance} produces the correct 5×5 covariance matrix\n     * for the Swiss Fertility dataset, cross-checked against values computed by R.\n     */\n    @Test\n    public void testSwissFertility() {\n        RealMatrix swissMatrix = createRealMatrix(swissData, SWISS_ROWS, SWISS_COLS);\n\n        RealMatrix actualCovariance = new Covariance(swissMatrix).getCovarianceMatrix();\n\n        RealMatrix expectedCovariance = createRealMatrix(expectedCovarianceData, SWISS_COLS, SWISS_COLS);\n        TestUtils.assertEquals(\"covariance matrix\", expectedCovariance, actualCovariance, COMPARISON_TOLERANCE);\n    }\n}\n",
