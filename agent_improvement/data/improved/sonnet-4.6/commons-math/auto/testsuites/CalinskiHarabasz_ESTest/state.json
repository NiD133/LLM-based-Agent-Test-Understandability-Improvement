  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 15:22:07 GMT 2026\n */\n\npackage org.apache.commons.math4.legacy.ml.clustering.evaluation;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.LinkedList;\nimport org.apache.commons.math4.legacy.ml.clustering.Cluster;\nimport org.apache.commons.math4.legacy.ml.clustering.DoublePoint;\nimport org.apache.commons.math4.legacy.ml.clustering.evaluation.CalinskiHarabasz;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class CalinskiHarabasz_ESTest extends CalinskiHarabasz_ESTest_scaffolding {\n\n  // With only one empty cluster there is no within-cluster spread to compute the index,\n  // so the implementation signals this by throwing RuntimeException(\"insufficient data\").\n  @Test(timeout = 4000)\n  public void test0()  throws Throwable  {\n      CalinskiHarabasz evaluator = new CalinskiHarabasz();\n      LinkedList<Cluster<DoublePoint>> clusters = new LinkedList<Cluster<DoublePoint>>();\n      Cluster<DoublePoint> emptyCluster = new Cluster<DoublePoint>();\n      clusters.push(emptyCluster);\n      // Undeclared exception!\n      try {\n        evaluator.score(clusters);\n        fail(\"Expecting exception: RuntimeException\");\n      } catch (RuntimeException e) {\n         //\n         // insufficient data\n         //\n         verifyException(\"org.apache.commons.math4.legacy.ml.clustering.evaluation.CalinskiHarabasz\", e);\n      }\n  }\n\n  // A higher Calinski-Harabasz score indicates better-separated clusters,\n  // so 1.0 should be judged better than 0.0.\n  @Test(timeout = 4000)\n  public void test1()  throws Throwable  {\n      CalinskiHarabasz evaluator = new CalinskiHarabasz();\n      boolean higherIsBetter = evaluator.isBetterScore(1.0, 0.0);\n      assertTrue(higherIsBetter);\n  }\n\n  // A lower score is not better: 1023.56 should not beat 2869.54.\n  @Test(timeout = 4000)\n  public void test2()  throws Throwable  {\n      CalinskiHarabasz evaluator = new CalinskiHarabasz();\n      boolean lowerIsNotBetter = evaluator.isBetterScore(1023.5644983, 2869.5372);\n      assertFalse(lowerIsNotBetter);\n  }\n\n  // With a single cluster (k=1), the between-cluster term k-1 equals zero,\n  // causing a division by zero that yields NaN.\n  @Test(timeout = 4000)\n  public void test3()  throws Throwable  {\n      CalinskiHarabasz evaluator = new CalinskiHarabasz();\n      LinkedList<Cluster<DoublePoint>> clusters = new LinkedList<Cluster<DoublePoint>>();\n      Cluster<DoublePoint> singleCluster = new Cluster<DoublePoint>();\n\n      int[] allZeros = new int[5];\n      DoublePoint firstPoint = new DoublePoint(allZeros);\n      singleCluster.addPoint(firstPoint);\n\n      allZeros[4] = 71;                               // modify array in-place to create a different point\n      DoublePoint secondPoint = new DoublePoint(allZeros);\n      singleCluster.addPoint(secondPoint);\n\n      clusters.add(singleCluster);\n      double score = evaluator.score(clusters);\n      assertEquals(Double.NaN, score, 0.01);\n  }\n\n  // With a single cluster containing exactly one point both the within-cluster\n  // and between-cluster sums of squares collapse; the implementation returns 1.0.\n  @Test(timeout = 4000)\n  public void test4()  throws Throwable  {\n      CalinskiHarabasz evaluator = new CalinskiHarabasz();\n      LinkedList<Cluster<DoublePoint>> clusters = new LinkedList<Cluster<DoublePoint>>();\n      Cluster<DoublePoint> singleCluster = new Cluster<DoublePoint>();\n\n      int[] coordinates = new int[5];\n      DoublePoint singlePoint = new DoublePoint(coordinates);\n      singleCluster.addPoint(singlePoint);\n\n      clusters.add(singleCluster);\n      double score = evaluator.score(clusters);\n      assertEquals(1.0, score, 0.01);\n  }\n}\n",
