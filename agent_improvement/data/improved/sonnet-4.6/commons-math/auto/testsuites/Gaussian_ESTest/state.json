  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 14:29:50 GMT 2026\n */\n\npackage org.apache.commons.math4.legacy.analysis.function;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.math4.legacy.analysis.differentiation.DerivativeStructure;\nimport org.apache.commons.math4.legacy.analysis.function.Gaussian;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Gaussian_ESTest extends Gaussian_ESTest_scaffolding {\n\n  /**\n   * Verifies that Gaussian.Parametric.value() returns 0.0 when the normalization\n   * factor (param[0]) is zero, regardless of the input x value.\n   * Parameters: [norm=0.0, mean=0.0, sigma=2.0], x=2.0 → result should be 0.0.\n   */\n  @Test(timeout = 4000)\n  public void test0()  throws Throwable  {\n      Gaussian.Parametric parametric = new Gaussian.Parametric();\n      // params: [norm=0.0, mean=0.0, sigma=2.0]\n      double[] params = new double[3];\n      params[2] = 2.0;\n      double result = parametric.value(2.0, params);\n      assertEquals(0.0, result, 0.01);\n  }\n\n  /**\n   * Verifies that a default Gaussian (mean=0, sigma=1) evaluated at a very large\n   * DerivativeStructure value (12^12) returns effectively 0.0, since the input\n   * is astronomically far from the mean.\n   */\n  @Test(timeout = 4000)\n  public void test1()  throws Throwable  {\n      Gaussian gaussian = new Gaussian();\n      // Create a DerivativeStructure representing the constant 12 (0 free variables, order 12)\n      DerivativeStructure constantTwelve = new DerivativeStructure(0, 12, 12);\n      // Raise 12.0 to the power of that DS → very large constant value\n      DerivativeStructure veryLargeValue = DerivativeStructure.pow((double) 12, constantTwelve);\n      DerivativeStructure gaussianResult = gaussian.value(veryLargeValue);\n      // Gaussian far from mean evaluates to ~0\n      assertEquals(0.0, gaussianResult.getValue(), 0.01);\n  }\n\n  /**\n   * Verifies that a default Gaussian (mean=0, sigma=1) evaluated at x=12 via a\n   * DerivativeStructure returns the expected tiny positive value (~2.15e-32),\n   * matching exp(-72) for x=12 away from the mean.\n   */\n  @Test(timeout = 4000)\n  public void test2()  throws Throwable  {\n      Gaussian gaussian = new Gaussian();\n      // Create a DerivativeStructure representing the constant 12 (0 free variables, order 12)\n      DerivativeStructure xEqualstwelve = new DerivativeStructure(0, 12, 12);\n      DerivativeStructure gaussianResult = gaussian.value(xEqualstwelve);\n      assertEquals(2.1463837356630605E-32, gaussianResult.getValue(), 0.01);\n  }\n\n  /**\n   * Verifies Gaussian.Parametric.gradient() when x equals mean (x=1530.0) and\n   * sigma=1530.0. The gradient with respect to norm is exp(-0.5) ≈ 0.6065.\n   * The gradients with respect to mean and sigma are both 0.0 (since x == mean).\n   * Parameters: [norm=0.0, mean=0.0, sigma=1530.0], x=1530.0.\n   */\n  @Test(timeout = 4000)\n  public void test3()  throws Throwable  {\n      Gaussian.Parametric parametric = new Gaussian.Parametric();\n      // params: [norm=0.0, mean=0.0, sigma=1530.0]\n      double[] params = new double[3];\n      params[2] = 1530.0;\n      double[] gradient = parametric.gradient(1530.0, params);\n      assertArrayEquals(new double[] {0.6065306597126334, 0.0, 0.0}, gradient, 0.01);\n  }\n\n  /**\n   * Verifies that Gaussian.Parametric.gradient() throws a RuntimeException when\n   * the parameter array length is not 3. Here a 9-element array is passed instead.\n   */\n  @Test(timeout = 4000)\n  public void test4()  throws Throwable  {\n      Gaussian.Parametric parametric = new Gaussian.Parametric();\n      double[] wrongSizeParams = new double[9];\n      try {\n        parametric.gradient(1015.1462, wrongSizeParams);\n        fail(\"Expecting exception: RuntimeException\");\n\n      } catch(RuntimeException e) {\n         //\n         // 9 != 3\n         //\n         verifyException(\"org.apache.commons.math4.legacy.analysis.function.Gaussian$Parametric\", e);\n      }\n  }\n\n  /**\n   * Verifies that Gaussian.Parametric.gradient() throws NullPointerException\n   * when the parameter array is null.\n   */\n  @Test(timeout = 4000)\n  public void test5()  throws Throwable  {\n      Gaussian.Parametric parametric = new Gaussian.Parametric();\n      try {\n        parametric.gradient(0.9166666666666666, (double[]) null);\n        fail(\"Expecting exception: NullPointerException\");\n\n      } catch(NullPointerException e) {\n         //\n         // null is not allowed\n         //\n         verifyException(\"org.apache.commons.math4.legacy.analysis.function.Gaussian$Parametric\", e);\n      }\n  }\n\n  /**\n   * Verifies that constructing a Gaussian with sigma=0.0 throws a RuntimeException,\n   * since the standard deviation must be strictly positive.\n   */\n  @Test(timeout = 4000)\n  public void test6()  throws Throwable  {\n      Gaussian gaussian = null;\n      try {\n        gaussian = new Gaussian(1193.809784545181, 0.0);\n        fail(\"Expecting exception: RuntimeException\");\n\n      } catch(RuntimeException e) {\n         //\n         // 0 is smaller than, or equal to, the minimum (0)\n         //\n         verifyException(\"org.apache.commons.math4.legacy.analysis.function.Gaussian\", e);\n      }\n  }\n\n  /**\n   * Verifies that Gaussian.Parametric.value() throws a RuntimeException when\n   * sigma (param[2]) is 0.0, since a Gaussian requires a strictly positive\n   * standard deviation.\n   * Parameters: [norm=0.0, mean=0.0, sigma=0.0], x=2.0.\n   */\n  @Test(timeout = 4000)\n  public void test7()  throws Throwable  {\n      Gaussian.Parametric parametric = new Gaussian.Parametric();\n      // params: [norm=0.0, mean=0.0, sigma=0.0] — sigma=0 is invalid\n      double[] paramsWithZeroSigma = new double[3];\n      try {\n        parametric.value(2.0, paramsWithZeroSigma);\n        fail(\"Expecting exception: RuntimeException\");\n\n      } catch(RuntimeException e) {\n         //\n         // 0 is smaller than, or equal to, the minimum (0)\n         //\n         verifyException(\"org.apache.commons.math4.legacy.analysis.function.Gaussian$Parametric\", e);\n      }\n  }\n\n  /**\n   * Verifies that a default Gaussian (mean=0, sigma=1) evaluated at a very large\n   * negative x value (-2892.35) returns effectively 0.0, since the input is far\n   * from the mean.\n   */\n  @Test(timeout = 4000)\n  public void test8()  throws Throwable  {\n      Gaussian gaussian = new Gaussian();\n      double result = gaussian.value(-2892.35172268);\n      assertEquals(0.0, result, 0.01);\n  }\n}\n",
