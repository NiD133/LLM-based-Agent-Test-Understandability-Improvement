  }\n\n  /**\n   * Verifies that a SummaryStatistics created via the copy constructor is a distinct object\n   * and not equal to the original instance.\n   */\n  @Test(timeout = 4000)\n  public void test06()  throws Throwable  {\n      SummaryStatistics original = new SummaryStatistics();\n      SummaryStatistics copy = new SummaryStatistics(original);\n      assertFalse(copy.equals((Object) original));\n  }\n\n  /**\n   * Verifies that the static copy(source, dest) method works correctly when both arguments\n   * are the same instance and custom implementations are configured.\n   */\n  @Test(timeout = 4000)\n  public void test07()  throws Throwable  {\n      SummaryStatistics stats = new SummaryStatistics();\n      Statistics.StorelessGeometricMean geometricMeanImpl = Statistics.StorelessGeometricMean.create();\n      stats.setSumImpl(geometricMeanImpl);\n      stats.setMaxImpl(geometricMeanImpl);\n      stats.setVarianceImpl(geometricMeanImpl);\n      stats.setMinImpl(geometricMeanImpl);\n      stats.setMeanImpl(geometricMeanImpl);\n      SummaryStatistics.copy(stats, stats);\n      assertEquals(0L, stats.getN());\n  }\n\n  /**\n   * Verifies that copy() returns a new instance that is not the same object as the original.\n   */\n  @Test(timeout = 4000)\n  public void test08()  throws Throwable  {\n      SummaryStatistics original = new SummaryStatistics();\n      SummaryStatistics copy = original.copy();\n      assertNotSame(copy, original);\n  }\n\n  /**\n   * Verifies that getMaxImpl returns null when no custom max implementation has been set.\n   */\n  @Test(timeout = 4000)\n  public void test09()  throws Throwable  {\n      SummaryStatistics stats = new SummaryStatistics();\n      StorelessUnivariateStatistic maxImpl = stats.getMaxImpl();\n      assertNull(maxImpl);\n  }\n\n  /**\n   * Verifies that getMinImpl returns null when no custom min implementation has been set.\n   */\n  @Test(timeout = 4000)\n  public void test10()  throws Throwable  {\n      SummaryStatistics stats = new SummaryStatistics();\n      StorelessUnivariateStatistic minImpl = stats.getMinImpl();\n      assertNull(minImpl);\n  }\n\n  /**\n   * Verifies that getSumImpl returns null when no custom sum implementation has been set.\n   */\n  @Test(timeout = 4000)\n  public void test11()  throws Throwable  {\n      SummaryStatistics stats = new SummaryStatistics();\n      StorelessUnivariateStatistic sumImpl = stats.getSumImpl();\n      assertNull(sumImpl);\n  }\n\n  /**\n   * Verifies that toString() returns the expected formatted string for an empty instance\n   * where all statistics are NaN.\n   */\n  @Test(timeout = 4000)\n  public void test12()  throws Throwable  {\n      SummaryStatistics stats = new SummaryStatistics();\n      String result = stats.toString();\n      assertEquals(\"SummaryStatistics:\\nn: 0\\nmin: NaN\\nmax: NaN\\nsum: NaN\\nmean: NaN\\nvariance: NaN\\nstandard deviation: NaN\\n\", result);\n  }\n\n  /**\n   * Verifies that getSummary() returns a StatisticalSummary whose sum is NaN for an empty instance.\n   */\n  @Test(timeout = 4000)\n  public void test13()  throws Throwable  {\n      SummaryStatistics stats = new SummaryStatistics();\n      StatisticalSummary summary = stats.getSummary();\n      assertEquals(Double.NaN, summary.getSum(), 0.01);\n  }\n\n  /**\n   * Verifies that getVarianceImpl returns null when no custom variance implementation has been set.\n   */\n  @Test(timeout = 4000)\n  public void test14()  throws Throwable  {\n      SummaryStatistics stats = new SummaryStatistics();\n      StorelessUnivariateStatistic varianceImpl = stats.getVarianceImpl();\n      assertNull(varianceImpl);\n  }\n}\n",
