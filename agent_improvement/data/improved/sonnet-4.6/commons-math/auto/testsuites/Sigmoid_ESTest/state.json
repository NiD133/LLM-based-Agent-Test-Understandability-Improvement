  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Mon Jun 15 15:05:52 GMT 2026\n */\n\npackage org.apache.commons.math4.legacy.analysis.function;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport org.apache.commons.math4.legacy.analysis.differentiation.DerivativeStructure;\nimport org.apache.commons.math4.legacy.analysis.function.Sigmoid;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Sigmoid_ESTest extends Sigmoid_ESTest_scaffolding {\n\n    // Sigmoid(lo, hi) maps to lo as x -> -infinity and hi as x -> +infinity.\n    // The midpoint value at x=0 is (lo + hi) / 2.\n\n    @Test(timeout = 4000)\n    public void test_valueWithDerivativeStructure_returnsLowerAsymptoteForVeryNegativeInput() throws Throwable {\n        // Sigmoid with lo=33.18, hi≈0; at x=-1023 the output saturates toward lo.\n        double lowerAsymptote = 33.182076530840796;\n        double upperAsymptote = 1.2246467991473532E-16;\n        Sigmoid sigmoid = new Sigmoid(lowerAsymptote, upperAsymptote);\n\n        // DerivativeStructure(params=620, order=0, value=-1023.14) – zeroth-order only\n        DerivativeStructure input = new DerivativeStructure(620, 0, -1023.143076);\n        DerivativeStructure result = sigmoid.value(input);\n\n        assertEquals(lowerAsymptote, result.getValue(), 0.01);\n    }\n\n    @Test(timeout = 4000)\n    public void test_valueWithDerivativeStructure_returnsMidpointForZeroInput() throws Throwable {\n        // Sigmoid(lo=0.0667, hi=0): midpoint at x=0 is (lo + hi) / 2 ≈ 0.0333\n        double lowerAsymptote = 0.06666666666666667;\n        double upperAsymptote = 0.0;\n        Sigmoid sigmoid = new Sigmoid(lowerAsymptote, upperAsymptote);\n\n        // DerivativeStructure(params=4, order=4, value=0.0)\n        DerivativeStructure input = new DerivativeStructure(4, 4, 0.0);\n        DerivativeStructure result = sigmoid.value(input);\n\n        double expectedMidpoint = (lowerAsymptote + upperAsymptote) / 2.0;\n        assertEquals(expectedMidpoint, result.getValue(), 0.01);\n    }\n\n    @Test(timeout = 4000)\n    public void test_parametricGradient_throwsWhenParameterArrayHasWrongSize() throws Throwable {\n        // Parametric requires exactly 2 parameters [lo, hi]; passing 1 triggers a RuntimeException.\n        Sigmoid.Parametric parametric = new Sigmoid.Parametric();\n        double[] oneParam = new double[1];\n\n        try {\n            parametric.gradient(-743.321909624, oneParam);\n            fail(\"Expecting exception: RuntimeException\");\n        } catch (RuntimeException e) {\n            // \"1 != 2\" – the parameter count mismatch message\n            verifyException(\"org.apache.commons.math4.legacy.analysis.function.Sigmoid$Parametric\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test_parametricGradient_throwsOnNullParameters() throws Throwable {\n        // Passing null instead of a parameter array must raise NullPointerException.\n        Sigmoid.Parametric parametric = new Sigmoid.Parametric();\n\n        try {\n            parametric.gradient(1.0, (double[]) null);\n            fail(\"Expecting exception: NullPointerException\");\n        } catch (NullPointerException e) {\n            // \"null is not allowed\"\n            verifyException(\"org.apache.commons.math4.legacy.analysis.function.Sigmoid$Parametric\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test_defaultConstructor_createsInstanceWithoutException() throws Throwable {\n        // The no-arg constructor should succeed (default lo=0, hi=1).\n        Sigmoid sigmoid = new Sigmoid();\n    }\n\n    @Test(timeout = 4000)\n    public void test_applyAsDouble_returnsCorrectValueForPositiveInput() throws Throwable {\n        // Sigmoid(lo=0.0667, hi=0).applyAsDouble(0.625) should return a value less than lo/2.\n        Sigmoid sigmoid = new Sigmoid(0.06666666666666667, 0.0);\n\n        double result = sigmoid.applyAsDouble(0.625);\n\n        assertEquals(0.023243009022263054, result, 0.01);\n    }\n\n    @Test(timeout = 4000)\n    public void test_parametricGradient_returnsCorrectGradientForVeryNegativeX() throws Throwable {\n        // At x=-20 with params [lo=0, hi=0], the gradient w.r.t. lo is nearly 1 (sigmoid≈1)\n        // and the gradient w.r.t. hi is nearly 0.\n        Sigmoid.Parametric parametric = new Sigmoid.Parametric();\n        double[] params = new double[2]; // [lo=0.0, hi=0.0]\n\n        double[] gradient = parametric.gradient(-20.0, params);\n\n        assertArrayEquals(new double[]{0.9999999979388464, 2.0611536181902037E-9}, gradient, 0.01);\n    }\n\n    @Test(timeout = 4000)\n    public void test_parametricValue_returnsZeroWhenBothAsymptotesAreZero() throws Throwable {\n        // With lo=0 and hi=0, the sigmoid value is always 0 regardless of x.\n        Sigmoid.Parametric parametric = new Sigmoid.Parametric();\n        double[] params = new double[2]; // [lo=0.0, hi=0.0]\n\n        double result = parametric.value(0.0, params);\n\n        assertEquals(0.0, result, 0.01);\n    }\n}\n",
