  "last_code": "package org.threeten.extra;\n\nimport static org.junit.jupiter.api.Assertions.assertThrows;\n\nimport java.time.DateTimeException;\nimport java.time.LocalTime;\n\nimport org.junit.jupiter.api.Test;\n\npublic class TestQuarter_test_from_TemporalAccessorl_invalid_noDerive {\n\n    /**\n     * Verifies that Quarter.from() throws DateTimeException when given a temporal\n     * object (LocalTime) that carries no quarter-of-year information and cannot be\n     * derived to one.\n     */\n    @Test\n    public void test_from_TemporalAccessorl_invalid_noDerive() {\n        assertThrows(DateTimeException.class, () -> Quarter.from(LocalTime.of(12, 30)));\n    }\n}\n",
