  "last_code": "package org.threeten.extra;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport static org.junit.jupiter.api.Assertions.assertThrows;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\nimport java.io.Serializable;\nimport java.time.Duration;\nimport java.time.LocalTime;\nimport java.time.format.DateTimeParseException;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.MethodSource;\nimport com.google.common.testing.EqualsTester;\n\npublic class TestMinutes_test_plus_int {\n\n    //-----------------------------------------------------------------------\n    public static Object[][] data_valid() {\n        return new Object[][] {\n            { \"PT0M\",          0              },\n            { \"PT1M\",          1              },\n            { \"PT2M\",          2              },\n            { \"PT123456789M\",  123456789      },\n            { \"PT+0M\",         0              },\n            { \"PT+2M\",         2              },\n            { \"PT-0M\",         0              },\n            { \"PT-2M\",         -2             },\n            { \"PT0H\",          0              },\n            { \"PT1H\",          60             },\n            { \"PT2H\",          120            },\n            { \"PT1234H\",       1234 * 60      },\n            { \"PT+0H\",         0              },\n            { \"PT+2H\",         120            },\n            { \"PT-0H\",         0              },\n            { \"PT-2H\",         -120           },\n            { \"P0D\",           0              },\n            { \"P1D\",           1 * 24 * 60    },\n            { \"P2D\",           2 * 24 * 60    },\n            { \"P1234D\",        1234 * 24 * 60 },\n            { \"P+0D\",          0              },\n            { \"P+2D\",          2 * 24 * 60    },\n            { \"P-0D\",          0              },\n            { \"P-2D\",          -2 * 24 * 60   },\n            { \"PT0H0M\",        0              },\n            { \"PT2H3M\",        123            },\n            { \"PT+2H3M\",       123            },\n            { \"PT2H+3M\",       123            },\n            { \"PT-2H3M\",       -117           },\n            { \"PT2H-3M\",       117            },\n            { \"PT-2H-3M\",      -123           },\n            { \"P0DT0H0M\",      0              },\n            { \"P5DT2H4M\",      5 * 24 * 60 + 2 * 60 + 4 },\n        };\n    }\n\n    public static Object[][] data_invalid() {\n        return new Object[][] {\n            { \"P3W\"   },\n            { \"P3Q\"   },\n            { \"P1M2Y\" },\n            { \"3\"     },\n            { \"-3\"    },\n            { \"3M\"    },\n            { \"-3M\"   },\n            { \"P3M\"   },\n            { \"P3\"    },\n            { \"P-3\"   },\n            { \"PM\"    },\n            { \"T3\"    },\n            { \"P3M\"   },\n            { \"PT3S\"  },\n            { \"PT3\"   },\n        };\n    }\n\n    //-----------------------------------------------------------------------\n    @Test\n    public void test_plus_int() {\n        Minutes test5 = Minutes.of(5);\n\n        // Adding zero should return the same value unchanged\n        assertEquals(Minutes.of(5), test5.plus(0),\n                \"Adding zero minutes should leave the value unchanged\");\n\n        // Adding a positive number should increase the total\n        assertEquals(Minutes.of(7), test5.plus(2),\n                \"5 minutes plus 2 should equal 7 minutes\");\n\n        // Adding a negative number should decrease the total\n        assertEquals(Minutes.of(3), test5.plus(-2),\n                \"5 minutes plus -2 should equal 3 minutes\");\n\n        // Adding 1 to Integer.MAX_VALUE - 1 should reach Integer.MAX_VALUE without overflow\n        assertEquals(Minutes.of(Integer.MAX_VALUE), Minutes.of(Integer.MAX_VALUE - 1).plus(1),\n                \"Adding 1 to MAX_VALUE-1 should reach Integer.MAX_VALUE\");\n\n        // Adding -1 to Integer.MIN_VALUE + 1 should reach Integer.MIN_VALUE without overflow\n        assertEquals(Minutes.of(Integer.MIN_VALUE), Minutes.of(Integer.MIN_VALUE + 1).plus(-1),\n                \"Adding -1 to MIN_VALUE+1 should reach Integer.MIN_VALUE\");\n    }\n}\n",
