  "last_code": "package org.threeten.extra;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.MethodSource;\n\npublic class TestMinutes_test_parse_CharSequence_valid {\n\n    public static Object[][] data_valid() {\n        return new Object[][] {\n            // Minutes only\n            { \"PT0M\",         0 },\n            { \"PT1M\",         1 },\n            { \"PT2M\",         2 },\n            { \"PT123456789M\", 123456789 },\n            { \"PT+0M\",        0 },\n            { \"PT+2M\",        2 },\n            { \"PT-0M\",        0 },\n            { \"PT-2M\",        -2 },\n\n            // Hours only (converted to minutes)\n            { \"PT0H\",    0 },\n            { \"PT1H\",    60 },\n            { \"PT2H\",    120 },\n            { \"PT1234H\", 1234 * 60 },\n            { \"PT+0H\",   0 },\n            { \"PT+2H\",   120 },\n            { \"PT-0H\",   0 },\n            { \"PT-2H\",   -120 },\n\n            // Days only (converted to minutes)\n            { \"P0D\",    0 },\n            { \"P1D\",    1 * 24 * 60 },\n            { \"P2D\",    2 * 24 * 60 },\n            { \"P1234D\", 1234 * 24 * 60 },\n            { \"P+0D\",   0 },\n            { \"P+2D\",   2 * 24 * 60 },\n            { \"P-0D\",   0 },\n            { \"P-2D\",   -2 * 24 * 60 },\n\n            // Hours and minutes combined\n            { \"PT0H0M\",  0 },\n            { \"PT2H3M\",  123 },\n            { \"PT+2H3M\", 123 },\n            { \"PT2H+3M\", 123 },\n            { \"PT-2H3M\", -117 },\n            { \"PT2H-3M\", 117 },\n            { \"PT-2H-3M\", -123 },\n\n            // Days, hours, and minutes combined\n            { \"P0DT0H0M\",  0 },\n            { \"P5DT2H4M\",  5 * 24 * 60 + 2 * 60 + 4 },\n        };\n    }\n\n    @ParameterizedTest\n    @MethodSource(\"data_valid\")\n    public void test_parse_CharSequence_valid(String str, int expectedMinutes) {\n        assertEquals(Minutes.of(expectedMinutes), Minutes.parse(str));\n    }\n}\n",
