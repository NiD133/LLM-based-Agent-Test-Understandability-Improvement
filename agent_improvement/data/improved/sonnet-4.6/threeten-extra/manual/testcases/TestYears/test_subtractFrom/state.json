  "last_code": "package org.threeten.extra;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\nimport java.time.LocalDate;\n\nimport org.junit.jupiter.api.Test;\n\npublic class TestYears_test_subtractFrom {\n\n    @Test\n    public void test_subtractFrom_zeroYears_returnsUnchangedDate() {\n        LocalDate originalDate = LocalDate.of(2019, 1, 10);\n        LocalDate result = (LocalDate) Years.of(0).subtractFrom(originalDate);\n        assertEquals(originalDate, result);\n    }\n\n    @Test\n    public void test_subtractFrom_fiveYears_returnsDateFiveYearsEarlier() {\n        LocalDate startDate = LocalDate.of(2019, 1, 10);\n        LocalDate expectedDate = LocalDate.of(2014, 1, 10);\n        LocalDate result = (LocalDate) Years.of(5).subtractFrom(startDate);\n        assertEquals(expectedDate, result);\n    }\n}\n",
