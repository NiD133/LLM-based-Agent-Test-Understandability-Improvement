  "last_code": "package org.threeten.extra;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.MethodSource;\n\npublic class TestMonths_test_parse_CharSequence_valid_initialPlus {\n\n    public static Object[][] data_valid() {\n        return new Object[][] {\n            { \"P0M\",          0 },\n            { \"P1M\",          1 },\n            { \"P2M\",          2 },\n            { \"P123456789M\",  123456789 },\n            { \"P+0M\",         0 },\n            { \"P+2M\",         2 },\n            { \"P-0M\",         0 },\n            { \"P-2M\",        -2 },\n            { \"P0Y\",          0 },\n            { \"P1Y\",         12 },\n            { \"P2Y\",         24 },\n            { \"P1234567Y\",    1234567 * 12 },\n            { \"P+0Y\",         0 },\n            { \"P+2Y\",        24 },\n            { \"P-0Y\",         0 },\n            { \"P-2Y\",       -24 },\n            { \"P0Y0M\",        0 },\n            { \"P2Y3M\",       27 },\n            { \"P+2Y3M\",      27 },\n            { \"P2Y+3M\",      27 },\n            { \"P-2Y3M\",     -21 },\n            { \"P2Y-3M\",      21 },\n            { \"P-2Y-3M\",    -27 },\n        };\n    }\n\n    @ParameterizedTest\n    @MethodSource(\"data_valid\")\n    public void test_parse_CharSequence_valid_initialPlus(String str, int expectedMonths) {\n        assertEquals(Months.of(expectedMonths), Months.parse(\"+\" + str));\n    }\n}\n",
