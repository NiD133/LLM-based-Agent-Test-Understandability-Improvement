  "last_code": "package org.threeten.extra;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.MethodSource;\n\npublic class TestSeconds_test_parse_CharSequence_valid_initialMinus {\n\n    public static Object[][] data_valid() {\n        return new Object[][] {\n            { \"PT0S\",          0 },\n            { \"PT1S\",          1 },\n            { \"PT2S\",          2 },\n            { \"PT123456789S\",  123456789 },\n            { \"PT+0S\",         0 },\n            { \"PT+2S\",         2 },\n            { \"PT-0S\",         0 },\n            { \"PT-2S\",         -2 },\n            { \"PT0M\",          0 },\n            { \"PT1M\",          60 },\n            { \"PT2M\",          120 },\n            { \"PT1234M\",       1234 * 60 },\n            { \"PT+0M\",         0 },\n            { \"PT+2M\",         120 },\n            { \"PT-0M\",         0 },\n            { \"PT-2M\",         -120 },\n            { \"PT0H\",          0 },\n            { \"PT1H\",          60 * 60 },\n            { \"PT2H\",          120 * 60 },\n            { \"PT1234H\",       1234 * 60 * 60 },\n            { \"PT+0H\",         0 },\n            { \"PT+2H\",         120 * 60 },\n            { \"PT-0H\",         0 },\n            { \"PT-2H\",         -120 * 60 },\n            { \"P0D\",           0 },\n            { \"P1D\",           60 * 60 * 24 },\n            { \"P2D\",           120 * 60 * 24 },\n            { \"P1234D\",        1234 * 60 * 60 * 24 },\n            { \"P+0D\",          0 },\n            { \"P+2D\",          120 * 60 * 24 },\n            { \"P-0D\",          0 },\n            { \"P-2D\",          -120 * 60 * 24 },\n            { \"PT0M0S\",        0 },\n            { \"PT2M3S\",        2 * 60 + 3 },\n            { \"PT+2M3S\",       2 * 60 + 3 },\n            { \"PT2M+3S\",       2 * 60 + 3 },\n            { \"PT-2M3S\",       -2 * 60 + 3 },\n            { \"PT2M-3S\",       2 * 60 - 3 },\n            { \"PT-2M-3S\",      -2 * 60 - 3 },\n            { \"PT0H0S\",        0 },\n            { \"PT2H3S\",        2 * 3600 + 3 },\n            { \"PT+2H3S\",       2 * 3600 + 3 },\n            { \"PT2H+3S\",       2 * 3600 + 3 },\n            { \"PT-2H3S\",       -2 * 3600 + 3 },\n            { \"PT2H-3S\",       2 * 3600 - 3 },\n            { \"PT-2H-3S\",      -2 * 3600 - 3 },\n            { \"P0DT0H0M0S\",    0 },\n            { \"P5DT2H4M3S\",    5 * 86400 + 2 * 3600 + 4 * 60 + 3 },\n        };\n    }\n\n    // Prepending \"-\" to a valid ISO duration string must negate the parsed result.\n    @ParameterizedTest\n    @MethodSource(\"data_valid\")\n    public void test_parse_CharSequence_valid_initialMinus(String str, int expectedSeconds) {\n        assertEquals(Seconds.of(-expectedSeconds), Seconds.parse(\"-\" + str));\n    }\n}\n",
