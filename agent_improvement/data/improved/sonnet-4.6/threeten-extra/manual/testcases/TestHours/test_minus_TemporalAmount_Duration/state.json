  "last_code": "package org.threeten.extra;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\nimport java.time.Duration;\n\nimport org.junit.jupiter.api.Test;\n\npublic class TestHours_test_minus_TemporalAmount_Duration {\n\n    @Test\n    public void test_minus_TemporalAmount_Duration() {\n        Hours fiveHours = Hours.of(5);\n\n        // Subtracting zero hours leaves the value unchanged\n        assertEquals(Hours.of(5), fiveHours.minus(Duration.ofHours(0)));\n\n        // Subtracting a positive duration decreases the hour count\n        assertEquals(Hours.of(3), fiveHours.minus(Duration.ofHours(2)));\n\n        // Subtracting a negative duration increases the hour count\n        assertEquals(Hours.of(7), fiveHours.minus(Duration.ofHours(-2)));\n\n        // Subtracting -1 hour from (MAX_VALUE - 1) reaches Integer.MAX_VALUE without overflow\n        assertEquals(Hours.of(Integer.MAX_VALUE),\n                Hours.of(Integer.MAX_VALUE - 1).minus(Duration.ofHours(-1)));\n\n        // Subtracting 1 hour from (MIN_VALUE + 1) reaches Integer.MIN_VALUE without overflow\n        assertEquals(Hours.of(Integer.MIN_VALUE),\n                Hours.of(Integer.MIN_VALUE + 1).minus(Duration.ofHours(1)));\n    }\n}\n",
