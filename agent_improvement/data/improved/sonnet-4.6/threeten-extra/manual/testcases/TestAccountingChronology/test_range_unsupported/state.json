  "last_code": "package org.threeten.extra.chrono;\n\nimport static java.time.temporal.ChronoField.MINUTE_OF_DAY;\nimport static org.junit.jupiter.api.Assertions.assertThrows;\n\nimport java.time.DayOfWeek;\nimport java.time.Month;\nimport java.time.temporal.UnsupportedTemporalTypeException;\n\nimport org.junit.jupiter.api.Test;\n\n/**\n * Verifies that querying a time-only field (MINUTE_OF_DAY) on an AccountingDate\n * throws UnsupportedTemporalTypeException, since AccountingDate is a date-only type.\n */\npublic class TestAccountingChronology_test_range_unsupported {\n\n    // A concrete AccountingChronology: ends on Sunday nearest end-of-August,\n    // divided into 13 equal 4-week months, leap week appended to month 13.\n    private static final AccountingChronology INSTANCE =\n            new AccountingChronologyBuilder()\n                    .endsOn(DayOfWeek.SUNDAY)\n                    .nearestEndOf(Month.AUGUST)\n                    .withDivision(AccountingYearDivision.THIRTEEN_EVEN_MONTHS_OF_4_WEEKS)\n                    .leapWeekInMonth(13)\n                    .toChronology();\n\n    @Test\n    public void test_range_unsupported() {\n        // MINUTE_OF_DAY is a time field; AccountingDate (a date-only type) must reject it.\n        assertThrows(\n                UnsupportedTemporalTypeException.class,\n                () -> INSTANCE.date(2012, 6, 28).range(MINUTE_OF_DAY));\n    }\n}\n",
