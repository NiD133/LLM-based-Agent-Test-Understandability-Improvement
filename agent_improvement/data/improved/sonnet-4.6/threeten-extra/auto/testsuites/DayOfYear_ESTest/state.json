yOfYear dayInUtcPlus18 = DayOfYear.now((ZoneId) utcPlus18);\n        DayOfYear dayInDefaultZone = DayOfYear.now();\n\n        assertFalse(dayInDefaultZone.equals(dayInUtcPlus18));\n        assertFalse(dayInUtcPlus18.equals((Object) dayInDefaultZone));\n        assertEquals(MOCKED_CURRENT_DAY, dayInDefaultZone.getValue());\n    }\n\n    // --- getValue() ---\n\n    @Test(timeout = 4000)\n    public void test_getValue_returnsCorrectDayNumber()  throws Throwable  {\n        DayOfYear dayOfYear = DayOfYear.now();\n        assertEquals(MOCKED_CURRENT_DAY, dayOfYear.getValue());\n    }\n\n    // --- isValidYear() ---\n\n    @Test(timeout = 4000)\n    public void test_isValidYear_day366WithLeapYear_returnsTrue()  throws Throwable  {\n        // Year -488 is a leap year, so day 366 is valid.\n        DayOfYear day366 = DayOfYear.of(LAST_DAY_OF_LEAP_YEAR);\n        boolean valid = day366.isValidYear(-488);\n        assertEquals(LAST_DAY_OF_LEAP_YEAR, day366.getValue());\n        assertTrue(valid);\n    }\n\n    @Test(timeout = 4000)\n    public void test_isValidYear_day366WithNonLeapYear_returnsFalse()  throws Throwable  {\n        // Year 366 is not a leap year, so day 366 is invalid for it.\n        DayOfYear day366 = DayOfYear.of(LAST_DAY_OF_LEAP_YEAR);\n        boolean valid = day366.isValidYear(366);\n        assertFalse(valid);\n    }\n\n    @Test(timeout = 4000)\n    public void test_isValidYear_dayLessThan366_alwaysReturnsTrue()  throws Throwable  {\n        // Any day before 366 is valid in every year regardless of leap status.\n        DayOfYear dayOfYear = DayOfYear.now();\n        boolean valid = dayOfYear.isValidYear(-1717);\n        assertEquals(MOCKED_CURRENT_DAY, dayOfYear.getValue());\n        assertTrue(valid);\n    }\n\n    // --- isSupported() ---\n\n    @Test(timeout = 4000)\n    public void test_isSupported_withDayOfYearField_returnsTrue()  throws Throwable  {\n        DayOfYear dayOfYear = DayOfYear.now();\n        boolean supported = dayOfYear.isSuppo