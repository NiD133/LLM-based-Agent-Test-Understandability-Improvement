 void testMinusSelfDurationPreservesInstant()  throws Throwable  {\n      Instant now = MockInstant.now();\n      UtcInstant utcInstant = UtcInstant.of(now);\n      Duration zeroDuration = utcInstant.durationUntil(utcInstant);\n      UtcInstant result = utcInstant.minus(zeroDuration);\n      assertTrue(result.equals((Object)utcInstant));\n      assertEquals(56702L, utcInstant.getModifiedJulianDay());\n      assertEquals(73281320000000L, result.getNanoOfDay());\n  }\n\n  @Test(timeout = 4000)\n  public void testHashCodeDoesNotThrow()  throws Throwable  {\n      Instant now = MockInstant.now();\n      UtcInstant utcInstant = UtcInstant.of(now);\n      utcInstant.hashCode();\n      assertEquals(73281320000000L, utcInstant.getNanoOfDay());\n      assertEquals(56702L, utcInstant.getModifiedJulianDay());\n  }\n\n  @Test(timeout = 4000)\n  public void testPlusNegativeDurationFromPastTaiInstant()  throws Throwable  {\n      TaiInstant taiInstant = TaiInstant.ofTaiSeconds((-745L), (-1000L));\n      UtcInstant utcInstant = UtcInstant.of(taiInstant);\n      Duration negativeOneThousandMinutes = Duration.ofMinutes((-1000L));\n      UtcInstant result = utcInstant.plus(negativeOneThousandMinutes);\n      assertEquals(36203L, utcInstant.getModifiedJulianDay());\n      assertEquals(36203L, result.getModifiedJulianDay());\n  }\n}\n",
