t(timeout = 4000)\n  public void testToStringIsCachedAcrossMultipleCalls()  throws Throwable  {\n      Instant epochPlusThreeSeconds = MockInstant.ofEpochSecond(3L);\n      UtcInstant utcInstant = UtcInstant.of(epochPlusThreeSeconds);\n      utcInstant.toString();\n      String result = utcInstant.toString();\n      assertNotNull(result);\n      assertEquals(\"1970-01-01T00:00:03Z\", result);\n  }\n\n  @Test(timeout = 4000)\n  public void testWithNanoOfDayProducesInequalInstance()  throws Throwable  {\n      Instant now = MockInstant.now();\n      UtcInstant original = UtcInstant.of(now);\n      UtcInstant withChangedNano = original.withNanoOfDay(1136L);\n      boolean isEqual = withChangedNano.equals(original);\n      assertEquals(56702L, original.getModifiedJulianDay());\n      assertFalse(isEqual);\n      assertEquals(56702L, withChangedNano.getModifiedJulianDay());\n      assertFalse(original.equals((Object)withChangedNano));\n  }\n\n  @Test(timeout = 4000)\n  public void testEqualsReturnsFalseForInstantsFromDifferentSources()  throws Throwable  {\n      Instant now = MockInstant.now();\n      TaiInstant largeTaiInstant = TaiInstant.ofTaiSeconds(36791000000652L, 36791000000652L);\n      UtcInstant fromTai = largeTaiInstant.toUtcInstant();\n      UtcInstant fromInstant = UtcInstant.of(now);\n      boolean isEqual = fromInstant.equals(fromTai);\n      assertEquals(56702L, fromInstant.getModifiedJulianDay());\n      assertFalse(isEqual);\n      assertEquals(73281320000000L, fromInstant.getNanoOfDay());\n  }\n\n  @Test(timeout = 4000)\n  public void testWithModifiedJulianDaySameValuePreservesEquality()  throws Throwable  {\n      UtcInstant original = UtcInstant.ofModifiedJulianDay(13L, 13L);\n      UtcInstant withSameDay = original.withModifiedJulianDay(13L);\n      boolean isEqual = withSameDay.equals(original);\n      assertEquals(13L, withSameDay.getModifiedJulianDay());\n      assertTrue(isEqual);\n  }\n\n  @Test(timeout = 4000)\n  public void testEqualsIsRefle