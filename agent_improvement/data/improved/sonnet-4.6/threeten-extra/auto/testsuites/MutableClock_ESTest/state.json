  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 03:08:54 GMT 2026\n */\n\npackage org.threeten.extra;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport java.time.Duration;\nimport java.time.Instant;\nimport java.time.ZoneOffset;\nimport java.time.temporal.ChronoField;\nimport java.time.temporal.ChronoUnit;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.mock.java.time.MockInstant;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class MutableClock_ESTest extends MutableClock_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void test_setTemporalField_milliOfSecondToZero() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      clock.set(ChronoField.MILLI_OF_SECOND, 0L);\n  }\n\n  @Test(timeout = 4000)\n  public void test_setTemporalAdjuster_usesInstantAsAdjuster() throws Throwable {\n      Instant pastInstant = MockInstant.ofEpochSecond(-1034L, -1034L);\n      MutableClock clock = MutableClock.of(pastInstant, ZoneOffset.MIN);\n      clock.set(pastInstant);\n  }\n\n  @Test(timeout = 4000)\n  public void test_add_negativeDecades() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      clock.add(-1L, ChronoUnit.DECADES);\n  }\n\n  @Test(timeout = 4000)\n  public void test_withZone_twoViewsOfSameBaseClockWithSameZoneAreEqual() throws Throwable {\n      MutableClock base = MutableClock.epochUTC();\n      MutableClock view1 = base.withZone(ZoneOffset.MIN);\n      MutableClock view2 = base.withZone(ZoneOffset.MIN);\n      boolean view1EqualsView2 = view1.equals(view2);\n      assertTrue(view1EqualsView2);\n      assertFalse(view2.equals(base));\n      assertNotSame(view2, base);\n  }\n\n  @Test(timeout = 4000)\n  public void test_equals_twoIndependentEpochUTCClocksAreNotEqual() throws Throwable {\n      MutableClock clock1 = MutableClock.epochUTC();\n      MutableClock clock2 = MutableClock.epochUTC();\n      boolean equal = clock1.equals(clock2);\n      assertFalse(equal);\n  }\n\n  @Test(timeout = 4000)\n  public void test_equals_clockIsNotEqualToArbitraryObject() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      Object obj = new Object();\n      boolean equal = clock.equals(obj);\n      assertFalse(equal);\n  }\n\n  @Test(timeout = 4000)\n  public void test_equals_clockIsEqualToItself() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      boolean equal = clock.equals(clock);\n      assertTrue(equal);\n  }\n\n  @Test(timeout = 4000)\n  public void test_withZone_sameZoneReturnsSameInstance() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      MutableClock sameZoneClock = clock.withZone(ZoneOffset.UTC);\n      assertSame(sameZoneClock, clock);\n  }\n\n  @Test(timeout = 4000)\n  public void test_withZone_differentZoneProducesClockNotEqualToOriginal() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      MutableClock minZoneClock = clock.withZone(ZoneOffset.MIN);\n      boolean equal = clock.equals(minZoneClock);\n      assertFalse(equal);\n  }\n\n  @Test(timeout = 4000)\n  public void test_toString_epochUTCClock() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      String str = clock.toString();\n      assertEquals(\"MutableClock[1970-01-01T00:00:00Z,Z]\", str);\n  }\n\n  @Test(timeout = 4000)\n  public void test_setInstant_updatesClockInstant() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      Instant now = MockInstant.now();\n      clock.setInstant(now);\n  }\n\n  @Test(timeout = 4000)\n  public void test_hashCode_doesNotThrow() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      clock.hashCode();\n  }\n\n  @Test(timeout = 4000)\n  public void test_add_zeroDurationDoesNotThrow() throws Throwable {\n      MutableClock clock = MutableClock.epochUTC();\n      clock.add(Duration.ZERO);\n  }\n}\n",
