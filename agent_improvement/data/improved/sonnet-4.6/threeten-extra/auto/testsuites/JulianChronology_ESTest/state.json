  try {\n        date.with((TemporalAdjuster) minOffset);\n        fail(\"Expecting exception: UnsupportedTemporalTypeException\");\n\n      } catch(UnsupportedTemporalTypeException e) {\n         //\n         // Unsupported field: OffsetSeconds\n         //\n         verifyException(\"org.threeten.extra.chrono.AbstractDate\", e);\n      }\n  }\n\n  /**\n   * range(YEAR) should return a non-null ValueRange representing the proleptic year bounds.\n   */\n  @Test(timeout = 4000)\n  public void test01()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      ValueRange yearRange = chronology.INSTANCE.range(ChronoField.YEAR);\n      assertNotNull(yearRange);\n  }\n\n  /**\n   * range(YEAR_OF_ERA) should return a non-null ValueRange for year-of-era bounds.\n   */\n  @Test(timeout = 4000)\n  public void test02()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      ValueRange yearOfEraRange = chronology.range(ChronoField.YEAR_OF_ERA);\n      assertNotNull(yearOfEraRange);\n  }\n\n  /**\n   * range(PROLEPTIC_MONTH) should return a non-null ValueRange for proleptic month bounds.\n   */\n  @Test(timeout = 4000)\n  public void test03()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      ValueRange prolepticMonthRange = chronology.INSTANCE.range(ChronoField.PROLEPTIC_MONTH);\n      assertNotNull(prolepticMonthRange);\n  }\n\n  /**\n   * prolepticYear with AD era should return the year-of-era value unchanged (AD 652 -> proleptic 652).\n   */\n  @Test(timeout = 4000)\n  public void test04()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      int prolepticYear = chronology.prolepticYear(JulianEra.AD, 652);\n      assertEquals(652, prolepticYear);\n  }\n\n  /**\n   * prolepticYear with BC era should return 1 - yearOfEra (BC 19 -> proleptic -18).\n   */\n  @Test(timeout = 4000)\n  public void test05()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      int prolepticYear = chronology.prolepticYear(JulianEra.BC, 19);\n      assertEquals((-18), prolepticYear);\n  }\n\n  /**\n   * isLeapYear should return true for -11999988, which is divisible by 4.\n   */\n  @Test(timeout = 4000)\n  public void test06()  throws Throwable  {\n      boolean isLeap = JulianChronology.INSTANCE.isLeapYear((-11999988L));\n      assertTrue(isLeap);\n  }\n\n  /**\n   * dateEpochDay(2) should create a JulianDate in the AD era (epoch day 2 falls in year AD 1970).\n   */\n  @Test(timeout = 4000)\n  public void test07()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      JulianDate date = chronology.INSTANCE.dateEpochDay(2L);\n      assertEquals(JulianEra.AD, date.getEra());\n  }\n\n  /**\n   * dateNow(null clock) should throw NullPointerException because the clock must not be null.\n   */\n  @Test(timeout = 4000)\n  public void test08()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      // Undeclared exception!\n      try {\n        chronology.dateNow((Clock) null);\n        fail(\"Expecting exception: NullPointerException\");\n\n      } catch(NullPointerException e) {\n         //\n         // clock\n         //\n         verifyException(\"java.util.Objects\", e);\n      }\n  }\n\n  /**\n   * eras() should return a non-empty list containing the Julian eras (BC and AD).\n   */\n  @Test(timeout = 4000)\n  public void test09()  throws Throwable  {\n      List<Era> eras = JulianChronology.INSTANCE.eras();\n      assertFalse(eras.isEmpty());\n  }\n\n  /**\n   * Passing a non-Julian era (ThaiBuddhistEra) to date(Era, ...) should throw ClassCastException.\n   */\n  @Test(timeout = 4000)\n  public void test10()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      ThaiBuddhistEra buddhistEra = ThaiBuddhistEra.BE;\n      // Undeclared exception!\n      try {\n        chronology.date((Era) buddhistEra, 61, 2, 61);\n        fail(\"Expecting exception: ClassCastException\");\n\n      } catch(ClassCastException e) {\n         //\n         // Era must be JulianEra\n         //\n         verifyException(\"org.threeten.extra.chrono.JulianChronology\", e);\n      }\n  }\n\n  /**\n   * Passing a non-Julian era (ThaiBuddhistEra) to dateYearDay(Era, ...) should throw ClassCastException.\n   */\n  @Test(timeout = 4000)\n  public void test11()  throws Throwable  {\n      ThaiBuddhistEra buddhistEra = ThaiBuddhistEra.BEFORE_BE;\n      // Undeclared exception!\n      try {\n        JulianChronology.INSTANCE.dateYearDay((Era) buddhistEra, 3, 3);\n        fail(\"Expecting exception: ClassCastException\");\n\n      } catch(ClassCastException e) {\n         //\n         // Era must be JulianEra\n         //\n         verifyException(\"org.threeten.extra.chrono.JulianChronology\", e);\n      }\n  }\n\n  /**\n   * date(63, 63, 63) should throw DateTimeException because month 63 is outside valid range 1-12.\n   */\n  @Test(timeout = 4000)\n  public void test12()  throws Throwable  {\n      // Undeclared exception!\n      try {\n        JulianChronology.INSTANCE.date(63, 63, 63);\n        fail(\"Expecting exception: DateTimeException\");\n\n      } catch(DateTimeException e) {\n         //\n         // Invalid value for MonthOfYear (valid values 1 - 12): 63\n         //\n         verifyException(\"java.time.temporal.ValueRange\", e);\n      }\n  }\n\n  /**\n   * getDisplayName should return \"Julian\" and getCalendarType should return \"julian\".\n   */\n  @Test(timeout = 4000)\n  public void test13()  throws Throwable  {\n      JulianChronology chronology = JulianChronology.INSTANCE;\n      String displayName = chronology.INSTANCE.getDisplayName(TextStyle.SHORT, Locale.ENGLISH);\n      assertEquals(\"Julian\", displayName);\n      assertEquals(\"julian\", chronology.getCalendarType());\n  }\n\n  /**\n   * dateYearDay(prolepticYear=2, dayOfYear=2) should return a date in the AD era.\n   */\n  @Test(timeout = 4000)\n  public void test14()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      JulianDate date = chronology.INSTANCE.dateYearDay(2, 2);\n      assertEquals(JulianEra.AD, date.getEra());\n  }\n\n  /**\n   * eraOf(-1073741823) should throw DateTimeException because the value is not a valid era index.\n   */\n  @Test(timeout = 4000)\n  public void test15()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      // Undeclared exception!\n      try {\n        chronology.eraOf((-1073741823));\n        fail(\"Expecting exception: DateTimeException\");\n\n      } catch(DateTimeException e) {\n         //\n         // Invalid era: -1073741823\n         //\n         verifyException(\"org.threeten.extra.chrono.JulianEra\", e);\n      }\n  }\n\n  /**\n   * zonedDateTime(TemporalAccessor) should convert a ZonedDateTime into a ChronoZonedDateTime.\n   */\n  @Test(timeout = 4000)\n  public void test16()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      ZonedDateTime now = MockZonedDateTime.now();\n      ChronoZonedDateTime<JulianDate> julianZonedDateTime = chronology.INSTANCE.zonedDateTime((TemporalAccessor) now);\n      assertNotNull(julianZonedDateTime);\n  }\n\n  /**\n   * dateNow() with no arguments should return a date in the AD era (current date is in AD).\n   */\n  @Test(timeout = 4000)\n  public void test17()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      JulianDate today = chronology.INSTANCE.dateNow();\n      assertEquals(JulianEra.AD, today.getEra());\n  }\n\n  /**\n   * resolveDate with an empty field map should return null (no date fields to resolve).\n   */\n  @Test(timeout = 4000)\n  public void test18()  throws Throwable  {\n      JulianChronology chronology = new JulianChronology();\n      HashMap<TemporalField, Long> emptyFields = new HashMap<TemporalField, Long>();\n      JulianDate resolved = chronology.resolveDate(emptyFields, ResolverStyle.STRICT);\n      assertNull(resolved);\n  }\n}\n",
