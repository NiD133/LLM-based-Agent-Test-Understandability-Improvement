  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 02:48:24 GMT 2026\n */\n\npackage org.threeten.extra;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.time.DateTimeException;\nimport java.time.DayOfWeek;\nimport java.time.Month;\nimport java.time.OffsetDateTime;\nimport java.time.chrono.MinguoDate;\nimport java.time.format.TextStyle;\nimport java.time.temporal.ChronoField;\nimport java.time.temporal.Temporal;\nimport java.time.temporal.TemporalField;\nimport java.time.temporal.TemporalQuery;\nimport java.time.temporal.UnsupportedTemporalTypeException;\nimport java.util.Locale;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.evosuite.runtime.mock.java.time.MockOffsetDateTime;\nimport org.evosuite.runtime.mock.java.time.chrono.MockMinguoDate;\nimport org.junit.runner.RunWith;\nimport org.threeten.extra.Half;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Half_ESTest extends Half_ESTest_scaffolding {\n\n    // --- Half.from() factory method ---\n\n    @Test(timeout = 4000)\n    public void from_withDayOfWeek_throwsDateTimeException() throws Throwable {\n        try {\n            Half.from(DayOfWeek.WEDNESDAY);\n            fail(\"Expecting exception: DateTimeException\");\n        } catch (DateTimeException e) {\n            verifyException(\"org.threeten.extra.Half\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void from_withHalfInstance_returnsSameInstance() throws Throwable {\n        Half h2 = Half.H2;\n        Half result = Half.from(h2);\n        assertSame(result, h2);\n    }\n\n    @Test(timeout = 4000)\n    public void from_withOffsetDateTime_returnsH1() throws Throwable {\n        OffsetDateTime now = MockOffsetDateTime.now();\n        Half result = Half.from(now);\n        assertEquals(Half.H1, result);\n    }\n\n    @Test(timeout = 4000)\n    public void from_withMinguoDate_returnsH1() throws Throwable {\n        MinguoDate minguoDate = MockMinguoDate.now();\n        Half result = Half.from(minguoDate);\n        assertEquals(Half.H1, result);\n    }\n\n    // --- Half.of() factory method ---\n\n    @Test(timeout = 4000)\n    public void of_withZero_throwsDateTimeException() throws Throwable {\n        try {\n            Half.of(0);\n            fail(\"Expecting exception: DateTimeException\");\n        } catch (DateTimeException e) {\n            verifyException(\"org.threeten.extra.Half\", e);\n        }\n    }\n\n    // --- Half.ofMonth() factory method ---\n\n    @Test(timeout = 4000)\n    public void ofMonth_withJune_returnsH1() throws Throwable {\n        Half result = Half.ofMonth(6);\n        assertEquals(Half.H1, result);\n    }\n\n    @Test(timeout = 4000)\n    public void ofMonth_withDecember_returnsH2() throws Throwable {\n        Half result = Half.ofMonth(12);\n        assertEquals(Half.H2, result);\n    }\n\n    // --- firstMonth() ---\n\n    @Test(timeout = 4000)\n    public void h1_firstMonth_returnsJanuary() throws Throwable {\n        Month firstMonth = Half.H1.firstMonth();\n        assertEquals(Month.JANUARY, firstMonth);\n    }\n\n    @Test(timeout = 4000)\n    public void h2_firstMonth_returnsJuly() throws Throwable {\n        Month firstMonth = Half.H2.firstMonth();\n        assertEquals(Month.JULY, firstMonth);\n    }\n\n    // --- length() ---\n\n    @Test(timeout = 4000)\n    public void h1_length_inLeapYear_returns182() throws Throwable {\n        int days = Half.H1.length(true);\n        assertEquals(182, days);\n    }\n\n    @Test(timeout = 4000)\n    public void h1_length_inNonLeapYear_returns181() throws Throwable {\n        int days = Half.H1.length(false);\n        assertEquals(181, days);\n    }\n\n    @Test(timeout = 4000)\n    public void h2_length_inNonLeapYear_returns184() throws Throwable {\n        int days = Half.H2.length(false);\n        assertEquals(184, days);\n    }\n\n    // --- adjustInto() ---\n\n    @Test(timeout = 4000)\n    public void h2_adjustInto_minguoDate_throwsDateTimeException() throws Throwable {\n        MinguoDate minguoDate = MockMinguoDate.now();\n        try {\n            Half.H2.adjustInto(minguoDate);\n            fail(\"Expecting exception: DateTimeException\");\n        } catch (DateTimeException e) {\n            verifyException(\"org.threeten.extra.Half\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void h2_adjustInto_offsetDateTime_returnsNewTemporal() throws Throwable {\n        OffsetDateTime original = MockOffsetDateTime.now();\n        Temporal adjusted = Half.H2.adjustInto(original);\n        assertNotSame(adjusted, original);\n    }\n\n    // --- query() ---\n\n    @Test(timeout = 4000)\n    public void h2_query_withMockReturningNull_doesNotThrow() throws Throwable {\n        TemporalQuery<ChronoField> query = (TemporalQuery<ChronoField>) mock(TemporalQuery.class, new ViolatedAssumptionAnswer());\n        doReturn((Object) null).when(query).queryFrom(any(java.time.temporal.TemporalAccessor.class));\n        Half.H2.query(query);\n    }\n\n    // --- getLong() ---\n\n    @Test(timeout = 4000)\n    public void h2_getLong_withNullField_throwsNullPointerException() throws Throwable {\n        try {\n            Half.H2.getLong((TemporalField) null);\n            fail(\"Expecting exception: NullPointerException\");\n        } catch (NullPointerException e) {\n            verifyException(\"org.threeten.extra.Half\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void h2_getLong_withOffsetSecondsField_throwsUnsupportedTemporalTypeException() throws Throwable {\n        try {\n            ChronoField.OFFSET_SECONDS.getFrom(Half.H2);\n            