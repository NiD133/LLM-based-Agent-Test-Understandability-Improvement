c void get_withAmPmOfDayField_returnsPmValue()  throws Throwable  {\n      AmPm pm = AmPm.PM;\n      ChronoField amPmField = ChronoField.AMPM_OF_DAY;\n      int value = pm.get(amPmField);\n      assertEquals(1, value);\n  }\n\n  @Test(timeout = 4000)\n  public void get_withUnsupportedMinuteOfHourField_throwsUnsupportedTemporalTypeException()  throws Throwable  {\n      AmPm pm = AmPm.PM;\n      ChronoField minuteField = ChronoField.MINUTE_OF_HOUR;\n      try {\n        pm.get(minuteField);\n        fail(\"Expecting exception: UnsupportedTemporalTypeException\");\n      } catch(UnsupportedTemporalTypeException e) {\n         verifyException(\"org.threeten.extra.AmPm\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void range_withAmPmOfDayField_returnsNonNullRange()  throws Throwable  {\n      AmPm pm = AmPm.PM;\n      ChronoField amPmField = ChronoField.AMPM_OF_DAY;\n      ValueRange range = pm.range(amPmField);\n      assertNotNull(range);\n  }\n\n  @Test(timeout = 4000)\n  public void get_withNullField_throwsNullPointerException()  throws Throwable  {\n      AmPm am = AmPm.AM;\n      try {\n        am.get((TemporalField) null);\n        fail(\"Expecting exception: NullPointerException\");\n      } catch(NullPointerException e) {\n         verifyException(\"org.threeten.extra.AmPm\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void isSupported_withAmPmOfDayField_returnsTrue()  throws Throwable  {\n      AmPm pm = AmPm.PM;\n      ChronoField amPmField = ChronoField.AMPM_OF_DAY;\n      boolean supported = pm.isSupported(amPmField);\n      assertTrue(supported);\n  }\n\n  @Test(timeout = 4000)\n  public void isSupported_withNullField_returnsFalse()  throws Throwable  {\n      AmPm am = AmPm.AM;\n      boolean supported = am.isSupported((TemporalField) null);\n      assertFalse(supported);\n  }\n\n  @Test(timeout = 4000)\n  public void from_withAmPmInstance_returnsSameInstance()  throws Throwable  {\n      AmPm am = AmPm.AM;\n      AmPm result = AmPm