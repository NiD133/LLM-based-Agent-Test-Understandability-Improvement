  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 00:52:41 GMT 2026\n */\n\npackage org.threeten.extra.chrono;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.time.Clock;\nimport java.time.DateTimeException;\nimport java.time.LocalDate;\nimport java.time.OffsetDateTime;\nimport java.time.ZoneId;\nimport java.time.ZoneOffset;\nimport java.time.chrono.ChronoZonedDateTime;\nimport java.time.chrono.Era;\nimport java.time.chrono.IsoEra;\nimport java.time.chrono.JapaneseEra;\nimport java.time.format.ResolverStyle;\nimport java.time.temporal.ChronoField;\nimport java.time.temporal.TemporalAccessor;\nimport java.time.temporal.TemporalField;\nimport java.time.temporal.ValueRange;\nimport java.util.HashMap;\nimport java.util.List;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.mock.java.time.MockClock;\nimport org.evosuite.runtime.mock.java.time.MockOffsetDateTime;\nimport org.junit.runner.RunWith;\nimport org.threeten.extra.chrono.BritishCutoverChronology;\nimport org.threeten.extra.chrono.BritishCutoverDate;\nimport org.threeten.extra.chrono.JulianEra;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class BritishCutoverChronology_ESTest extends BritishCutoverChronology_ESTest_scaffolding {\n\n    // --- range() tests ---\n\n    @Test(timeout = 4000)\n    public void test00_range_secondOfDay_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ValueRange range = chronology.range(ChronoField.SECOND_OF_DAY);\n        assertNotNull(range);\n    }\n\n    @Test(timeout = 4000)\n    public void test01_range_year_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ValueRange range = chronology.range(ChronoField.YEAR);\n        assertNotNull(range);\n    }\n\n    @Test(timeout = 4000)\n    public void test02_range_yearOfEra_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ValueRange range = chronology.range(ChronoField.YEAR_OF_ERA);\n        assertNotNull(range);\n    }\n\n    @Test(timeout = 4000)\n    public void test03_range_prolepticMonth_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ValueRange range = chronology.range(ChronoField.PROLEPTIC_MONTH);\n        assertNotNull(range);\n    }\n\n    @Test(timeout = 4000)\n    public void test04_range_alignedWeekOfMonth_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ValueRange range = chronology.range(ChronoField.ALIGNED_WEEK_OF_MONTH);\n        assertNotNull(range);\n    }\n\n    @Test(timeout = 4000)\n    public void test05_range_alignedWeekOfYear_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ValueRange range = chronology.range(ChronoField.ALIGNED_WEEK_OF_YEAR);\n        assertNotNull(range);\n    }\n\n    @Test(timeout = 4000)\n    public void test06_range_dayOfYear_viaInstance_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ValueRange range = chronology.INSTANCE.range(ChronoField.DAY_OF_YEAR);\n        assertNotNull(range);\n    }\n\n    // --- prolepticYear() tests ---\n\n    @Test(timeout = 4000)\n    public void test07_prolepticYear_bcEra_returnsNegativeValue() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        int prolepticYear = chronology.INSTANCE.prolepticYear(JulianEra.BC, 538);\n        assertEquals((-537), prolepticYear);\n    }\n\n    @Test(timeout = 4000)\n    public void test08_prolepticYear_adEra_returnsSameValue() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        int prolepticYear = chronology.INSTANCE.prolepticYear(JulianEra.AD, 538);\n        assertEquals(538, prolepticYear);\n    }\n\n    // --- isLeapYear() tests ---\n\n    @Test(timeout = 4000)\n    public void test09_isLeapYear_negativeOutOfRangeYear_returnsFalse() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        boolean isLeap = chronology.isLeapYear((-999998L));\n        assertFalse(isLeap);\n    }\n\n    @Test(timeout = 4000)\n    public void test10_isLeapYear_largeOutOfRangeYear_returnsFalse() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        boolean isLeap = chronology.isLeapYear(1000005L);\n        assertFalse(isLeap);\n    }\n\n    // --- dateYearDay() tests ---\n\n    @Test(timeout = 4000)\n    public void test11_dateYearDay_nonJulianEra_throwsClassCastException() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        JapaneseEra japaneseEra = JapaneseEra.HEISEI;\n        try {\n            chronology.dateYearDay((Era) japaneseEra, 9, 9);\n            fail(\"Expecting exception: ClassCastException\");\n        } catch (ClassCastException e) {\n            //\n            // Era must be JulianEra\n            //\n            verifyException(\"org.threeten.extra.chrono.BritishCutoverChronology\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test12_dateYearDay_invalidDayOfYear_throwsDateTimeException() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        try {\n            chronology.INSTANCE.dateYearDay((-1002), (-1002));\n            fail(\"Expecting exception: DateTimeException\");\n        } catch (DateTimeException e) {\n            //\n            // Invalid value for DayOfYear (valid values 1 - 365/366): -1002\n            //\n            verifyException(\"java.time.temporal.ValueRange\", e);\n        }\n    }\n\n    // --- date(Era, ...) tests ---\n\n    @Test(timeout = 4000)\n    public void test13_date_nonJulianEra_throwsClassCastException() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        IsoEra isoEra = IsoEra.BCE;\n        try {\n            chronology.INSTANCE.date((Era) isoEra, 60, 60, 60);\n            fail(\"Expecting exception: ClassCastException\");\n        } catch (ClassCastException e) {\n            //\n            // Era must be JulianEra\n            //\n            verifyException(\"org.threeten.extra.chrono.BritishCutoverChronology\", e);\n        }\n    }\n\n    // --- getId() test ---\n\n    @Test(timeout = 4000)\n    public void test14_getId_returnsBritishCutover() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        String id = chronology.getId();\n        assertEquals(\"BritishCutover\", id);\n    }\n\n    // --- eras() test ---\n\n    @Test(timeout = 4000)\n    public void test15_eras_returnsTwoEras() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        List<Era> eras = chronology.INSTANCE.eras();\n        assertEquals(2, eras.size());\n    }\n\n    // --- dateNow() tests ---\n\n    @Test(timeout = 4000)\n    public void test16_dateNow_withClock_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = BritishCutoverChronology.INSTANCE;\n        Clock clock = MockClock.systemDefaultZone();\n        BritishCutoverDate date = chronology.INSTANCE.dateNow(clock);\n        assertNotNull(date);\n    }\n\n    // --- getCalendarType() test ---\n\n    @Test(timeout = 4000)\n    public void test17_getCalendarType_returnsNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        String calendarType = chronology.getCalendarType();\n        assertNull(calendarType);\n    }\n\n    // --- eraOf() test ---\n\n    @Test(timeout = 4000)\n    public void test18_eraOf_zero_returnsBcEra() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        JulianEra era = chronology.eraOf(0);\n        assertEquals(JulianEra.BC, era);\n    }\n\n    // --- dateEpochDay() test ---\n\n    @Test(timeout = 4000)\n    public void test19_dateEpochDay_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        BritishCutoverDate date = chronology.INSTANCE.dateEpochDay(3697L);\n        assertNotNull(date);\n    }\n\n    // --- zonedDateTime() test ---\n\n    @Test(timeout = 4000)\n    public void test20_zonedDateTime_fromOffsetDateTime_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        OffsetDateTime offsetDateTime = MockOffsetDateTime.now();\n        ChronoZonedDateTime<BritishCutoverDate> zonedDateTime = chronology.zonedDateTime((TemporalAccessor) offsetDateTime);\n        assertNotNull(zonedDateTime);\n    }\n\n    @Test(timeout = 4000)\n    public void test21_dateNow_systemDefault_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        BritishCutoverDate date = chronology.dateNow();\n        assertNotNull(date);\n    }\n\n    // --- resolveDate() test ---\n\n    @Test(timeout = 4000)\n    public void test22_resolveDate_withEmptyFieldMap_returnsNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        HashMap<TemporalField, Long> emptyFields = new HashMap<TemporalField, Long>();\n        BritishCutoverDate date = chronology.resolveDate(emptyFields, ResolverStyle.STRICT);\n        assertNull(date);\n    }\n\n    // --- date(int, int, int) test ---\n\n    @Test(timeout = 4000)\n    public void test23_date_invalidMonth_throwsDateTimeException() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        try {\n            chronology.date((-992), (-992), (-992));\n            fail(\"Expecting exception: DateTimeException\");\n        } catch (DateTimeException e) {\n            //\n            // Invalid value for MonthOfYear (valid values 1 - 12): -992\n            //\n            verifyException(\"java.time.temporal.ValueRange\", e);\n        }\n    }\n\n    @Test(timeout = 4000)\n    public void test24_dateNow_withZoneOffset_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        ZoneOffset zoneOffset = ZoneOffset.MAX;\n        BritishCutoverDate date = chronology.dateNow((ZoneId) zoneOffset);\n        assertNotNull(date);\n    }\n\n    // --- getCutover() test ---\n\n    @Test(timeout = 4000)\n    public void test25_getCutover_returnsNonNull() throws Throwable {\n        BritishCutoverChronology chronology = new BritishCutoverChronology();\n        LocalDate cutoverDate = chronology.getCutover();\n        assertNotNull(cutoverDate);\n    }\n}\n",
