      } catch(IllegalArgumentException e) {\n         //\n         // NanoOfSecond must be from 0 to 999,999,999\n         //\n         verifyException(\"org.threeten.extra.scale.TaiInstant\", e);\n      }\n  }\n\n  // --- parse() tests ---\n\n  @Test(timeout = 4000)\n  public void test15_parse_may_throw_IllegalStateException_for_ambiguous_format()  throws Throwable  {\n      // Undeclared exception!\n      try {\n        TaiInstant.parse(\"20.000000020s(TAI)\");\n       //  fail(\"Expecting exception: IllegalStateException\");\n       // Unstable assertion\n      } catch(IllegalStateException e) {\n         //\n         // No match found\n         //\n         verifyException(\"java.util.regex.Matcher\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void test16_parse_throws_DateTimeParseException_for_blank_CharBuffer()  throws Throwable  {\n      CharBuffer blankBuffer = CharBuffer.allocate(706);\n      // Undeclared exception!\n      try {\n        TaiInstant.parse(blankBuffer);\n        fail(\"Expecting exception: DateTimeParseException\");\n\n      } catch(DateTimeParseException e) {\n         //\n         // The text could not be parsed\n         //\n         verifyException(\"org.threeten.extra.scale.TaiInstant\", e);\n      }\n  }\n\n  // --- durationUntil() tests ---\n\n  @Test(timeout = 4000)\n  public void test17_durationUntil_self_yields_zero_duration()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds(86400L, 0L);\n      instant.durationUntil(instant);\n      assertEquals(86400L, instant.getTaiSeconds());\n      assertEquals(0, instant.getNano());\n  }\n\n  // --- toUtcInstant() test ---\n\n  @Test(timeout = 4000)\n  public void test18_toUtcInstant_converts_tai_to_utc_correctly()  throws Throwable  {\n      TaiInstant taiInstant = TaiInstant.ofTaiSeconds(25, 25);\n      UtcInstant utcInstant = taiInstant.toUtcInstant();\n      assertEquals(15000000025L, utcInstant.getNanoOfDay());\n  }\n\n  // --- toInstant() test ---\n\n  @Test(timeout = 4000)\n  public void test19_toInstant_completes_without_error()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds(20, 20);\n      instant.toInstant();\n      assertEquals(20L, instant.getTaiSeconds());\n      assertEquals(20, instant.getNano());\n  }\n\n  // --- toString() test ---\n\n  @Test(timeout = 4000)\n  public void test20_toString_formats_seconds_and_nanos_correctly()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds(20, 20);\n      String formatted = instant.toString();\n      assertEquals(\"20.000000020s(TAI)\", formatted);\n  }\n\n  // --- of(Instant) test ---\n\n  @Test(timeout = 4000)\n  public void test21_of_instant_converts_system_time_to_tai()  throws Throwable  {\n      Instant now = MockInstant.now();\n      TaiInstant taiInstant = TaiInstant.of(now);\n      assertEquals(320000000, taiInstant.getNano());\n      assertEquals(1771100516L, taiInstant.getTaiSeconds());\n  }\n\n  // --- hashCode() test ---\n\n  @Test(timeout = 4000)\n  public void test22_hashCode_executes_without_error()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds(634L, 634L);\n      instant.hashCode();\n      assertEquals(634, instant.getNano());\n      assertEquals(634L, instant.getTaiSeconds());\n  }\n\n  // --- of(UtcInstant) null test ---\n\n  @Test(timeout = 4000)\n  public void test23_of_null_utcInstant_throws_NullPointerException()  throws Throwable  {\n      // Undeclared exception!\n      try {\n        TaiInstant.of((UtcInstant) null);\n        fail(\"Expecting exception: NullPointerException\");\n\n      } catch(NullPointerException e) {\n         //\n         // no message in exception (getMessage() returned null)\n         //\n         verifyException(\"org.threeten.extra.scale.UtcRules\", e);\n      }\n  }\n}\n",
