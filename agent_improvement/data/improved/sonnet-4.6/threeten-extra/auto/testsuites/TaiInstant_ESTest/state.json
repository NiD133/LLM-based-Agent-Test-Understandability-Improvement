  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 02:14:27 GMT 2026\n */\n\npackage org.threeten.extra.scale;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport java.time.Duration;\nimport java.time.Instant;\nimport java.time.format.DateTimeParseException;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.mock.java.time.MockInstant;\nimport org.junit.runner.RunWith;\nimport org.threeten.extra.scale.TaiInstant;\nimport org.threeten.extra.scale.UtcInstant;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class TaiInstant_ESTest extends TaiInstant_ESTest_scaffolding {\n\n  // --- equals() tests ---\n\n  @Test(timeout = 4000)\n  public void test00_equals_returns_true_for_equal_instances()  throws Throwable  {\n      TaiInstant first = TaiInstant.ofTaiSeconds((-3113L), (-3113L));\n      TaiInstant second = TaiInstant.ofTaiSeconds((-3113L), (-3113L));\n      boolean areEqual = first.equals(second);\n      assertEquals(999996887, second.getNano());\n      assertTrue(areEqual);\n      assertEquals((-3114L), second.getTaiSeconds());\n  }\n\n  @Test(timeout = 4000)\n  public void test01_equals_returns_false_for_instances_with_different_seconds()  throws Throwable  {\n      TaiInstant base = TaiInstant.ofTaiSeconds((-3113L), (-1192L));\n      TaiInstant other = TaiInstant.ofTaiSeconds((-1192L), (-3113L));\n      boolean areEqual = base.equals(other);\n      assertFalse(areEqual);\n      assertEquals(999996887, other.getNano());\n      assertEquals((-1193L), other.getTaiSeconds());\n  }\n\n  @Test(timeout = 4000)\n  public void test02_equals_returns_false_for_non_TaiInstant_object()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds((-1L), (-1L));\n      Object plainObject = new Object();\n      boolean areEqual = instant.equals(plainObject);\n      assertEquals((-2L), instant.getTaiSeconds());\n      assertFalse(areEqual);\n      assertEquals(999999999, instant.getNano());\n  }\n\n  @Test(timeout = 4000)\n  public void test03_equals_returns_true_when_compared_to_itself()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds(3600000000000L, (-1194L));\n      boolean areEqual = instant.equals(instant);\n      assertTrue(areEqual);\n      assertEquals(3599999999999L, instant.getTaiSeconds());\n      assertEquals(999998806, instant.getNano());\n  }\n\n  @Test(timeout = 4000)\n  public void test04_equals_returns_false_when_nanos_differ_after_withNano()  throws Throwable  {\n      TaiInstant original = TaiInstant.ofTaiSeconds((-3113L), (-1194L));\n      TaiInstant withZeroNano = original.withNano(0);\n      boolean withZeroEqualsOriginal = withZeroNano.equals(original);\n      assertEquals((-3114L), withZeroNano.getTaiSeconds());\n      assertFalse(original.equals((Object) withZeroNano));\n      assertFalse(withZeroEqualsOriginal);\n      assertEquals((-3114L), original.getTaiSeconds());\n      assertEquals(0, withZeroNano.getNano());\n      assertEquals(999998806, original.getNano());\n  }\n\n  // --- isBefore() tests ---\n\n  @Test(timeout = 4000)\n  public void test05_isBefore_returns_true_when_seconds_are_less()  throws Throwable  {\n      TaiInstant earlier = TaiInstant.ofTaiSeconds((-5), (-5));\n      TaiInstant later = earlier.withTaiSeconds((-5));\n      boolean isEarlierBefore = earlier.isBefore(later);\n      assertEquals(999999995, later.getNano());\n      assertEquals((-5L), later.getTaiSeconds());\n      assertEquals(999999995, earlier.getNano());\n      assertTrue(isEarlierBefore);\n  }\n\n  @Test(timeout = 4000)\n  public void test06_isBefore_returns_false_when_compared_to_itself()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds(20, 20);\n      boolean isBeforeItself = instant.isBefore(instant);\n      assertEquals(20L, instant.getTaiSeconds());\n      assertFalse(isBeforeItself);\n      assertEquals(20, instant.getNano());\n  }\n\n  // --- isAfter() tests ---\n\n  @Test(timeout = 4000)\n  public void test07_isAfter_returns_true_when_nanos_are_greater()  throws Throwable  {\n      TaiInstant base = TaiInstant.ofTaiSeconds((-3113L), (-1194L));\n      TaiInstant withZeroNano = base.withNano(0);\n      boolean isBaseAfterZeroNano = base.isAfter(withZeroNano);\n      assertEquals((-3114L), withZeroNano.getTaiSeconds());\n      assertEquals(0, withZeroNano.getNano());\n      assertEquals((-3114L), base.getTaiSeconds());\n      assertTrue(isBaseAfterZeroNano);\n      assertEquals(999998806, base.getNano());\n  }\n\n  @Test(timeout = 4000)\n  public void test08_isAfter_returns_false_when_seconds_are_less()  throws Throwable  {\n      TaiInstant laterInstant = TaiInstant.ofTaiSeconds(86400L, 0L);\n      TaiInstant earlierInstant = TaiInstant.ofTaiSeconds(883L, (-784L));\n      boolean isEarlierAfterLater = earlierInstant.isAfter(laterInstant);\n      assertEquals(999999216, earlierInstant.getNano());\n      assertEquals(882L, earlierInstant.getTaiSeconds());\n      assertFalse(isEarlierAfterLater);\n  }\n\n  // --- minus() tests ---\n\n  @Test(timeout = 4000)\n  public void test09_minus_zero_duration_returns_same_instance()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds((-1660L), (-1660L));\n      TaiInstant result = instant.minus(Duration.ZERO);\n      assertEquals(999998340, result.getNano());\n      assertEquals((-1661L), result.getTaiSeconds());\n      assertSame(result, instant);\n  }\n\n  @Test(timeout = 4000)\n  public void test10_minus_duration_subtracts_milliseconds_correctly()  throws Throwable  {\n      TaiInstant instant = TaiInstant.ofTaiSeconds(3600000000000L, (-1194L));\n      Duration twentyMillis = Duration.ofMillis(20);\n      TaiInstant result = instant.minus(twen