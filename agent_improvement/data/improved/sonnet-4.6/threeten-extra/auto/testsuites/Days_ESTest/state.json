  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Tue Jun 16 04:14:21 GMT 2026\n */\n\npackage org.threeten.extra;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.time.DateTimeException;\nimport java.time.Duration;\nimport java.time.Instant;\nimport java.time.ZonedDateTime;\nimport java.time.chrono.MinguoDate;\nimport java.time.format.DateTimeParseException;\nimport java.time.temporal.ChronoField;\nimport java.time.temporal.ChronoUnit;\nimport java.time.temporal.Temporal;\nimport java.time.temporal.TemporalAmount;\nimport java.time.temporal.TemporalUnit;\nimport java.time.temporal.UnsupportedTemporalTypeException;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.mock.java.time.MockInstant;\nimport org.evosuite.runtime.mock.java.time.MockZonedDateTime;\nimport org.evosuite.runtime.mock.java.time.chrono.MockMinguoDate;\nimport org.junit.runner.RunWith;\nimport org.threeten.extra.Days;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Days_ESTest extends Days_ESTest_scaffolding {\n\n  @Test(timeout = 4000)\n  public void test00_equals_twoInstancesWithSameWeekCount_areEqual() throws Throwable {\n      Days firstInstance = Days.ofWeeks(-3574);\n      Days secondInstance = Days.ofWeeks(-3574);\n      assertTrue(firstInstance.equals(secondInstance));\n      assertEquals(-25018, secondInstance.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test01_equals_instanceMultipliedToLargerValue_notEqualToOriginal() throws Throwable {\n      Days negativeWeeks = Days.ofWeeks(-3386);\n      Days multipliedResult = negativeWeeks.multipliedBy(-3386);\n      assertFalse(negativeWeeks.equals(multipliedResult));\n      assertFalse(multipliedResult.equals((Object) negativeWeeks));\n      assertFalse(negativeWeeks.isPositive());\n      assertEquals(80254972, multipliedResult.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test02_equals_sameInstance_returnsTrue() throws Throwable {\n      assertTrue(Days.ONE.equals(Days.ONE));\n  }\n\n  @Test(timeout = 4000)\n  public void test03_equals_nonDaysObject_returnsFalse() throws Throwable {\n      Days days = Days.ofWeeks(-3380);\n      Object nonDays = new Object();\n      assertFalse(days.equals(nonDays));\n      assertEquals(-23660, days.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test04_subtractFrom_nonZeroDays_returnsNewTemporal() throws Throwable {\n      Instant referenceInstant = MockInstant.ofEpochSecond(-2086L, -2086L);\n      Days zeroDays = Days.between(referenceInstant, referenceInstant);\n      // Subtracting a negative Duration from zero Days yields a positive Days amount\n      Days positiveDays = zeroDays.minus((TemporalAmount) Duration.ofDays(-2086L));\n      Temporal adjustedInstant = positiveDays.subtractFrom(referenceInstant);\n      assertEquals(2086, positiveDays.getAmount());\n      assertNotSame(adjustedInstant, referenceInstant);\n      assertEquals(0, zeroDays.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test05_subtractFrom_zeroDays_temporalUnchanged() throws Throwable {\n      MinguoDate today = MockMinguoDate.now();\n      Days zeroDays = Days.between(today, today);\n      Days.ZERO.subtractFrom(today);\n      assertEquals(0, zeroDays.getAmount());\n      assertTrue(zeroDays.isZero());\n  }\n\n  @Test(timeout = 4000)\n  public void test06_addTo_nonZeroDays_returnsNewTemporal() throws Throwable {\n      Instant referenceInstant = MockInstant.ofEpochSecond(-2086L, -2086L);\n      Days zeroDays = Days.between(referenceInstant, referenceInstant);\n      // Subtracting a negative Duration from zero Days yields a positive Days amount\n      Days positiveDays = zeroDays.minus((TemporalAmount) Duration.ofDays(-2086L));\n      Temporal adjustedInstant = positiveDays.addTo(referenceInstant);\n      assertNotSame(adjustedInstant, referenceInstant);\n      assertTrue(zeroDays.isZero());\n      assertEquals(2086, positiveDays.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test07_addTo_zeroDays_returnsSameTemporal() throws Throwable {\n      ZonedDateTime now = MockZonedDateTime.now();\n      Days zeroDays = Days.between(now, now);\n      Temporal result = Days.ZERO.addTo(now);\n      assertEquals(0, zeroDays.getAmount());\n      assertSame(result, now);\n  }\n\n  @Test(timeout = 4000)\n  public void test08_abs_negativeDays_returnsPositiveEquivalent() throws Throwable {\n      Days negativeDays = Days.of(-2129);\n      Days absoluteValue = negativeDays.abs();\n      assertEquals(2129, absoluteValue.getAmount());\n      assertEquals(-2129, negativeDays.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test09_abs_positiveDays_returnsUnchangedValue() throws Throwable {\n      Days ofWeeks = Days.ofWeeks(-3380);\n      Days absoluteOfOne = Days.ONE.abs();\n      assertEquals(-23660, ofWeeks.getAmount());\n      assertEquals(1, absoluteOfOne.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test10_dividedBy_one_returnsEquivalentAmount() throws Throwable {\n      Days result = Days.ONE.dividedBy(1);\n      assertEquals(1, result.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test11_dividedBy_zeroDays_alwaysReturnsZero() throws Throwable {\n      Instant referenceInstant = MockInstant.ofEpochSecond(-2086L, -2086L);\n      Days zeroDays = Days.between(referenceInstant, referenceInstant);\n      Days result = zeroDays.dividedBy(-507);\n      assertTrue(result.isZero());\n      assertSame(result, zeroDays);\n  }\n\n  @Test(timeout = 4000)\n  public void test12_multipliedBy_one_returnsEquivalentAmount() throws Throwable {\n      Instant referenceInstant = MockInstant.ofEpochSecond(-2086L, -2086L);\n      Days zeroDays = Days.between(referenceInstant, referenceInstant);\n      Days result = zeroDays.multipliedBy(1);\n      assertEquals(0, result.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test13_minus_zeroDuration_returnsSameInstance() throws Throwable {\n      Days result = Days.ONE.minus((TemporalAmount) Duration.ZERO);\n      assertFalse(result.isNegative());\n      assertSame(result, Days.ONE);\n  }\n\n  @Test(timeout = 4000)\n  public void test14_isPositive_productOfTwoNegatives_returnsTrue() throws Throwable {\n      Days negativeWeeks = Days.ofWeeks(-3386);\n      Days multipliedResult = negativeWeeks.multipliedBy(-3386);\n      assertTrue(multipliedResult.isPositive());\n      assertEquals(80254972, multipliedResult.getAmount());\n      assertFalse(negativeWeeks.isPositive());\n  }\n\n  @Test(timeout = 4000)\n  public void test15_isPositive_zeroDays_returnsFalse() throws Throwable {\n      assertFalse(Days.ZERO.isPositive());\n      assertEquals(0, Days.ZERO.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test16_isZero_zeroDays_returnsTrue() throws Throwable {\n      assertTrue(Days.ZERO.isZero());\n  }\n\n  @Test(timeout = 4000)\n  public void test17_isZero_nonZeroDays_returnsFalse() throws Throwable {\n      Days negativeWeeks = Days.ofWeeks(-3574);\n      assertFalse(negativeWeeks.isZero());\n      assertEquals(-25018, negativeWeeks.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test18_isNegative_negativeWeeks_returnsTrue() throws Throwable {\n      Days negativeWeeks = Days.ofWeeks(-3574);\n      assertTrue(negativeWeeks.isNegative());\n      assertEquals(-25018, negativeWeeks.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test19_isNegative_oneDays_returnsFalse() throws Throwable {\n      assertFalse(Days.ONE.isNegative());\n      assertEquals(1, Days.ONE.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test20_get_daysUnit_returnsAmountInDays() throws Throwable {\n      Days ofWeeks = Days.ofWeeks(-4447);\n      // ChronoField.MILLI_OF_DAY has DAYS as its range unit\n      TemporalUnit daysUnit = ChronoField.MILLI_OF_DAY.getRangeUnit();\n      long result = Days.ONE.get(daysUnit);\n      assertEquals(-31129, ofWeeks.getAmount());\n      assertEquals(1L, result);\n  }\n\n  @Test(timeout = 4000)\n  public void test21_get_unsupportedUnit_throwsUnsupportedTemporalTypeException() throws Throwable {\n      try {\n        Days.ZERO.get(ChronoUnit.HOURS);\n        fail(\"Expecting exception: UnsupportedTemporalTypeException\");\n      } catch(UnsupportedTemporalTypeException e) {\n         //\n         // Unsupported unit: Hours\n         //\n         verifyException(\"org.threeten.extra.Days\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void test22_parse_validIso8601DayString_parsesSuccessfully() throws Throwable {\n      // Undeclared exception!\n      try {\n        Days.parse(\"P0D\");\n       //  fail(\"Expecting exception: DateTimeParseException\");\n       // Unstable assertion\n      } catch(DateTimeParseException e) {\n         //\n         // Text cannot be parsed to a Days\n         //\n         verifyException(\"org.threeten.extra.Days\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void test23_from_durationInSeconds_throwsDateTimeException() throws Throwable {\n      Duration secondsDuration = Duration.ofSeconds(1927L);\n      try {\n        Days.from(secondsDuration);\n        fail(\"Expecting exception: DateTimeException\");\n      } catch(DateTimeException e) {\n         //\n         // Amount could not be converted to a whole number of days: 1927 Seconds\n         //\n         verifyException(\"org.threeten.extra.Days\", e);\n      }\n  }\n\n  @Test(timeout = 4000)\n  public void test24_ofWeeks_zero_returnsZeroDays() throws Throwable {\n      assertTrue(Days.ofWeeks(0).isZero());\n  }\n\n  @Test(timeout = 4000)\n  public void test25_of_one_returnsOneDays() throws Throwable {\n      assertEquals(1, Days.of(1).getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test26_plus_self_doublesAmount() throws Throwable {\n      Instant referenceInstant = MockInstant.ofEpochSecond(-2086L, -2086L);\n      Days zeroDays = Days.between(referenceInstant, referenceInstant);\n      Days positiveDays = zeroDays.minus((TemporalAmount) Duration.ofDays(-2086L));\n      Days doubled = positiveDays.plus((TemporalAmount) positiveDays);\n      assertEquals(4172, doubled.getAmount());\n      assertTrue(zeroDays.isZero());\n  }\n\n  @Test(timeout = 4000)\n  public void test27_hashCode_doesNotThrow() throws Throwable {\n      Days days = Days.of(3);\n      days.hashCode();\n      assertEquals(3, days.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test28_getUnits_returnsUnitsList() throws Throwable {\n      Days negativeWeeks = Days.ofWeeks(-25018);\n      negativeWeeks.getUnits();\n      assertEquals(-175126, negativeWeeks.getAmount());\n  }\n\n  @Test(timeout = 4000)\n  public void test29_toString_zeroDays_returnsIso8601Format() throws Throwable {\n      assertEquals(\"P0D\", Days.ZERO.toString());\n  }\n\n  @Test(timeout = 4000)\n  public void test30_toPeriod_doesNotThrow() throws Throwable {\n      Days negativeWeeks = Days.ofWeeks(-25018);\n      Days.ZERO.toPeriod();\n      assertEquals(-175126, negativeWeeks.getAmount());\n      assertFalse(negativeWeeks.isPositive());\n  }\n\n  @Test(timeout = 4000)\n  public void test31_plus_zeroDays_returnsZero() throws Throwable {\n      Instant referenceInstant = MockInstant.ofEpochSecond(-2086L, -2086L);\n      Days zeroDays = Days.between(referenceInstant, referenceInstant);\n      Days result = zeroDays.plus((TemporalAmount) zeroDays);\n      assertTrue(result.isZero());\n  }\n\n  @Test(timeout = 4000)\n  public void test32_compareTo_equalInstances_returnsZero() throws Throwable {\n      assertEquals(0, Days.ZERO.compareTo(Days.ZERO));\n  }\n}\n",
