  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Sat Jun 13 17:44:07 GMT 2026\n */\n\npackage org.apache.commons.cli;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.List;\nimport org.apache.commons.cli.Option;\nimport org.apache.commons.cli.OptionGroup;\nimport org.apache.commons.cli.Options;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class) @EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class Options_ESTest extends Options_ESTest_scaffolding {\n\n  /**\n   * A required option stored under a null key can be looked up via hasShortOption(null).\n   */\n  @Test(timeout = 4000)\n  public void test00()  throws Throwable  {\n      Options options = new Options();\n      options.addRequiredOption((String) null, (String) null, true, \"Y6.E))P%{qV#g\");\n      boolean found = options.hasShortOption((String) null);\n      assertTrue(found);\n  }\n\n  /**\n   * hasShortOption returns false when no option with that short name exists.\n   */\n  @Test(timeout = 4000)\n  public void test01()  throws Throwable  {\n      Options options = new Options();\n      boolean found = options.hasShortOption(\"j\");\n      assertFalse(found);\n  }\n\n  /**\n   * hasOption matches by long name as well as short name.\n   */\n  @Test(timeout = 4000)\n  public void test02()  throws Throwable  {\n      Options options = new Options();\n      options.addOption(\"v\", \" ]\", false, \"MBMwU(V1:l*[\\\"cE\");\n      boolean found = options.hasOption(\" ]\");\n      assertTrue(found);\n  }\n\n  /**\n   * hasLongOption returns true when a required option with that long name exists.\n   */\n  @Test(timeout = 4000)\n  public void test03()  throws Throwable  {\n      Options options = new Options();\n      options.addRequiredOption(\"j\", \"j\", false, \"g\");\n      boolean found = options.hasLongOption(\"j\");\n      assertTrue(found);\n  }\n\n  /**\n   * hasLongOption returns false when no option with that long name exists.\n   */\n  @Test(timeout = 4000)\n  public void test04()  throws Throwable  {\n      Options options = new Options();\n      boolean found = options.hasLongOption(\"T\");\n      assertFalse(found);\n  }\n\n  /**\n   * getOption returns null when no option with that name has been registered.\n   */\n  @Test(timeout = 4000)\n  public void test05()  throws Throwable  {\n      Options options = new Options();\n      Option result = options.getOption(\"v\");\n      assertNull(result);\n  }\n\n  /**\n   * getMatchingOptions(\"\") matches all long options (since every string starts with \"\"),\n   * so the result is non-empty but does not literally contain the empty string as a key.\n   */\n  @Test(timeout = 4000)\n  public void test06()  throws Throwable  {\n      Options options = new Options();\n      options.addRequiredOption(\"j\", \"NR1W*T\", false, \"j\");\n      List<String> matches = options.getMatchingOptions(\"\");\n      assertFalse(matches.contains(\"\"));\n      assertFalse(matches.isEmpty());\n  }\n\n  /**\n   * getMatchingOptions returns an empty list when no long option name starts with the given prefix.\n   */\n  @Test(timeout = 4000)\n  public void test07()  throws Throwable  {\n      Options options = new Options();\n      Options optionsWithJ = options.addRequiredOption(\"j\", \"j\", false, \"j\");\n      List<String> matches = optionsWithJ.getMatchingOptions(\" ] [ long \");\n      assertTrue(matches.isEmpty());\n  }\n\n  /**\n   * getMatchingOptions returns a list containing the exact long option name when it matches.\n   */\n  @Test(timeout = 4000)\n  public void test08()  throws Throwable  {\n      Options options = new Options();\n      Options optionsWithJ = options.addRequiredOption(\"j\", \"j\", false, \"j\");\n      List<String> matches = optionsWithJ.getMatchingOptions(\"j\");\n      assertTrue(matches.contains(\"j\"));\n  }\n\n  /**\n   * addOptions throws IllegalArgumentException when the source already contains\n   * a key that is also present in the target (duplicate key: null).\n   */\n  @Test(timeout = 4000)\n  public void test09()  throws Throwable  {\n      Options options0 = new Options();\n      Options options1 = options0.addOption((String) null, (String) null);\n      // Undeclared exception!\n      try {\n        options0.addOptions(options1);\n        fail(\"Expecting exception: IllegalArgumentException\");\n      } catch (IllegalArgumentException e) {\n         //\n         // Duplicate key: null\n         //\n         verifyException(\"org.apache.commons.cli.Options\", e);\n      }\n  }\n\n  /**\n   * addOptions returns the receiver (options0), which is not the same object as the argument (options1).\n   */\n  @Test(timeout = 4000)\n  public void test10()  throws Throwable  {\n      Options options0 = new Options();\n      Options options1 = new Options();\n      options1.addOption(\"v\", \" ]\", false, \"MBMwU(V1:l*[\\\"cE\");\n      Options result = options0.addOptions(options1);\n      assertNotSame(options1, result);\n  }\n\n  /**\n   * addOptionGroup returns the same Options instance (fluent API),\n   * and a required OptionGroup is accepted without error.\n   */\n  @Test(timeout = 4000)\n  public void test11()  throws Throwable  {\n      Options options = new Options();\n      OptionGroup requiredGroup = new OptionGroup();\n      requiredGroup.setRequired(true);\n      Options result = options.addOptionGroup(requiredGroup);\n      assertSame(options, result);\n  }\n\n  /**\n   * addOptionGroup returns the same Options instance (fluent API)\n   * even when the group is not required.\n   */\n  @Test(timeout = 4000)\n  public void test12()  throws Throwable  {\n      Options options = new Options();\n      OptionGroup optionalGroup = new OptionGroup();\n      Options result = options.addOptionGroup(optionalGroup);\n      assertSame(result, options);\n  }\n\n  /**\n   * An Option retrieved from Options and then re-added via addOption retains its required flag\n   * and its hasArg property.\n   */\n  @Test(timeout = 4000)\n  public void test13()  throws Throwable  {\n      Options options = new Options();\n      Options optionsWithJ = options.addRequiredOption(\"j\", \"j\", false, \"j\");\n      Option optionJ = optionsWithJ.getOption(\"j\");\n      options.addOption(optionJ);\n      assertTrue(optionJ.isRequired());\n      assertFalse(optionJ.hasArg());\n  }\n\n  /**\n   * getOptionGroup returns null when the option does not belong to any group.\n   */\n  @Test(timeout = 4000)\n  public void test14()  throws Throwable  {\n      Options options = new Options();\n      Option ungroupedOption = new Option((String) null, true, (String) null);\n      OptionGroup group = options.getOptionGroup(ungroupedOption);\n      assertNull(group);\n  }\n\n  /**\n   * toString of an empty Options produces the expected diagnostic string.\n   */\n  @Test(timeout = 4000)\n  public void test15()  throws Throwable  {\n      Options options = new Options();\n      String representation = options.toString();\n      assertEquals(\"[ Options: [ short {} ] [ long {} ]\", representation);\n  }\n\n  /**\n   * getRequiredOptions returns an empty list when no required options have been added.\n   */\n  @Test(timeout = 4000)\n  public void test16()  throws Throwable  {\n      Options options = new Options();\n      List<?> required = options.getRequiredOptions();\n      assertTrue(required.isEmpty());\n  }\n\n  /**\n   * addOption(shortName, hasArg, description) with a null short name is accepted\n   * and returns the same Options instance (fluent API).\n   */\n  @Test(timeout = 4000)\n  public void test17()  throws Throwable  {\n      Options options = new Options();\n      Options result = options.addOption((String) null, false, \"NO_ARGS_ALLOWED\");\n      assertSame(options, result);\n  }\n}\n",
