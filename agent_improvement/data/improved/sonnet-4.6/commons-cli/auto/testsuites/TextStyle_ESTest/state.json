oid test03_padEmptyCharBufferWithoutIndentReturnsEmptyString() throws Throwable {\n        CharBuffer emptyBuffer = CharBuffer.allocate(0);\n        CharSequence result = TextStyle.DEFAULT.pad(false, emptyBuffer);\n        assertEquals(\"\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test04_padWithAddIndentWhenTextShorterThanMaxWidth() throws Throwable {\n        TextStyle.Builder builder = TextStyle.builder();\n        builder.setMaxWidth(1132);\n        TextStyle style = builder.get();\n        style.pad(true, \"TextStyle{LEFT, l:0, i:0, true, min:0, max:unset}\");\n        assertEquals(1132, builder.getMaxWidth());\n    }\n\n    @Test(timeout = 4000)\n    public void test05_padCenterAlignedWithUnsetMaxWidthAndAddIndentReturnsTextUnchanged() throws Throwable {\n        TextStyle.Builder builder = TextStyle.builder();\n        TextStyle.Builder builderWithCenter = builder.setAlignment(TextStyle.Alignment.CENTER);\n        TextStyle centerStyle = builderWithCenter.get();\n        CharSequence result = centerStyle.pad(true, \"TextStyle{LEFT, l:0, i:0, true, min:0, max:unset}\");\n        assertEquals(Integer.MAX_VALUE, centerStyle.getMaxWidth());\n        assertTrue(centerStyle.isScalable());\n        assertEquals(\"TextStyle{LEFT, l:0, i:0, true, min:0, max:unset}\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void test06_padCenterAlignedWithSpecificMaxWidthAndAddIndent() throws Throwable {\n        TextStyle.Builder builder = TextStyle.builder();\n        TextStyle.Builder builderWithMaxWidth = builder.setMaxWidth(3173);\n        builderWithMaxWidth.setAlignment(TextStyle.Alignment.CENTER);\n        TextStyle centerStyle = builderWithMaxWidth.get();\n        centerStyle.pad(true, \"TextStyle{CENTER, l:0, i:0, true, min:0, max:3173}\");\n        assertEquals(3173, builder.getMaxWidth());\n    }\n\n    @Test(timeout = 4000)\n    public void test07_padRightAlignedWithUnsetMaxWidthAndAddIndentReturnsTextUnchanged() throws Throwable {\n  