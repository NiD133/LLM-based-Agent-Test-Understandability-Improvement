  "last_code": "/*\n * This file was automatically generated by EvoSuite\n * Sat Jun 13 16:44:09 GMT 2026\n */\n\npackage org.apache.commons.cli.help;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.shaded.org.mockito.Mockito.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.util.function.BiFunction;\nimport java.util.function.Function;\nimport org.apache.commons.cli.Option;\nimport org.apache.commons.cli.help.OptionFormatter;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.evosuite.runtime.ViolatedAssumptionAnswer;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class OptionFormatter_ESTest extends OptionFormatter_ESTest_scaffolding {\n\n    // -----------------------------------------------------------------------\n    // toOptional()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void toOptional_wrapsTextWithDefaultBrackets_whenFormatterHasNullOption() throws Throwable {\n        OptionFormatter formatter = OptionFormatter.from((Option) null);\n        String result = formatter.toOptional(\"-\");\n        assertEquals(\"[-]\", result);\n    }\n\n    // -----------------------------------------------------------------------\n    // getDescription()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void getDescription_returnsOptionDescription_whenOptionIsNotDeprecated() throws Throwable {\n        Option option = new Option(\"arg\", \"arg\", false, \"arg\");\n        OptionFormatter formatter = OptionFormatter.from(option);\n        String result = formatter.getDescription();\n        assertEquals(\"arg\", result);\n    }\n\n    // -----------------------------------------------------------------------\n    // getBothOpt()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void getBothOpt_returnsShortOptWithPrefix_whenOnlyShortOptIsSet() throws Throwable {\n        // Option(opt, description) — no longOpt, so only the short opt appears\n        Option option = new Option(\"NO_ARGS_ALLOWED\", \"NO_ARGS_ALLOWED\");\n        OptionFormatter formatter = OptionFormatter.from(option);\n        String result = formatter.getBothOpt();\n        assertEquals(\"-NO_ARGS_ALLOWED\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void getBothOpt_returnsBothOptsJoinedBySeparator_whenBothShortAndLongOptsAreSet() throws Throwable {\n        Option option = new Option(\"arEg\", \"arEg\", true, \"arEg\");\n        OptionFormatter formatter = OptionFormatter.from(option);\n        String result = formatter.getBothOpt();\n        assertEquals(\"-arEg, --arEg\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void getBothOpt_returnsEmptyString_whenBothOptAndLongOptAreNull() throws Throwable {\n        Option option = new Option((String) null, (String) null);\n        OptionFormatter formatter = OptionFormatter.from(option);\n        String result = formatter.getBothOpt();\n        assertEquals(\"\", result);\n    }\n\n    // -----------------------------------------------------------------------\n    // toSyntaxOption()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void toSyntaxOption_returnsArgNameWithSeparatorOnly_whenOptionIsRequiredAndHasArgButNoOpt() throws Throwable {\n        // null opt, hasArg=true: the syntax becomes just the separator + default arg name\n        Option option = new Option((String) null, true, (String) null);\n        OptionFormatter formatter = OptionFormatter.from(option);\n        String result = formatter.toSyntaxOption(true);\n        assertEquals(\" <arg>\", result);\n    }\n\n    @Test(timeout = 4000)\n    public void toSyntaxOption_returnsEmptyString_whenBothOptAndLongOptAreNull() throws Throwable {\n        Option option = new Option((String) null, (String) null);\n        OptionFormatter formatter = OptionFormatter.from(option);\n        String result = formatter.toSyntaxOption();\n        assertEquals(\"\", result);\n    }\n\n    // -----------------------------------------------------------------------\n    // getSince()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void getSince_throwsNullPointerException_whenFormatterHasNullOption() throws Throwable {\n        OptionFormatter formatter = OptionFormatter.from((Option) null);\n        try {\n            formatter.getSince();\n            fail(\"Expecting exception: NullPointerException\");\n        } catch (NullPointerException e) {\n            verifyException(\"org.apache.commons.cli.help.OptionFormatter\", e);\n        }\n    }\n\n    // -----------------------------------------------------------------------\n    // Builder.build() and Builder.get()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void builderBuild_returnsNewFormatterInstance_distinctFromSourceFormatter() throws Throwable {\n        Option option = new Option(\"arKg\", \"arKg\");\n        OptionFormatter original = OptionFormatter.from(option);\n        OptionFormatter.Builder builder = new OptionFormatter.Builder(original);\n        OptionFormatter rebuilt = builder.build(option);\n        assertNotSame(original, rebuilt);\n    }\n\n    @Test(timeout = 4000)\n    public void builderGet_returnsNull_becauseGetIsNotImplemented() throws Throwable {\n        Option option = new Option(\"arKg\", \"arKg\");\n        OptionFormatter formatter = OptionFormatter.from(option);\n        OptionFormatter.Builder builder = new OptionFormatter.Builder(formatter);\n        OptionFormatter result = builder.get();\n        assertNull(result);\n    }\n\n    // -----------------------------------------------------------------------\n    // Builder fluent-setter methods — each must return the same builder instance\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void setOptArgSeparator_returnsSameBuilderInstance() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        OptionFormatter.Builder returned = builder.setOptArgSeparator(\"\");\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setOptionalDelimiters_returnsSameBuilderInstance_whenBothDelimitersAreNull() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        OptionFormatter.Builder returned = builder.setOptionalDelimiters((String) null, (String) null);\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setArgumentNameDelimiters_returnsSameBuilderInstance() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        OptionFormatter.Builder returned = builder.setArgumentNameDelimiters(\"\", \"\");\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setDefaultArgName_returnsSameBuilderInstance() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        OptionFormatter.Builder returned = builder.setDefaultArgName(\"\");\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setLongOptPrefix_returnsSameBuilderInstance_whenPrefixMatchesDefault() throws Throwable {\n        Option option = new Option(\"arg\", \"arg\", false, \"arg\");\n        OptionFormatter formatter = OptionFormatter.from(option);\n        OptionFormatter.Builder builder = new OptionFormatter.Builder(formatter);\n        OptionFormatter.Builder returned = builder.setLongOptPrefix(\"--\");\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setSyntaxFormatFunction_returnsSameBuilderInstance() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        BiFunction<OptionFormatter, Boolean, String> mockFunction =\n                (BiFunction<OptionFormatter, Boolean, String>) mock(BiFunction.class, new ViolatedAssumptionAnswer());\n        OptionFormatter.Builder returned = builder.setSyntaxFormatFunction(mockFunction);\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setOptSeparator_returnsSameBuilderInstance() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        OptionFormatter.Builder returned = builder.setOptSeparator(\"\");\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setDeprecatedFormatFunction_returnsSameBuilderInstance_usingNoDeprecatedFormat() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        Function<Option, String> noDeprecatedFormat = OptionFormatter.NO_DEPRECATED_FORMAT;\n        OptionFormatter.Builder returned = builder.setDeprecatedFormatFunction(noDeprecatedFormat);\n        assertSame(builder, returned);\n    }\n\n    @Test(timeout = 4000)\n    public void setOptPrefix_returnsSameBuilderInstance() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        OptionFormatter.Builder returned = builder.setOptPrefix(\"\");\n        assertSame(builder, returned);\n    }\n\n    // -----------------------------------------------------------------------\n    // Builder.toArgName()\n    // -----------------------------------------------------------------------\n\n    @Test(timeout = 4000)\n    public void toArgName_wrapsArgNameWithDefaultAngleBrackets() throws Throwable {\n        OptionFormatter.Builder builder = OptionFormatter.builder();\n        String result = builder.toArgName(\" \");\n        assertEquals(\"< >\", result);\n    }\n}\n",
