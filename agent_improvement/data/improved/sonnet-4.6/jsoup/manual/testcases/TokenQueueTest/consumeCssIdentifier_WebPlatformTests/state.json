  "last_code": "package org.jsoup.parser;\n\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.Arguments;\nimport org.junit.jupiter.params.provider.MethodSource;\nimport java.util.stream.Stream;\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\n/**\n * Tests for {@link TokenQueue#consumeCssIdentifier()}, using test cases derived from\n * the W3C Web Platform Tests and the CSS Syntax specification.\n *\n * <p>Sources:\n * <ul>\n *   <li>https://github.com/web-platform-tests/wpt/blob/36036fb5212a3fc15fc5750cecb1923ba4071668/dom/nodes/ParentNode-querySelector-escapes.html\n *   <li>CSS Syntax Module Level 3 ident-token spec\n * </ul>\n */\npublic class TokenQueueTest_consumeCssIdentifier_WebPlatformTests {\n\n    private static String parseCssIdentifier(String text) {\n        TokenQueue q = new TokenQueue(text);\n        return q.consumeCssIdentifier();\n    }\n\n    private void assertParsedCssIdentifierEquals(String expected, String cssIdentifier) {\n        assertEquals(expected, parseCssIdentifier(cssIdentifier));\n    }\n\n    /**\n     * Web Platform Test cases for CSS identifier parsing.\n     * Each argument is (expectedDecodedIdentifier, rawCssIdentifier).\n     */\n    private static Stream<Arguments> cssIdentifiers() {\n        return Stream.of(\n            // --- escape: hex digit ---\n\n            // Trailing whitespace after hex escape terminates the escape sequence\n            Arguments.of(\"0nextIsWhiteSpace\",          \"\\\\30 nextIsWhiteSpace\"),\n            // Non-hex letter immediately after hex escape also terminates the sequence\n            Arguments.of(\"0nextIsNotHexLetters\",       \"\\\\30nextIsNotHexLetters\"),\n            // More than 6 hex digits: only the last 6 are consumed\n            Arguments.of(\"0connectHexMoreThan6Hex\",    \"\\\\000030connectHexMoreThan6Hex\"),\n            Arguments.of(\"0spaceMoreThan6Hex\",         \"\\\\000030 spaceMoreThan6Hex\"),\n\n            // --- hex digit special replacement ---\n\n            // 1. Zero code points are replaced by the replacement character U+FFFD\n            Arguments.of(\"zero�\",                 \"zero\\\\0\"),\n            Arguments.of(\"zero�\",                 \"zero\\\\000000\"),\n\n            // 2. Surrogate code points are replaced by U+FFFD\n            Arguments.of(\"�surrogateFirst\",       \"\\\\d83d surrogateFirst\"),\n            Arguments.of(\"surrogateSecond�\",      \"surrogateSecond\\\\dd11\"),\n            Arguments.of(\"surrogatePair��\",  \"surrogatePair\\\\d83d\\\\dd11\"),\n\n            // 3. Out-of-range code points are replaced by U+FFFD\n            Arguments.of(\"outOfRange�\",           \"outOfRange\\\\110000\"),\n            Arguments.of(\"outOfRange�\",           \"outOfRange\\\\110030\"),\n            Arguments.of(\"outOfRange�\",           \"outOfRange\\\\555555\"),\n            Arguments.of(\"outOfRange�\",           \"outOfRange\\\\ffffff\"),\n\n            // --- escape: arbitrary characters ---\n\n            Arguments.of(\".comma\",                     \"\\\\.comma\"),\n            Arguments.of(\"-minus\",                     \"\\\\-minus\"),\n            Arguments.of(\"g\",                          \"\\\\g\"),\n\n            // --- non-edge-case escapes ---\n\n            // BMP character via hex escape with trailing space\n            Arguments.of(\"aBMPRegular\",                \"\\\\61 BMPRegular\"),\n            // Non-BMP character via hex escape (U+1F511 = key emoji)\n            Arguments.of(\"🔑nonBMP\",         \"\\\\1f511 nonBMP\"),\n\n            // Consecutive hex escapes\n            Arguments.of(\"00continueEscapes\",          \"\\\\30\\\\30 continueEscapes\"),\n            Arguments.of(\"00continueEscapes\",          \"\\\\30 \\\\30 continueEscapes\"),\n            Arguments.of(\"continueEscapes00\",          \"continueEscapes\\\\30 \\\\30 \"),\n            Arguments.of(\"continueEscapes00\",          \"continueEscapes\\\\30 \\\\30\"),\n            Arguments.of(\"continueEscapes00\",          \"continueEscapes\\\\30\\\\30 \"),\n            Arguments.of(\"continueEscapes00\",          \"continueEscapes\\\\30\\\\30\"),\n\n            // --- ident tests from CSS tests in Chromium source (https://goo.gl/3Cxdov) ---\n\n            Arguments.of(\"hello\",                      \"hel\\\\6Co\"),\n            Arguments.of(\"&B\",                         \"\\\\26 B\"),\n            Arguments.of(\"hello\",                      \"hel\\\\6C o\"),\n            // Escape followed by various whitespace terminators\n            Arguments.of(\"spaces\",                     \"spac\\\\65\\r\\ns\"),\n            Arguments.of(\"spaces\",                     \"sp\\\\61\\tc\\\\65\\fs\"),\n            // Private-use area and end-of-BMP codepoints\n            Arguments.of(\"test힙\",                 \"test\\\\D799\"),\n            Arguments.of(\"\",                     \"\\\\E000\"),\n            // Escaped letter characters\n            Arguments.of(\"test\",                       \"te\\\\s\\\\t\"),\n            // Escaped spaces and tabs within the identifier\n            Arguments.of(\"spaces in\\tident\",           \"spaces\\\\ in\\\\\\tident\"),\n            Arguments.of(\".,:!\",                       \"\\\\.\\\\,\\\\:\\\\!\"),\n            // Null bytes replaced by U+FFFD\n            Arguments.of(\"null�\",                 \"null\\\\0\"),\n            Arguments.of(\"null�\",                 \"null\\\\0000\"),\n            // Large code points (out of Unicode range) replaced by U+FFFD\n            Arguments.of(\"large�\",                \"large\\\\110000\"),\n            Arguments.of(\"large�\",                \"large\\\\23456a\"),\n            // Surrogate code points replaced by U+FFFD\n            Arguments.of(\"surrogate�\",            \"surrogate\\\\D800\"),\n            Arguments.of(\"surrogate�\",            \"surrogate\\\\0DBAC\"),\n            Arguments.of(\"�surrogate\",            \"\\\\00DFFFsurrogate\"),\n            // Supplementary plane characters (encoded as surrogate pair in Java)\n            Arguments.of(\"􏿿\",               \"\\\\10fFfF\"),\n            Arguments.of(\"􏿿0\",              \"\\\\10fFfF0\"),\n            Arguments.of(\"􀀀00\",             \"\\\\10000000\"),\n            // EOF after backslash yields U+FFFD\n            Arguments.of(\"eof�\",                  \"eof\\\\\"),\n            // Plain identifiers with no escapes\n            Arguments.of(\"simple-ident\",               \"simple-ident\"),\n            Arguments.of(\"testing123\",                 \"testing123\"),\n            Arguments.of(\"_underscore\",                \"_underscore\"),\n            Arguments.of(\"-text\",                      \"-text\"),\n            // Escaped hex digit for a letter after a leading dash\n            Arguments.of(\"-m\",                         \"-\\\\6d\"),\n            // Double-dash identifiers (CSS custom property prefix)\n            Arguments.of(\"--abc\",                      \"--abc\"),\n            Arguments.of(\"--\",                         \"--\"),\n            Arguments.of(\"--11\",                       \"--11\"),\n            Arguments.of(\"---\",                        \"---\"),\n            // Non-ASCII characters preserved as-is\n            Arguments.of(\" \",                     \" \"),\n            Arguments.of(\" \",                     \" \"),\n            Arguments.of(\"ሴ\",                     \"ሴ\"),\n            Arguments.of(\"𒍅\",               \"𒍅\"),\n            // Literal null byte in input is replaced by U+FFFD\n            Arguments.of(\"�\",                     \"\u0000\"),\n            Arguments.of(\"ab�c\",                  \"ab\u0000c\")\n        );\n    }\n\n    /**\n     * Additional CSS identifier parsing cases covering edge cases in escape sequences.\n     */\n    private static Stream<Arguments> cssAdditionalIdentifiers() {\n        return Stream.of(\n            // CRLF after hex escape is consumed as a single whitespace terminator\n            Arguments.of(\"1st\",  \"\\\\31\\r\\nst\"),\n            // Lone CR after hex escape terminates the escape sequence\n            Arguments.of(\"1\",    \"\\\\31\\r\"),\n            Arguments.of(\"1a\",   \"\\\\31\\ra\"),\n            // Leading-zero variants of the same hex value\n            Arguments.of(\"1\",    \"\\\\031\"),\n            Arguments.of(\"1\",    \"\\\\0031\"),\n            Arguments.of(\"1\",    \"\\\\00031\"),\n            Arguments.of(\"1\",    \"\\\\000031\"),\n            Arguments.of(\"1\",    \"\\\\000031\"),\n            // Escaped newline is ignored (line continuation)\n            Arguments.of(\"a\",    \"a\\\\\\nb\")\n        );\n    }\n\n    @ParameterizedTest\n    @MethodSource(\"cssIdentifiers\")\n    @MethodSource(\"cssAdditionalIdentifiers\")\n    void consumeCssIdentifier_WebPlatformTests(String expected, String cssIdentifier) {\n        assertParsedCssIdentifierEquals(expected, cssIdentifier);\n    }\n}\n",
