  "last_code": "package org.jsoup.parser;\n\nimport org.junit.jupiter.api.DisplayName;\nimport org.junit.jupiter.params.ParameterizedTest;\nimport org.junit.jupiter.params.provider.Arguments;\nimport org.junit.jupiter.params.provider.MethodSource;\nimport java.util.stream.Stream;\nimport static org.junit.jupiter.api.Assertions.*;\n\npublic class TokenQueueTest_escapeCssIdentifier {\n\n    // Test data from:\n    // https://github.com/web-platform-tests/wpt/blob/328fa1c67bf5dfa6f24571d4c41dd10224b6d247/css/cssom/escape.html\n    private static Stream<Arguments> escapeCssIdentifier_WebPlatformTestParameters() {\n        return Stream.of(\n            // Empty string - returned unchanged\n            Arguments.of(\"\", \"\"),\n\n            // Null bytes (U+0000) - replaced with U+FFFD REPLACEMENT CHARACTER\n            Arguments.of(\"�\",    \"\u0000\"),\n            Arguments.of(\"a�\",  \"a\u0000\"),\n            Arguments.of(\"�b\",  \"\u0000b\"),\n            Arguments.of(\"a�b\", \"a\u0000b\"),\n\n            // U+FFFD REPLACEMENT CHARACTER input - preserved as-is in output\n            Arguments.of(\"�\",    \"�\"),\n            Arguments.of(\"a�\",  \"a�\"),\n            Arguments.of(\"�b\",  \"�b\"),\n            Arguments.of(\"a�b\", \"a�b\"),\n\n            // Digit as first character - escaped as CSS code-point (e.g. \"0a\" becomes \"\\30 a\")\n            Arguments.of(\"\\\\30 a\", \"0a\"),\n            Arguments.of(\"\\\\31 a\", \"1a\"),\n            Arguments.of(\"\\\\32 a\", \"2a\"),\n            Arguments.of(\"\\\\33 a\", \"3a\"),\n            Arguments.of(\"\\\\34 a\", \"4a\"),\n            Arguments.of(\"\\\\35 a\", \"5a\"),\n            Arguments.of(\"\\\\36 a\", \"6a\"),\n            Arguments.of(\"\\\\37 a\", \"7a\"),\n            Arguments.of(\"\\\\38 a\", \"8a\"),\n            Arguments.of(\"\\\\39 a\", \"9a\"),\n\n            // Digit in the middle of an identifier - preserved unchanged\n            Arguments.of(\"a0b\", \"a0b\"),\n            Arguments.of(\"a1b\", \"a1b\"),\n            Arguments.of(\"a2b\", \"a2b\"),\n            Arguments.of(\"a3b\", \"a3b\"),\n            Arguments.of(\"a4b\", \"a4b\"),\n            Arguments.of(\"a5b\", \"a5b\"),\n            Arguments.of(\"a6b\", \"a6b\"),\n            Arguments.of(\"a7b\", \"a7b\"),\n            Arguments.of(\"a8b\", \"a8b\"),\n            Arguments.of(\"a9b\", \"a9b\"),\n\n            // '-' as first char followed by a digit - digit is escaped as code-point\n            Arguments.of(\"-\\\\30 a\", \"-0a\"),\n            Arguments.of(\"-\\\\31 a\", \"-1a\"),\n            Arguments.of(\"-\\\\32 a\", \"-2a\"),\n            Arguments.of(\"-\\\\33 a\", \"-3a\"),\n            Arguments.of(\"-\\\\34 a\", \"-4a\"),\n            Arguments.of(\"-\\\\35 a\", \"-5a\"),\n            Arguments.of(\"-\\\\36 a\", \"-6a\"),\n            Arguments.of(\"-\\\\37 a\", \"-7a\"),\n            Arguments.of(\"-\\\\38 a\", \"-8a\"),\n            Arguments.of(\"-\\\\39 a\", \"-9a\"),\n\n            // Double-dash prefix \"--\" - preserved unchanged\n            Arguments.of(\"--a\", \"--a\"),\n\n            // C0 control characters (U+0001-U+001F) - each escaped as a CSS code-point\n            Arguments.of(\"\\\\1 \\\\2 \\\\1e \\\\1f \", \"\u0001\u0002\u001e\u001f\"),\n\n            // '-' (U+002D), '_' (U+005F) and non-ASCII chars >= U+0080 are valid ident chars - preserved unchanged\n            Arguments.of(\"-_©\", \"-_©\"),\n\n            // U+007F DEL is escaped as code-point; U+0080-U+009F are all preserved unchanged\n            Arguments.of(\n                \"\\\\7f \"\n                    + \"\"\n                    + \"\",\n                \"\"\n                    + \"\"\n                    + \"\"),\n\n            // Latin-1 supplement characters (U+00A0 and above) - preserved unchanged\n            Arguments.of(\" ¡¢\", \" ¡¢\"),\n\n            // Mixed alphanumeric runs - preserved unchanged\n            Arguments.of(\"a0123456789b\",              \"a0123456789b\"),\n            Arguments.of(\"abcdefghijklmnopqrstuvwxyz\", \"abcdefghijklmnopqrstuvwxyz\"),\n            Arguments.of(\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"),\n\n            // Backslash - escaped with a second backslash\n            Arguments.of(\"hello\\\\\\\\world\", \"hello\\\\world\"),\n\n            // Non-ASCII code points > U+0080 - preserved without escaping\n            Arguments.of(\"helloሴworld\", \"helloሴworld\"),\n\n            // Single lone '-' (U+002D) - escaped with a leading backslash\n            Arguments.of(\"\\\\-\", \"-\"),\n\n            // Non-ident ASCII chars: space (U+0020) and '!' (U+0021) - each escaped with a leading backslash\n            Arguments.of(\"\\\\ \\\\!xy\", \" !xy\"),\n\n            // Astral symbol U+1D306 (TETRAGRAM FOR CENTRE) - surrogate pair preserved unchanged\n            Arguments.of(\"𝌆\", \"𝌆\"),\n\n            // Lone surrogates - preserved as-is\n            Arguments.of(\"\\uDF06\", \"\\uDF06\"),\n            Arguments.of(\"\\uD834\", \"\\uD834\")\n        );\n    }\n\n    private static Stream<Arguments> escapeCssIdentifier_additionalParameters() {\n        return Stream.of(\n            // Special CSS characters inside an identifier are each prefixed with a backslash\n            Arguments.of(\"one\\\\#two\\\\.three\\\\/four\\\\\\\\five\", \"one#two.three/four\\\\five\"),\n\n            // Leading '-' followed by a letter - preserved unchanged\n            Arguments.of(\"-a\", \"-a\"),\n\n            // Double dash with no following characters - preserved unchanged\n            Arguments.of(\"--\", \"--\")\n        );\n    }\n\n    @ParameterizedTest\n    @MethodSource({\"escapeCssIdentifier_WebPlatformTestParameters\", \"escapeCssIdentifier_additionalParameters\"})\n    @DisplayName(\"escapeCssIdentifier escapes CSS special characters per the CSS Object Model serialization spec\")\n    public void escapeCssIdentifier(String expected, String input) {\n        assertEquals(expected, TokenQueue.escapeCssIdentifier(input));\n    }\n}\n",
