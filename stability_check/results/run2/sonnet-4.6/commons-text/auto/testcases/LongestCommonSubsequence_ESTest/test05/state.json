  "last_code": "package org.apache.commons.text.similarity;\n\nimport org.junit.Test;\nimport static org.junit.Assert.*;\nimport static org.evosuite.runtime.EvoAssertions.*;\nimport java.nio.CharBuffer;\nimport org.evosuite.runtime.EvoRunner;\nimport org.evosuite.runtime.EvoRunnerParameters;\nimport org.junit.runner.RunWith;\n\n@RunWith(EvoRunner.class)\n@EvoRunnerParameters(mockJVMNonDeterminism = true, useVFS = true, useVNET = true, resetStaticState = true, separateClassLoader = false)\npublic class LongestCommonSubsequence_ESTest_test05 extends LongestCommonSubsequence_ESTest_scaffolding {\n\n    /**\n     * Verifies that the LCS length of \"\u0000r\" against a CharBuffer of 3226 null chars is 1.\n     * The input \"\u0000r\" contains a null char and 'r'. The CharBuffer holds only null chars,\n     * so only the null char is shared — yielding an LCS length of 1.\n     */\n    @Test(timeout = 4000)\n    public void test05_lcsOfNullPlusRAgainstAllNullBuffer_returnsOne() throws Throwable {\n        LongestCommonSubsequence lcs = new LongestCommonSubsequence();\n\n        // All 3226 positions in this buffer are initialised to the null character '\u0000'\n        CharBuffer allNullChars = CharBuffer.allocate(3226);\n\n        // \"\u0000r\" has two chars: null ('\u0000') and 'r'. Only '\u0000' exists in the buffer.\n        int lcsLength = lcs.apply((CharSequence) \"\u0000r\", (CharSequence) allNullChars);\n\n        assertEquals(1, lcsLength);\n    }\n}\n",
