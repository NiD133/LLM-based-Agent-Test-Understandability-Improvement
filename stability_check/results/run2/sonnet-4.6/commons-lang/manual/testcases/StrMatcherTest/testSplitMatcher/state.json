  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n@Deprecated\npublic class StrMatcherTest_testSplitMatcher extends AbstractLangTest {\n\n    // Buffer characters by index:\n    //  0:'0'  1:','  2:'1'     3:'\\t'      4:'2'  5:' '       6:'3'\n    //  7:'\\n' 8:'\\r' 9:'\\f'  10:'\u0000'  11:'\\'' 12:'\"'\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    @Test\n    void testSplitMatcher() {\n        final StrMatcher matcher = StrMatcher.splitMatcher();\n\n        // splitMatcher() is a singleton — every call returns the same instance\n        assertSame(matcher, StrMatcher.splitMatcher());\n\n        // splitMatcher matches: space (' '), tab ('\\t'), newline ('\\n'), carriage return ('\\r'), form feed ('\\f')\n        assertEquals(0, matcher.isMatch(BUFFER1, 2));  // '1'       — not a split character\n        assertEquals(1, matcher.isMatch(BUFFER1, 3));  // '\\t'      — tab matches\n        assertEquals(0, matcher.isMatch(BUFFER1, 4));  // '2'       — not a split character\n        assertEquals(1, matcher.isMatch(BUFFER1, 5));  // ' '       — space matches\n        assertEquals(0, matcher.isMatch(BUFFER1, 6));  // '3'       — not a split character\n        assertEquals(1, matcher.isMatch(BUFFER1, 7));  // '\\n'      — newline matches\n        assertEquals(1, matcher.isMatch(BUFFER1, 8));  // '\\r'      — carriage return matches\n        assertEquals(1, matcher.isMatch(BUFFER1, 9));  // '\\f'      — form feed matches\n        assertEquals(0, matcher.isMatch(BUFFER1, 10)); // '\u0000'  — null char does not match\n    }\n}\n",
