  "last_code": "package org.apache.commons.math4.legacy.stat.correlation;\n\nimport org.apache.commons.math4.legacy.TestUtils;\nimport org.apache.commons.math4.legacy.exception.MathIllegalArgumentException;\nimport org.apache.commons.math4.legacy.exception.NotStrictlyPositiveException;\nimport org.apache.commons.math4.legacy.linear.Array2DRowRealMatrix;\nimport org.apache.commons.math4.legacy.linear.RealMatrix;\nimport org.junit.Assert;\nimport org.junit.Test;\n\n/**\n * Tests covariance computation using the classic Longley (1967) econometric dataset.\n *\n * Data source: J. Longley (1967) \"An Appraisal of Least Squares Programs for the\n * Electronic Computer from the Point of View of the User\", Journal of the American\n * Statistical Association, vol. 62, pp. 819-841.\n * Available from NIST: http://www.itl.nist.gov/div898/strd/lls/data/LINKS/DATA/Longley.dat\n *\n * The dataset covers US economic indicators from 1947 to 1962 (16 annual observations).\n * Columns (in order): Employed, GNP Deflator, GNP, Unemployed, Armed Forces,\n *                     Non-institutional Population, Year\n */\npublic class CovarianceTest_testLongley {\n\n    // Number of annual observations in the Longley dataset (1947-1962)\n    private static final int LONGLEY_ROWS = 16;\n\n    // Number of economic variables measured per year\n    private static final int LONGLEY_COLS = 7;\n\n    /**\n     * Longley dataset: 16 yearly observations x 7 economic variables.\n     * Each row contains: Employed, GNP_Deflator, GNP, Unemployed, Armed_Forces, Population, Year\n     */\n    protected final double[] longleyData = new double[] {\n        // Employed  GNP_Defl    GNP       Unemployed  Armed_Forces  Population  Year\n           60323,    83.0,    234289,    2356,    1590,    107608,    1947,\n           61122,    88.5,    259426,    2325,    1456,    108632,    1948,\n           60171,    88.2,    258054,    3682,    1616,    109773,    1949,\n           61187,    89.5,    284599,    3351,    1650,    110929,    1950,\n           63221,    96.2,    328975,    2099,    3099,    112075,    1951,\n           63639,    98.1,    346999,    1932,    3594,    113270,    1952,\n           64989,    99.0,    365385,    1870,    3547,    115094,    1953,\n           63761,   100.0,    363112,    3578,    3350,    116219,    1954,\n           66019,   101.2,    397469,    2904,    3048,    117388,    1955,\n           67857,   104.6,    419180,    2822,    2857,    118734,    1956,\n           68169,   108.4,    442769,    2936,    2798,    120445,    1957,\n           66513,   110.8,    444546,    4681,    2637,    121950,    1958,\n           68655,   112.6,    482704,    3813,    2552,    123366,    1959,\n           69564,   114.2,    502601,    3931,    2514,    125368,    1960,\n           69331,   115.7,    518173,    4806,    2572,    127852,    1961,\n           70551,   116.9,    554894,    4007,    2827,    130081,    1962\n    };\n\n    protected final double[] swissData = new double[] { 80.2, 17.0, 15, 12, 9.96, 83.1, 45.1, 6, 9, 84.84, 92.5, 39.7, 5, 5, 93.40, 85.8, 36.5, 12, 7, 33.77, 76.9, 43.5, 17, 15, 5.16, 76.1, 35.3, 9, 7, 90.57, 83.8, 70.2, 16, 7, 92.85, 92.4, 67.8, 14, 8, 97.16, 82.4, 53.3, 12, 7, 97.67, 82.9, 45.2, 16, 13, 91.38, 87.1, 64.5, 14, 6, 98.61, 64.1, 62.0, 21, 12, 8.52, 66.9, 67.5, 14, 7, 2.27, 68.9, 60.7, 19, 12, 4.43, 61.7, 69.3, 22, 5, 2.82, 68.3, 72.6, 18, 2, 24.20, 71.7, 34.0, 17, 8, 3.30, 55.7, 19.4, 26, 28, 12.11, 54.3, 15.2, 31, 20, 2.15, 65.1, 73.0, 19, 9, 2.84, 65.5, 59.8, 22, 10, 5.23, 65.0, 55.1, 14, 3, 4.52, 56.6, 50.9, 22, 12, 15.14, 57.4, 54.1, 20, 6, 4.20, 72.5, 71.2, 12, 1, 2.40, 74.2, 58.1, 14, 8, 5.23, 72.0, 63.5, 6, 3, 2.56, 60.5, 60.8, 16, 10, 7.72, 58.3, 26.8, 25, 19, 18.46, 65.4, 49.5, 15, 8, 6.10, 75.5, 85.9, 3, 2, 99.71, 69.3, 84.9, 7, 6, 99.68, 77.3, 89.7, 5, 2, 100.00, 70.5, 78.2, 12, 6, 98.96, 79.4, 64.9, 7, 3, 98.22, 65.0, 75.9, 9, 9, 99.06, 92.2, 84.6, 3, 3, 99.46, 79.3, 63.1, 13, 13, 96.83, 70.4, 38.4, 26, 12, 5.62, 65.7, 7.7, 29, 11, 13.79, 72.7, 16.7, 22, 13, 11.22, 64.4, 17.6, 35, 32, 16.92, 77.6, 37.6, 15, 7, 4.97, 67.6, 18.7, 25, 7, 8.65, 35.0, 1.2, 37, 53, 42.34, 44.7, 46.6, 16, 29, 50.43, 42.8, 27.7, 22, 29, 58.33 };\n\n    protected RealMatrix createRealMatrix(double[] data, int nRows, int nCols) {\n        double[][] matrixData = new double[nRows][nCols];\n        int ptr = 0;\n        for (int i = 0; i < nRows; i++) {\n            System.arraycopy(data, ptr, matrixData[i], 0, nCols);\n            ptr += nCols;\n        }\n        return new Array2DRowRealMatrix(matrixData);\n    }\n\n    /**\n     * Verifies that the computed covariance matrix matches the reference values\n     * produced by R for the Longley dataset.\n     *\n     * The expected 7x7 covariance matrix is stored row-by-row. Row and column\n     * indices correspond to: 0=Employed, 1=GNP_Deflator, 2=GNP, 3=Unemployed,\n     * 4=Armed_Forces, 5=Population, 6=Year.\n     */\n    @Test\n    public void testLongley() {\n        RealMatrix matrix = createRealMatrix(longleyData, LONGLEY_ROWS, LONGLEY_COLS);\n        RealMatrix covarianceMatrix = new Covariance(matrix).getCovarianceMatrix();\n\n        // Expected 7x7 covariance matrix computed by R (stored row by row)\n        // Rows/cols: Employed, GNP_Deflator, GNP, Unemployed, Armed_Forces, Population, Year\n        double[] rData = new double[] {\n            // row 0: Employed\n            12333921.73333333246,   3.679666000000000e+04,  343330206.333333313,\n            1649102.666666666744,   1117681.066666666651,   23461965.733333334,    16240.93333333333248,\n            // row 1: GNP_Deflator\n            36796.66000000000,      1.164576250000000e+02,  1063604.115416667,\n            6258.666250000000,      3490.253750000000,      73503.000000000,       50.92333333333334,\n            // row 2: GNP\n            343330206.33333331347,  1.063604115416667e+06,  9879353659.329166412,\n            56124369.854166664183,  30880428.345833335072,  685240944.600000024,   470977.90000000002328,\n            // row 3: Unemployed\n            1649102.66666666674,    6.258666250000000e+03,  56124369.854166664,\n            873223.429166666698,    -115378.762499999997,   4462741.533333333,     2973.03333333333330,\n            // row 4: Armed_Forces\n            1117681.06666666665,    3.490253750000000e+03,  30880428.345833335,\n            -115378.762499999997,   484304.095833333326,    1764098.133333333,     1382.43333333333339,\n            // row 5: Population\n            23461965.73333333433,   7.350300000000000e+04,  685240944.600000024,\n            4462741.533333333209,   1764098.133333333302,   48387348.933333330,    32917.40000000000146,\n            // row 6: Year\n            16240.93333333333,      5.092333333333334e+01,  470977.900000000,\n            2973.033333333333,      1382.433333333333,      32917.40000000,        22.66666666666667\n        };\n\n        RealMatrix expectedCovariance = createRealMatrix(rData, LONGLEY_COLS, LONGLEY_COLS);\n        TestUtils.assertEquals(\"covariance matrix\", expectedCovariance, covarianceMatrix, 10E-9);\n    }\n}\n",
