  "last_code": "package org.apache.commons.lang3.text;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.junit.jupiter.api.Assertions.assertSame;\nimport org.apache.commons.lang3.AbstractLangTest;\nimport org.junit.jupiter.api.Test;\n\n/**\n * Tests for {@link StrMatcher#splitMatcher()}, which matches the same whitespace\n * characters as {@link java.util.StringTokenizer}: space, tab, newline (\\n),\n * carriage return (\\r), and form feed (\\f).\n */\n@Deprecated\npublic class StrMatcherTest_testSplitMatcher extends AbstractLangTest {\n\n    // Buffer layout (index -> character):\n    //  0='0', 1=',', 2='1', 3='\\t', 4='2', 5=' ', 6='3',\n    //  7='\\n', 8='\\r', 9='\\f', 10='\u0000', 11='\\'', 12='\"'\n    private static final char[] BUFFER1 = \"0,1\\t2 3\\n\\r\\f\u0000'\\\"\".toCharArray();\n\n    private static final char[] BUFFER2 = \"abcdef\".toCharArray();\n\n    /** Return value from isMatch when the character at the tested position matches. */\n    private static final int MATCH = 1;\n\n    /** Return value from isMatch when the character at the tested position does not match. */\n    private static final int NO_MATCH = 0;\n\n    @Test\n    void testSplitMatcher() {\n        final StrMatcher matcher = StrMatcher.splitMatcher();\n\n        // splitMatcher() must return the same singleton on every call\n        assertSame(matcher, StrMatcher.splitMatcher());\n\n        // Non-whitespace characters should NOT be matched\n        assertEquals(NO_MATCH, matcher.isMatch(BUFFER1, 2));   // '1'        — digit\n        assertEquals(NO_MATCH, matcher.isMatch(BUFFER1, 4));   // '2'        — digit\n        assertEquals(NO_MATCH, matcher.isMatch(BUFFER1, 6));   // '3'        — digit\n        assertEquals(NO_MATCH, matcher.isMatch(BUFFER1, 10));  // '\u0000'  — null char, not a StringTokenizer separator\n\n        // Whitespace characters recognised by splitMatcher SHOULD be matched\n        assertEquals(MATCH, matcher.isMatch(BUFFER1, 3));   // '\\t' — horizontal tab\n        assertEquals(MATCH, matcher.isMatch(BUFFER1, 5));   // ' '  — space\n        assertEquals(MATCH, matcher.isMatch(BUFFER1, 7));   // '\\n' — newline\n        assertEquals(MATCH, matcher.isMatch(BUFFER1, 8));   // '\\r' — carriage return\n        assertEquals(MATCH, matcher.isMatch(BUFFER1, 9));   // '\\f' — form feed\n    }\n}\n",
