    ],
    "own_line": true,
    "norm": "--- Group 6: escape + nested expressions that DO resolve partially --- A leading \"$$\" is an escape sequence that produces a literal \"$\". The portion after the escape is then evaluated independently. \"$${${a}}\" → escape gives \"$\", then \"${${a}}\" inner \"${a}\"=1 → \"${1}\" → result: \"${1}\""
   },
