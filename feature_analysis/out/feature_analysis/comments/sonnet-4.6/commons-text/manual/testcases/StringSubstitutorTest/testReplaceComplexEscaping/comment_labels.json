   {
    "id": "i17",
    "kind": "Javadoc",
    "lines": [
     167,
     177
    ],
    "own_line": true,
    "norm": "Tests complex escaping. <p>The escape prefix {@code $$} prevents the immediately following {@code ${...}} from being treated as a variable reference, emitting a literal {@code ${...}} in its place. Inner variable references (inside the braces) are still resolved normally before the outer literal is assembled.</p> <p>Single-escape pattern: {@code $${${var}}} → {@code ${resolvedValue}}<br> Double-escape pattern: {@code $${$${var}}} → {@code ${${var}}} (no substitution at all)</p>"
   },
   {
    "id": "i18",
    "kind": "LineComment",
    "lines": [
     180,
     181
    ],
    "own_line": true,
    "norm": "Single-escape: $${${var}} resolves the inner variable but emits the result as a literal \"${...}\" string rather than substituting it. E.g. $${${a}} → \"${\" + \"1\" + \"}\" = \"${1}\"."
   },
   {
    "id": "i19",
    "kind": "LineComment",
    "lines": [
     187,
     188
    ],
    "own_line": true,
    "norm": "Single-escape inside a full sentence: the escaped expression produces a literal \"${quick brown fox}\" while the non-escaped ${target} is still resolved."
   },
   {
    "id": "i20",
    "kind": "LineComment",
    "lines": [
     192,
     193
    ],
    "own_line": true,
    "norm": "Double-escape: $${$${var}} escapes both the outer and inner variable markers, so the entire \"${var}\" expression is preserved literally with no substitution."
   },
   {
    "id": "i21",
    "kind": "LineComment",
    "lines": [
     199,
     199
    ],
    "own_line": true,
    "norm": "Double-escape with surrounding punctuation characters."
   },
   {
    "id": "i22",
    "kind": "LineComment",
    "lines": [
     204,
     205
    ],
    "own_line": true,
    "norm": "Double-escape in a full sentence: ${target} is resolved normally while the animal reference is double-escaped and emitted entirely as a literal."
   },
   {
    "id": "i23",
    "kind": "LineComment",
    "lines": [
     209,
     210
    ],
    "own_line": true,
    "norm": "Combining single-escape with a default-value expression: $${${undefined.number:-1234567890}} → \"${\" + \"1234567890\" + \"}\" = \"${1234567890}\""
   }
