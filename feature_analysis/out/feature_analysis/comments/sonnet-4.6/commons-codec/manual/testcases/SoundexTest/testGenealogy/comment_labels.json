     42
    ],
    "own_line": true,
    "norm": "--- 'H' is silent (not a separator) --- The 'h' between the two 'd' sounds in \"Dhdds\" is ignored entirely, causing the duplicate 'd' codes to collapse: D200."
   },
   {
