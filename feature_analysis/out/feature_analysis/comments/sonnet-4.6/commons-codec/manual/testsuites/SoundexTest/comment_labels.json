    "id": "i4",
    "kind": "Javadoc",
    "lines": [
     55,
     61
    ],
    "own_line": true,
    "norm": "Verifies basic encoding of common English words against known expected codes. <p> The inputs are the words of the well-known \"quick brown fox\" phrase, providing a quick sanity check of the most common phoneme patterns. </p>"
   },
