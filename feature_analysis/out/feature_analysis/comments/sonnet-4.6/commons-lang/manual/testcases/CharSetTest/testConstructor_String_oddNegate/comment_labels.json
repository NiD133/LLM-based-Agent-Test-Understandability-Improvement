  "i": [
   {
    "id": "i1",
    "kind": "Javadoc",
    "lines": [
     8,
     21
    ],
    "own_line": true,
    "norm": "Tests CharSet construction with patterns containing caret ('^') characters in unusual positions. <p>The CharSet DSL parses patterns left-to-right using these rules (highest priority first):</p> <ol> <li>Four chars matching {@code ^X-Y} → negated range \"not X..Y\"</li> <li>Three chars matching {@code X-Y} → ordinary range \"X..Y\"</li> <li>Two chars matching {@code ^X} → negated single char \"not X\"</li> <li>Single char {@code X} → literal char \"X\"</li> </ol> <p>A lone trailing {@code ^} is consumed as rule 4, becoming a literal {@code ^}. Duplicate ranges are automatically collapsed to a single entry.</p>"
   },
   {
    "id": "i2",
    "kind": "LineComment",
    "lines": [
     29,
     30
    ],
    "own_line": true,
    "norm": "\"^\" — a lone caret has no following char to negate, so rule 4 fires: it is stored as the literal character '^'."
   },
   {
    "id": "i3",
    "kind": "LineComment",
    "lines": [
     36,
     37
    ],
    "own_line": true,
    "norm": "\"^^\" — rule 3 fires on the two carets: the second '^' is the negated char, yielding one range: \"not '^'\"."
   },
   {
    "id": "i4",
    "kind": "LineComment",
    "lines": [
     43,
     44
    ],
    "own_line": true,
    "norm": "\"^^^\" — rule 3 consumes the first two carets as \"not '^'\", then rule 4 consumes the third as the literal '^', yielding two distinct ranges."
   },
   {
    "id": "i5",
    "kind": "LineComment",
    "lines": [
     51,
     52
    ],
    "own_line": true,
    "norm": "\"^^^^\" — rule 3 fires twice producing \"not '^'\" both times; duplicates are collapsed, leaving exactly one range."
   },
   {
    "id": "i6",
    "kind": "LineComment",
    "lines": [
     58,
     59
    ],
    "own_line": true,
    "norm": "\"a^\" — rule 4 fires for 'a' (literal 'a'), then rule 4 fires for the trailing '^' (literal '^'), yielding two ranges."
   },
   {
    "id": "i7",
    "kind": "LineComment",
    "lines": [
     66,
     67
    ],
    "own_line": true,
    "norm": "\"^a-\" — rule 3 fires on \"^a\" (not 'a'); the remaining '-' has no right-hand char for a range, so rule 4 fires and stores it as the literal '-'."
   },
   {
    "id": "i8",
    "kind": "LineComment",
    "lines": [
     74,
     75
    ],
    "own_line": true,
    "norm": "\"^^-c\" — rule 1 fires on all four chars: '^' is the negation prefix, so the result is a negated range from '^' to 'c'."
   },
   {
    "id": "i9",
    "kind": "LineComment",
    "lines": [
     81,
     81
    ],
    "own_line": true,
    "norm": "\"^c-^\" — rule 1 fires: negated range from 'c' to '^'."
   },
   {
    "id": "i10",
    "kind": "LineComment",
    "lines": [
     87,
     88
    ],
    "own_line": true,
    "norm": "\"^c-^d\" — rule 1 consumes \"^c-^\" as a negated range from 'c' to '^'; rule 4 then consumes 'd' as a literal, yielding two ranges."
   },
   {
    "id": "i11",
    "kind": "LineComment",
    "lines": [
     95,
     96
    ],
    "own_line": true,
    "norm": "\"^^-\" — rule 3 fires on \"^^\" (not '^'); the remaining '-' is a trailing char with no range context, so rule 4 stores it as the literal '-'."
   }
  ]
