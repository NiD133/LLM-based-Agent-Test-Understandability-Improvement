    ],
    "own_line": true,
    "norm": "Tests that {@link LocalDate#until(java.time.temporal.Temporal)} returns {@link Period#ZERO} when the target is a {@link Symmetry454Date} that represents the same instant in time, i.e. both dates share the same epoch-day despite belonging to different calendar systems."
   },
   {
    "id": "i2",
    "kind": "Javadoc",
    "lines": [
     19,
     26
    ],
    "own_line": true,
    "norm": "Pairs of (Symmetry454Date, ISO LocalDate) that represent the same point in time. Each pair is drawn from a notable historical date to provide concrete anchors across a wide range of years (year 1 through year 2000). <p>Because the Symmetry454 and Gregorian calendars diverge in their month/day numbering, the numeric fields differ, but the underlying epoch-day is the same for each pair."
   },
