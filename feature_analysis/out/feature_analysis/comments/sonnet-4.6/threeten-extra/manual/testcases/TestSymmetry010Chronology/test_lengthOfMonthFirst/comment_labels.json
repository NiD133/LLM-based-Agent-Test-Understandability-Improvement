    ],
    "own_line": true,
    "norm": "Leap year (2004): December gets an extra 7-day leap week → 37 days"
   },
   {
    "id": "i5",
    "kind": "Javadoc",
    "lines": [
     46,
     52
    ],
    "own_line": true,
    "norm": "Verifies that {@code lengthOfMonth()} returns the expected length when called on a date at the first day of each month. <p>The {@code day} parameter from the data source is intentionally ignored here; using day=1 ensures the test is independent of which specific day is chosen."
   }
