     36,
     39
    ],
    "own_line": true,
    "norm": "----------------------------------------------------------------------- DAY_OF_MONTH: 1..28 normally, 1..29 for months that carry an extra day (month 6 in a leap year, and month 13 every year). -----------------------------------------------------------------------"
   },
