    ],
    "own_line": true,
    "norm": "Verifies that {@link DiscordianDate#plus(long, java.time.temporal.TemporalUnit)} with {@link java.time.temporal.ChronoUnit#DAYS DAYS} advances a Discordian date by exactly the same number of days as the equivalent ISO {@link LocalDate}. <p>Each test case pairs a {@code DiscordianDate} with the ISO {@code LocalDate} that falls on the very same physical day. Adding (or subtracting) N days to the Discordian date must therefore land on the same day as adding N days to the ISO date."
   },
   {
    "id": "i2",
