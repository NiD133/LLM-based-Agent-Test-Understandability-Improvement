    "id": "i1",
    "kind": "Javadoc",
    "lines": [
     12,
     22
    ],
    "own_line": true,
    "norm": "Verifies that {@link LoopingListIterator#reset()} always returns the cursor to the start of the list, regardless of how far it has been advanced with {@link LoopingListIterator#next()} or rewound with {@link LoopingListIterator#previous()}. <p>The cursor sits between elements. The notation {@code [a] b c} below marks the cursor position: it is just before {@code a}, so the next call to {@code next()} returns {@code a} and the next call to {@code previous()} wraps around to the last element {@code c}.</p>"
   },
   {
    "id": "i2",
    "kind": "LineComment",
    "lines": [
     27,
     27
    ],
    "own_line": true,
    "norm": "Cursor starts at the beginning: [a] b c"
   },
   {
    "id": "i3",
    "kind": "LineComment",
    "lines": [
     29,
     29
    ],
    "own_line": true,
    "norm": "Advance two steps: a b [c]"
   },
   {
    "id": "i4",
    "kind": "LineComment",
    "lines": [
     33,
     33
    ],
    "own_line": true,
    "norm": "reset() jumps the cursor back to the beginning: [a] b c"
   },
   {
    "id": "i5",
    "kind": "LineComment",
    "lines": [
     37,
     37
    ],
    "own_line": true,
    "norm": "reset() again, then walk forward through the whole list and loop around."
   },
   {
    "id": "i6",
    "kind": "LineComment",
    "lines": [
     43,
     43
    ],
    "own_line": true,
    "norm": "reset() puts us back at the start; previous() now wraps to the end."
   },
   {
    "id": "i7",
    "kind": "LineComment",
    "lines": [
     48,
     48
    ],
    "own_line": true,
    "norm": "reset() again; previous() wraps to the end once more."
