    "own_line": true,
    "norm": "The modify/access times this library read from the 0x5455 extended field."
   },
   {
    "id": "i42",
    "kind": "BlockComment",
    "lines": [
     481,
     485
    ],
    "own_line": true,
    "norm": "We must distinguish three cases: - Java has read the extended time field itself and agrees with us (Java9 or Java8 and years prior to 2038) - Java has read the extended time field but found a year >= 2038 (Java8) - Java hasn't read the extended time field at all (Java7- or early Java8)"
   },
   {
    "id": "i43",
    "kind": "LineComment",
    "lines": [
     491,
     491
    ],
    "own_line": true,
    "norm": "When Java did not consult the extended field, its raw zip time is in local time and must be shifted to the expected offset."
   },
   {
    "id": "i44",
    "kind": "LineComment",
    "lines": [
     501,
     501
    ],
    "own_line": true,
    "norm": "All three timestamps have overflowed by 2109."
   },
   {
    "id": "i45",
    "kind": "LineComment",
    "lines": [
     508,
     509
    ],
    "own_line": true,
    "norm": "X5455 time is good from epoch (1970) to 2037. Zip time is good from 1980 to 2107."
   }
