   {
    "id": "i1",
    "kind": "Javadoc",
    "lines": [
     20,
     23
    ],
    "own_line": true,
    "norm": "Exercises the getters/setters of {@link X5455_ExtendedTimestamp} for the modify, access and create timestamps, plus the flags byte that controls how much data the field serializes."
   },
   {
    "id": "i2",
    "kind": "Javadoc",
    "lines": [
     26,
     26
    ],
    "own_line": true,
    "norm": "The largest value (in seconds since epoch) that still fits in a signed 32-bit integer."
   },
   {
    "id": "i3",
    "kind": "Javadoc",
    "lines": [
     29,
     29
    ],
    "own_line": true,
    "norm": "The extended timestamp field under test; freshly created before each test."
   },
   {
    "id": "i4",
    "kind": "LineComment",
    "lines": [
     39,
     39
    ],
    "own_line": true,
    "norm": "X5455 is all about time, so pick a fixed timestamp to play with: midnight Jan 1st, 2000 UTC."
   },
   {
    "id": "i5",
    "kind": "LineComment",
    "lines": [
     51,
     51
    ],
    "own_line": true,
    "norm": "The field stores seconds in 32 signed bits; a Java time one second past the max must be rejected."
   },
   {
    "id": "i6",
    "kind": "LineComment",
    "lines": [
     56,
     57
    ],
    "own_line": true,
    "norm": "Each timestamp (modify / access / create) shares the same getter/setter contract, so we verify them all through the same helper, wiring up the bit-specific methods via references."
   },
   {
    "id": "i7",
    "kind": "LineComment",
    "lines": [
     71,
     71
    ],
    "own_line": true,
    "norm": "Give all three timestamps a value so the flags below decide what actually gets serialized."
   },
   {
    "id": "i8",
    "kind": "LineComment",
    "lines": [
     76,
     80
    ],
    "own_line": true,
    "norm": "The flags byte drives which timestamps are present and how long the serialized data is. Local data can hold modify + access + create; central data only ever holds modify. Each field contributes 4 bytes on top of the mandatory 1-byte flags header. flags modify access create localLen centralLen"
   },
   {
    "id": "i9",
    "kind": "Javadoc",
    "lines": [
     89,
     94
    ],
    "own_line": true,
    "norm": "Verifies the getter/setter round-trips for a single timestamp slot (modify, access or create). The CUT exposes each timestamp through three equivalent representations - {@link ZipLong} (raw seconds), {@link Date} (Java millis) and {@link FileTime} - all of which must agree, truncate sub-second precision, and clear the presence bit when set to null."
   },
   {
    "id": "i10",
    "kind": "LineComment",
    "lines": [
     100,
     100
    ],
    "own_line": true,
    "norm": "Set via the raw ZipLong: all three representations report the same instant."
   },
   {
    "id": "i11",
    "kind": "LineComment",
    "lines": [
     104,
     104
    ],
    "own_line": true,
    "norm": "Set via java.util.Date: same result."
   },
   {
    "id": "i12",
    "kind": "LineComment",
    "lines": [
     108,
     108
    ],
    "own_line": true,
    "norm": "Set via Date carrying stray milliseconds: they must be zeroed out (per-second precision)."
   },
   {
    "id": "i13",
    "kind": "LineComment",
    "lines": [
     112,
     112
    ],
    "own_line": true,
    "norm": "Set via FileTime carrying stray milliseconds: also truncated to the second."
   },
   {
    "id": "i14",
    "kind": "LineComment",
    "lines": [
     116,
     116
    ],
    "own_line": true,
    "norm": "Clearing through any representation clears the others and unsets the presence bit."
   },
   {
    "id": "i15",
    "kind": "Javadoc",
    "lines": [
     133,
     136
    ],
    "own_line": true,
    "norm": "Asserts that the raw, Java-Date and FileTime views of a timestamp all report the same instant and that the presence bit is set."
   },
   {
    "id": "i16",
    "kind": "Javadoc",
    "lines": [
     146,
     149
    ],
    "own_line": true,
    "norm": "Sets the flags byte and asserts which presence bits it activates and how long the resulting local-file and central-directory data become."
   }
