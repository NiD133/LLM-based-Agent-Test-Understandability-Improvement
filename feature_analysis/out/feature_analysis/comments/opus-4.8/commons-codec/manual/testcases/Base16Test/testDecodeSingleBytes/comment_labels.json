    ],
    "own_line": true,
    "norm": "Verifies that {@link Base16#decode} can be driven incrementally: feeding the encoded hex characters in small, arbitrarily-split chunks must accumulate into the same plaintext as decoding them all at once. <p>The shared {@link BaseNCodec.Context} carries any \"half byte\" left over when a chunk ends in the middle of a hex pair, so the next {@code decode} call can finish that byte. After all chunks are processed, the decoded bytes are read out of the context buffer.</p>"
   },
   {
    "id": "i2",
    "kind": "LineComment",
    "lines": [
     21,
     21
    ],
    "own_line": true,
    "norm": "\"556E74696C206E6578742074696D6521\" is the Base16 (hex) encoding of \"Until next time!\"."
   },
