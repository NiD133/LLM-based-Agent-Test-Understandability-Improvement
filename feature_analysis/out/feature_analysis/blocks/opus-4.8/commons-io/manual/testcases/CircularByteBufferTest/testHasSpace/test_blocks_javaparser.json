            "line_count": 1,
            "preview": "final CircularByteBuffer buffer = new CircularByteBuffer(SINGLE_BYTE_CAPACITY);"
          },
          {
            "start_line": 23,
            "end_line": 24,
            "line_count": 2,
            "preview": "// A freshly created buffer is empty, so it has room for a byte. assertTrue(buffer.hasSpace(), \"Empty buffer should have space\");"
          },
          {
            "start_line": 26,
            "end_line": 28,
            "line_count": 3,
            "preview": "// Adding a byte fills the single slot, leaving no space. buffer.add((byte) 1); assertFalse(buffer.hasSpace(), \"Full buffer should report no space\");"
          },
          {
            "start_line": 30,
            "end_line": 32,
            "line_count": 3,
            "preview": "// Reading the byte back frees the slot again. assertEquals(1, buffer.read()); assertTrue(buffer.hasSpace(), \"Buffer should have space after the byte is read\");"
          },
          {
            "start_line": 34,
            "end_line": 38,
            "line_count": 5,
            "preview": "// The same fill-then-drain cycle works a second time, confirming the slot is reusable. buffer.add((byte) 2); assertFalse(buffer.hasSpace(), \"Full buffer should report no space\");"
          }
