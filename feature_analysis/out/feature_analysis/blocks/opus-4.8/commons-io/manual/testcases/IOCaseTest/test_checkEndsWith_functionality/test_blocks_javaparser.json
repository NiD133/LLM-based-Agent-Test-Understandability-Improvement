            "line_count": 2,
            "preview": "// The empty suffix is considered to end every string. assertTrue(IOCase.SENSITIVE.checkEndsWith(\"ABC\", \"\"));"
          },
          {
            "start_line": 19,
            "end_line": 24,
            "line_count": 6,
            "preview": "// A genuine suffix matches; a prefix or mid-string fragment does not. assertTrue(IOCase.SENSITIVE.checkEndsWith(\"ABC\", \"ABC\")); assertTrue(IOCase.SENSITIVE.checkEndsWith(\"ABC\", \"BC\"));"
          },
          {
            "start_line": 26,
            "end_line": 27,
            "line_count": 2,
            "preview": "// A suffix longer than the string cannot match. assertFalse(IOCase.SENSITIVE.checkEndsWith(\"ABC\", \"ABCD\"));"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// Empty-string edge cases. assertFalse(IOCase.SENSITIVE.checkEndsWith(\"\", \"ABC\")); assertTrue(IOCase.SENSITIVE.checkEndsWith(\"\", \"\"));"
