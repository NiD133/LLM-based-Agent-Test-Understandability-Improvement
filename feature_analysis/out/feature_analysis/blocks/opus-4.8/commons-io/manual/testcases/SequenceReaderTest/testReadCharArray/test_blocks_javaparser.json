          {
            "start_line": 35,
            "end_line": 36,
            "line_count": 2,
            "preview": "// Reading \"Foo\" then \"Bar\" in sequence yields the stream \"FooBar\". try (Reader reader = new SequenceReader(new StringReader(\"Foo\"), new StringReader(\"Bar\"))) {"
          },
          {
            "start_line": 38,
            "end_line": 41,
            "line_count": 4,
            "preview": "// First read: a 2-char buffer is filled entirely from \"Foo\" -> \"Fo\". char[] buffer = new char[2]; assertEquals(2, reader.read(buffer), \"Should read 2 chars: 'F', 'o'\");"
          },
          {
            "start_line": 43,
            "end_line": 47,
            "line_count": 5,
            "preview": "// Second read: a 3-char buffer crosses the reader boundary, // taking the last 'o' of \"Foo\" and the first two chars \"Ba\" of \"Bar\". buffer = new char[3];"
          },
          {
            "start_line": 49,
            "end_line": 53,
            "line_count": 5,
            "preview": "// Third read: only the final 'r' remains, so just 1 char is read // and the rest of the buffer keeps its initial '\\0' values. buffer = new char[3];"
          },
          {
            "start_line": 55,
            "end_line": 57,
            "line_count": 3,
            "preview": "// Stream is now exhausted: a further read reports end of stream. assertEquals(END_OF_STREAM, reader.read(buffer), \"Should report end of stream\"); }"
          }
