            "line_count": 4,
            "preview": "// The stream is not backed by OS resources, so it need not be closed. @SuppressWarnings(\"resource\") final UnsynchronizedByteArrayInputStream is ="
          },
          {
            "start_line": 44,
            "end_line": 45,
            "line_count": 2,
            "preview": "// mark/reset is always supported by this stream. assertTrue(is.markSupported());"
          },
          {
            "start_line": 47,
            "end_line": 50,
            "line_count": 4,
            "preview": "// Consume the first byte, then place a mark before the second byte. assertEquals(FIRST_BYTE, is.read()); assertTrue(is.markSupported());"
          },
          {
            "start_line": 52,
            "end_line": 54,
            "line_count": 3,
            "preview": "// Read to the end of the stream from the marked position. assertEquals(SECOND_BYTE, is.read()); assertEquals(THIRD_BYTE, is.read());"
          },
          {
            "start_line": 56,
            "end_line": 61,
            "line_count": 6,
            "preview": "// reset() rewinds to the mark, so the same two bytes are read again, // followed by end-of-stream. is.reset();"
          },
          {
            "start_line": 63,
            "end_line": 67,
            "line_count": 5,
            "preview": "// The mark survives reset(), so rewinding once more replays the bytes. is.reset(); assertEquals(SECOND_BYTE, is.read());"
