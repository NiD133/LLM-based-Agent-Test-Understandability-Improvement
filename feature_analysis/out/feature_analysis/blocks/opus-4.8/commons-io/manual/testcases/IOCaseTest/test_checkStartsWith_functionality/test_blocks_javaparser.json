          {
            "start_line": 16,
            "end_line": 18,
            "line_count": 3,
            "preview": "// Every string starts with the empty prefix, including the empty string itself. assertTrue(IOCase.SENSITIVE.checkStartsWith(\"ABC\", \"\")); assertTrue(IOCase.SENSITIVE.checkStartsWith(\"\", \"\"));"
          },
          {
            "start_line": 20,
            "end_line": 23,
            "line_count": 4,
            "preview": "// Any leading portion of the string is a valid prefix, up to the whole string. assertTrue(IOCase.SENSITIVE.checkStartsWith(\"ABC\", \"A\")); assertTrue(IOCase.SENSITIVE.checkStartsWith(\"ABC\", \"AB\"));"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// A substring that is not at the start is not a prefix. assertFalse(IOCase.SENSITIVE.checkStartsWith(\"ABC\", \"BC\")); assertFalse(IOCase.SENSITIVE.checkStartsWith(\"ABC\", \"C\"));"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// A prefix longer than the string can never match. assertFalse(IOCase.SENSITIVE.checkStartsWith(\"ABC\", \"ABCD\")); assertFalse(IOCase.SENSITIVE.checkStartsWith(\"\", \"ABC\"));"
          },
          {
            "start_line": 33,
            "end_line": 36,
            "line_count": 4,
            "preview": "// Null inputs always yield false. assertFalse(IOCase.SENSITIVE.checkStartsWith(\"ABC\", null)); assertFalse(IOCase.SENSITIVE.checkStartsWith(null, \"ABC\"));"
          }
