            "preview": "// A predefined BOM is equal to itself. assertEquals(ByteOrderMark.UTF_16BE, ByteOrderMark.UTF_16BE); assertEquals(ByteOrderMark.UTF_16LE, ByteOrderMark.UTF_16LE);"
