            "preview": "// Different predefined BOMs have different bytes, so they are not equal. assertNotEquals(ByteOrderMark.UTF_8, ByteOrderMark.UTF_16BE); assertNotEquals(ByteOrderMark.UTF_8, ByteOrderMark.UTF_16LE);"
