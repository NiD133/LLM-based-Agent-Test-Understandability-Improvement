          {
            "start_line": 41,
            "end_line": 44,
            "line_count": 4,
            "preview": "// Requesting zero bytes reads nothing (returns 0) even when data is available. final UnsynchronizedByteArrayInputStream zeroLengthRead = newStream(new byte[] { (byte) 0xa, (byte) 0xb, (byte) 0xc });"
          },
          {
            "start_line": 46,
            "end_line": 49,
            "line_count": 4,
            "preview": "// Partial then remaining reads: a 3-byte stream read in chunks of 2 then up to 10. final UnsynchronizedByteArrayInputStream stream = newStream(new byte[] { (byte) 0xa, (byte) 0xb, (byte) 0xc });"
