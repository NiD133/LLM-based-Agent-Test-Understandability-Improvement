        "blocks": [
          {
            "start_line": 24,
            "end_line": 25,
            "line_count": 2,
            "preview": "// The SequenceReader yields \"Foo\" followed by \"Bar\", i.e. the stream \"FooBar\". final char[] buffer = new char[10];"
          },
          {
            "start_line": 27,
            "end_line": 30,
            "line_count": 4,
            "preview": "try (Reader reader = new SequenceReader(new StringReader(\"Foo\"), new StringReader(\"Bar\"))) { // Read the first 3 characters (\"Foo\") into buffer[3..5], leaving buffer[0..2] untouched. assertEquals(3, reader.read(buffer, 3, 3));"
          },
          {
            "start_line": 32,
            "end_line": 34,
            "line_count": 3,
            "preview": "// Read the next 3 characters (\"Bar\") into buffer[0..2], overwriting the leading slots. assertEquals(3, reader.read(buffer, 0, 3)); assertBufferStartsWith(buffer, 'B', 'a', 'r', 'F', 'o', 'o', UNTOUCHED);"
          },
          {
            "start_line": 36,
            "end_line": 37,
            "line_count": 2,
            "preview": "// The \"FooBar\" stream is now exhausted, so a further read reports end-of-stream. assertEquals(-1, reader.read(buffer));"
          },
          {
            "start_line": 39,
            "end_line": 40,
            "line_count": 2,
            "preview": "// An offset/length beyond the buffer bounds must be rejected. assertThrows(IndexOutOfBoundsException.class, () -> reader.read(buffer, 10, 10));"
          },
          {
            "start_line": 42,
            "end_line": 44,
            "line_count": 3,
            "preview": "// A null destination buffer must be rejected. assertThrows(NullPointerException.class, () -> reader.read(null, 0, 10)); }"
          }
        ],
