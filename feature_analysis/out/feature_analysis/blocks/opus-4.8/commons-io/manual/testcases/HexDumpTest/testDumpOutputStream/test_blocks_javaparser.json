            "end_line": 97,
            "line_count": 2,
            "preview": "// Whole array, zero offset and index. assertDump(testArray, 0, 0);"
          },
          {
            "start_line": 99,
            "end_line": 100,
            "line_count": 2,
            "preview": "// Non-zero offset: the printed line offsets are shifted accordingly. assertDump(testArray, 0x10000000, 0);"
          },
          {
            "start_line": 102,
            "end_line": 103,
            "line_count": 2,
            "preview": "// \"Negative\" offset (high bit set): only the low 32 bits are printed. assertDump(testArray, 0xFF000000, 0);"
          },
          {
            "start_line": 105,
            "end_line": 106,
            "line_count": 2,
            "preview": "// Non-zero start index: dumping begins partway through the array. assertDump(testArray, 0x10000000, 0x81);"
          },
          {
            "start_line": 108,
            "end_line": 110,
            "line_count": 3,
            "preview": "// Negative index is rejected. assertThrows(ArrayIndexOutOfBoundsException.class, () -> HexDump.dump(testArray, 0x10000000, new ByteArrayOutputStream(), -1));"
          },
          {
            "start_line": 112,
            "end_line": 114,
            "line_count": 3,
            "preview": "// Index at or beyond the array length is rejected. assertThrows(ArrayIndexOutOfBoundsException.class, () -> HexDump.dump(testArray, 0x10000000, new ByteArrayOutputStream(), testArray.length));"
