            "start_line": 19,
            "end_line": 20,
            "line_count": 2,
            "preview": "for (int prolepticYear = -200; prolepticYear < 200; prolepticYear++) { JulianDate dateFromYear = JulianChronology.INSTANCE.date(prolepticYear, 1, 1);"
          },
          {
            "start_line": 22,
            "end_line": 23,
            "line_count": 2,
            "preview": "// The date should report back the proleptic year it was built from. assertEquals(prolepticYear, dateFromYear.get(YEAR));"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// Years 0 and earlier fall in the BC era; positive years are AD. JulianEra expectedEra = (prolepticYear <= 0 ? JulianEra.BC : JulianEra.AD); assertEquals(expectedEra, dateFromYear.getEra());"
          },
          {
            "start_line": 29,
            "end_line": 32,
            "line_count": 4,
            "preview": "// Within BC the year-of-era counts backwards (1 - prolepticYear); // within AD it equals the proleptic year. int expectedYearOfEra = (prolepticYear <= 0 ? 1 - prolepticYear : prolepticYear);"
          },
          {
            "start_line": 34,
            "end_line": 37,
            "line_count": 4,
            "preview": "// Building the same date from (era, year-of-era) must yield an equal date. JulianDate dateFromEra = JulianChronology.INSTANCE.date(expectedEra, expectedYearOfEra, 1, 1); assertEquals(dateFromYear, dateFromEra);"
          }
        ],
