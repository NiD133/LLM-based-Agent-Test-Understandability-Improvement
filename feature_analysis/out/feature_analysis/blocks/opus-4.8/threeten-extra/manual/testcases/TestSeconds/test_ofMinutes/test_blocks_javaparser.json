            "line_count": 2,
            "preview": "// Zero minutes -> zero seconds. assertEquals(0, Seconds.ofMinutes(0).getAmount());"
          },
          {
            "start_line": 23,
            "end_line": 25,
            "line_count": 3,
            "preview": "// Small positive amounts are scaled by 60. assertEquals(60, Seconds.ofMinutes(1).getAmount()); assertEquals(120, Seconds.ofMinutes(2).getAmount());"
          },
          {
            "start_line": 27,
            "end_line": 29,
            "line_count": 3,
            "preview": "// Largest minute value that still fits in an int once scaled by 60. int maxMinutes = Integer.MAX_VALUE / SECONDS_PER_MINUTE; assertEquals(maxMinutes * SECONDS_PER_MINUTE, Seconds.ofMinutes(maxMinutes).getAmount());"
          },
          {
            "start_line": 31,
            "end_line": 33,
            "line_count": 3,
            "preview": "// Small negative amounts are scaled by 60. assertEquals(-60, Seconds.ofMinutes(-1).getAmount()); assertEquals(-120, Seconds.ofMinutes(-2).getAmount());"
          },
          {
