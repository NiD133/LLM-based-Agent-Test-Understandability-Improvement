            "start_line": 18,
            "end_line": 20,
            "line_count": 3,
            "preview": "for (int prolepticYear = -200; prolepticYear < 200; prolepticYear++) { BritishCutoverDate firstDayOfYear = BritishCutoverChronology.INSTANCE.dateYearDay(prolepticYear, 1);"
          },
          {
            "start_line": 22,
            "end_line": 23,
            "line_count": 2,
            "preview": "// The proleptic year is preserved verbatim. assertEquals(prolepticYear, firstDayOfYear.get(YEAR));"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// Non-positive proleptic years fall in the BC era, positive years in AD. JulianEra expectedEra = (prolepticYear <= 0 ? JulianEra.BC : JulianEra.AD); assertEquals(expectedEra, firstDayOfYear.getEra());"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// BC counts backwards from year 1, so proleptic 0 -> year-of-era 1, -1 -> 2, etc. int expectedYearOfEra = (prolepticYear <= 0 ? 1 - prolepticYear : prolepticYear); assertEquals(expectedYearOfEra, firstDayOfYear.get(YEAR_OF_ERA));"
          },
          {
            "start_line": 33,
            "end_line": 37,
            "line_count": 5,
            "preview": "// Building the same date via (era, year-of-era) must yield an equal date. BritishCutoverDate fromEraAndYearOfEra = BritishCutoverChronology.INSTANCE.dateYearDay(expectedEra, expectedYearOfEra, 1);"
          }
