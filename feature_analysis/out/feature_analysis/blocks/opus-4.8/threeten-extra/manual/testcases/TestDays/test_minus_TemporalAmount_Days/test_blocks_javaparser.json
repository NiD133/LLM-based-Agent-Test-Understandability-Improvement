            "line_count": 2,
            "preview": "// Subtracting zero leaves the amount unchanged: 5 - 0 = 5. assertEquals(Days.of(5), fiveDays.minus(Days.of(0)));"
          },
          {
            "start_line": 22,
            "end_line": 23,
            "line_count": 2,
            "preview": "// Subtracting a positive amount decreases the value: 5 - 2 = 3. assertEquals(Days.of(3), fiveDays.minus(Days.of(2)));"
          },
          {
            "start_line": 25,
            "end_line": 26,
            "line_count": 2,
            "preview": "// Subtracting a negative amount increases the value: 5 - (-2) = 7. assertEquals(Days.of(7), fiveDays.minus(Days.of(-2)));"
