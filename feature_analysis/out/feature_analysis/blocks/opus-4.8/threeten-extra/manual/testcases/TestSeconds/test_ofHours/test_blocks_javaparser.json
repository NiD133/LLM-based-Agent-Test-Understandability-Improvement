          {
            "start_line": 20,
            "end_line": 21,
            "line_count": 2,
            "preview": "// Zero hours converts to zero seconds. assertEquals(0, Seconds.ofHours(0).getAmount());"
          },
          {
            "start_line": 23,
            "end_line": 25,
            "line_count": 3,
            "preview": "// Positive hours are multiplied by 3600. assertEquals(SECONDS_PER_HOUR, Seconds.ofHours(1).getAmount()); assertEquals(2 * SECONDS_PER_HOUR, Seconds.ofHours(2).getAmount());"
          },
          {
            "start_line": 27,
            "end_line": 29,
            "line_count": 3,
            "preview": "// Negative hours are also multiplied by 3600, keeping the sign. assertEquals(-SECONDS_PER_HOUR, Seconds.ofHours(-1).getAmount()); assertEquals(-2 * SECONDS_PER_HOUR, Seconds.ofHours(-2).getAmount());"
          },
          {
            "start_line": 31,
            "end_line": 33,
            "line_count": 3,
            "preview": "// The largest hour count that does not overflow when scaled to seconds. int maxHours = Integer.MAX_VALUE / SECONDS_PER_HOUR; assertEquals(maxHours * SECONDS_PER_HOUR, Seconds.ofHours(maxHours).getAmount());"
          },
          {
            "start_line": 35,
            "end_line": 37,
            "line_count": 3,
            "preview": "// The smallest (most negative) hour count that does not overflow. int minHours = Integer.MIN_VALUE / SECONDS_PER_HOUR; assertEquals(minHours * SECONDS_PER_HOUR, Seconds.ofHours(minHours).getAmount());"
          }
        ],
