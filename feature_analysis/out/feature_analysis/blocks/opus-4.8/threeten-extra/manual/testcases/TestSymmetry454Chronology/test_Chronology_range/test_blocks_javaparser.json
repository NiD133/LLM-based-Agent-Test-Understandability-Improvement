            "line_count": 4,
            "preview": "// Week-based fields: a week is always 7 days. assertEquals(ValueRange.of(1, 7), CHRONOLOGY.range(DAY_OF_WEEK)); assertEquals(ValueRange.of(1, 7), CHRONOLOGY.range(ALIGNED_DAY_OF_WEEK_IN_MONTH));"
          },
          {
            "start_line": 43,
            "end_line": 46,
            "line_count": 4,
            "preview": "// Weeks within a month: 4 in a normal month, 5 in a long (or leap-extended) month. assertEquals(ValueRange.of(1, 4, 5), CHRONOLOGY.range(ALIGNED_WEEK_OF_MONTH)); // Weeks within a year: 52 normally, 53 in a leap year."
          },
          {
            "start_line": 48,
            "end_line": 51,
            "line_count": 4,
            "preview": "// Days within a month: 28 in a normal month, 35 in a long (or leap-extended) month. assertEquals(ValueRange.of(1, 28, 35), CHRONOLOGY.range(DAY_OF_MONTH)); // Days within a year: 364 normally, 371 in a leap year (the extra leap week)."
          },
          {
            "start_line": 53,
            "end_line": 55,
            "line_count": 3,
            "preview": "// Calendar structure: 12 months per year, single CE era (0..1). assertEquals(ValueRange.of(1, 12), CHRONOLOGY.range(MONTH_OF_YEAR)); assertEquals(ValueRange.of(0, 1), CHRONOLOGY.range(ERA));"
          },
          {
            "start_line": 57,
            "end_line": 61,
            "line_count": 5,
            "preview": "// Year-based fields are bounded by +/- 1,000,000 proleptic years. assertEquals(ValueRange.of(-1_000_000L, 1_000_000), CHRONOLOGY.range(YEAR)); assertEquals(ValueRange.of(-1_000_000, 1_000_000), CHRONOLOGY.range(YEAR_OF_ERA));"
