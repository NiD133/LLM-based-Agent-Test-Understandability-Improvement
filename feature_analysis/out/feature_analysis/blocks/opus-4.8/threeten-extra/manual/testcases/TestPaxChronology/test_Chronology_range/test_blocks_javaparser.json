            "line_count": 2,
            "preview": "// Days of the week always run 1..7. assertEquals(ValueRange.of(1, 7), PaxChronology.INSTANCE.range(DAY_OF_WEEK));"
          },
          {
            "start_line": 31,
            "end_line": 33,
            "line_count": 3,
            "preview": "// Day-of-month is 1..28 for normal months, but the leap month \"Pax\" has // only 7 days, so the smallest possible maximum is 7. assertEquals(ValueRange.of(1, 7, 28), PaxChronology.INSTANCE.range(DAY_OF_MONTH));"
          },
          {
            "start_line": 35,
            "end_line": 37,
            "line_count": 3,
            "preview": "// Day-of-year is 1..364 in a common year (13 * 28) and up to 371 in a // leap year (13 * 28 + 7). assertEquals(ValueRange.of(1, 364, 371), PaxChronology.INSTANCE.range(DAY_OF_YEAR));"
          },
          {
