        "block_count": 7,
        "blocks": [
          {
            "start_line": 18,
            "end_line": 19,
            "line_count": 2,
            "preview": "// A clock created with epochUTC() starts at the epoch in the UTC zone. MutableClock utcClock = MutableClock.epochUTC();"
          },
          {
            "start_line": 21,
            "end_line": 23,
            "line_count": 3,
            "preview": "// withZone(...) returns a view that shares this clock's mutable instant, // so updates to one are visible through the other. MutableClock viewInMinZone = utcClock.withZone(ZoneOffset.MIN);"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// Switching the view back to UTC produces another shared view that, this // time, also matches the original clock's zone. MutableClock viewBackInUtcZone = viewInMinZone.withZone(ZoneOffset.UTC);"
          },
          {
            "start_line": 29,
            "end_line": 30,
            "line_count": 2,
            "preview": "// Update the instant through the original clock. utcClock.setInstant(Instant.MIN);"
          },
          {
            "start_line": 32,
            "end_line": 34,
            "line_count": 3,
            "preview": "// The shared instant is visible through every view. assertEquals(Instant.MIN, viewInMinZone.instant()); assertEquals(Instant.MIN, viewBackInUtcZone.instant());"
          },
          {
            "start_line": 36,
            "end_line": 38,
            "line_count": 3,
            "preview": "// Each view keeps the zone it was created with. assertEquals(ZoneOffset.MIN, viewInMinZone.getZone()); assertEquals(ZoneOffset.UTC, viewBackInUtcZone.getZone());"
          },
          {
            "start_line": 40,
            "end_line": 44,
            "line_count": 5,
            "preview": "// Two clocks are equal only when they share updates AND use the same zone. // viewInMinZone shares updates but uses a different zone, so it is not equal. assertNotEquals(utcClock, viewInMinZone);"
          }
        ],
