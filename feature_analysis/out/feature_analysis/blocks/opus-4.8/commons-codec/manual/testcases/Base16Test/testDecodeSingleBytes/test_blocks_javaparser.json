          {
            "start_line": 21,
            "end_line": 23,
            "line_count": 3,
            "preview": "// \"556E74696C206E6578742074696D6521\" is the Base16 (hex) encoding of \"Until next time!\". final String encodedHex = \"556E74696C206E6578742074696D6521\"; final byte[] encodedBytes = StringUtils.getBytesUtf8(encodedHex);"
          },
          {
            "start_line": 25,
            "end_line": 26,
            "line_count": 2,
            "preview": "final Base16 base16 = new Base16(); final BaseNCodec.Context context = new BaseNCodec.Context();"
          },
          {
            "start_line": 28,
            "end_line": 29,
            "line_count": 2,
            "preview": "// Feed the encoded characters in deliberately uneven chunks to exercise the // incremental decoding paths (single character, split hex-pairs, and remainder)."
          },
          {
            "start_line": 31,
            "end_line": 35,
            "line_count": 5,
            "preview": "// Whole hex pairs, one character at a time -> \"Un\" base16.decode(encodedBytes, 0, 1, context); base16.decode(encodedBytes, 1, 1, context);"
          },
          {
            "start_line": 37,
            "end_line": 40,
            "line_count": 4,
            "preview": "// Odd-sized chunks that split hex-pairs across calls -> \"til \" base16.decode(encodedBytes, 4, 3, context); base16.decode(encodedBytes, 7, 3, context);"
          },
          {
            "start_line": 42,
            "end_line": 43,
            "line_count": 2,
            "preview": "// Everything that remains in one chunk -> \"next time!\" base16.decode(encodedBytes, 13, 19, context);"
          },
          {
            "start_line": 45,
            "end_line": 48,
            "line_count": 4,
            "preview": "// Copy the decoded bytes out of the context buffer and turn them back into text. final byte[] decodedBytes = new byte[context.pos]; System.arraycopy(context.buffer, context.readPos, decodedBytes, 0, decodedBytes.length);"
          },
          {
            "start_line": 50,
            "end_line": 50,
