            "line_count": 3,
            "preview": "// A fresh context holds no parked nibble and has not allocated an output buffer yet. assertEquals(0, context.ibitWorkArea); assertNull(context.buffer);"
          },
          {
            "start_line": 31,
            "end_line": 31,
            "line_count": 1,
            "preview": "final byte[] singleChar = new byte[1];"
          },
          {
            "start_line": 33,
            "end_line": 37,
            "line_count": 5,
            "preview": "// Feed the high nibble 'E' (0xE == 14). It is parked, not yet emitted, so no buffer exists. singleChar[0] = (byte) 'E'; base16.decode(singleChar, 0, 1, context);"
          },
          {
            "start_line": 39,
            "end_line": 43,
            "line_count": 5,
            "preview": "// Feed the low nibble 'F'. The two nibbles combine into the byte 0xEF and the work area resets. singleChar[0] = (byte) 'F'; base16.decode(singleChar, 0, 1, context);"
