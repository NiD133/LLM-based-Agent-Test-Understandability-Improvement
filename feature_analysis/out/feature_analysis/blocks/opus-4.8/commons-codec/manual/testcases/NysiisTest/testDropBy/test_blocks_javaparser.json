            "end_line": 48,
            "line_count": 3,
            "preview": "// Violates rule 4j: the second N should not be added, as the first key char is // already an N. Original: NNAT; modified: NATH. assertEncoding(\"KNUTH\", \"NAT\");"
          },
          {
            "start_line": 50,
            "end_line": 54,
            "line_count": 5,
            "preview": "// O and E are transcoded to A because of rule 4a; H also to A because of rule 4h. // The N gets lost, maybe because of a wrongly implemented rule 4h that skips the // next char in such a case. The remaining A is removed because of rule 7."
          },
          {
            "start_line": 56,
            "end_line": 57,
            "line_count": 2,
            "preview": "// Violates rule 4j (see also KNUTH). Original: FFALAP[SAN]. assertEncoding(\"PHILLIPSON\", \"FALAPSAN\");"
          },
          {
            "start_line": 59,
            "end_line": 60,
            "line_count": 2,
            "preview": "// Violates rule 4j (see also KNUTH). Original: FFASTA[R]. assertEncoding(\"PFEISTER\", \"FASTAR\");"
          },
          {
            "start_line": 62,
            "end_line": 63,
            "line_count": 2,
            "preview": "// Violates rule 4j (see also KNUTH). Original: SSANAF[T]. assertEncoding(\"SCHOENHOEFT\", \"SANAFT\");"
          },
          {
            "start_line": 65,
            "end_line": 72,
            "line_count": 8,
            "preview": "// 2. Transcode last characters of name. assertEncoding(\"MCKEE\", \"MCY\"); assertEncoding(\"MACKIE\", \"MCY\");"
          },
          {
            "start_line": 74,
            "end_line": 80,
            "line_count": 7,
            "preview": "// 4. Transcode remaining characters, incrementing by one character each time. assertEncoding(\"CASSTEVENS\", \"CASTAFAN\"); assertEncoding(\"VASQUEZ\", \"VASG\");"
