            "start_line": 60,
            "end_line": 67,
            "line_count": 8,
            "preview": "// \"$$\" escapes the leading \"$\" so the outer \"${...}\" survives as literal text, // while the inner variable is still substituted. assertReplaces(\"${1}\", \"$${${a}}\", false);"
          },
          {
            "start_line": 69,
            "end_line": 74,
            "line_count": 6,
            "preview": "// Both \"$\" characters of the inner \"${...}\" are escaped, so nothing inside is substituted // and the whole inner expression is emitted literally. assertReplaces(\"${${a}}\", \"$${$${a}}\", false);"
          },
          {
            "start_line": 76,
            "end_line": 81,
            "line_count": 6,
            "preview": "// Surrounding literal text (leading/trailing dots) is preserved verbatim. assertReplaces(\".${${animal}}\", \".$${$${animal}}\", false); assertReplaces(\"${${animal}}.\", \"$${$${animal}}.\", false);"
          },
          {
            "start_line": 83,
            "end_line": 86,
            "line_count": 4,
            "preview": "// The \"-\" default-value syntax: \"undefined.number\" is unknown, so its default \"1234567890\" // is used, then escaped into literal \"${1234567890}\". assertReplaces(\"The ${quick brown fox} jumps over the lazy dog. ${1234567890}.\","
          }
        ],
