            "start_line": 15,
            "end_line": 16,
            "line_count": 2,
            "preview": "// A tokenizer built from a null input has no text and therefore no tokens. final StringTokenizer tokenizer = new StringTokenizer((char[]) null);"
          },
          {
            "start_line": 18,
            "end_line": 22,
            "line_count": 5,
            "preview": "// Sanity check: with no input, nextToken() returns null, and resetting // the tokenizer keeps that behaviour. assertNull(tokenizer.nextToken(), \"null input should yield no tokens\");"
          },
          {
            "start_line": 24,
            "end_line": 25,
            "line_count": 2,
            "preview": "// Clone the tokenizer; the clone must be independent of the original. final StringTokenizer clonedTokenizer = (StringTokenizer) tokenizer.clone();"
          },
          {
            "start_line": 27,
            "end_line": 30,
            "line_count": 4,
            "preview": "// Both the reset original and the clone must behave like an empty tokenizer. tokenizer.reset(); assertNull(tokenizer.nextToken(), \"original should still have no tokens\");"
          }
