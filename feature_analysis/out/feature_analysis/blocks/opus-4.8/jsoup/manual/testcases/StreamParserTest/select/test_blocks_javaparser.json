            "preview": "String html = \"<title>One</title><p id=1>P One</p><p id=2>P Two</p>\"; StreamParser parser = new StreamParser(Parser.htmlParser()).parse(html, \"\");"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// expectFirst parses only as far as needed to find the <title>. Element title = parser.expectFirst(\"title\"); assertEquals(\"One\", title.text());"
          },
          {
            "start_line": 33,
            "end_line": 36,
            "line_count": 4,
            "preview": "// The element belongs to the still-incomplete document being built. Document partialDoc = title.ownerDocument(); assertNotNull(partialDoc);"
          },
          {
            "start_line": 38,
            "end_line": 42,
            "line_count": 5,
            "preview": "// Because the <title> was emitted when parsing reached the head of the first <p>, // exactly one (still text-less) <p> exists in the partial document so far. Elements ps = partialDoc.select(\"p\");"
          },
          {
            "start_line": 44,
            "end_line": 46,
            "line_count": 3,
            "preview": "// selectFirst re-runs the query against what is already parsed: same <title> element. Element titleAgain = parser.selectFirst(\"title\"); assertSame(title, titleAgain);"
          },
          {
            "start_line": 48,
            "end_line": 50,
            "line_count": 3,
            "preview": "// expectNext resumes parsing from the current position to the next matching <p>. Element firstP = parser.expectNext(\"p\"); assertEquals(\"P One\", firstP.text());"
