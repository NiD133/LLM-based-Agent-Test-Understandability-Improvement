            "line_count": 2,
            "preview": "// Java string literal \"i\\\\.d i\\\\\\\\d\" represents the raw text:  i\\.d i\\\\d TokenQueue queue = new TokenQueue(\"i\\\\.d i\\\\\\\\d\");"
          },
          {
            "start_line": 26,
            "end_line": 27,
            "line_count": 2,
            "preview": "// First identifier: the escaped dot unescapes to a literal dot. assertEquals(\"i.d\", queue.consumeCssIdentifier());"
          },
          {
            "start_line": 29,
            "end_line": 30,
            "line_count": 2,
            "preview": "// The space between the two identifiers is consumed as whitespace. assertTrue(queue.consumeWhitespace());"
          },
          {
            "start_line": 32,
            "end_line": 33,
            "line_count": 2,
            "preview": "// Second identifier: the escaped backslash unescapes to a single backslash. assertEquals(\"i\\\\d\", queue.consumeCssIdentifier());"
