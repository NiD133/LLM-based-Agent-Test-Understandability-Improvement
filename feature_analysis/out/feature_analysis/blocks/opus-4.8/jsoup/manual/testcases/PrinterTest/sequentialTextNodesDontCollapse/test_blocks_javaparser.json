          {
            "start_line": 20,
            "end_line": 23,
            "line_count": 4,
            "preview": "// Parse a <div> that contains an empty nested <div> followed by the text \"Hello\". // The text needs to be content that the pretty printer would normally indent. Document doc = Jsoup.parse(\"<div><div></div>Hello</div>\");"
          },
          {
            "start_line": 25,
            "end_line": 26,
            "line_count": 2,
            "preview": "// childNode(1) is the \"Hello\" text node (childNode(0) is the empty nested <div>). TextNode helloText = (TextNode) outerDiv.childNode(1);"
          },
          {
            "start_line": 28,
            "end_line": 30,
            "line_count": 3,
            "preview": "// Manually insert a second, adjacent text node right after \"Hello\". // This creates the sequential-text-node scenario that a parse alone cannot. helloText.after(\" there.\");"
          },
          {
            "start_line": 32,
            "end_line": 35,
            "line_count": 4,
            "preview": "// The two text nodes remain separate and retain their exact whitespace. assertEquals(\"Hello\", helloText.getWholeText()); TextNode insertedText = (TextNode) helloText.nextSibling();"
          },
          {
            "start_line": 37,
            "end_line": 38,
            "line_count": 2,
            "preview": "// The combined, normalized text reads as a single sentence. assertEquals(\"Hello there.\", outerDiv.text());"
          },
          {
            "start_line": 40,
            "end_line": 42,
            "line_count": 3,
            "preview": "// Pretty-printed HTML: the adjacent text nodes are joined without collapsing the space between them. assertEquals(\"<div></div>\\nHello there.\", outerDiv.html()); assertEquals(\"<div>\\n <div></div>\\n Hello there.\\n</div>\", outerDiv.outerHtml("
