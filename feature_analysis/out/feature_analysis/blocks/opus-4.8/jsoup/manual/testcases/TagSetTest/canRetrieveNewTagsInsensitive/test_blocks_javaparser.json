        "blocks": [
          {
            "start_line": 20,
            "end_line": 21,
            "line_count": 2,
            "preview": "Document doc = Jsoup.parse(\"<div><p>One</p></div>\"); TagSet tags = doc.parser().tagSet();"
          },
          {
            "start_line": 23,
            "end_line": 27,
            "line_count": 5,
            "preview": "// The parser's tag set starts as the full HTML default set, so a standard tag // like \"meta\" is already present and flagged as a known tag. Tag meta = tags.get(\"meta\", NamespaceHtml);"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// The parsed <p> element resolves to a known HTML tag too. Element p = doc.expectFirst(\"p\"); assertTrue(p.tag().isKnownTag());"
          },
          {
            "start_line": 33,
            "end_line": 34,
            "line_count": 2,
            "preview": "// \"FOO\" is not a known tag, so it is absent from the set before we introduce it. assertNull(tags.get(\"FOO\", NamespaceHtml));"
          },
          {
            "start_line": 36,
            "end_line": 42,
            "line_count": 7,
            "preview": "// Renaming the element to \"FOO\" creates a new, unknown tag in the set. p.tagName(\"FOO\"); Tag foo = p.tag();"
          },
          {
            "start_line": 44,
            "end_line": 47,
            "line_count": 4,
            "preview": "// The new tag is now retrievable case-insensitively: both the lower-case lookup // and the original \"FOO\" (via valueOf) return the very same Tag instance... assertSame(foo, tags.get(\"foo\", NamespaceHtml));"
          },
          {
            "start_line": 49,
            "end_line": 50,
            "line_count": 2,
            "preview": "// ...but only within its own (HTML) namespace. assertNull(tags.get(\"foo\", \"SomeOtherNamespace\"));"
          }
