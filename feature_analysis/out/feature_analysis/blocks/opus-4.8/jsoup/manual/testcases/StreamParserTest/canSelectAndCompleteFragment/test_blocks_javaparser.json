            "start_line": 23,
            "end_line": 26,
            "line_count": 4,
            "preview": "// Three table rows, each holding one cell. There is no <table>/<tbody> wrapper in the // input; the fragment is parsed in the context of a <table>, so the parser infers a <tbody>. String html = \"<tr id=1><td>One</td><tr id=2><td>Two</td></"
          },
          {
            "start_line": 28,
            "end_line": 31,
            "line_count": 4,
            "preview": "try (StreamParser parser = new StreamParser(Parser.htmlParser()).parseFragment(html, tableContext, \"\")) { // Stream the cells one at a time; they arrive in document order. Element firstCell = parser.expectNext(\"td\");"
          },
          {
            "start_line": 33,
            "end_line": 34,
            "line_count": 2,
            "preview": "Element secondCell = parser.expectNext(\"td\"); assertEquals(\"Two\", secondCell.ownText());"
          },
          {
            "start_line": 36,
            "end_line": 37,
            "line_count": 2,
            "preview": "Element thirdCell = parser.expectNext(\"td\"); assertEquals(\"Three\", thirdCell.ownText());"
          },
          {
            "start_line": 39,
            "end_line": 40,
            "line_count": 2,
            "preview": "// No further <td> remains in the input. assertNull(parser.selectNext(\"td\"));"
          },
          {
            "start_line": 42,
            "end_line": 43,
            "line_count": 2,
            "preview": "// Finish the parse and inspect the resulting fragment tree. List<Node> fragmentRoots = parser.completeFragment();"
          },
          {
            "start_line": 45,
            "end_line": 48,
            "line_count": 4,
            "preview": "// The single root node is the <tbody> inferred by the table-aware parser. assertEquals(1, fragmentRoots.size()); Node tbody = fragmentRoots.get(0);"
