            "start_line": 32,
            "end_line": 37,
            "line_count": 6,
            "preview": "// Single-argument padding: caps at the default maximum of 30 spaces. assertEquals(spaces(0), StringUtil.padding(0)); assertEquals(spaces(1), StringUtil.padding(1));"
          },
          {
            "start_line": 39,
            "end_line": 41,
            "line_count": 3,
            "preview": "// Unlimited cap (-1): cached widths 0..20 return as requested (the cap is irrelevant here). assertEquals(spaces(0), StringUtil.padding(0, -1)); assertEquals(spaces(20), StringUtil.padding(20, -1));"
          },
          {
            "start_line": 43,
            "end_line": 46,
            "line_count": 4,
            "preview": "// Unlimited cap (-1) for non-cached widths (21+): the full requested width is returned. assertEquals(spaces(21), StringUtil.padding(21, -1)); assertEquals(spaces(30), StringUtil.padding(30, -1));"
          },
          {
            "start_line": 48,
            "end_line": 50,
            "line_count": 3,
            "preview": "// Zero cap: width 0 yields \"\" (also a cache hit); width 21 bypasses the cache and is capped to \"\". assertEquals(spaces(0), StringUtil.padding(0, 0)); assertEquals(spaces(0), StringUtil.padding(21, 0));"
          },
          {
            "start_line": 52,
            "end_line": 57,
            "line_count": 6,
            "preview": "// Explicit cap of 30 mirrors the single-argument behaviour: widths above 30 are capped to 30. assertEquals(spaces(0), StringUtil.padding(0, 30)); assertEquals(spaces(1), StringUtil.padding(1, 30));"
          },
          {
            "start_line": 59,
            "end_line": 60,
            "line_count": 2,
            "preview": "// The cap applies even though width 20 would otherwise be a cache hit: capped to length 5. assertEquals(5, StringUtil.padding(20, 5).length());"
          }
