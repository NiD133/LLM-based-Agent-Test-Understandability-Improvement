        "blocks": [
          {
            "start_line": 21,
            "end_line": 22,
            "line_count": 2,
            "preview": "// An unknown tag whose name mixes upper and lower case characters. Tag tag = Tag.valueOf(\"3urw0GS^ `H\");"
          },
          {
            "start_line": 24,
            "end_line": 25,
            "line_count": 2,
            "preview": "// Clearing the Known option returns the same tag for chaining. Tag cleared = tag.clear(Tag.Known);"
          },
          {
            "start_line": 27,
            "end_line": 28,
            "line_count": 2,
            "preview": "// The normalized name is always the lower-cased form of the original name. assertEquals(\"3urw0gs^ `h\", cleared.normalName());"
          },
          {
            "start_line": 30,
            "end_line": 31,
            "line_count": 2,
            "preview": "// A freshly created, unknown tag carries the default HTML namespace. assertEquals(\"http://www.w3.org/1999/xhtml\", cleared.namespace());"
          },
          {
            "start_line": 33,
            "end_line": 34,
            "line_count": 2,
            "preview": "// With the Known option cleared, the tag is still treated as not known. assertFalse(tag.isKnownTag());"
          },
          {
            "start_line": 36,
            "end_line": 40,
            "line_count": 5,
            "preview": "// None of the layout or parse-related options are set by default. assertFalse(cleared.isSelfClosing()); assertFalse(cleared.preserveWhitespace());"
          },
          {
            "start_line": 42,
            "end_line": 43,
            "line_count": 2,
            "preview": "// Without the Block option, the tag is inline. assertTrue(cleared.isInline());"
