            "end_line": 30,
            "line_count": 5,
            "preview": "// An empty input string never matches, regardless of the set. assertFalse(CharSetUtils.containsAny(\"\", (String[]) null), \"empty string, null array\"); assertFalse(CharSetUtils.containsAny(\"\"), \"empty string, no set\");"
