          {
            "start_line": 40,
            "end_line": 41,
            "line_count": 2,
            "preview": "// Two carets negate one another: '^' negates the following literal '^'. assertCharRanges(\"^^\", CharRange.isNot('^'));"
          },
          {
            "start_line": 43,
            "end_line": 44,
            "line_count": 2,
            "preview": "// Three carets: a negated '^' followed by a leftover literal '^'. assertCharRanges(\"^^^\", CharRange.isNot('^'), CharRange.is('^'));"
          },
          {
            "start_line": 46,
            "end_line": 47,
            "line_count": 2,
            "preview": "// Four carets collapse to a single negated '^' (the duplicate is dropped). assertCharRanges(\"^^^^\", CharRange.isNot('^'));"
          },
          {
            "start_line": 49,
            "end_line": 50,
            "line_count": 2,
            "preview": "// A literal 'a' followed by a trailing literal '^'. assertCharRanges(\"a^\", CharRange.is('a'), CharRange.is('^'));"
