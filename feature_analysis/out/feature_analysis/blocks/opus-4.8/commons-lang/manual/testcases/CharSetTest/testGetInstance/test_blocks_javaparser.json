            "end_line": 23,
            "line_count": 5,
            "preview": "// A null or empty definition yields the shared EMPTY constant. assertSame(CharSet.EMPTY, CharSet.getInstance((String) null)); assertSame(CharSet.EMPTY, CharSet.getInstance((String[]) null));"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// \"a-zA-Z\" and its reordered equivalent \"A-Za-z\" both map to ASCII_ALPHA. assertSame(CharSet.ASCII_ALPHA, CharSet.getInstance(\"a-zA-Z\")); assertSame(CharSet.ASCII_ALPHA, CharSet.getInstance(\"A-Za-z\"));"
