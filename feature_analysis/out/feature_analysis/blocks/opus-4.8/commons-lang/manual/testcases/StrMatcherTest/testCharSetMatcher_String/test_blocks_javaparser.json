            "end_line": 26,
            "line_count": 3,
            "preview": "// A matcher built from the set {a, c, e} should match exactly those characters. final StrMatcher matcher = StrMatcher.charSetMatcher(\"ace\"); final char[] text = \"abcdef\".toCharArray();"
          },
          {
            "start_line": 28,
            "end_line": 33,
            "line_count": 6,
            "preview": "assertEquals(MATCH,    matcher.isMatch(text, 0), \"'a' is in the set\"); assertEquals(NO_MATCH, matcher.isMatch(text, 1), \"'b' is not in the set\"); assertEquals(MATCH,    matcher.isMatch(text, 2), \"'c' is in the set\");"
          },
          {
            "start_line": 35,
            "end_line": 39,
            "line_count": 5,
            "preview": "// An empty or null character set yields the shared \"matches nothing\" matcher. assertSame(StrMatcher.noneMatcher(), StrMatcher.charSetMatcher(\"\"), \"empty set returns the none matcher\");"
          },
          {
            "start_line": 41,
            "end_line": 43,
            "line_count": 3,
            "preview": "// A single-character set is optimised into a CharMatcher. assertInstanceOf(StrMatcher.CharMatcher.class, StrMatcher.charSetMatcher(\"a\"), \"single-character set returns a CharMatcher\");"
