            "line_count": 3,
            "preview": "// \"^a-c\" is a negated range: it contains every character EXCEPT 'a', 'b', 'c'. assertFalse(CharSet.getInstance(\"^a-c\").contains('a'), \"'a' is excluded by the negated range\"); assertTrue(CharSet.getInstance(\"^a-c\").contains('d'), \"'d' is ou"
