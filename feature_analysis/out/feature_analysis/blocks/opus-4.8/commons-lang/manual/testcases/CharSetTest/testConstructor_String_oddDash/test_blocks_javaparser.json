          {
            "start_line": 26,
            "end_line": 31,
            "line_count": 6,
            "preview": "// A lone dash, or any run of only dashes, collapses to the single literal '-'. for (final String onlyDashes : new String[] {\"-\", \"--\", \"---\", \"----\"}) { final Set<CharRange> ranges = charRangesOf(onlyDashes);"
          },
          {
            "start_line": 33,
            "end_line": 38,
            "line_count": 6,
            "preview": "// A dash next to a single other character stays two separate literals, // because a range needs the dash to sit between two characters. Set<CharRange> ranges = charRangesOf(\"-a\");"
          },
          {
            "start_line": 40,
            "end_line": 43,
            "line_count": 4,
            "preview": "ranges = charRangesOf(\"a-\"); assertEquals(2, ranges.size()); assertTrue(ranges.contains(CharRange.is('a')));"
          },
          {
            "start_line": 45,
            "end_line": 49,
            "line_count": 5,
            "preview": "// With three characters, the parser reads a range from the first to the third // character; the middle dash is the range separator. ranges = charRangesOf(\"a--\");"
          },
          {
            "start_line": 51,
            "end_line": 53,
            "line_count": 3,
            "preview": "ranges = charRangesOf(\"--a\"); assertEquals(1, ranges.size()); assertTrue(ranges.contains(CharRange.isIn('-', 'a')));"
          }
