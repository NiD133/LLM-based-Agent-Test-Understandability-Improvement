            "start_line": 36,
            "end_line": 38,
            "line_count": 3,
            "preview": "// Negation prefix applies only to the immediately following character. assertParsesTo(\"^abc\", CharRange.isNot('a'), CharRange.is('b'), CharRange.is('c'));"
          },
          {
            "start_line": 40,
            "end_line": 42,
            "line_count": 3,
            "preview": "// A '^' in the middle negates just the next character; order does not matter to set membership. assertParsesTo(\"b^ac\", CharRange.is('b'), CharRange.isNot('a'), CharRange.is('c'));"
          },
          {
            "start_line": 44,
            "end_line": 46,
            "line_count": 3,
            "preview": "// Leading plain character followed by a mid-string negation. assertParsesTo(\"db^ac\", CharRange.is('d'), CharRange.is('b'), CharRange.isNot('a'), CharRange.is('c'));"
          },
          {
            "start_line": 48,
            "end_line": 50,
            "line_count": 3,
            "preview": "// Two independent negated single characters. assertParsesTo(\"^b^a\", CharRange.isNot('b'), CharRange.isNot('a'));"
          },
          {
            "start_line": 52,
            "end_line": 54,
            "line_count": 3,
            "preview": "// Mix of a plain char, a negated range (\"^a-c\") and a negated single char (\"^z\"). assertParsesTo(\"b^a-c^z\", CharRange.isNotIn('a', 'c'), CharRange.isNot('z'), CharRange.is('b'));"
          }
