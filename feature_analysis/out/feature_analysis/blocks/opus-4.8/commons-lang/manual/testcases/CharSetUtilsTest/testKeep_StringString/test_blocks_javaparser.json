        "block_count": 6,
        "blocks": [
          {
            "start_line": 20,
            "end_line": 22,
            "line_count": 3,
            "preview": "// A null input string always yields null, regardless of the set. assertNull(CharSetUtils.keep(null, (String) null)); assertNull(CharSetUtils.keep(null, \"\"));"
          },
          {
            "start_line": 24,
            "end_line": 27,
            "line_count": 4,
            "preview": "// An empty input string always yields an empty string. assertEquals(\"\", CharSetUtils.keep(\"\", (String) null)); assertEquals(\"\", CharSetUtils.keep(\"\", \"\"));"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// A null or empty set keeps nothing, so the result is empty. assertEquals(\"\", CharSetUtils.keep(\"hello\", (String) null)); assertEquals(\"\", CharSetUtils.keep(\"hello\", \"\"));"
          },
          {
            "start_line": 33,
            "end_line": 34,
            "line_count": 2,
            "preview": "// A set sharing no characters with the input also yields an empty string. assertEquals(\"\", CharSetUtils.keep(\"hello\", \"xyz\"));"
          },
          {
            "start_line": 36,
            "end_line": 38,
            "line_count": 3,
            "preview": "// A set covering every character keeps the whole string. assertEquals(\"hello\", CharSetUtils.keep(\"hello\", \"a-z\")); assertEquals(\"hello\", CharSetUtils.keep(\"hello\", \"oleh\"));"
          },
          {
            "start_line": 40,
            "end_line": 41,
            "line_count": 2,
            "preview": "// A partial set keeps only the matching characters, preserving their order. assertEquals(\"ell\", CharSetUtils.keep(\"hello\", \"el\"));"
          }
        ],
