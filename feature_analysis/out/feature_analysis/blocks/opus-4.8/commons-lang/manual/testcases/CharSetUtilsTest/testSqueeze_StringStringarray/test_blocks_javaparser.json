        "blocks": [
          {
            "start_line": 17,
            "end_line": 21,
            "line_count": 5,
            "preview": "// A null input string always yields null, regardless of the set. assertNull(CharSetUtils.squeeze(null, (String[]) null)); assertNull(CharSetUtils.squeeze(null));"
          },
          {
            "start_line": 23,
            "end_line": 27,
            "line_count": 5,
            "preview": "// An empty input string always yields an empty string. assertEquals(\"\", CharSetUtils.squeeze(\"\", (String[]) null)); assertEquals(\"\", CharSetUtils.squeeze(\"\"));"
          },
          {
            "start_line": 29,
            "end_line": 33,
            "line_count": 5,
            "preview": "// A null, empty, or non-matching set leaves the input string unchanged. assertEquals(\"hello\", CharSetUtils.squeeze(\"hello\", (String[]) null)); assertEquals(\"hello\", CharSetUtils.squeeze(\"hello\"));"
          },
          {
            "start_line": 35,
            "end_line": 39,
            "line_count": 5,
            "preview": "// Only repeated characters that are in the set get squeezed. // \"hello\" -> \"helo\": the \"ll\" run collapses because both 'e' and 'l' are in \"el\". assertEquals(\"helo\", CharSetUtils.squeeze(\"hello\", \"el\"));"
          },
          {
            "start_line": 41,
            "end_line": 45,
            "line_count": 5,
            "preview": "// Multiple runs of set characters each collapse to a single character. // \"fooffooff\" -> \"fofof\": every \"oo\" and \"ff\" run is squeezed (both in \"of\"). assertEquals(\"fofof\", CharSetUtils.squeeze(\"fooffooff\", \"of\"));"
          }
        ],
