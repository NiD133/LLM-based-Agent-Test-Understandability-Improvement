        "order": 1,
        "name": "testSqueeze_StringString",
        "is_test": true,
        "method_begin_line": 16,
        "method_end_line": 42,
        "body_begin_line": 17,
        "body_end_line": 42,
        "annotations": [
          "Test"
        ],
        "block_count": 7,
        "blocks": [
          {
            "start_line": 18,
            "end_line": 20,
            "line_count": 3,
            "preview": "// A null input string always yields null, regardless of the set. assertNull(CharSetUtils.squeeze(null, (String) null)); assertNull(CharSetUtils.squeeze(null, \"\"));"
          },
          {
            "start_line": 22,
            "end_line": 25,
            "line_count": 4,
            "preview": "// An empty input string is returned unchanged (as empty). assertEquals(\"\", CharSetUtils.squeeze(\"\", (String) null)); assertEquals(\"\", CharSetUtils.squeeze(\"\", \"\"));"
          },
          {
            "start_line": 27,
            "end_line": 29,
            "line_count": 3,
            "preview": "// A null or empty set means there is nothing to squeeze: the string is unchanged. assertEquals(\"hello\", CharSetUtils.squeeze(\"hello\", (String) null)); assertEquals(\"hello\", CharSetUtils.squeeze(\"hello\", \"\"));"
          },
          {
            "start_line": 31,
            "end_line": 32,
            "line_count": 2,
            "preview": "// Set \"a-e\" does not include 'l', so the doubled 'l' in \"hello\" is kept. assertEquals(\"hello\", CharSetUtils.squeeze(\"hello\", \"a-e\"));"
          },
          {
            "start_line": 34,
            "end_line": 35,
            "line_count": 2,
            "preview": "// Set \"l-p\" includes 'l', so the doubled 'l' is squeezed to a single 'l'. assertEquals(\"helo\", CharSetUtils.squeeze(\"hello\", \"l-p\"));"
          },
          {
            "start_line": 37,
            "end_line": 38,
            "line_count": 2,
            "preview": "// Only 'l' is squeezed; the trailing doubled 'o' stays because 'o' is not in the set. assertEquals(\"heloo\", CharSetUtils.squeeze(\"helloo\", \"l\"));"
          },
          {
            "start_line": 40,
            "end_line": 41,
            "line_count": 2,
            "preview": "// Negated set \"^l\" matches everything except 'l', so 'o' is squeezed but 'l' is not. assertEquals(\"hello\", CharSetUtils.squeeze(\"helloo\", \"^l\"));"
          }
        ],
