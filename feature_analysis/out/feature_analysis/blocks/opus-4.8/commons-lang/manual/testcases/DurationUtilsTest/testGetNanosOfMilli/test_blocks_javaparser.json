        "blocks": [
          {
            "start_line": 23,
            "end_line": 24,
            "line_count": 2,
            "preview": "// A null duration is treated as zero. assertEquals(0, DurationUtils.getNanosOfMilli(null));"
          },
          {
            "start_line": 26,
            "end_line": 27,
            "line_count": 2,
            "preview": "// Zero duration has no nanosecond remainder. assertEquals(0, DurationUtils.getNanosOfMilli(Duration.ZERO));"
          },
          {
            "start_line": 29,
            "end_line": 36,
            "line_count": 8,
            "preview": "// Durations smaller than one millisecond are returned unchanged, // because the whole nanosecond value is below the 1,000,000 modulus. assertEquals(1, DurationUtils.getNanosOfMilli(Duration.ofNanos(1)));"
          },
          {
            "start_line": 38,
            "end_line": 39,
            "line_count": 2,
            "preview": "// Exactly one millisecond leaves a sub-millisecond remainder of zero. assertEquals(0, DurationUtils.getNanosOfMilli(Duration.ofNanos(1_000_000)));"
          },
          {
            "start_line": 41,
            "end_line": 42,
            "line_count": 2,
            "preview": "// One millisecond plus one nanosecond leaves a remainder of one. assertEquals(1, DurationUtils.getNanosOfMilli(Duration.ofNanos(1_000_001)));"
          }
        ],
        "blank_lines": [
