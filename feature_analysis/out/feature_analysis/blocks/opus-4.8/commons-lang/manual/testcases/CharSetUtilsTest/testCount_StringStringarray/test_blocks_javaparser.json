            "start_line": 18,
            "end_line": 22,
            "line_count": 5,
            "preview": "// A null input string always counts to zero, regardless of the set. assertEquals(0, CharSetUtils.count(null, (String[]) null)); assertEquals(0, CharSetUtils.count(null));"
          },
          {
            "start_line": 24,
            "end_line": 28,
            "line_count": 5,
            "preview": "// An empty input string always counts to zero, regardless of the set. assertEquals(0, CharSetUtils.count(\"\", (String[]) null)); assertEquals(0, CharSetUtils.count(\"\"));"
          },
          {
            "start_line": 30,
            "end_line": 34,
            "line_count": 5,
            "preview": "// A null or empty set means there is nothing to match, so the count is zero. assertEquals(0, CharSetUtils.count(\"hello\", (String[]) null)); assertEquals(0, CharSetUtils.count(\"hello\"));"
          },
