            "start_line": 27,
            "end_line": 32,
            "line_count": 6,
            "preview": "// A null implementation must be rejected for every statistic. Assertions.assertThrows(NullPointerException.class, () -> u.setSumImpl(null)); Assertions.assertThrows(NullPointerException.class, () -> u.setMinImpl(null));"
          },
          {
            "start_line": 34,
            "end_line": 39,
            "line_count": 6,
            "preview": "// Inject a distinct, identifiable implementation for each statistic. u.setSumImpl(new SeededSumStatistic(1)); u.setMinImpl(new SeededSumStatistic(2));"
          },
          {
            "start_line": 41,
            "end_line": 47,
            "line_count": 7,
            "preview": "// After observing one value, each seed k yields k + 1. u.addValue(1); Assertions.assertEquals(2, u.getSum());"
          },
          {
            "start_line": 49,
            "end_line": 54,
            "line_count": 6,
            "preview": "// The getters must expose the very implementations we injected. Assertions.assertEquals(2, u.getSumImpl().getResult()); Assertions.assertEquals(3, u.getMinImpl().getResult());"
          },
          {
            "start_line": 56,
            "end_line": 62,
            "line_count": 7,
            "preview": "// A copy must carry over the injected implementations and their state. final SummaryStatistics v = u.copy(); Assertions.assertEquals(2, v.getSum());"
          },
          {
            "start_line": 64,
            "end_line": 70,
            "line_count": 7,
            "preview": "// Clearing must honour the \"return NaN when empty\" contract. u.clear(); Assertions.assertEquals(Double.NaN, u.getSum());"
          },
          {
            "start_line": 72,
            "end_line": 79,
            "line_count": 8,
            "preview": "// After clearing, the (now reset) implementations keep working: each // seed is back to 0, so observing 1 yields 1 for every statistic. u.addValue(1);"
