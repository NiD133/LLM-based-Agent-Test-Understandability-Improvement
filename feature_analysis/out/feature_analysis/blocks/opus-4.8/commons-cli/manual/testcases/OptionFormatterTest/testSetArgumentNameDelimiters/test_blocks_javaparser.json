            "start_line": 17,
            "end_line": 18,
            "line_count": 2,
            "preview": "// An option that takes an argument; with no explicit arg name it defaults to \"arg\". final Option option = Option.builder().option(\"o\").longOpt(\"opt\").hasArg().get();"
          },
          {
            "start_line": 20,
            "end_line": 23,
            "line_count": 4,
            "preview": "// Custom begin and end delimiters surround the default argument name. OptionFormatter.Builder builder = OptionFormatter.builder() .setArgumentNameDelimiters(\"with argument named \", \".\");"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// A null begin delimiter is treated as \"\", and an empty end delimiter leaves the name bare. builder = OptionFormatter.builder().setArgumentNameDelimiters(null, \"\"); assertEquals(\"arg\", builder.build(option).getArgName());"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// Symmetrically, an empty begin delimiter and a null end delimiter also yield the bare name. builder = OptionFormatter.builder().setArgumentNameDelimiters(\"\", null); assertEquals(\"arg\", builder.build(option).getArgName());"
          }
        ],
