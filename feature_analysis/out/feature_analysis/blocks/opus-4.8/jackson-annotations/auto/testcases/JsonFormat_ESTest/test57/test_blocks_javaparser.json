            "line_count": 3,
            "preview": "JsonFormat.Value emptyValue = new JsonFormat.Value(); JsonFormat.Feature readUnknownEnumAsNull = JsonFormat.Feature.READ_UNKNOWN_ENUM_VALUES_AS_NULL;"
          },
          {
            "start_line": 24,
            "end_line": 25,
            "line_count": 2,
            "preview": "// Enabling the feature on the empty value produces a new value. JsonFormat.Value valueWithFeature = emptyValue.withFeature(readUnknownEnumAsNull);"
          },
          {
            "start_line": 27,
            "end_line": 29,
            "line_count": 3,
            "preview": "// Enabling the same feature again is a no-op: the same instance is returned. JsonFormat.Value valueWithFeatureAgain = valueWithFeature.withFeature(readUnknownEnumAsNull); assertSame(valueWithFeature, valueWithFeatureAgain);"
          },
          {
            "start_line": 31,
            "end_line": 35,
            "line_count": 5,
            "preview": "// Merging the feature-bearing value (base) with the empty value (overrides) // yields a distinct instance that is still equal to the feature-bearing value. JsonFormat.Value mergedValue = JsonFormat.Value.merge(valueWithFeature, emptyValue)"
          },
          {
            "start_line": 37,
            "end_line": 39,
            "line_count": 3,
            "preview": "// Overriding with an equal value keeps the result equal to the original. JsonFormat.Value overriddenValue = valueWithFeatureAgain.withOverrides(mergedValue); assertTrue(overriddenValue.equals((Object) valueWithFeatureAgain));"
          },
          {
            "start_line": 41,
            "end_line": 42,
            "line_count": 2,
            "preview": "// No radix was ever specified, so the value keeps the default radix. assertFalse(valueWithFeatureAgain.hasNonDefaultRadix());"
