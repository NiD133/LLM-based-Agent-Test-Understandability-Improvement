            "end_line": 36,
            "line_count": 2,
            "preview": "// Merge the overrides onto the empty base. JsonIgnoreProperties.Value merged = emptyValue.withOverrides(overrides);"
          },
          {
            "start_line": 38,
            "end_line": 39,
            "line_count": 2,
            "preview": "// The overrides themselves keep allowSetters disabled. assertFalse(overrides.getAllowSetters());"
