            "start_line": 22,
            "end_line": 24,
            "line_count": 3,
            "preview": "JsonFormat.Value emptyValue = JsonFormat.Value.empty(); JsonFormat.Value featureEnabled = emptyValue.withFeature(feature); JsonFormat.Value featureDisabled = emptyValue.withoutFeature(feature);"
          },
          {
            "start_line": 26,
            "end_line": 27,
            "line_count": 2,
            "preview": "// Override the \"disabled\" value with the \"enabled\" value. JsonFormat.Value merged = featureDisabled.withOverrides(featureEnabled);"
          },
          {
            "start_line": 29,
            "end_line": 30,
            "line_count": 2,
            "preview": "// Disabling a feature produces a value distinct from the empty default. assertFalse(featureDisabled.equals((Object) emptyValue));"
