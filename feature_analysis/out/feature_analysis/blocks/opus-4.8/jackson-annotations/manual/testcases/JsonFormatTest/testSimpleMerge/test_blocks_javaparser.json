            "line_count": 6,
            "preview": "// The empty value should report that nothing has been configured. assertFalse(EMPTY.hasLocale()); assertFalse(EMPTY.hasPattern());"
          },
          {
            "start_line": 32,
            "end_line": 38,
            "line_count": 7,
            "preview": "// A value created from a pattern should carry only that pattern. Value patternOnly = Value.forPattern(TEST_PATTERN); assertTrue(patternOnly.hasPattern());"
          },
          {
            "start_line": 40,
            "end_line": 45,
            "line_count": 6,
            "preview": "// Overriding with an empty value changes nothing: pattern is kept. Value merged = patternOnly.withOverrides(EMPTY); assertEquals(TEST_PATTERN, merged.getPattern());"
          },
          {
            "start_line": 47,
            "end_line": 48,
            "line_count": 2,
            "preview": "// Optimization: overriding a value with itself returns that same instance. assertSame(merged, merged.withOverrides(merged));"
          },
          {
            "start_line": 50,
            "end_line": 55,
            "line_count": 6,
            "preview": "// Merging empty (base) with the pattern (overrides) yields the pattern. merged = Value.merge(EMPTY, patternOnly); assertEquals(TEST_PATTERN, merged.getPattern());"
          },
          {
            "start_line": 57,
            "end_line": 58,
            "line_count": 2,
            "preview": "// Optimization: overriding with null returns the same instance. assertSame(merged, merged.withOverrides(null));"
          },
          {
