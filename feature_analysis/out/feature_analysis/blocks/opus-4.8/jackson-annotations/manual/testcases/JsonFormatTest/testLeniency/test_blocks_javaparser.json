        "blocks": [
          {
            "start_line": 23,
            "end_line": 27,
            "line_count": 5,
            "preview": "// --- Default state: leniency is not configured at all --- JsonFormat.Value unset = JsonFormat.Value.empty(); assertFalse(unset.hasLenient(), \"empty Value should have no leniency setting\");"
          },
          {
            "start_line": 29,
            "end_line": 33,
            "line_count": 5,
            "preview": "// --- Explicitly lenient: withLenient(TRUE) --- JsonFormat.Value lenient = unset.withLenient(Boolean.TRUE); assertTrue(lenient.hasLenient());"
          },
          {
            "start_line": 35,
            "end_line": 38,
            "line_count": 4,
            "preview": "// A value equals itself but differs from the unset value (in both directions). assertTrue(lenient.equals(lenient)); assertFalse(unset.equals(lenient));"
          },
          {
            "start_line": 40,
            "end_line": 41,
            "line_count": 2,
            "preview": "// Re-applying the same setting is a no-op and must reuse the same instance. assertSame(lenient, lenient.withLenient(Boolean.TRUE));"
          },
          {
            "start_line": 43,
            "end_line": 47,
            "line_count": 5,
            "preview": "// --- Explicitly strict: withLenient(FALSE) --- JsonFormat.Value strict = lenient.withLenient(Boolean.FALSE); assertTrue(strict.hasLenient(), \"FALSE is still an explicit setting\");"
          },
          {
            "start_line": 49,
            "end_line": 54,
            "line_count": 6,
            "preview": "// Strict equals itself but differs from both the unset and lenient values. assertTrue(strict.equals(strict)); assertFalse(unset.equals(strict));"
          },
          {
            "start_line": 56,
            "end_line": 60,
            "line_count": 5,
            "preview": "// --- Clearing the setting: withLenient(null) restores the unset state --- JsonFormat.Value cleared = lenient.withLenient(null); assertFalse(cleared.hasLenient());"
          },
          {
            "start_line": 62,
            "end_line": 66,
            "line_count": 5,
            "preview": "// Cleared is equivalent to the original unset value, but not to lenient. assertTrue(unset.equals(cleared)); assertTrue(cleared.equals(unset));"
          }
        ],
