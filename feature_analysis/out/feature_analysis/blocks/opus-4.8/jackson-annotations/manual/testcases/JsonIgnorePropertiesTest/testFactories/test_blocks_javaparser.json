            "line_count": 4,
            "preview": "// Factory calls that carry no actual settings should all reuse the shared EMPTY instance. assertSame(EMPTY, JsonIgnoreProperties.Value.forIgnoreUnknown(false)); assertSame(EMPTY, JsonIgnoreProperties.Value.forIgnoredProperties());"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// A value built from two ignored property names exposes exactly those names. JsonIgnoreProperties.Value ignoringAandB = JsonIgnoreProperties.Value.forIgnoredProperties(\"a\", \"b\"); assertEquals(setOf(\"a\", \"b\"), ignoringAandB.getIgnored());"
          },
          {
            "start_line": 33,
            "end_line": 39,
            "line_count": 7,
            "preview": "// \"allow getters\": getters stay active, so the names are ignored only for deserialization. JsonIgnoreProperties.Value allowingGetters = ignoringAandB.withAllowGetters(); assertTrue(allowingGetters.getAllowGetters());"
