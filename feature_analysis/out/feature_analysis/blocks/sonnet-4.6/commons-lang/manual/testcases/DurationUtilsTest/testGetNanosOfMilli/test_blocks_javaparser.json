            "start_line": 19,
            "end_line": 23,
            "line_count": 5,
            "preview": "// Null and zero-duration inputs should both return 0 assertEquals(0, DurationUtils.getNanosOfMilli(null), \"null duration should yield 0 nanoseconds\");"
          },
          {
            "start_line": 25,
            "end_line": 37,
            "line_count": 13,
            "preview": "// Durations well under 1 ms: the nano value is returned as-is assertEquals(1, DurationUtils.getNanosOfMilli(Duration.ofNanos(1)), \"1 ns < 1 ms, so remainder is 1\");"
          },
          {
            "start_line": 39,
            "end_line": 41,
            "line_count": 3,
            "preview": "// Exactly 1 ms (1,000,000 ns): the modulo operation yields 0 assertEquals(0, DurationUtils.getNanosOfMilli(Duration.ofNanos(1_000_000)), \"1,000,000 ns is exactly 1 ms, so remainder is 0\");"
          },
          {
            "start_line": 43,
            "end_line": 45,
            "line_count": 3,
            "preview": "// 1 ms + 1 ns: only the sub-millisecond part (1 ns) is returned assertEquals(1, DurationUtils.getNanosOfMilli(Duration.ofNanos(1_000_001)), \"1,000,001 ns is 1 ms plus 1 ns, so remainder is 1\");"
          }
        ],
