          {
            "start_line": 15,
            "end_line": 18,
            "line_count": 4,
            "preview": "// empty string input always returns false regardless of the set argument assertFalse(CharSetUtils.containsAny(\"\", (String) null)); assertFalse(CharSetUtils.containsAny(\"\", \"\"));"
