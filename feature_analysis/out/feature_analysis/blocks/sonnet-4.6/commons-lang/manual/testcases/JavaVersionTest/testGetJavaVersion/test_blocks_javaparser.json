        "blocks": [
          {
            "start_line": 10,
            "end_line": 11,
            "line_count": 2,
            "preview": "// Legacy format: Android's non-standard \"0.9\" version string maps to JAVA_0_9 assertEquals(JavaVersion.JAVA_0_9, JavaVersion.get(\"0.9\"), \"0.9 failed\");"
          },
          {
            "start_line": 13,
            "end_line": 21,
            "line_count": 9,
            "preview": "// Legacy format: Java 1.1–1.8 used \"1.x\" version strings assertEquals(JavaVersion.JAVA_1_1, JavaVersion.get(\"1.1\"), \"1.1 failed\"); assertEquals(JavaVersion.JAVA_1_2, JavaVersion.get(\"1.2\"), \"1.2 failed\");"
          },
          {
            "start_line": 23,
            "end_line": 42,
            "line_count": 20,
            "preview": "// Modern format: Java 9+ uses a plain major version number string assertEquals(JavaVersion.JAVA_9,  JavaVersion.get(\"9\")); assertEquals(JavaVersion.JAVA_10, JavaVersion.get(\"10\"));"
          },
          {
            "start_line": 44,
            "end_line": 46,
            "line_count": 3,
            "preview": "// \"1.10\" has a minor part > .9 in the legacy range, so it maps to JAVA_RECENT assertEquals(JavaVersion.JAVA_RECENT, JavaVersion.get(\"1.10\"), \"1.10 failed\"); // assertNull(\"2.10 unexpectedly worked\", JavaVersion.get(\"2.10\"));"
          },
          {
            "start_line": 48,
            "end_line": 49,
            "line_count": 2,
            "preview": "// getJavaVersion is a wrapper that delegates to get — results must be identical assertEquals(JavaVersion.get(\"1.5\"), JavaVersion.getJavaVersion(\"1.5\"), \"Wrapper method failed\");"
          },
          {
            "start_line": 51,
            "end_line": 52,
            "line_count": 2,
            "preview": "// LANG-1384: an unrecognised future version (e.g. \"99\") falls back to JAVA_RECENT assertEquals(JavaVersion.JAVA_RECENT, JavaVersion.get(\"99\"), \"Unhandled\");"
          }
        ],
