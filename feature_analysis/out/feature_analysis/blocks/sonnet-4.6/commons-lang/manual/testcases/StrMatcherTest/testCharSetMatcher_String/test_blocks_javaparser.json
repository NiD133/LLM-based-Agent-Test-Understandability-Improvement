        "blocks": [
          {
            "start_line": 19,
            "end_line": 20,
            "line_count": 2,
            "preview": "// Matcher built from a multi-character string matches exactly those characters final StrMatcher matcher = StrMatcher.charSetMatcher(\"ace\");"
          },
          {
            "start_line": 22,
            "end_line": 25,
            "line_count": 4,
            "preview": "// Characters in the set {\"a\", \"c\", \"e\"} should match (return 1) assertEquals(1, matcher.isMatch(BUFFER2, 0)); // 'a' is in the set assertEquals(1, matcher.isMatch(BUFFER2, 2)); // 'c' is in the set"
          },
          {
            "start_line": 27,
            "end_line": 30,
            "line_count": 4,
            "preview": "// Characters not in the set {\"b\", \"d\", \"f\"} should not match (return 0) assertEquals(0, matcher.isMatch(BUFFER2, 1)); // 'b' is not in the set assertEquals(0, matcher.isMatch(BUFFER2, 3)); // 'd' is not in the set"
          },
          {
            "start_line": 32,
            "end_line": 34,
            "line_count": 3,
            "preview": "// Empty or null input produces the shared noneMatcher singleton (matches nothing) assertSame(StrMatcher.noneMatcher(), StrMatcher.charSetMatcher(\"\")); assertSame(StrMatcher.noneMatcher(), StrMatcher.charSetMatcher((String) null));"
          },
          {
            "start_line": 36,
            "end_line": 37,
            "line_count": 2,
            "preview": "// A single-character string optimises to a CharMatcher rather than a CharSetMatcher assertInstanceOf(StrMatcher.CharMatcher.class, StrMatcher.charSetMatcher(\"a\"));"
          }
        ],
