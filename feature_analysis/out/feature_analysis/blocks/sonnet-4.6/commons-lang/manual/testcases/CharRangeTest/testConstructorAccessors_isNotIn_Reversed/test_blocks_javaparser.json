            "line_count": 2,
            "preview": "// Pass arguments in reversed order: 'e' > 'a', so the constructor must swap them. final CharRange reversedNegatedRange = CharRange.isNotIn('e', 'a');"
          },
          {
            "start_line": 21,
            "end_line": 23,
            "line_count": 3,
            "preview": "// After normalisation the smaller character becomes the start … assertEquals('a', reversedNegatedRange.getStart(), \"isNotIn should reorder a reversed pair so the smaller char is the start\");"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// … and the larger character becomes the end. assertEquals('e', reversedNegatedRange.getEnd(), \"isNotIn should reorder a reversed pair so the larger char is the end\");"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// The range must be negated because it was created with isNotIn. assertTrue(reversedNegatedRange.isNegated(), \"A range created with isNotIn must be negated\");"
          },
          {
            "start_line": 33,
            "end_line": 35,
            "line_count": 3,
            "preview": "// The canonical string representation of a negated range is \"^<start>-<end>\". assertEquals(\"^a-e\", reversedNegatedRange.toString(), \"toString should produce the canonical negated-range notation\");"
