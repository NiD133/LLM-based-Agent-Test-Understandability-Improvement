            "line_count": 2,
            "preview": "// Create a negated range that represents \"every character except 'a'\" final CharRange notA = CharRange.isNot('a');"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// A single-character isNot range has start == end == the excluded character assertEquals('a', notA.getStart(), \"start should equal the excluded character\"); assertEquals('a', notA.getEnd(),   \"end should equal the excluded character\");"
          },
          {
            "start_line": 29,
            "end_line": 30,
            "line_count": 2,
            "preview": "// The range must be marked as negated (i.e. it excludes, rather than includes, 'a') assertTrue(notA.isNegated(), \"isNot range must be negated\");"
          },
          {
            "start_line": 32,
            "end_line": 33,
            "line_count": 2,
            "preview": "// The canonical string form of a negated single character is \"^<char>\" assertEquals(\"^a\", notA.toString(), \"toString of a negated single-char range should be '^a'\");"
          }
