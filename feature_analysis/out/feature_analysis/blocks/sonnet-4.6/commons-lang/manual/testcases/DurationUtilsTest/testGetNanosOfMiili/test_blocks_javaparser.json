            "line_count": 3,
            "preview": "// null and zero durations have no sub-millisecond nanoseconds assertEquals(0, DurationUtils.getNanosOfMiili(null)); assertEquals(0, DurationUtils.getNanosOfMiili(Duration.ZERO));"
