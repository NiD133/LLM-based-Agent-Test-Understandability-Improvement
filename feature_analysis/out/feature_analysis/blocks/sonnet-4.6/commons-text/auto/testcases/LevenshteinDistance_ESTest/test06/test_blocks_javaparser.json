          },
          {
            "start_line": 39,
            "end_line": 40,
            "line_count": 2,
            "preview": "// Distance from a CharBuffer to itself is always 0; used as the threshold. Integer zeroThreshold = unlimitedDistance.apply((CharSequence) source, (CharSequence) source);"
          },
          {
            "start_line": 42,
            "end_line": 44,
            "line_count": 3,
            "preview": "char[] targetChars = new char[2]; // targetChars[0] and [1] both remain '\\0' (default), so target = \"\u0000\u0000\" CharBuffer target = CharBuffer.wrap(targetChars);"
          },
          {
            "start_line": 46,
            "end_line": 47,
            "line_count": 2,
            "preview": "// Create a threshold-limited instance; threshold == 0 means any difference returns -1. LevenshteinDistance limitedDistance = new LevenshteinDistance(zeroThreshold);"
