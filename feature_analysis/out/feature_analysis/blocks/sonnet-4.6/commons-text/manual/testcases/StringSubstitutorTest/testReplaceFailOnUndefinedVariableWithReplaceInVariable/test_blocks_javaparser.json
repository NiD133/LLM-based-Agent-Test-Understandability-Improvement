            "line_count": 8,
            "preview": "// Set up variables that support nested key construction (e.g. \"animal.${species}\" -> \"animal.2\" -> \"mouse\") values.put(\"animal.1\", \"fox\"); values.put(\"animal.2\", \"mouse\");"
