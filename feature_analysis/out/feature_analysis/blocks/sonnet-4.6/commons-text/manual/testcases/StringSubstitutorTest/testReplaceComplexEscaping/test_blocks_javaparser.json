        ],
        "block_count": 6,
        "blocks": [
          {
            "start_line": 180,
            "end_line": 185,
            "line_count": 6,
            "preview": "// Single-escape: $${${var}} resolves the inner variable but emits the result as a literal // \"${...}\" string rather than substituting it. E.g. $${${a}} → \"${\" + \"1\" + \"}\" = \"${1}\". doReplace(\"${1}\",               \"$${${a}}\",      false);"
          },
          {
            "start_line": 187,
            "end_line": 190,
            "line_count": 4,
            "preview": "// Single-escape inside a full sentence: the escaped expression produces a literal // \"${quick brown fox}\" while the non-escaped ${target} is still resolved. doReplace(\"The ${quick brown fox} jumps over the lazy dog.\","
          },
          {
            "start_line": 192,
            "end_line": 197,
            "line_count": 6,
            "preview": "// Double-escape: $${$${var}} escapes both the outer and inner variable markers, so the // entire \"${var}\" expression is preserved literally with no substitution. doReplace(\"${${a}}\",      \"$${$${a}}\",      false);"
          },
          {
            "start_line": 199,
            "end_line": 202,
            "line_count": 4,
            "preview": "// Double-escape with surrounding punctuation characters. doReplace(\".${${animal}}\",  \".$${$${animal}}\",  false); doReplace(\"${${animal}}.\",  \"$${$${animal}}.\",  false);"
          },
          {
            "start_line": 204,
            "end_line": 207,
            "line_count": 4,
            "preview": "// Double-escape in a full sentence: ${target} is resolved normally while the animal // reference is double-escaped and emitted entirely as a literal. doReplace(\"The ${${animal}} jumps over the lazy dog.\","
          },
          {
            "start_line": 209,
            "end_line": 212,
            "line_count": 4,
            "preview": "// Combining single-escape with a default-value expression: // $${${undefined.number:-1234567890}} → \"${\" + \"1234567890\" + \"}\" = \"${1234567890}\" doReplace(\"The ${quick brown fox} jumps over the lazy dog. ${1234567890}.\","
          }
        ],
        "blank_lines": [
