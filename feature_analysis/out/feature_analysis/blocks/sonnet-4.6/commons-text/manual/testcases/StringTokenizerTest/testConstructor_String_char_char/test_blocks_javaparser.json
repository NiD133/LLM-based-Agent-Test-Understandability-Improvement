            "start_line": 15,
            "end_line": 16,
            "line_count": 2,
            "preview": "// A non-empty string with space delimiter and double-quote quoting StringTokenizer tok = new StringTokenizer(\"a b\", DELIMITER, QUOTE_CHAR);"
          },
          {
            "start_line": 18,
            "end_line": 20,
            "line_count": 3,
            "preview": "// The delimiter matcher should recognise a single space character assertEquals(1, tok.getDelimiterMatcher().isMatch(\" \".toCharArray(), 0, 0, 1)); assertEquals(1, tok.getDelimiterMatcher().isMatch(\" \", 0, 0, 1));"
          },
          {
            "start_line": 22,
            "end_line": 24,
            "line_count": 3,
            "preview": "// The quote matcher should recognise a double-quote character assertEquals(1, tok.getQuoteMatcher().isMatch(\"\\\"\".toCharArray(), 0, 0, 1)); assertEquals(1, tok.getQuoteMatcher().isMatch(\"\\\"\", 0, 0, 1));"
          },
          {
            "start_line": 26,
            "end_line": 29,
            "line_count": 4,
            "preview": "// Tokenising \"a b\" with a space delimiter should yield two tokens assertEquals(\"a\", tok.next()); assertEquals(\"b\", tok.next());"
          },
          {
            "start_line": 31,
            "end_line": 33,
            "line_count": 3,
            "preview": "// An empty string produces no tokens StringTokenizer emptyTok = new StringTokenizer(\"\", DELIMITER, QUOTE_CHAR); assertFalse(emptyTok.hasNext());"
          },
          {
