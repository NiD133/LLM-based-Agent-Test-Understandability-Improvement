            "start_line": 162,
            "end_line": 163,
            "line_count": 2,
            "preview": "// $$ escapes the prefix: $${animal} is left as ${animal} while ${target} is still resolved doReplace(\"The ${animal} jumps over the lazy dog.\", \"The $${animal} jumps over the ${target}.\", true);"
          },
          {
            "start_line": 165,
            "end_line": 166,
            "line_count": 2,
            "preview": "// $${a} -> ${a}: the doubled $$ causes the variable reference to appear verbatim doReplace(\"${a}\", \"$${a}\", false);"
          },
          {
            "start_line": 168,
            "end_line": 169,
            "line_count": 2,
            "preview": "// $${a$${a}} -> ${a${a}}: both escape sequences are unescaped, neither inner key is resolved doReplace(\"${a${a}}\", \"$${a$${a}}\", false);"
          },
          {
            "start_line": 171,
            "end_line": 172,
            "line_count": 2,
            "preview": "// $${a$${a$${a}}} -> ${a${a${a}}}: three levels of escaping all unescape cleanly doReplace(\"${a${a${a}}}\", \"$${a$${a$${a}}}\", false);"
