            "start_line": 143,
            "end_line": 146,
            "line_count": 4,
            "preview": "// Dump entire array with positive base offset — addresses start at 0x10000000 stream = new ByteArrayOutputStream(); HexDump.dump(testArray, 0x10000000, stream, 0);"
