          {
            "start_line": 148,
            "end_line": 151,
            "line_count": 4,
            "preview": "// Dump entire array with large (wrapping) base offset — addresses start at 0xFF000000 stream = new ByteArrayOutputStream(); HexDump.dump(testArray, 0xFF000000, stream, 0);"
