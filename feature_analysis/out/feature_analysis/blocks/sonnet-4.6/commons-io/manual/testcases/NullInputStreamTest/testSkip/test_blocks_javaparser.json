            "line_count": 4,
            "preview": "try (TestNullInputStream input = new TestNullInputStream(10, true, false)) { // Read the first two bytes to advance the stream to position 2. assertEquals(0, input.read(), \"Read 1\");"
          },
          {
            "start_line": 65,
            "end_line": 66,
            "line_count": 2,
            "preview": "// Skip 5 bytes (positions 2–6); stream moves to position 7. assertEquals(5, input.skip(5), \"Skip 1\");"
          },
          {
            "start_line": 68,
            "end_line": 69,
            "line_count": 2,
            "preview": "// Read byte at position 7; processByte() returns position-1 = 7. assertEquals(7, input.read(), \"Read 3\");"
          },
          {
            "start_line": 71,
            "end_line": 73,
            "line_count": 3,
            "preview": "// Stream is at position 8; only 2 bytes remain before EOF. // Requesting a skip of 5 returns only 2 (the actual bytes available). assertEquals(2, input.skip(5), \"Skip 2\");"
          },
          {
            "start_line": 75,
            "end_line": 76,
            "line_count": 2,
            "preview": "// Stream is now at EOF (position 10 == size 10); skip returns -1. assertEquals(-1, input.skip(5), \"Skip 3 (EOF)\");"
          },
          {
            "start_line": 78,
            "end_line": 80,
            "line_count": 3,
            "preview": "// EOF skip is idempotent: subsequent skips also return -1. assertEquals(-1, input.skip(5), \"Skip 4 (EOF again)\"); }"
