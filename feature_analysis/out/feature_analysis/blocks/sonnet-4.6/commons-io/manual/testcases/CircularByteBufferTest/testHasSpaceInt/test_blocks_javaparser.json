            "line_count": 2,
            "preview": "// A buffer with capacity 1: it can hold exactly one byte at a time. final CircularByteBuffer buffer = new CircularByteBuffer(1);"
          },
          {
            "start_line": 17,
            "end_line": 18,
            "line_count": 2,
            "preview": "// Initially empty — there is room for one more byte. assertTrue(buffer.hasSpace(1));"
          },
          {
            "start_line": 20,
            "end_line": 23,
            "line_count": 4,
            "preview": "// --- First write/read cycle --- buffer.add((byte) 1); // Buffer is now full; no room for another byte."
          },
          {
            "start_line": 25,
            "end_line": 28,
            "line_count": 4,
            "preview": "// Reading drains the buffer and returns the written value. assertEquals(1, buffer.read()); // Buffer is empty again — space is restored."
          },
          {
            "start_line": 30,
            "end_line": 33,
            "line_count": 4,
            "preview": "// --- Second write/read cycle (confirms state resets correctly) --- buffer.add((byte) 2); // Buffer is full again after the second write."
          },
          {
            "start_line": 35,
            "end_line": 38,
            "line_count": 4,
            "preview": "// Reading returns the second written value. assertEquals(2, buffer.read()); // Buffer is empty once more — space is available again."
