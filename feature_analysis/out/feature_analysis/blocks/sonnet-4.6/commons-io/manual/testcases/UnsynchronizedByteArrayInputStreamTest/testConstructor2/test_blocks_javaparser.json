            "end_line": 58,
            "line_count": 3,
            "preview": "// Single-byte buffer: offset=0 exposes the full 1-byte buffer UnsynchronizedByteArrayInputStream oneAtStart = newStream(one, 0); assertEquals(one.length, oneAtStart.available());"
          },
          {
