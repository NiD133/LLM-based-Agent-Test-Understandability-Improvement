          {
            "start_line": 44,
            "end_line": 47,
            "line_count": 4,
            "preview": "// Advance past the first byte, then set the mark at the current position. assertEquals(first & 0xff, stream.read()); assertTrue(stream.markSupported());"
          },
          {
            "start_line": 49,
            "end_line": 51,
            "line_count": 3,
            "preview": "// Read through the remaining bytes to reach end-of-stream. assertEquals(second & 0xff, stream.read()); assertEquals(third  & 0xff, stream.read());"
