          {
            "start_line": 23,
            "end_line": 25,
            "line_count": 3,
            "preview": "// Bounds check (offset + length > bytes.length) is performed before the closed-stream // check, so an IndexOutOfBoundsException is expected even on a closed stream. assertThrows(IndexOutOfBoundsException.class, () -> in.read(new byte[0], 0"
          },
          {
            "start_line": 27,
            "end_line": 29,
            "line_count": 3,
            "preview": "// When length == 0 the method short-circuits and returns 0 without checking // whether the stream is closed, so no exception should be thrown. assertEquals(0, in.read(new byte[1], 0, 0));"
          },
          {
