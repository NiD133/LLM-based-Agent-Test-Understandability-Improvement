          {
            "start_line": 85,
            "end_line": 91,
            "line_count": 7,
            "preview": "// Stream is already exhausted; subsequent skips throw IOException final IOException ioOnSecondSkip = assertThrows(IOException.class, () -> input.skip(5),"
