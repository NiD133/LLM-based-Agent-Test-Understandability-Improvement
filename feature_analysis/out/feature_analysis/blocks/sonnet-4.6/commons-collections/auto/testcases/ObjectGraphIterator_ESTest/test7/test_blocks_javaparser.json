            "line_count": 3,
            "preview": "// Wrap the predicate in a transformer so transform(x) == predicate.evaluate(x) PredicateTransformer<Transformer<Boolean, Boolean>> predicateAsTransformer = new PredicateTransformer<Transformer<Boolean, Boolean>>(notNullPredicate);"
          },
          {
            "start_line": 48,
            "end_line": 50,
            "line_count": 3,
            "preview": "// A graph transformer that collapses every element to null ConstantTransformer<Boolean, Boolean> alwaysNullTransformer = new ConstantTransformer<Boolean, Boolean>((Boolean) null);"
          },
          {
            "start_line": 52,
            "end_line": 53,
            "line_count": 2,
            "preview": "// alwaysNullTransformer is not null, so the predicate returns TRUE Boolean rootValue = predicateAsTransformer.transform(alwaysNullTransformer);"
          },
          {
            "start_line": 55,
            "end_line": 57,
            "line_count": 3,
            "preview": "// Inner iterator: root=TRUE, transformer always maps to null ObjectGraphIterator<Boolean> innerIterator = new ObjectGraphIterator<Boolean>(rootValue, alwaysNullTransformer);"
