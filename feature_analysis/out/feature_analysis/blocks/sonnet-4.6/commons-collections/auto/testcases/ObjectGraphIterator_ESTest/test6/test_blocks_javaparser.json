            "start_line": 23,
            "end_line": 25,
            "line_count": 3,
            "preview": "// A constant transformer always returns the same integer, forming a one-element cycle Integer constantValue = new Integer(414); Transformer<Object, Integer> constantTransformer = ConstantTransformer.constantTransformer(constantValue);"
          },
          {
            "start_line": 27,
            "end_line": 29,
            "line_count": 3,
            "preview": "// Base iterator: rooted at constantValue, applies constantTransformer to advance ObjectGraphIterator<Integer> baseIterator = new ObjectGraphIterator<Integer>(constantValue, constantTransformer);"
          },
          {
            "start_line": 31,
            "end_line": 33,
            "line_count": 3,
            "preview": "// Wrapping iterator: treats baseIterator as an iterator-of-iterators ObjectGraphIterator<Integer> wrappingIterator = new ObjectGraphIterator<Integer>(baseIterator);"
          },
          {
            "start_line": 35,
            "end_line": 37,
            "line_count": 3,
            "preview": "// Null-root iterator: produces no elements on its own when traversed ObjectGraphIterator<Integer> nullRootIterator = new ObjectGraphIterator<Integer>((Integer) null, constantTransformer);"
          },
          {
            "start_line": 39,
            "end_line": 42,
            "line_count": 4,
            "preview": "// Redirect wrappingIterator to traverse nullRootIterator first; // since nullRootIterator has no elements, the traversal falls back to the // stacked baseIterator and finds the next value there"
