            "start_line": 28,
            "end_line": 30,
            "line_count": 3,
            "preview": "// 72-bit filter requires two 64-bit longs to hold all bits final Shape shape = Shape.fromKM(2, 72); final BloomFilter bf = createFilter(shape, hasher);"
          },
          {
            "start_line": 32,
            "end_line": 32,
            "line_count": 1,
            "preview": "final long[] bitMapArray = bf.asBitMapArray();"
          },
          {
            "start_line": 34,
            "end_line": 34,
            "line_count": 1,
            "preview": "assertEquals(2, bitMapArray.length, \"A 72-bit filter must be represented by exactly 2 longs\");"
