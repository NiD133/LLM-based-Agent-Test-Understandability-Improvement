            "line_count": 2,
            "preview": "// Re-encoding the decoded point must reproduce the same hash (idempotency). assertEquals(FULL_PRECISION_HASH, GeohashUtils.encodeLatLon(decodedFull.getY(), decodedFull.getX()));"
