            "line_count": 2,
            "preview": "// Create a standard Java Instant 3 seconds after the Unix epoch (1970-01-01T00:00:03Z) Instant javaInstant = MockInstant.ofEpochSecond(3L);"
          },
          {
            "start_line": 28,
            "end_line": 29,
            "line_count": 2,
            "preview": "// Convert to UtcInstant, which uses Modified Julian Day + nanosecond-of-day representation UtcInstant utcInstant = UtcInstant.of(javaInstant);"
          },
          {
            "start_line": 31,
            "end_line": 33,
            "line_count": 3,
            "preview": "// 3 seconds after midnight is not a leap second (leap seconds occur at 23:59:60) boolean isLeapSecond = utcInstant.isLeapSecond(); assertFalse(isLeapSecond);"
          },
          {
            "start_line": 35,
            "end_line": 36,
            "line_count": 2,
            "preview": "// The instant falls on the same calendar day (MJD 40587 = 1970-01-01) assertEquals(MJD_UNIX_EPOCH, utcInstant.getModifiedJulianDay());"
          },
          {
            "start_line": 38,
            "end_line": 39,
            "line_count": 2,
            "preview": "// The nanosecond-of-day is exactly 3 seconds worth of nanoseconds from start of day assertEquals(THREE_SECONDS_IN_NANOS, utcInstant.getNanoOfDay());"
