          {
            "start_line": 48,
            "end_line": 49,
            "line_count": 2,
            "preview": "// Apply the Ethiopic date back as a TemporalAdjuster to the original International Fixed date InternationalFixedDate adjustedDate = sourceDate.with((TemporalAdjuster) ethiopicEquivalent);"
