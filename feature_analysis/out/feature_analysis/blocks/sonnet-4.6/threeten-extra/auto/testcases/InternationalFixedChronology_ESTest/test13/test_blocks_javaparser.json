            "line_count": 3,
            "preview": "// Create a date at year 7, day 7 of that year in the International Fixed calendar InternationalFixedChronology chronology = new InternationalFixedChronology(); InternationalFixedDate sourceDate = chronology.dateYearDay(7, 7);"
          },
          {
            "start_line": 45,
            "end_line": 46,
            "line_count": 2,
            "preview": "// Convert the International Fixed date to its Ethiopic calendar equivalent EthiopicDate ethiopicEquivalent = EthiopicDate.from(sourceDate);"
