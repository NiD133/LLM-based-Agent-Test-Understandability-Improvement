            "start_line": 34,
            "end_line": 36,
            "line_count": 3,
            "preview": "// Create a reference instant; using the same instant for both bounds gives zero days Instant referenceInstant = MockInstant.ofEpochSecond((-2086L), (-2086L)); Days zeroDays = Days.between(referenceInstant, referenceInstant);"
          },
          {
            "start_line": 38,
            "end_line": 40,
            "line_count": 3,
            "preview": "// Subtracting a negative duration flips the sign: 0 - (-2086) = +2086 Duration negativeDuration = Duration.ofDays((-2086L)); Days positiveDays = zeroDays.minus((TemporalAmount) negativeDuration);"
          },
          {
            "start_line": 42,
            "end_line": 44,
            "line_count": 3,
            "preview": "// addTo() must return a new Temporal shifted by 2086 days, not the original reference Temporal shiftedInstant = positiveDays.addTo(referenceInstant); assertNotSame(shiftedInstant, referenceInstant);"
          },
          {
            "start_line": 46,
            "end_line": 47,
            "line_count": 2,
            "preview": "// Verify intermediate state: between the same instant is always zero assertTrue(zeroDays.isZero());"
