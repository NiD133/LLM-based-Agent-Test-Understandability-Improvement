            "line_count": 4,
            "preview": "for (int year = -200; year < 200; year++) { // Create day 1 of the proleptic year and confirm the YEAR field round-trips JulianDate base = JulianChronology.INSTANCE.dateYearDay(year, 1);"
          },
          {
            "start_line": 18,
            "end_line": 20,
            "line_count": 3,
            "preview": "// Julian calendar: proleptic year <= 0 maps to BC, year > 0 maps to AD JulianEra era = (year <= 0 ? JulianEra.BC : JulianEra.AD); assertEquals(era, base.getEra());"
          },
          {
            "start_line": 22,
            "end_line": 25,
            "line_count": 4,
            "preview": "// Year-of-era counts from 1 in both directions: // AD years: yearOfEra == prolepticYear; BC years: yearOfEra == 1 - prolepticYear int yearOfEra = (year <= 0 ? 1 - year : year);"
          },
          {
            "start_line": 27,
            "end_line": 30,
            "line_count": 4,
            "preview": "// Building the same date via era + yearOfEra must produce an equal date JulianDate eraBased = JulianChronology.INSTANCE.dateYearDay(era, yearOfEra, 1); assertEquals(base, eraBased);"
          }
