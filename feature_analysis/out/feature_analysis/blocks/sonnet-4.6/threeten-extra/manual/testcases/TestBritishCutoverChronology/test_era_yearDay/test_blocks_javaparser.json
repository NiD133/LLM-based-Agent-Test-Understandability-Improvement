          },
          {
            "start_line": 28,
            "end_line": 29,
            "line_count": 2,
            "preview": "// Day 247 of 1752 is September 14 — the first Gregorian day (Sep 3–13 were skipped) assertEquals(BritishCutoverDate.of(1752, 9, 14), CHRONO.dateYearDay(1752, 247));"
          },
          {
            "start_line": 31,
            "end_line": 32,
            "line_count": 2,
