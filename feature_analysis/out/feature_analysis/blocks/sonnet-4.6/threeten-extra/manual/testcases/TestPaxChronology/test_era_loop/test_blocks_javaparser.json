            "line_count": 3,
            "preview": "for (int prolepticYear = -200; prolepticYear < 200; prolepticYear++) { PaxDate dateByProlepticYear = PaxChronology.INSTANCE.date(prolepticYear, 1, 1); assertEquals(prolepticYear, dateByProlepticYear.get(YEAR));"
          },
          {
            "start_line": 103,
            "end_line": 105,
            "line_count": 3,
            "preview": "// BCE covers proleptic years <= 0; CE covers proleptic years > 0 PaxEra expectedEra = (prolepticYear <= 0) ? PaxEra.BCE : PaxEra.CE; assertEquals(expectedEra, dateByProlepticYear.getEra());"
          },
          {
            "start_line": 107,
            "end_line": 111,
            "line_count": 5,
            "preview": "// Year-of-era always counts from 1 within an era: //   CE  proleptic year Y → yoe = Y //   BCE proleptic year Y (≤ 0) → yoe = 1 - Y  (so year 0 → yoe 1, year -1 → yoe 2, …)"
          },
          {
            "start_line": 113,
            "end_line": 116,
            "line_count": 4,
            "preview": "// Reconstructing the date from (era, yearOfEra) must yield the same date PaxDate dateByEraAndYearOfEra = PaxChronology.INSTANCE.date(expectedEra, yearOfEra, 1, 1); assertEquals(dateByProlepticYear, dateByEraAndYearOfEra);"
          }
