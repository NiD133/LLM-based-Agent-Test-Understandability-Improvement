          {
            "start_line": 39,
            "end_line": 40,
            "line_count": 2,
            "preview": "// Regular months have 28 days (4 weeks × 7); the leap-week month can reach 35. assertEquals(ValueRange.of(1, 28, 35), INSTANCE.range(DAY_OF_MONTH));"
          },
          {
            "start_line": 42,
            "end_line": 43,
            "line_count": 2,
            "preview": "// A standard accounting year has 364 days; a leap year adds one week → 371. assertEquals(ValueRange.of(1, 364, 371), INSTANCE.range(DAY_OF_YEAR));"
          },
          {
