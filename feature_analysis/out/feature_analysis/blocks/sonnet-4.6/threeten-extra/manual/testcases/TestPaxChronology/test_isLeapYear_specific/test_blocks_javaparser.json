            "end_line": 23,
            "line_count": 3,
            "preview": "// Rule 1: years divisible by 400 are NOT leap years assertFalse(PaxChronology.INSTANCE.isLeapYear(400)); assertFalse(PaxChronology.INSTANCE.isLeapYear(-400));"
          },
          {
            "start_line": 25,
            "end_line": 27,
            "line_count": 3,
            "preview": "// Rule 2: years ending in \"00\" that are NOT divisible by 400 ARE leap years assertTrue(PaxChronology.INSTANCE.isLeapYear(100)); assertTrue(PaxChronology.INSTANCE.isLeapYear(-100));"
          },
          {
            "start_line": 29,
            "end_line": 31,
            "line_count": 3,
            "preview": "// Rule 3: years whose last two digits are 99 ARE leap years assertTrue(PaxChronology.INSTANCE.isLeapYear(99)); assertTrue(PaxChronology.INSTANCE.isLeapYear(-99));"
          },
          {
            "start_line": 33,
            "end_line": 35,
            "line_count": 3,
            "preview": "// Rule 4: years whose last two digits are divisible by 6 ARE leap years assertTrue(PaxChronology.INSTANCE.isLeapYear(6)); assertTrue(PaxChronology.INSTANCE.isLeapYear(-6));"
          },
          {
            "start_line": 37,
            "end_line": 49,
            "line_count": 13,
            "preview": "// Rule 5 & 6: all remaining years are NOT leap years assertFalse(PaxChronology.INSTANCE.isLeapYear(7)); assertFalse(PaxChronology.INSTANCE.isLeapYear(5));"
          }
