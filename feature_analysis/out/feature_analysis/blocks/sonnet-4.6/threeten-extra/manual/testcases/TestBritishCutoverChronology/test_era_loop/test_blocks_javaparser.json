            "line_count": 2,
            "preview": "for (int prolepticYear = -200; prolepticYear < 200; prolepticYear++) { BritishCutoverDate base = BritishCutoverChronology.INSTANCE.date(prolepticYear, 1, 1);"
          },
          {
            "start_line": 200,
            "end_line": 201,
            "line_count": 2,
            "preview": "// YEAR field holds the proleptic year (0 and negative values represent BC years) assertEquals(prolepticYear, base.get(YEAR));"
          },
          {
            "start_line": 203,
            "end_line": 205,
            "line_count": 3,
            "preview": "// Proleptic year 0 and below belong to the BC era; year 1 and above belong to AD JulianEra expectedEra = (prolepticYear <= 0) ? JulianEra.BC : JulianEra.AD; assertEquals(expectedEra, base.getEra());"
          },
          {
            "start_line": 207,
            "end_line": 211,
            "line_count": 5,
            "preview": "// Year-of-era is 1-based and counts upward in both directions from the epoch: //   AD: prolepticYear 1 → yoe 1, prolepticYear 2 → yoe 2, ... //   BC: prolepticYear 0 → yoe 1, prolepticYear -1 → yoe 2, ..."
          },
          {
            "start_line": 213,
            "end_line": 216,
            "line_count": 4,
            "preview": "// Reconstructing the date via (era, yearOfEra) must yield the same date BritishCutoverDate eraBased = BritishCutoverChronology.INSTANCE.date(expectedEra, expectedYearOfEra, 1, 1); assertEquals(base, eraBased);"
