            "preview": "for (int prolepticYear = -200; prolepticYear < 200; prolepticYear++) { JulianDate julianDate = JulianChronology.INSTANCE.date(prolepticYear, 1, 1);"
          },
          {
            "start_line": 16,
            "end_line": 17,
            "line_count": 2,
            "preview": "// The proleptic year is stored as-is (0 and negatives represent BC years) assertEquals(prolepticYear, julianDate.get(YEAR));"
          },
          {
            "start_line": 19,
            "end_line": 21,
            "line_count": 3,
            "preview": "// Proleptic year <= 0 belongs to the BC era; year > 0 belongs to AD JulianEra expectedEra = (prolepticYear <= 0 ? JulianEra.BC : JulianEra.AD); assertEquals(expectedEra, julianDate.getEra());"
          },
          {
            "start_line": 23,
            "end_line": 27,
            "line_count": 5,
            "preview": "// Year-of-era counts from 1 outward in both directions: //   BC: proleptic year 0 -> yoe 1, proleptic year -1 -> yoe 2, ... //   AD: proleptic year 1 -> yoe 1, proleptic year 2 -> yoe 2, ..."
          },
          {
            "start_line": 29,
            "end_line": 32,
            "line_count": 4,
            "preview": "// Round-trip: constructing from (era, yearOfEra) must produce the same date JulianDate eraBasedDate = JulianChronology.INSTANCE.date(expectedEra, expectedYearOfEra, 1, 1); assertEquals(julianDate, eraBasedDate);"
