            "line_count": 2,
            "preview": "for (int prolepticYear = -200; prolepticYear < 200; prolepticYear++) { AccountingDate base = INSTANCE.date(prolepticYear, 1, 1);"
          },
          {
            "start_line": 109,
            "end_line": 110,
            "line_count": 2,
            "preview": "// Proleptic year round-trips correctly through the YEAR field. assertEquals(prolepticYear, base.get(YEAR));"
          },
          {
            "start_line": 112,
            "end_line": 114,
            "line_count": 3,
            "preview": "// Years <= 0 are BCE; years >= 1 are CE. AccountingEra expectedEra = (prolepticYear <= 0 ? AccountingEra.BCE : AccountingEra.CE); assertEquals(expectedEra, base.getEra());"
          },
          {
            "start_line": 116,
            "end_line": 118,
            "line_count": 3,
            "preview": "// Year-of-era counts up from 1 going backwards into BCE, and forwards in CE. int expectedYearOfEra = (prolepticYear <= 0 ? 1 - prolepticYear : prolepticYear); assertEquals(expectedYearOfEra, base.get(YEAR_OF_ERA));"
          },
          {
            "start_line": 120,
            "end_line": 123,
            "line_count": 4,
            "preview": "// A date built from (era, yearOfEra) must equal the proleptic-year date. AccountingDate eraBased = INSTANCE.date(expectedEra, expectedYearOfEra, 1, 1); assertEquals(base, eraBased);"
          }
        ],
