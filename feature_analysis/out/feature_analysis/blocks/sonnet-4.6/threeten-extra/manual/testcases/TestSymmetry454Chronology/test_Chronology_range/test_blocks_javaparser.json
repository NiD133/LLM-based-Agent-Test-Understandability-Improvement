        "blocks": [
          {
            "start_line": 32,
            "end_line": 35,
            "line_count": 4,
            "preview": "// Day-of-week fields are always 1–7 regardless of month or year type assertEquals(ValueRange.of(1, 7), CHRONO.range(ALIGNED_DAY_OF_WEEK_IN_MONTH)); assertEquals(ValueRange.of(1, 7), CHRONO.range(ALIGNED_DAY_OF_WEEK_IN_YEAR));"
          },
          {
            "start_line": 37,
            "end_line": 40,
            "line_count": 4,
            "preview": "// Week-count fields vary: standard months have 4 weeks, long months have 5; // standard years have 52 weeks, leap years have 53 assertEquals(ValueRange.of(1, 4, 5), CHRONO.range(ALIGNED_WEEK_OF_MONTH));"
          },
          {
            "start_line": 42,
            "end_line": 44,
            "line_count": 3,
            "preview": "// Day fields vary because long months have 35 days and leap years have 371 days assertEquals(ValueRange.of(1, 28, 35), CHRONO.range(DAY_OF_MONTH)); assertEquals(ValueRange.of(1, 364, 371), CHRONO.range(DAY_OF_YEAR));"
          },
          {
            "start_line": 46,
            "end_line": 47,
            "line_count": 2,
            "preview": "// Era is binary: 0 = BCE, 1 = CE (same eras as Gregorian/ISO) assertEquals(ValueRange.of(0, 1), CHRONO.range(ERA));"
          },
          {
            "start_line": 49,
            "end_line": 50,
            "line_count": 2,
            "preview": "// Twelve months per year, always assertEquals(ValueRange.of(1, 12), CHRONO.range(MONTH_OF_YEAR));"
          },
          {
            "start_line": 52,
            "end_line": 53,
            "line_count": 2,
            "preview": "// Proleptic month spans the full supported year range (12 months each) assertEquals(ValueRange.of(-MAX_YEAR * 12, MAX_YEAR * 12 - 1), CHRONO.range(PROLEPTIC_MONTH));"
          },
          {
            "start_line": 55,
            "end_line": 57,
            "line_count": 3,
            "preview": "// Year and year-of-era span ±1 000 000 assertEquals(ValueRange.of(-MAX_YEAR, MAX_YEAR), CHRONO.range(YEAR)); assertEquals(ValueRange.of(-MAX_YEAR, MAX_YEAR), CHRONO.range(YEAR_OF_ERA));"
