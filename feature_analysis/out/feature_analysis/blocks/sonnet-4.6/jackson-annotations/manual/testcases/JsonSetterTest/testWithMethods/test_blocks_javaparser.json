        "blocks": [
          {
            "start_line": 12,
            "end_line": 14,
            "line_count": 3,
            "preview": "// Passing null to withContentNulls normalizes it to DEFAULT, so EMPTY is returned unchanged JsonSetter.Value nullContentResult = EMPTY.withContentNulls(null); assertSame(EMPTY, nullContentResult);"
          },
          {
            "start_line": 16,
            "end_line": 18,
            "line_count": 3,
            "preview": "// Setting contentNulls to FAIL produces a new value with the updated setting JsonSetter.Value withContentFail = nullContentResult.withContentNulls(Nulls.FAIL); assertEquals(Nulls.FAIL, withContentFail.getContentNulls());"
          },
          {
            "start_line": 20,
            "end_line": 21,
            "line_count": 2,
            "preview": "// withContentNulls is idempotent: calling with the same value returns the same instance assertSame(withContentFail, withContentFail.withContentNulls(Nulls.FAIL));"
          },
          {
            "start_line": 23,
            "end_line": 27,
            "line_count": 5,
            "preview": "// withValueNulls creates a new distinct value; the original and new value are not equal JsonSetter.Value withValueSkip = withContentFail.withValueNulls(Nulls.SKIP); assertEquals(Nulls.SKIP, withValueSkip.getValueNulls());"
          },
          {
            "start_line": 29,
            "end_line": 32,
            "line_count": 4,
            "preview": "// withValueNulls(null, null) resets both valueNulls and contentNulls to DEFAULT JsonSetter.Value allDefaults = withValueSkip.withValueNulls(null, null); assertEquals(Nulls.DEFAULT, allDefaults.getContentNulls());"
          },
          {
            "start_line": 34,
            "end_line": 35,
            "line_count": 2,
            "preview": "// withValueNulls(null, null) on an all-default value is idempotent assertSame(allDefaults, allDefaults.withValueNulls(null, null));"
          },
          {
            "start_line": 37,
            "end_line": 42,
            "line_count": 6,
            "preview": "// withOverrides applies non-DEFAULT settings from the override value; // result equals the override but is a distinct instance JsonSetter.Value merged = allDefaults.withOverrides(withValueSkip);"
          }
