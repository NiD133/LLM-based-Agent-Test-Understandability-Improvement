            "line_count": 2,
            "preview": "// Baseline: an empty Value with no features configured JsonFormat.Value baseValue = JsonFormat.Value.empty();"
          },
          {
            "start_line": 25,
            "end_line": 25,
            "line_count": 1,
            "preview": "JsonFormat.Feature feature = JsonFormat.Feature.READ_UNKNOWN_ENUM_VALUES_AS_NULL;"
          },
          {
            "start_line": 27,
            "end_line": 28,
            "line_count": 2,
            "preview": "// valueWithFeatureEnabled has READ_UNKNOWN_ENUM_VALUES_AS_NULL explicitly enabled JsonFormat.Value valueWithFeatureEnabled = baseValue.withFeature(feature);"
          },
          {
            "start_line": 30,
            "end_line": 31,
            "line_count": 2,
            "preview": "// valueWithFeatureDisabled has READ_UNKNOWN_ENUM_VALUES_AS_NULL explicitly disabled JsonFormat.Value valueWithFeatureDisabled = baseValue.withoutFeature(feature);"
          },
          {
            "start_line": 33,
            "end_line": 35,
            "line_count": 3,
            "preview": "// Applying valueWithFeatureEnabled as overrides to valueWithFeatureDisabled // should yield a result equivalent to valueWithFeatureEnabled JsonFormat.Value merged = valueWithFeatureDisabled.withOverrides(valueWithFeatureEnabled);"
          },
          {
            "start_line": 37,
            "end_line": 38,
            "line_count": 2,
            "preview": "// Explicitly disabling a feature changes the Value, so it is not equal to the base empty Value assertFalse(valueWithFeatureDisabled.equals((Object) baseValue));"
