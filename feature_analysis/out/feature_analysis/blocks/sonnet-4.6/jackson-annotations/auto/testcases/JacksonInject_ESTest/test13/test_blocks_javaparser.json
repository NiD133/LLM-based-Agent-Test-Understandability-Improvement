        "block_count": 6,
        "blocks": [
          {
            "start_line": 22,
            "end_line": 23,
            "line_count": 2,
            "preview": "// A non-null object serves as the injection id so that hasId() will return true. Object injectionId = new Object();"
          },
          {
            "start_line": 25,
            "end_line": 26,
            "line_count": 2,
            "preview": "// Build a Value with useInput=TRUE and optional=TRUE. JacksonInject.Value originalValue = JacksonInject.Value.construct(injectionId, Boolean.TRUE, Boolean.TRUE);"
          },
          {
            "start_line": 28,
            "end_line": 30,
            "line_count": 3,
            "preview": "// Replacing useInput with null must return a brand-new instance (not the same reference) // because the useInput field changes from TRUE to null. JacksonInject.Value valueWithNullUseInput = originalValue.withUseInput((Boolean) null);"
          },
          {
            "start_line": 32,
            "end_line": 33,
            "line_count": 2,
            "preview": "// The two instances must be different objects. assertNotSame(valueWithNullUseInput, originalValue);"
          },
          {
            "start_line": 35,
            "end_line": 36,
            "line_count": 2,
            "preview": "// They must not be equal because their useInput fields differ (TRUE vs null). assertFalse(valueWithNullUseInput.equals((Object) originalValue));"
          },
          {
            "start_line": 38,
            "end_line": 39,
            "line_count": 2,
            "preview": "// The injection id is unchanged, so the new Value still reports having an id. assertTrue(valueWithNullUseInput.hasId());"
          }
        ],
