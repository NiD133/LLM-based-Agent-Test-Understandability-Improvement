          {
            "start_line": 34,
            "end_line": 38,
            "line_count": 5,
            "preview": "// --- Vowels are silent (not separators) --- // In standard Soundex, a vowel between two consonants with the same code keeps // both consonants encoded. In the genealogy variant, the 'o' in \"Dodds\" is silent,"
          },
          {
            "start_line": 40,
            "end_line": 43,
            "line_count": 4,
            "preview": "// --- 'H' is silent (not a separator) --- // The 'h' between the two 'd' sounds in \"Dhdds\" is ignored entirely, // causing the duplicate 'd' codes to collapse: D200."
          },
          {
            "start_line": 45,
            "end_line": 48,
            "line_count": 4,
            "preview": "// --- 'W' is silent (not a separator) --- // The 'w' between the two 'd' sounds in \"Dwdds\" is ignored entirely, // causing the duplicate 'd' codes to collapse: D200."
