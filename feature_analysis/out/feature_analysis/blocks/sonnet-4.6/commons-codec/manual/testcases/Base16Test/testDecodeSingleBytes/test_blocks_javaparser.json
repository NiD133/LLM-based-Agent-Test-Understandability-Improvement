            "line_count": 4,
            "preview": "final String encoded = \"556E74696C206E6578742074696D6521\"; final byte[] encodedBytes = StringUtils.getBytesUtf8(encoded); final BaseNCodec.Context context = new BaseNCodec.Context();"
          },
          {
            "start_line": 25,
            "end_line": 33,
            "line_count": 9,
            "preview": "// Feed one hex character at a time; the codec accumulates half-bytes across calls. // Offset 0: '5' — first nibble of \"55\" ('U'), stored as a half-byte b16.decode(encodedBytes, 0, 1, context);"
          },
          {
            "start_line": 35,
            "end_line": 41,
            "line_count": 7,
            "preview": "// Feed chunks that split across hex-pair boundaries. // Offset 4, length 3: \"746\" — emits 't' (from \"74\"), stores '6' (first nibble of \"69\") b16.decode(encodedBytes, 4, 3, context);"
          },
          {
            "start_line": 43,
            "end_line": 45,
            "line_count": 3,
            "preview": "// Feed the remaining 19 bytes in one call; combines stored '6' with 'E' to emit 'n', // then decodes \"6578742074696D6521\" to complete \"ext time!\" b16.decode(encodedBytes, 13, 19, context);"
          },
          {
            "start_line": 47,
            "end_line": 49,
            "line_count": 3,
            "preview": "final byte[] decodedBytes = new byte[context.pos]; System.arraycopy(context.buffer, context.readPos, decodedBytes, 0, decodedBytes.length); assertEquals(\"Until next time!\", StringUtils.newStringUtf8(decodedBytes));"
