            "end_line": 42,
            "line_count": 3,
            "preview": "// \"ver\" is a prefix of both \"version\" and \"verbose\", so both must be returned. assertEquals(2, options.getMatchingOptions(\"ver\").size(), \"Prefix 'ver' should match both 'version' and 'verbose'\");"
