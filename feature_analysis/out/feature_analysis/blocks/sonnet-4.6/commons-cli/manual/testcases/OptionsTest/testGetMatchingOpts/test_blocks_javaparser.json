          },
          {
            "start_line": 32,
            "end_line": 34,
            "line_count": 3,
            "preview": "// \"foo\" does not match any registered long option, so the result must be empty. assertTrue(options.getMatchingOptions(\"foo\").isEmpty(), \"No option starts with 'foo'; expected an empty match list\");"
          },
          {
            "start_line": 36,
            "end_line": 38,
            "line_count": 3,
            "preview": "// \"version\" is an exact long-option name, so only that single option matches. assertEquals(1, options.getMatchingOptions(\"version\").size(), \"Exact match on 'version' should return exactly one option\");"
          },
          {
