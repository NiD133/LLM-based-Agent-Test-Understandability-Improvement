            "start_line": 15,
            "end_line": 17,
            "line_count": 3,
            "preview": "// A non-empty prefix is prepended to the long option name OptionFormatter.Builder builder = OptionFormatter.builder().setLongOptPrefix(\"fo\"); assertEquals(\"foopt\", builder.build(option).getLongOpt());"
          },
          {
            "start_line": 19,
            "end_line": 21,
            "line_count": 3,
            "preview": "// An empty-string prefix produces the bare long option name builder = OptionFormatter.builder().setLongOptPrefix(\"\"); assertEquals(\"opt\", builder.build(option).getLongOpt());"
