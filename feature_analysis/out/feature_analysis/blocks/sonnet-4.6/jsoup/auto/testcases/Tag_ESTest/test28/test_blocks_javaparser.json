            "start_line": 22,
            "end_line": 23,
            "line_count": 2,
            "preview": "// After explicitly clearing the Known bit, the tag is no longer recognized as known assertFalse(unknownTag.isKnownTag());"
          },
          {
            "start_line": 25,
            "end_line": 26,
            "line_count": 2,
            "preview": "// The normal name is the lowercased version of the original tag name assertEquals(\"3urw0gs^ `h\", tagWithKnownCleared.normalName());"
