        "blocks": [
          {
            "start_line": 15,
            "end_line": 18,
            "line_count": 4,
            "preview": "// Input string (Java literal): \":contains(one (two) \\( \\) \\) three) four\" // The \\( and \\) are escaped parens — they should be treated as plain characters, // not as depth-changing open/close tokens."
          },
          {
            "start_line": 20,
            "end_line": 21,
            "line_count": 2,
            "preview": "// consumeTo stops just before the first unescaped '(' String pre = tq.consumeTo(\"(\");"
          },
          {
            "start_line": 23,
            "end_line": 24,
            "line_count": 2,
            "preview": "// chompBalanced consumes from '(' to its true matching ')', preserving escape sequences String guts = tq.chompBalanced('(', ')');"
          },
          {
            "start_line": 26,
            "end_line": 27,
            "line_count": 2,
            "preview": "// remainder() returns everything left after the closing ')' String remainder = tq.remainder();"
          },
          {
            "start_line": 29,
            "end_line": 30,
            "line_count": 2,
            "preview": "assertEquals(\":contains\", pre, \"consumeTo('(') should capture the selector name before the opening paren\");"
          },
          {
            "start_line": 32,
            "end_line": 33,
            "line_count": 2,
            "preview": "assertEquals(\"one (two) \\\\( \\\\) \\\\) three\", guts, \"chompBalanced should capture the balanced content with escape sequences intact\");"
          },
          {
            "start_line": 35,
            "end_line": 36,
            "line_count": 2,
            "preview": "assertEquals(\"one (two) ( ) ) three\", TokenQueue.unescape(guts), \"unescape() should convert backslash-escaped parens to their literal characters\");"
          },
          {
            "start_line": 38,
            "end_line": 39,
            "line_count": 2,
            "preview": "assertEquals(\" four\", remainder, \"remainder() should contain the text that follows the closing paren\");"
