          {
            "start_line": 32,
            "end_line": 34,
            "line_count": 3,
            "preview": "// Backreference pattern: matches a word followed by the same word (e.g. \"hello hello\"). // re2j rejects backreferences because it enforces linear-time matching. String backReferencePattern = \"(\\\\w+)\\\\s+\\\\1\";"
          },
          {
            "start_line": 36,
            "end_line": 37,
            "line_count": 2,
            "preview": "// jsoup must wrap re2j's rejection as a ValidationException (not re2j's PatternSyntaxException) assertThrows(ValidationException.class, () -> Regex.compile(backReferencePattern));"
