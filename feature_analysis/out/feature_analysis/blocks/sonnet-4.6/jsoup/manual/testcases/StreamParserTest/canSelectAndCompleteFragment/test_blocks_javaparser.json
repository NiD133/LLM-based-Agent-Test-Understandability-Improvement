            "start_line": 16,
            "end_line": 19,
            "line_count": 4,
            "preview": "// Fragment input: three table rows, each with one cell String html = \"<tr id=1><td>One</td><tr id=2><td>Two</td></tr><tr id=3><td>Three</td></tr>\"; // Parse as a fragment rooted in a <table> context so the browser-implied <tbody> is create"
          },
          {
            "start_line": 21,
            "end_line": 24,
            "line_count": 4,
            "preview": "try (StreamParser parser = new StreamParser(Parser.htmlParser()).parseFragment(html, tableContext, \"\")) { // Retrieve each <td> in document order; expectNext throws if no match is found Element firstTd = parser.expectNext(\"td\");"
          },
          {
            "start_line": 26,
            "end_line": 27,
            "line_count": 2,
            "preview": "Element secondTd = parser.expectNext(\"td\"); assertEquals(\"Two\", secondTd.ownText());"
          },
          {
            "start_line": 29,
            "end_line": 30,
            "line_count": 2,
            "preview": "Element thirdTd = parser.expectNext(\"td\"); assertEquals(\"Three\", thirdTd.ownText());"
          },
          {
            "start_line": 32,
            "end_line": 34,
            "line_count": 3,
            "preview": "// No more <td> elements remain; selectNext returns null instead of throwing Element noMoreTd = parser.selectNext(\"td\"); assertNull(noMoreTd);"
          },
          {
            "start_line": 36,
            "end_line": 37,
            "line_count": 2,
            "preview": "// Finish the parse and retrieve the top-level fragment nodes List<Node> fragmentRoots = parser.completeFragment();"
          },
          {
            "start_line": 39,
            "end_line": 42,
            "line_count": 4,
            "preview": "// The HTML parser wraps the <tr> elements in an inferred <tbody> assertEquals(1, fragmentRoots.size()); Node tbody = fragmentRoots.get(0);"
          },
          {
            "start_line": 44,
            "end_line": 46,
            "line_count": 3,
            "preview": "// The <tbody> should contain all three <tr> rows List<Node> rows = tbody.childNodes(); assertEquals(3, rows.size());"
