        "block_count": 9,
        "blocks": [
          {
            "start_line": 14,
            "end_line": 16,
            "line_count": 3,
            "preview": "// Parse with case-preserving settings so that custom tag names like \"FOO\" are kept as-is Document doc = Jsoup.parse(\"<div><p>One</p></div>\", \"\", Parser.htmlParser().settings(ParseSettings.preserveCase)); TagSet tags = doc.parser().tagSet()"
          },
          {
            "start_line": 18,
            "end_line": 21,
            "line_count": 4,
            "preview": "// Known HTML tags (e.g. \"meta\") should be present and flagged as known Tag meta = tags.get(\"meta\", NamespaceHtml); assertNotNull(meta);"
          },
          {
            "start_line": 23,
            "end_line": 25,
            "line_count": 3,
            "preview": "// Elements parsed from HTML should also carry a known tag Element p = doc.expectFirst(\"p\"); assertTrue(p.tag().isKnownTag());"
          },
          {
            "start_line": 27,
            "end_line": 28,
            "line_count": 2,
            "preview": "// An unrecognised tag name returns null before it has been introduced assertNull(tags.get(\"FOO\", NamespaceHtml));"
          },
          {
            "start_line": 30,
            "end_line": 32,
            "line_count": 3,
            "preview": "// Renaming the element introduces \"FOO\" as a new, unknown tag in the TagSet p.tagName(\"FOO\"); Tag foo = p.tag();"
          },
          {
            "start_line": 34,
            "end_line": 37,
            "line_count": 4,
            "preview": "// The new tag preserves the user-supplied case, stores the lowercase normalName, and lives in the HTML namespace assertEquals(\"FOO\", foo.name()); assertEquals(\"foo\", foo.normalName());"
          },
          {
            "start_line": 39,
            "end_line": 40,
            "line_count": 2,
            "preview": "// Because \"FOO\" was not declared upfront it is not a known tag assertFalse(foo.isKnownTag());"
          },
          {
            "start_line": 42,
            "end_line": 44,
            "line_count": 3,
            "preview": "// Both get() and valueOf() must return the exact same Tag instance that was created assertSame(foo, tags.get(\"FOO\", NamespaceHtml)); assertSame(foo, tags.valueOf(\"FOO\", NamespaceHtml));"
          },
          {
            "start_line": 46,
            "end_line": 47,
            "line_count": 2,
            "preview": "// The tag is only registered under its own namespace; other namespaces return null assertNull(tags.get(\"FOO\", \"SomeOtherNamespace\"));"
          }
