        "blocks": [
          {
            "start_line": 11,
            "end_line": 13,
            "line_count": 3,
            "preview": "// Set up a source TagSet with a customizer that marks every new tag as RcData. TagSet source = TagSet.Html(); source.onNewTag(tag -> tag.set(Tag.RcData));"
          },
          {
            "start_line": 15,
            "end_line": 16,
            "line_count": 2,
            "preview": "// Copy the source; the copy should inherit the source's customizer. TagSet copy = new TagSet(source);"
          },
          {
            "start_line": 18,
            "end_line": 20,
            "line_count": 3,
            "preview": "// Both source and copy should apply the RcData customizer to known tags pulled from the source. assertTrue(copy.valueOf(\"script\", NamespaceHtml).is(Tag.RcData)); assertTrue(source.valueOf(\"script\", NamespaceHtml).is(Tag.RcData));"
          },
          {
            "start_line": 22,
            "end_line": 23,
            "line_count": 2,
            "preview": "// Add a second customizer to the copy only; it should not bleed back into source. copy.onNewTag(tag -> tag.set(Tag.Void));"
          },
          {
            "start_line": 25,
            "end_line": 26,
            "line_count": 2,
            "preview": "// The copy applies its own Void customizer to unknown tags. assertTrue(copy.valueOf(\"custom-tag\", NamespaceHtml).is(Tag.Void));"
          },
          {
            "start_line": 28,
            "end_line": 29,
            "line_count": 2,
            "preview": "// The source has no Void customizer, so unknown tags it resolves are not marked Void. assertFalse(source.valueOf(\"custom-tag\", NamespaceHtml).is(Tag.Void));"
          }
