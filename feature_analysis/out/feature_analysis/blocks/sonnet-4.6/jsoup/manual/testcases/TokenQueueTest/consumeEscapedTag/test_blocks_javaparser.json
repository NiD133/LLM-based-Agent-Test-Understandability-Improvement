          {
            "start_line": 41,
            "end_line": 42,
            "line_count": 2,
            "preview": "// \"p\\\\p\"  → backslash is itself escaped, so the result is a literal backslash assertEquals(\"p\\\\p\", q.consumeElementSelector());"
