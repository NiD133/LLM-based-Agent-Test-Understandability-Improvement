            "line_count": 2,
            "preview": "// Queue content (actual chars): p\\\\p p\\.p p\\:p p\\!p TokenQueue q = new TokenQueue(\"p\\\\\\\\p p\\\\.p p\\\\:p p\\\\!p\");"
