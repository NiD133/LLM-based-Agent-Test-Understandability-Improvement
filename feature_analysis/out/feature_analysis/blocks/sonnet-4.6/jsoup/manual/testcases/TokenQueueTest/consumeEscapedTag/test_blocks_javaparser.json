          {
            "start_line": 44,
            "end_line": 45,
            "line_count": 2,
            "preview": "// Separator between selectors must be present and consumed assertTrue(q.consumeWhitespace());"
          },
          {
            "start_line": 47,
            "end_line": 48,
            "line_count": 2,
            "preview": "// \"p\\.p\"  → dot is a CSS special char; the escape strips the backslash, leaving \".\" assertEquals(\"p.p\", q.consumeElementSelector());"
