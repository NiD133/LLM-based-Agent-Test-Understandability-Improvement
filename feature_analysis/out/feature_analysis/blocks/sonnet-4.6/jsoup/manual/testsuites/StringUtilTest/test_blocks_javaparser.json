      {
        "order": 14,
        "name": "resolvesRfc3986AbnormalRelativePaths",
        "is_test": true,
        "method_begin_line": 176,
        "method_end_line": 212,
        "body_begin_line": 177,
        "body_end_line": 212,
        "annotations": [
