        "blocks": [
          {
            "start_line": 143,
            "end_line": 146,
            "line_count": 4,
            "preview": "// Path-relative resolution assertEquals(\"http://example.com/one/two?three\", resolve(\"http://example.com\", \"./one/two?three\")); assertEquals(\"http://example.com/one/two?three\", resolve(\"http://example.com?one\", \"./one/two?three\"));"
          },
          {
            "start_line": 148,
            "end_line": 150,
            "line_count": 3,
            "preview": "// Absolute URL in relUrl supersedes the base completely assertEquals(\"https://example.com/one\", resolve(\"http://example.com/\", \"https://example.com/one\")); assertEquals(\"https://example2.com/one\", resolve(\"http://example.com/\", \"https://ex"
          },
          {
            "start_line": 152,
            "end_line": 153,
            "line_count": 2,
            "preview": "// Protocol-relative URL inherits the scheme from the base assertEquals(\"https://example2.com/one\", resolve(\"https://example.com/\", \"//example2.com/one\"));"
          },
          {
            "start_line": 155,
            "end_line": 156,
            "line_count": 2,
            "preview": "// Parent-directory traversal with \"..\" assertEquals(\"http://example.com/one/two.html\", resolve(\"http://example.com/two/\", \"../one/two.html\"));"
          },
          {
            "start_line": 158,
            "end_line": 159,
            "line_count": 2,
            "preview": "// Port number in the base is preserved during resolution assertEquals(\"https://example.com:8080/one\", resolve(\"https://example.com:8080\", \"./one\"));"
          },
          {
            "start_line": 161,
            "end_line": 162,
            "line_count": 2,
            "preview": "// Invalid base: fall back to relUrl if it is itself absolute assertEquals(\"https://example.com/one\", resolve(\"wrong\", \"https://example.com/one\"));"
          },
          {
            "start_line": 164,
            "end_line": 165,
            "line_count": 2,
            "preview": "// Empty relUrl returns the base URL unchanged assertEquals(\"https://example.com/one\", resolve(\"https://example.com/one\", \"\"));"
          },
          {
            "start_line": 167,
            "end_line": 168,
            "line_count": 2,
            "preview": "// Both base and relUrl are invalid -> empty string assertEquals(\"\", resolve(\"wrong\", \"also wrong\"));"
          },
          {
            "start_line": 170,
            "end_line": 173,
            "line_count": 4,
            "preview": "// FTP scheme is supported assertEquals(\"ftp://example.com/one\", resolve(\"ftp://example.com/two/\", \"../one\")); assertEquals(\"ftp://example.com/one/two.c\", resolve(\"ftp://example.com/one/\", \"./two.c\"));"
          }
