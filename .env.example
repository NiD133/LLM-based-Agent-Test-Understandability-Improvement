# Copy this file to .env at the repository root and fill in the values.
# .env is read by agent_improvement/scripts/main.py (and the modules that
# import it), feature_analysis/, stability_check/ and downstream_tasks/.

# ── JDK homes (directories containing bin/java) ────────────────────────────
# The study used Corretto 1.8.0_442, Temurin 11 and JDK 21.
#   JDK 8   builds the subject projects and runs EvoSuite 1.2.0 (Steps 1-2a)
#   JDK 11  compiles the tests and runs JaCoCo / PIT / JUnit (Steps 2b-5, stability, RQ4)
#   JDK 21  RefactoringMiner 3.0.12 and GumTree (feature_analysis, stability analysis)
#           and the JavaParser oracle-masking helper (downstream_tasks)
JDK_8_HOME=/path/to/jdk-8
JDK_11_HOME=/path/to/jdk-11
JDK_21_HOME=/path/to/jdk-21

# ── Agent credentials (Step 4 only) ───────────────────────────────────────
CLAUDE_CODE_OAUTH_TOKEN=            # Claude Code subscription token, or set ANTHROPIC_API_KEY instead
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=                     # Codex (GPT-5.5)
CODEX_CLI_PATH=                     # path to the `codex` binary if it is not on PATH
