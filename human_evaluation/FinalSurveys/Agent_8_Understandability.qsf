c0392b;\">plus<\/span>(2));\n        <span style=\"color: #c0392b;\">assertEquals<\/span>(<span style=\"color: #c0392b;\">Minutes<\/span>.<span style=\"color: #c0392b;\">of<\/span>(3), fiveMinutes.<span style=\"color: #c0392b;\">plus<\/span>(-2));\n\n        <span style=\"color: #c0392b;\">Minutes<\/span> justBelowMaximum = <span style=\"color: #c0392b;\">Minutes<\/span>.<span style=\"color: #c0392b;\">of<\/span>(<span style=\"color: #c0392b;\">Integer<\/span>.<span style=\"color: #333333;\">MAX_VALUE<\/span> - 1);\n        <span style=\"color: #c0392b;\">assertEquals<\/span>(<span style=\"color: #c0392b;\">Minutes<\/span>.<span style=\"color: #c0392b;\">of<\/span>(<span style=\"color: #c0392b;\">Integer<\/span>.<span style=\"color: #333333;\">MAX_VALUE<\/span>), justBelowMaximum.<span style=\"color: #c0392b;\">plus<\/span>(1));\n\n        <span style=\"color: #c0392b;\">Minutes<\/span> justAboveMinimum = <span style=\"color: #c0392b;\">Minutes<\/span>.<span style=\"color: #c0392b;\">of<\/span>(<span style=\"color: #c0392b;\">Integer<\/span>.<span style=\"color: #333333;\">MIN_VALUE<\/span> + 1);\n        <span style=\"color: #c0392b;\">assertEquals<\/span>(<span style=\"color: #c0392b;\">Minutes<\/span>.<span style=\"color: #c0392b;\">of<\/span>(<span style=\"color: #c0392b;\">Integer<\/span>.<span style=\"color: #333333;\">MIN_VALUE<\/span>), justAboveMinimum.<span style=\"color: #c0392b;\">plus<\/span>(-1));\n    }\n<\/code><\/pre>\n    <\/div>\n<\/div>\n\n<p style=\"margin: 15px 0 5px 0; font-size: 15px; max-width: 1250px; margin-left: auto; margin-right: auto;\"><b>On a scale from 1 to 5, how understandable is this test?<\/b><\/p>\n<p style=\"margin: 0; font-style: italic; color: #666; font-size: 14px; max-width: 1250px; margin-left: auto; margin-right: auto;\">(1 = very hard to understand, 5 = very easy to understand)<\/p>","DefaultChoices":false,"DataExportTag":"P1_T11","QuestionID":"QID31","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnsw