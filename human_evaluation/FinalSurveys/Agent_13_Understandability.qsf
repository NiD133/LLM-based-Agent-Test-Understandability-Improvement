).<span style=\"color: #c0392b;\">encode<\/span>(<span style=\"color: #c0392b;\">StringUtils<\/span>.<span style=\"color: #c0392b;\">getBytesUtf8<\/span>(<span style=\"color: #333333;\">content<\/span>));\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">byte<\/span>[] <span style=\"color: #333333;\">encodedBytes1<\/span> = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #c0392b;\">Base58<\/span>().<span style=\"color: #c0392b;\">encode<\/span>(<span style=\"color: #c0392b;\">StringUtils<\/span>.<span style=\"color: #c0392b;\">getBytesUtf8<\/span>(<span style=\"color: #333333;\">content1<\/span>));\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">byte<\/span>[] <span style=\"color: #333333;\">content2Bytes<\/span> = <span style=\"color: #c0392b;\">ByteBuffer<\/span>.<span style=\"color: #c0392b;\">allocate<\/span>(8).<span style=\"color: #c0392b;\">putLong<\/span>(<span style=\"color: #333333;\">content2<\/span>).<span style=\"color: #c0392b;\">array<\/span>();\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">byte<\/span>[] <span style=\"color: #333333;\">content2Trimmed<\/span> = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #0066bb;\">byte<\/span>[6];\n        <span style=\"color: #c0392b;\">System<\/span>.<span style=\"color: #c0392b;\">arraycopy<\/span>(<span style=\"color: #333333;\">content2Bytes<\/span>, 2, <span style=\"color: #333333;\">content2Trimmed<\/span>, 0, 6);\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">byte<\/span>[] <span style=\"color: #333333;\">encodedBytes2<\/span> = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #c0392b;\">Base58<\/span>().<span style=\"color: #c0392b;\">encode<\/span>(<span style=\"color: #333333;\">content2Trimmed<\/span>);\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #c0392b;\">String<\