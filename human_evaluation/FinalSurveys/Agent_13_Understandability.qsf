":"QID55","SecondaryAttribute":"Part 2 attention check","TertiaryAttribute":null,"Payload":{"QuestionText":"Which test is more understandable","DataExportTag":"P2_P03_AC_1_CHOICE","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Part 2 attention check","Choices":{"1":{"Display":"Test A is more understandable"},"2":{"Display":"Test B is more understandable"},"3":{"Display":"They are about the same"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID55"}},{"SurveyID":"SV_a3l7r92DfSorfds","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Test 4 @Test void testBasicEncodeDecode() throws Exception { final QCodec qcodec = new QCodec();...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin-bottom: 20px;\">\n    <b style=\"font-size: 16px; display: block; margin-bottom: 10px; font-family: sans-serif;\">Test 4<\/b><div style=\"border: 1px solid #e0e0e0; border-radius: 4px; background-color: #f8f7f5; padding: 20px;\"><pre style=\"margin: 0; white-space: pre-wrap;\"><code style=\"font-family: 'Consolas', 'Monaco', monospace; font-size: 14px; line-height: 1.6; color: #333333;\">    <span style=\"color: #999999;\">@Test<\/span>\n    <span style=\"color: #0066bb;\">void<\/span> <span style=\"color: #c0392b;\">testBasicEncodeDecode<\/span>() <span style=\"color: #0066bb;\">throws<\/span> <span style=\"color: #c0392b;\">Exception<\/span> {\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #c0392b;\">QCodec<\/span> <span style=\"color: #333333;\">qcodec<\/span> = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #c0392b;\">QCodec<\/span>();\n\n        <span style=\"color: #999999;\">\/\/ A string mixing the unsafe characters '=', SPACE, CR and LF, which Q<\/span>\n        <span style=\"color: #999999;\">\/\/ encoding must escape as =3D, kept-space, =0D and =0A respectively.<\/span>\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #c0392b;\">String<\/span> <span style=\"color: #333333;\">plainText<\/span> = <span style=\"color: #448844;\">\"= Hello there =\\r\\n\"<\/span>;\n        <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #c0392b;\">String<\/span> <span style=\"color: #333333;\">expectedEncoded<\/span> = <span style=\"color: #448844;\">\"=?UTF-8?Q?=3D Hello there =3D=0D=0A?=\"<\/span>;\n\n        <span style=\"color: #999999;\">\/\/ Encoding wraps the text in the \"=?charset?Q?...?=\" envelope and escapes<\/span>\n        <span style=\"color: #999999;\">\/\/ the unsafe characters.<\/span>\n        <span style=\"color: #c0392b;\">assertEquals<\/span>(<span style=\"color: #333333;\">expectedEncoded<\/span>, <span style=\"color: #333333;\">qcodec<\/span>.<span style=\"color: #c0392b;\">encode<\/span>(<span style=\"color: #333333;\">plainText<\/span>), <span style=\"color: #448844;\">\"Basic Q encoding test\"<\/span>);\n\n        <span style=\"color: #999999;\">\/\/ Decoding the encoded form must reproduce the original text exactly.<\/span>\n        <span style=\"color: #c0392b;\">assertEquals<\/span>(<span style=\"color: #333333;\">plainText<\/span>, <span style=\"color: #333333;\">qcodec<\/span>.<span style=\"color: #c0392b;\">decode<\/span>(<span style=\"color: #333333;\">expectedEncoded<\/span>), <span style=\"color: #448844;\">\"Basic Q decoding test\"<\/span>);\n    }\n<\/code><\/pre>\n    <\/div>\n<\/div>\n\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\"><b>On a scale from 1 to 5, how understandable is this test?<\/b><\/p>\n<p style=\"margin: 0; font-style: italic; color: #666; font-size: 14px;\">(1 = very hard to understand, 5 = very easy to understand)<\/p>","DefaultChoices":false,"DataExportTag":"P1_T04","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Test 4 @Test void testBasicEncodeDecode() throws Exception { final QCodec qcodec = new QCodec();...","Choices":{"4":{"Display":"Understandability of Test"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"1 \u2013 Very hard to understand"},"2":{"Display":"2 \u2013 Hard"},"3":{"Display":"3 \u2013 Neutral"},"4":{"Display":"4 \u2013 Easy"},"5":{"Display":"5 \u2013 Very easy to understand"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID56"}},{"SurveyID":"SV_a3l7r92DfSorfds","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"ZZ_UNUSED_02","QuestionID":"QID58","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_a3l7r92DfSorfds","Element":"SQ","PrimaryAttribute":"QID59","SecondaryAttribute":"Please describe here","TertiaryAttribute":null,"Payload":{"QuestionText":"Please describe here","DefaultChoices":false,"DataExportTag":"P2_P06_4_WHY","QuestionID":"QID59","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription