#c0392b;\">IEEE754rUtils<\/span>.<span style=\"color: #c0392b;\">min<\/span>((<span style=\"color: #0066bb;\">float<\/span>[]) <span style=\"color: #0066bb;\">null<\/span>), <span style=\"color: #333333;\">NULL_ARRAY_MESSAGE<\/span>);\n        <span style=\"color: #c0392b;\">assertIllegalArgumentException<\/span>(<span style=\"color: #c0392b;\">IEEE754rUtils<\/span>::<span style=\"color: #c0392b;\">min<\/span>, <span style=\"color: #333333;\">EMPTY_ARRAY_MESSAGE<\/span>);\n    }\n\n    <span style=\"color: #0066bb;\">private void<\/span> <span style=\"color: #c0392b;\">assertFloatMaxRejectsInvalidInput<\/span>() {\n        <span style=\"color: #c0392b;\">assertNullPointerException<\/span>(() -&gt; <span style=\"color: #c0392b;\">IEEE754rUtils<\/span>.<span style=\"color: #c0392b;\">max<\/span>((<span style=\"color: #0066bb;\">float<\/span>[]) <span style=\"color: #0066bb;\">null<\/span>), <span style=\"color: #333333;\">NULL_ARRAY_MESSAGE<\/span>);\n        <span style=\"color: #c0392b;\">assertIllegalArgumentException<\/span>(<span style=\"color: #c0392b;\">IEEE754rUtils<\/span>::<span style=\"color: #c0392b;\">max<\/span>, <span style=\"color: #333333;\">EMPTY_ARRAY_MESSAGE<\/span>);\n    }\n\n    <span style=\"color: #0066bb;\">private void<\/span> <span style=\"color: #c0392b;\">assertDoubleMinRejectsInvalidInput<\/span>() {\n        <span style=\"color: #c0392b;\">assertNullPointerException<\/span>(() -&gt; <span style=\"color: #c0392b;\">IEEE754rUtils<\/span>.<span style=\"color: #c0392b;\">min<\/span>((<span style=\"color: #0066bb;\">double<\/span>[]) <span style=\"color: #0066bb;\">null<\/span>), <span style=\"color: #333333;\">NULL_ARRAY_MESSAGE<\/span>);\n        <span style=\"color: #c0392b;\">assertIllegalArgumentException<\/span>(<span style=\"color: #c0392b;\">IEEE754rUtils<\/span>::<span style=\"color: #c0392b;\">min<\/span>, <span style=\"color: #333333;\">EMPTY_ARRAY_MESSAGE<\/span>);\n    }\n\n    <span style=\"color: #0066bb;\">private void<\/span