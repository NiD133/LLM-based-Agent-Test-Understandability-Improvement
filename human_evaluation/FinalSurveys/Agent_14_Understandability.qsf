olor: #999999;\">@Test<\/span>\n<span style=\"color: #0066bb;\">public<\/span> <span style=\"color: #0066bb;\">void<\/span> <span style=\"color: #c0392b;\">testGet_WithExistingKey_ShouldReturnStoredValue<\/span>() {\n    <span style=\"color: #c0392b;\">Map<\/span>&lt;<span style=\"color: #c0392b;\">String<\/span>, <span style=\"color: #c0392b;\">Integer<\/span>&gt; stock = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #c0392b;\">HashMap<\/span>&lt;&gt;();\n    stock.<span style=\"color: #c0392b;\">put<\/span>(<span style=\"color: #448844;\">\"apple\"<\/span>, 5);\n    <span style=\"color: #0066bb;\">int<\/span> expected = 5;\n    <span style=\"color: #0066bb;\">int<\/span> result = stock.<span style=\"color: #c0392b;\">get<\/span>(<span style=\"color: #448844;\">\"apple\"<\/span>);\n    <span style=\"color: #c0392b;\">assertEquals<\/span>(expected, result, <span style=\"color: #448844;\">\"The value stored for the key was not returned.\"<\/span>);\n}<\/code><\/pre>\n    <\/div>\n<\/div>\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\">\n  <b>Attention Check:<\/b> \n  To ensure you are reading the instructions and code carefully, please \n  <b>ignore<\/b> \n  the actual understandability of the code above and select \n  <b>'1 = Very hard to understand'<\/b> \n  for this specific question.\n<\/p>\n\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\">\n  <b>On a scale from 1 to 5, how understandable is this test?<\/b>\n<\/p>\n\n<p style=\"margin: 0; font-style: italic; color: #666; font-size: 14px;\">\n  (1 = very hard to understand, 5 = very easy to understand)\n<\/p>","DefaultChoices":false,"DataExportTag":"P1_T09_AC","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Test 9 @Test public v