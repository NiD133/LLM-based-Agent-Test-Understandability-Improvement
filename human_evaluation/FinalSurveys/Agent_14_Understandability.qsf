{"SurveyEntry":{"SurveyID":"SV_5jupEnru3mqlGBg","SurveyName":"Agent_14_Understandability","SurveyDescription":null,"SurveyOwnerID":"UR_7QCiOyVkkhQbz94","SurveyBrandID":"kcliop","DivisionID":"DV_bOsqpWB9UkCSima","SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_0qukSw2mN7v3GMC","SurveyStatus":"Active","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2026-09-26 19:00:10","CreatorID":"UR_7QCiOyVkkhQbz94","LastModified":"2026-09-27 15:10:14","LastAccessed":"0000-00-00 00:00:00","LastActivated":"2026-09-27 07:56:40","Deleted":null},"SurveyElements":[{"SurveyID":"SV_5jupEnru3mqlGBg","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","Description":"Default Question Block","ID":"BL_6Mxt1JwIiOArQ8K","BlockElements":[{"Type":"Question","QuestionID":"QID1"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}},{"Type":"Trash","Description":"Trash \/ Unused Questions","ID":"BL_ctNTc82FgHpTtd4","BlockElements":[]},{"Type":"Standard","SubType":"","Description":"Block 1","ID":"BL_3jUDS37OIV1Gz5Q","BlockElements":[{"Type":"Question","QuestionID":"QID2"},{"Type":"Page Break"}]},{"Type":"Standard","SubType":"","Description":"Block 2","ID":"BL_3L7jWnYW4la8AKy","BlockElements":[{"Type":"Question","QuestionID":"QID4"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID18"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID38"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID37"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID56"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID36"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID35"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID34"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID33"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID52"},{"Type":"Page Break"},{"Type":"Quest