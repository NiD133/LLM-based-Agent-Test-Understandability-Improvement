void<\/span> <span style=\"color: #c0392b;\">testStartsWith_WithMatchingPrefix_ShouldReturnTrue<\/span>() {\n    <span style=\"color: #c0392b;\">String<\/span> input = <span style=\"color: #448844;\">\"JavaScript\"<\/span>;\n    <span style=\"color: #c0392b;\">String<\/span> prefix = <span style=\"color: #448844;\">\"Java\"<\/span>;\n    <span style=\"color: #0066bb;\">boolean<\/span> result = input.<span style=\"color: #c0392b;\">startsWith<\/span>(prefix);\n    <span style=\"color: #c0392b;\">assertTrue<\/span>(result, <span style=\"color: #448844;\">\"The string should start with the given prefix.\"<\/span>);\n}<\/code><\/pre>\n    <\/div>\n<\/div>\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\">\n  <b>Attention Check:<\/b> \n  To ensure you are reading the instructions and code carefully, please \n  <b>ignore<\/b> \n  the actual understandability of the code above and select \n  <b>'1 = Very hard to understand'<\/b> \n  for this specific question.\n<\/p>\n\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\">\n  <b>On a scale from 1 to 5, how understandable is this test?<\/b>\n<\/p>\n\n<p style=\"margin: 0; font-style: italic; color: #666; font-size: 14px;\">\n  (1 = very hard to understand, 5 = very easy to understand)\n<\/p>","DefaultChoices":false,"DataExportTag":"P1_T09_AC","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Test 9 @Test public void testStartsWith_WithMatchingPrefix_ShouldReturnTrue() { String input = \"J...","Choices":{"4":{"Display":"Understandability of Test"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"1 \u2013 Very hard to understand"},"2":{"Display":"2 \u2013 Hard"},"3":{"Display":"3 \u2013 Neutral"},"4":{"Display":"4 \u2013 Easy"},"5":{"Display":"5 \u2013 Very easy to understand"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID52"}},{"SurveyID":"SV_6i00wJNO8n2tTa6","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"ZZ_UNUSED_01","QuestionID":"QID53","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_6i00wJNO8n2tTa6","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"Please describe here","TertiaryAttribute":null,"Payload":{"QuestionText":"Please describe here","DefaultChoices":false,"DataExportTag":"P2_P05_4_WHY","QuestionID":"QID54","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please describe here","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_6i00wJNO8n2tTa6","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"Part 2 attention check","TertiaryAttribute":null,"Payload":{"QuestionText":"Which test is more understandable","DataExportTag":"P2_P03_AC_1_CHOICE","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Part 2 attention check","Choices":{"1":{"Display":"Test A is more understandable"},"2":{"Display":"Test B is more understandable"},"3":{"Display":"They are about the same"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID55"}},{"SurveyID":"SV_6i00wJNO8n2tTa6","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Test 4 private static final int NUMBER_OF_HASH_FUNCTIONS = 295; private static final int NUMBER_O...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin-bottom: 20px;\">\n    <b style=\"font-size: 16px; display: block; margin-bottom: 10px; font-family: sans-serif;\">Test 4<\/b><div style=\"border: 1px solid #e0e0e0; border-radius: 4px; background-color: #f8f7f5; padding: 20px;\"><pre style=\"margin: 0; white-space: pre-wrap;\"><code style=\"font-family: 'Consolas', 'Monaco', monospace; font-size: 14px; line-height: 1.6; color: #333333;\">    <span style=\"color: #0066bb;\">private<\/span> <span style=\"color: #0066bb;\">static<\/span> <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">int<\/span> <span style=\"color: #333333;\">NUMBER_OF_HASH_FUNCTIONS<\/span> = 295;\n    <span style=\"color: #0066bb;\">private<\/span> <span style=\"color: #0066bb;\">static<\/span> <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">int<\/span> <span style=\"color: #333333;\">NUMBER_OF_BITS<\/span> = 295;\n    <span style=\"color: #0066bb;\">private<\/span> <span style=\"color: #0066bb;\">static<\/span> <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">int<\/span> <span style=\"color: #333333;\">INDEX_ARRAY_LENGTH<\/span> = 7;\n    <span style=\"color: #0066bb;\">private<\/span> <span style=\"color: #0066bb;\">static<\/span> <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #0066bb;\">int<\/span> <span style=\"color: #333333;\">FIRST_OUT_OF_RANGE_INDEX<\/span> = 295;\n\n    <span style=\"color: #999999;\">@Test(timeout = 4000)<\/span>\n    <span style=\"color: #0066bb;\">public<\/span> <span style=\"color: #0066bb;\">void<\/span> <span style=\"color: #c0392b;\">test04<\/span>() <span style=\"color: #0066bb;\">throws<\/span> <span style=\"color: #c0392b;\">Throwable<\/span> {\n        <span style=\"color: #c0392b;\">Shape<\/span> shape = <span style=\"color: #c0392b;\">Shape<\/span>.<span style=\"color: #c0392b;\">fromKM<\/span>(<span style=\"color: #333333;\">NUMBER_OF_HASH_FUNCTIONS<\/span>, <span style=\"color: #333333;\">NUMBER_OF_BITS<\/span>);\n        <span style=\"color: #c0392b;\">SimpleBloomFilter<\/span> bloomFilter = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #c0392b;\">SimpleBloomFilter<\/span>(shape);\n\n        <span style=\"color: #0066bb;\">int<\/span>[] indexes = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #0066bb;\">int<\/span>[<span style=\"color: #333333;\">INDEX_ARRAY_LENGTH<\/span>];\n        indexes[0] = <span style=\"color: #333333;\">FIRST_OUT_OF_RANGE_INDEX<\/span>;\n        <span style=\"color: #c0392b;\">IndexExtractor<\/span> outOfRangeIndexExtractor = <span style=\"color: #c0392b;\">IndexExtractor<\/span>.<span style=\"color: #c0392b;\">fromIndexArray<\/span>(indexes);\n\n        <span style=\"color: #0066bb;\">try<\/span> {\n            bloomFilter.<span style=\"color: #c0392b;\">merge<\/span>(outOfRangeIndexExtractor);\n            <span style=\"color: #c0392b;\">fail<\/span>(<span style=\"color: #448844;\">\"Expecting exception: IllegalArgumentException\"<\/span>);\n        } <span style=\"color: #0066bb;\">catch<\/span> (<span style=\"color: #c0392b;\">IllegalArgumentException<\/span> e) {\n            <span style=\"color: #999999;\">\/\/<\/span>\n            <span style=\"color: #999999;\">\/\/ IndexExtractor should only send values in the range[0,295)<\/span>\n            <span style=\"color: #999999;\">\/\/<\/span>\n            <span style=\"color: #c0392b;\">verifyException<\/span>(<span style=\"color: #448844;\">\"org.apache.commons.collections4.bloomfilter.SimpleBloomFilter\"<\/span>, e);\n        }\n    }\n<\/code><\/pre>\n    <\/div>\n<\/div>\n\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\"><b>On a scale from 1 to 5, how understandable is this test?<\/b><\/p>\n<p style=\"margin: 0; font-style: italic; color: #666; font-size: 14px;\">(1 = very hard to understand, 5 = very easy to understand)<\/p>","DefaultChoices":false,"DataExportTag":"P1_T04","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Test 4 private static final int NUMBER_OF_HASH_FUNCTIONS = 295; private static final int NUMBER_O...","Choices":{"4":{"Display":"Understandability of Test"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"1 \u2013 Very hard to understand"},"2":{"Display":"2 \u2013 Hard"},"3":{"Display":"3 \u2013 Neutral"},"4":{"Display":"4 \u2013 Easy"},"5":{"Display":"5 \u2013 Very easy to understand"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID56"}},{"SurveyID":"SV_6i00wJNO8n2tTa6","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"ZZ_UNUSED_02","QuestionID":"QID58","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Setti