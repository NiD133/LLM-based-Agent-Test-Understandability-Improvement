lic void testLength_WithSimpleWord_ShouldReturnCharacterCount() { String input =...","Choices":{"4":{"Display":"Understandability of Test"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"1 \u2013 Very hard to understand"},"2":{"Display":"2 \u2013 Hard"},"3":{"Display":"3 \u2013 Neutral"},"4":{"Display":"4 \u2013 Easy"},"5":{"Display":"5 \u2013 Very easy to understand"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID52"}},{"SurveyID":"SV_cxe2I8sfQWx1JzM","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"ZZ_UNUSED_01","QuestionID":"QID53","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cxe2I8sfQWx1JzM","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"Please describe here","TertiaryAttribute":null,"Payload":{"QuestionText":"Please describe here","DefaultChoices":false,"DataExportTag":"P2_P05_4_WHY","QuestionID":"QID54","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please describe here","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cxe2I8sfQWx1JzM","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"Part 2 attention check","TertiaryAttribute":null,"Payload":{"QuestionText":"Which test is more understandable","DataExportTag":"P2_P03_AC_1_CHOICE","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Part 2 attention check","Choices":{"1":{"Display":"Test A is more understandable"},"2":{"Display":"Test B is more understandable"},"3":{"Display":"They are about the same"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID55"}},{"SurveyID":"SV_cxe2I8sfQWx1JzM","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Test 4 \/** * The constructor inserts every \"always encode\" byte into a BitSet, which * requires e...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin-bottom: 20px;\">\n    <b style=\"font-size: 16px; display: block; margin-bottom: 10px; font-family: sans-serif;\">Test 4<\/b><div style=\"border: 1px solid #e0e0e0; border-radius: 4px; background-color: #f8f7f5; padding: 20px;\"><pre style=\"margin: 0; white-space: pre-wrap;\"><code style=\"font-family: 'Consolas', 'Monaco', monospace; font-size: 14px; line-height: 1.6; color: #333333;\">  <span style=\"color: #999999;\">\/**\n     * The constructor inserts every \"always encode\" byte into a BitSet, which\n     * requires each byte to be non-negative. A negative byte must therefore be\n     * rejected with an IllegalArgumentException (\"byte must be &gt;= 0\").\n     *\/<\/span>\n    <span style=\"color: #999999;\">@Test(timeout = 4000)<\/span>\n    <span style=\"color: #0066bb;\">public<\/span> <span style=\"color: #0066bb;\">void<\/span> <span style=\"color: #c0392b;\">constructorRejectsNegativeAlwaysEncodeByte<\/span>() <span style=\"color: #0066bb;\">throws<\/span> <span style=\"color: #c0392b;\">Throwable<\/span> {\n        <span style=\"color: #0066bb;\">byte<\/span>[] alwaysEncodeChars = <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #0066bb;\">byte<\/span>[] { (<span style=\"color: #0066bb;\">byte<\/span>) -43 };\n\n        <span style=\"color: #0066bb;\">try<\/span> {\n            <span style=\"color: #0066bb;\">new<\/span> <span style=\"color: #c0392b;\">PercentCodec<\/span>(alwaysEncodeChars, <span style=\"color: #0066bb;\">false<\/span>);\n            <span style=\"color: #c0392b;\">fail<\/span>(<span style=\"color: #448844;\">\"Expecting exception: IllegalArgumentException\"<\/span>);\n        } <span style=\"color: #0066bb;\">catch<\/span> (<span style=\"color: #c0392b;\">IllegalArgumentException<\/span> e) {\n            <span style=\"color: #999999;\">\/\/ Negative bytes cannot be stored in the BitSet: \"byte must be &gt;= 0\".<\/span>\n            <span style=\"color: #c0392b;\">verifyException<\/span>(<span style=\"color: #448844;\">\"org.apache.commons.codec.net.PercentCodec\"<\/span>, e);\n        }\n    }\n<\/code><\/pre>\n    <\/div>\n<\/div>\n\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\"><b>On a scale from 1 to 5, how understandable is this test?<\/b><\/p>\n<p style=\"margin: 0; font-style: italic; color: #666; font-size: 14px;\">(1 = very hard to understand, 5 = very easy to understand)<\/p>","DefaultChoices":false,"DataExportTag":"P1_T04","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Test 4 \/** * The constructor inserts every \"always encode\" byte into a BitSet, which * requires e...","Choices":{"4":{"Display":"Understandability of Test"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"1 \u2013 Very hard to understand"},"2":{"Display":"2 \u2013 Hard"},"3":{"Display":"3 \u2013 Neutral"},"4":{"Display":"4 \u2013 Easy"},"5":{"Display":"5 \u2013 Very easy to understand"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID56"}},{"SurveyID":"SV_cxe2I8sfQWx1JzM","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"ZZ_UNUSED_02","QuestionID":"QID58","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cxe2I8sfQWx1JzM","Element":"SQ","PrimaryAttribute":"QID59","SecondaryAttribute":"Please describe here","TertiaryAttribute":null,"Payload":{"QuestionText":"Please describe here","DefaultChoices":false,"DataExportTag":"P2_P06_4_WHY","QuestionID":"QID59","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please describe here","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_cxe2I8sfQWx1JzM","Element":"SQ","PrimaryAttribute":"QID60","SecondaryAttribute":"Please describe here","TertiaryAttribute":null,"Payload":{"QuestionText":"Please describe here","DefaultChoices":false,"DataExportTag":"P2_P02_4_WHY","QuestionID":"QID60","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden