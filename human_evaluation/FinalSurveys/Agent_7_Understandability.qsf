utral"},"4":{"Display":"4 \u2013 Easy"},"5":{"Display":"5 \u2013 Very easy to understand"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID52"}},{"SurveyID":"SV_emKN858Tnr5XWia","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"ZZ_UNUSED_01","QuestionID":"QID53","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_emKN858Tnr5XWia","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"Please describe here","TertiaryAttribute":null,"Payload":{"QuestionText":"Please describe here","DefaultChoices":false,"DataExportTag":"P2_P05_4_WHY","QuestionID":"QID54","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please describe here","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_emKN858Tnr5XWia","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"Part 2 attention check","TertiaryAttribute":null,"Payload":{"QuestionText":"Which test is more understandable","DataExportTag":"P2_P03_AC_1_CHOICE","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Part 2 attention check","Choices":{"1":{"Display":"Test A is more understandable"},"2":{"Display":"Test B is more understandable"},"3":{"Display":"They are about the same"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID55"}},{"SurveyID":"SV_emKN858Tnr5XWia","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Test 4 \/** A fixed sample day-of-month used as the test subject. *\/ private static final DayOfMon...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"margin-bottom: 20px;\">\n    <b style=\"font-size: 16px; display: block; margin-bottom: 10px; font-family: sans-serif;\">Test 4<\/b><div style=\"border: 1px solid #e0e0e0; border-radius: 4px; background-color: #f8f7f5; padding: 20px;\"><pre style=\"margin: 0; white-space: pre-wrap;\"><code style=\"font-family: 'Consolas', 'Monaco', monospace; font-size: 14px; line-height: 1.6; color: #333333;\">    <span style=\"color: #999999;\">\/** A fixed sample day-of-month used as the test subject. *\/<\/span>\n    <span style=\"color: #0066bb;\">private<\/span> <span style=\"color: #0066bb;\">static<\/span> <span style=\"color: #0066bb;\">final<\/span> <span style=\"color: #c0392b;\">DayOfMonth<\/span> <span style=\"color: #333333;\">TEST<\/span> = <span style=\"color: #c0392b;\">DayOfMonth<\/span>.<span style=\"color: #c0392b;\">of<\/span>(12);\n\n    <span style=\"color: #999999;\">\/\/-----------------------------------------------------------------------<\/span>\n    <span style=\"color: #999999;\">\/\/ now()<\/span>\n    <span style=\"color: #999999;\">\/\/-----------------------------------------------------------------------<\/span>\n    <span style=\"color: #999999;\">@RetryingTest(100)<\/span>\n    <span style=\"color: #0066bb;\">public<\/span> <span style=\"color: #0066bb;\">void<\/span> <span style=\"color: #c0392b;\">test_now<\/span>() {\n        <span style=\"color: #0066bb;\">int<\/span> expectedDay = <span style=\"color: #c0392b;\">LocalDate<\/span>.<span style=\"color: #c0392b;\">now<\/span>().<span style=\"color: #c0392b;\">getDayOfMonth<\/span>();\n        <span style=\"color: #c0392b;\">assertEquals<\/span>(expectedDay, <span style=\"color: #c0392b;\">DayOfMonth<\/span>.<span style=\"color: #c0392b;\">now<\/span>().<span style=\"color: #c0392b;\">getValue<\/span>());\n    }\n\n    <span style=\"color: #999999;\">@RetryingTest(100)<\/span>\n    <span style=\"color: #0066bb;\">public<\/span> <span style=\"color: #0066bb;\">void<\/span> <span style=\"color: #c0392b;\">test_now_ZoneId<\/span>() {\n        <span style=\"color: #c0392b;\">ZoneId<\/span> tokyo = <span style=\"color: #c0392b;\">ZoneId<\/span>.<span style=\"color: #c0392b;\">of<\/span>(<span style=\"color: #448844;\">\"Asia\/Tokyo\"<\/span>);\n        <span style=\"color: #0066bb;\">int<\/span> expectedDay = <span style=\"color: #c0392b;\">LocalDate<\/span>.<span style=\"color: #c0392b;\">now<\/span>(tokyo).<span style=\"color: #c0392b;\">getDayOfMonth<\/span>();\n        <span style=\"color: #c0392b;\">assertEquals<\/span>(expectedDay, <span style=\"color: #c0392b;\">DayOfMonth<\/span>.<span style=\"color: #c0392b;\">now<\/span>(tokyo).<span style=\"color: #c0392b;\">getValue<\/span>());\n    }\n\n    <span style=\"color: #999999;\">\/\/-----------------------------------------------------------------------<\/span>\n    <span style=\"color: #999999;\">\/\/ adjustInto(Temporal)<\/span>\n    <span style=\"color: #999999;\">\/\/-----------------------------------------------------------------------<\/span>\n    <span style=\"color: #999999;\">@Test<\/span>\n    <span style=\"color: #0066bb;\">public<\/span> <span style=\"color: #0066bb;\">void<\/span> <span style=\"color: #c0392b;\">test_adjustInto_null<\/span>() {\n        <span style=\"color: #999999;\">\/\/ Adjusting a null temporal must be rejected with a NullPointerException.<\/span>\n        <span style=\"color: #c0392b;\">assertThrows<\/span>(<span style=\"color: #c0392b;\">NullPointerException<\/span>.<span style=\"color: #0066bb;\">class<\/span>, () -&gt; <span style=\"color: #333333;\">TEST<\/span>.<span style=\"color: #c0392b;\">adjustInto<\/span>((<span style=\"color: #c0392b;\">Temporal<\/span>) <span style=\"color: #0066bb;\">null<\/span>));\n    }\n<\/code><\/pre>\n    <\/div>\n<\/div>\n\n<p style=\"margin: 15px 0 5px 0; font-size: 15px;\"><b>On a scale from 1 to 5, how understandable is this test?<\/b><\/p>\n<p style=\"margin: 0; font-style: italic; color: #666; font-size: 14px;\">(1 = very hard to understand, 5 = very easy to understand)<\/p>","DefaultChoices":false,"DataExportTag":"P1_T04","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Test 4 \/** A fixed sample day-of-month used as the test subject. *\/ private static final DayOfMon...","Choices":{"4":{"Display":"Understandability of Test"}},"ChoiceOrder":["4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"1 \u2013 Very hard to understand"},"2":{"Display":"2 \u2013 Hard"},"3":{"Display":"3 \u2013 Neutral"},"4":{"Display":"4 \u2013 Easy"},"5":{"Display":"5 \u2013 Very easy to understand"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID56"}},{"SurveyID":"SV_emKN858Tnr5XWia","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"ZZ_UNUSED_02","QuestionID":"QID58","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption"