xtChoiceId":6,"NextAnswerId":1,"QuestionID":"QID2"}},{"SurveyID":"SV_6DmA5L24z0MN3L0","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"What happens if an assertEquals(10, result) fails?","TertiaryAttribute":null,"Payload":{"QuestionText":"What happens if an <em><strong>assertEquals(10, result)<\/strong><\/em> fails?","DefaultChoices":false,"DataExportTag":"Q3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What happens if an assertEquals(10, result) fails?","Choices":{"1":{"Display":"The program crashes and stops entirely."},"2":{"Display":"The current test fails, but other tests will still run."},"3":{"Display":"The test will automatically retry until it passes."},"4":{"Display":"JUnit will ignore the failure and mark it as \"Success\"."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"2","Grades":{"SC_dp49Wjjz7sKhNYy":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_6DmA5L24z0MN3L0","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"If you want to assert a condition and provide a custom failure message in one statement, the JUni...","TertiaryAttribute":null,"Payload":{"QuestionText":"If you want to assert a condition and provide a custom failure message in one statement, the JUnit5 <strong>assertEquals<\/strong> method signature can be:","DefaultChoices":false,"DataExportTag":"Q4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you want to assert a condition and provide a custom failure message in one statement, the JUni...","Choices":{"1":{"Display":"assertEquals(expected, actual, message)"},"2":{"Display":"assertEquals(message, expected, actual)"},"3":{"Display":"assertEquals(expected, message, actual)"},"4":{"Display":"assertEquals(expected, actual) (cannot have a message)"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","Grades":{"SC_dp49Wjjz7sKhNYy":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID4"}},{"SurveyID":"SV_6DmA5L24z0MN3L0","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"List list = new ArrayList (Arrays.asList(1, 2, 3)); list.remove(1); \/\/ What is removed? assertFal...","TertiaryAttribute":null,"Payload":{"QuestionText":"List&lt;Integer&gt; list = new ArrayList&lt;&gt;(Arrays.asList(1, 2, 3));<br>\nlist.remove(1); \/\/ What is removed?<br>\nassertFalse(list.contains(1));","DefaultChoices":false,"DataExportTag":"Q5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"List list = new ArrayList (Arrays.asList(1, 2, 3)); list.remove(1); \/\/ What is removed? assertFal...","Choices":{"1":{"Display":"Yes, because value 1 was removed."},"2":{"Display":"No, because remove(1) removed the element at index 1."},"3":{"Display":"No, because remove doesn't work on Integers."},"4":{"Display":"Yes, because all elements are removed."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"2","Grades":{"SC_dp49Wjjz7sKhNYy":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_6DmA5L24z0MN3L0","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Will this test pass? Why? Set set = new HashSet(); set.add(\"apple\"); set.add(\"apple\"); assertEqua...","TertiaryAttribute":null,"Payload":{"QuestionText":"Will this test pass? Why?<br><br>Set set = new HashSet();\n<br>set.add(\"apple\"); <br>set.add(\"apple\");\n<br>assertEquals(1, set.size());<br>","DefaultChoices":false,"DataExportTag":"Q6","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Will this test pass? Why? Set set = new HashSet(); set.add(\"apple\"); set.add(\"apple\"); assertEqua...","Choices":{"1":{"Display":"Yes \u2013 Because HashSet does not allow duplicate elements."},"2":{"Display":"Yes \u2013 Because HashSet automatically removes all null values."},"3":{"Display":"No \u2013 Because adding a duplicate throws an exception."},"4":{"Display":"No \u2013 Because HashSet counts each add call, even if it\u2019s a duplicate."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","Grades":{"SC_dp49Wjjz7sKhNYy":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_6DmA5L24z0MN3L0","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Queue queue = new LinkedList (); queue.add(\"1\"); queue.add(\"2\"); String result = queue.poll(); as...","TertiaryAttribute":null,"Payload":{"QuestionText":"Queue&lt;String&gt; queue = new LinkedList&lt;&gt;();<br>\nqueue.add(\"1\");<br>\nqueue.add(\"2\");<br>\nString result = queue.poll();<br>\n<br>\nassertEquals(\"1\", result);","DefaultChoices":false,"DataExportTag":"Q7","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Queue queue = new LinkedList (); queue.add(\"1\"); queue.add(\"2\"); String result = queue.poll(); as...","Choices":{"1":{"Display":"It returns the first element added and removes it from the queue."},"2":{"Display":"It returns the first element added but does not remove it."},"3":{"Display":"It returns the last element added and removes it from the queue."},"4":{"Display":"It returns the last element but not remove it."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","Grades":{"SC_dp49Wjjz7sKhNYy":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID7"}},{"SurveyID":"SV_6DmA5L24z0MN3L0","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"A system has the following requirement: \"Users must be at least 18 years old and no more than 65...","TertiaryAttribute":null,"Payload":{"QuestionText":"A system has the following requirement: \"Users must be <b data-index-in-node=\"65\" data-path-to-node=\"11,0\">at least 18<\/b> years old and <b data-index-in-node=\"91\" data-path-to-node=\"11,0\">no more than 65<\/b> years old to register.\" The developer writes: <code data-index-in-node=\"153\" data-path-to-node=\"11,0\">assertTrue(age &gt;= 18 &amp;&amp; age &lt;= 65);<\/code> Which set of input values best represents the <b data-index-in-node=\"235\" data-path-to-node=\"11,0\">boundary cases<\/b> to verify this specific logic?","DefaultChoices":false,"DataExportTag":"Q8","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"A system has the following requirement: \"Users must be at least 18 years old and no more than 65...","Choices":{"1":{"Display":"0,100"},"2":{"Display":"18,65"},"3":{"Display":"17,18,19"},"4":{"Display":"17,18,65,66"}},"ChoiceOrder":[1,2,"3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","Grades":{"SC_dp49Wjjz7sKhNYy":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID8"}},{"SurveyID":"SV_6DmA5L24z0MN3L0","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Which assertion would you use to check if two objects are not the same?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which assertion would you use to check if tw